<apex:page standardController="TASKRAY__Project_Task__c">
    <apex:form >
        <apex:pageBlock mode="edit">            
            <apex:pageBlockSection columns="1">
                <apex:inputField label="Scribe Page URL" value="{!TASKRAY__Project_Task__c.Scribe_Page_URL__c}"/>
                <apex:inputField label="Scribe" value="{!TASKRAY__Project_Task__c.Scribe__c}"/>
            </apex:pageBlockSection>
            <apex:pageBlockButtons >
                <apex:commandButton action="{!save}" value="Save"/>
            </apex:pageBlockButtons>
        </apex:pageBlock>
    </apex:form>
    <apex:include pagename="ScribePageView" rendered="{!NOT(ISBLANK(TASKRAY__Project_Task__c.Scribe_Page_URL__c))}"/>
</apex:page>