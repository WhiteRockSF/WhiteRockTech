    <formulas>
        <name>DayWeekAfterFirstDay</name>
        <dataType>Date</dataType>
        <expression>{!FirstDayOfMonth} + 7</expression>
    </formulas>
    <formulas>
        <name>FirstDayOfMonth</name>
        <dataType>Date</dataType>
        <expression>DATE( YEAR( TODAY()), MONTH( TODAY()), 1 )</expression>
    </formulas>
    <formulas>
        <name>GroupNumberToProcess</name>
        <dataType>Number</dataType>
        <expression>IF( {!Support_Task_Settings.GroupNumber__c} != {!Support_Task_Default_Settings.Total_Count__c},  {!Support_Task_Settings.GroupNumber__c}+1, 1)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>LastDayOfMonth</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS( DATE( YEAR( TODAY()), MONTH( TODAY() ), 1 ), 1 ) - 1</expression>
    </formulas>
    <formulas>
        <name>MonthName</name>
        <dataType>String</dataType>
        <expression>CASE(MONTH(TODAY()),
  1, &quot;January&quot;,
  2, &quot;February&quot;,
  3, &quot;March&quot;,
  4, &quot;April&quot;,
  5, &quot;May&quot;,
  6, &quot;June&quot;,
  7, &quot;July&quot;,
  8, &quot;August&quot;,
  9, &quot;September&quot;,
  10, &quot;October&quot;,
  11, &quot;November&quot;,
  12, &quot;December&quot;,
  &quot;None&quot;
)</expression>
    </formulas>
    <formulas>
        <name>TaskName</name>
        <dataType>String</dataType>
        <expression>&apos;Monthly Health Check - &apos;&amp;{!MonthName}</expression>
    </formulas>
