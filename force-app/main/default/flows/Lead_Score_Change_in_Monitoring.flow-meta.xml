    <decisions>
        <name>Monitoring_Status</name>
        <label>Monitoring Status</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Set_Score_Change_and_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Score_and_Date</targetReference>
            </connector>
            <label>Set Score Change and Date</label>
        </rules>
        <rules>
            <name>Check_Score_Change</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Date_Changed_to_Monitoring__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>SixtyDays</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Lead_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>FiftyPlus</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reset_Status</targetReference>
            </connector>
            <label>Check Score Change</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>FiftyPlus</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Lead_Score_when_Monitoring__c}+50</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>SixtyDays</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Date_Changed_to_Monitoring__c}+60</expression>
    </formulas>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>TwoDaysOut</name>
        <dataType>Date</dataType>
        <expression>CASE(
MOD(TODAY() - DATE(1900, 1, 7), 7),
0, (TODAY()) + 3 + FLOOR((3-1)/5)*2,
1, (TODAY()) + 3 + FLOOR((3-1)/5)*2,
2, (TODAY()) + 3 + FLOOR((3-1)/5)*2,
3, (TODAY()) + 3 + FLOOR((3-1)/5)*2,
4, (TODAY()) + 3 + FLOOR((3-1)/5)*2,
5, (TODAY()) + 3 + FLOOR((3-1)/5)*2,
6, (TODAY()) - IF(3&gt;0,1,0) + 3 + CEILING((3)/5)*2,
null)</expression>
    </formulas>
    <interviewLabel>Lead Score Change in Monitoring {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead Score Change in Monitoring</label>
