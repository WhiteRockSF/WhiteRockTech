        <label>How much tasks on lead?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>X1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TasksAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_1st_Contact_status_to_Lead</targetReference>
            </connector>
            <label>1</label>
        </rules>
        <rules>
            <name>More</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TasksAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Working_status_to_Lead</targetReference>
            </connector>
            <label>More</label>
        </rules>
    </decisions>
