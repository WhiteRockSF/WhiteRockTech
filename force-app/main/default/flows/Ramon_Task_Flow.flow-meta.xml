    <formulas>
        <name>OneDayDueDate</name>
        <dataType>Date</dataType>
        <expression>CASE(
MOD(TODAY() - DATE(1900, 1, 7), 7) ,
0, (TODAY() + 1),
1, (TODAY() + 2),
2, (TODAY() + 2),
3, (TODAY() + 2) ,
4, (TODAY() + 4) ,
5, (TODAY() + 3) ,
6, (TODAY() + 2),
null)</expression>
    </formulas>
    <formulas>
        <name>TwoDayDueDate</name>
        <dataType>Date</dataType>
        <expression>CASE(
MOD(TODAY() - DATE(1900, 1, 7), 7)  ,
0, (TODAY() + 1),
1, (TODAY() + 3),
2, (TODAY() + 3),
3, (TODAY() + 5) ,
4, (TODAY() + 4) ,
5, (TODAY() + 3) ,
6, (TODAY() + 2),
null)</expression>
    </formulas>
