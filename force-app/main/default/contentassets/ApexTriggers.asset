"01q15000001dVQzAAM","","DeleteProcessRecords","PbxProcess__c","false","false","false","false","true","false","true","false","36.0","Active","false","1.847217002E9","/**
        Name                 :    DeleteProcessRecords 
        Description          :    This trigger is used to delete Child Process Records.
        Date                 :    April 25, 2016

*/

trigger DeleteProcessRecords on PbxProcess__c (before delete) {

    List<PbxProcess__c >  parentProcessList = new List<PbxProcess__c >();
  
    // Deleting Child Process records

    parentProcessList  = [select id from PbxProcess__c  where ParentPublishProcess__c in: trigger.old];
    if(parentProcessList !=null && parentProcessList.size()>0)
       delete parentProcessList ;
    
}","341","2016-04-25T07:40:51.000Z","00515000006PjX3AAK","2016-04-25T11:31:59.000Z","00515000006PjX3AAK","2018-06-02T13:54:13.000Z"
"01q15000001dU2kAAE","","UpdateSortPositionPlay","PbxPlay__c","false","true","false","false","true","false","true","false","36.0","Active","false","3.563782184E9","trigger UpdateSortPositionPlay on PbxPlay__c (after insert ,before delete ) {
    List<PbxPlay__c>playInsList = new List<PbxPlay__c>();
    
    if(trigger.isInsert){
        map<string,integer> stageMap = new map<string,integer>();
        set<string> playSet = new set<string>();
        for(PbxPlay__c obj : trigger.new){
            stageMap.put(obj.stage__c,null);
            playSet.add(obj.id);
            
        }
        
        if(stageMap.size() > 0 && playSet.size() > 0){
            for(AggregateResult obj : [select stage__c stg,Max(sortPosition__c) max from PbxPlay__c where stage__c in : stageMap.keySet() group by stage__c ]){
                if(obj.get('stg') != null && obj.get('max') != null){
                   stageMap.put(string.valueOf(obj.get('stg')), integer.valueOf(obj.get('max'))); 
                }        
            }
            
            for(PbxPlay__c obj : [select id,stage__c,sortPosition__c from PbxPlay__c where id in : playSet]){
                obj.name = obj.id;
                if(stageMap.get(obj.stage__c) != null){
                    obj.sortPosition__c = stageMap.get(obj.stage__c) + 1;
                    stageMap.put(obj.stage__c,stageMap.get(obj.stage__c) + 1);
                }else{
                    obj.sortPosition__c = 0;
                    stageMap.put(obj.stage__c,0);
                }
                playInsList.add(obj);
            }
            
            if(playInsList.size() > 0){
                update playInsList;
            }
        }                    
    }else if(trigger.isDelete){
        map<string,decimal> stageMap2 = new map<string,decimal>();
        
        for(PbxPlay__c obj : trigger.old){
            stageMap2.put(obj.stage__c,obj.sortPosition__c);
        }
        if(stageMap2.size() > 0){
            for(PbxPlay__c obj : [select id , sortPosition__c,stage__c from PbxPlay__c where stage__c in : stageMap2.keySet()]){
                if(stageMap2.containsKey(obj.stage__c) && obj.sortPosition__c > stageMap2.get(obj.stage__c)){
                    obj.sortPosition__c = obj.sortPosition__c - 1;
                    playInsList.add(obj);                        
                }
            }
            if(playInsList.size() > 0){
                update playInsList;
            }            
        }
    }

}","2265","2016-04-15T10:06:23.000Z","00515000006PjX3AAK","2016-05-12T06:08:35.000Z","00515000006PjX3AAK","2018-06-02T13:54:13.000Z"
