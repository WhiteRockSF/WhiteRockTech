"01q15000001dUWpAAM","","OpportunityPlayBookFieldUpdate","PbxProcessInstance__c","false","true","false","true","false","true","true","true","36.0","Active","false","3.857571424E9","trigger OpportunityPlayBookFieldUpdate on PbxProcessInstance__c (after insert,after update,after delete,after undelete) {
    Map<String,PbxProcessInstance__c> oppMap = new Map<String,PbxProcessInstance__c>();
    Set<Id> processInstanceIds = new Set<Id>();
    List<Opportunity> oppsToUpdate = new List<Opportunity>();
    List<Account> accToUpdate = new List<Account>();
    List<Lead> leadToUpdate = new List<Lead>();
    
    //Puting those opportunity which are updated.
    if(trigger.isUpdate){
        for(PbxProcessInstance__c processIns : trigger.new){
            if(trigger.oldMap.get(processIns.id).opportunity__c != null && trigger.oldMap.get(processIns.id).opportunity__c != processIns.Opportunity__c)
                oppMap.put((String)trigger.oldMap.get(processIns.id).opportunity__c,null);                                                  
            if(processIns.Opportunity__c!=null)oppMap.put(processIns.Opportunity__c,processIns); 
            
            processInstanceIds.add(processIns.Id);             
        }
        Map<Id, PbxProcessInstance__c> piMap = new Map<Id, PbxProcessInstance__c>([SELECT Id, Score__c, RedFlagCount__c, PlaybookEntityType__c, 
                                                                    Opportunity__r.Id, Lead__r.Id, Account__r.Id
                                                                    FROM PbxProcessInstance__c WHERE Id in: processInstanceIds]);
        
        for (PbxProcessInstance__c pi : Trigger.new) {
            PbxProcessInstance__c piFromDb = piMap.get(pi.Id);
    
            if(piFromDb.Opportunity__r !=null && piFromDb.PlaybookEntityType__c == 'Opportunity')
            {
                Opportunity opp = piFromDb.Opportunity__r;
                opp.WinnabilityScore__c = piFromDb.Score__c < 0?0:piFromDb.Score__c;
                opp.RedFlagCount__c = piFromDb.RedFlagCount__c;
                
                oppsToUpdate.add(opp);            
            }else if(piFromDb.Lead__r!=null && piFromDb.PlaybookEntityType__c == 'Lead'){
            
            }else if(piFromDb.Account__r!=null && piFromDb.PlaybookEntityType__c == 'Account'){
            }
        }       
    }else {  //On Insert, delete and undelete.
        //Filling Map with there opportunity Id.
        for(PbxProcessInstance__c processIns : trigger.isDelete ? trigger.old : trigger.new){
            if(processIns.Opportunity__c!=null)oppMap.put(processIns.Opportunity__c,processIns);
        }
    }
    
    //On Delete
    if(trigger.isDelete){        
        for (PbxProcessInstance__c pInstance : trigger.old){
            processInstanceIds.add( pInstance.Id );
        }
        
        Map<Id, PbxProcessInstance__c> pIMap = new Map<Id, PbxProcessInstance__c>([SELECT Id, PlaybookEntityType__c, Opportunity__r.Id, Account__r.Id, Lead__r.Id FROM PbxProcessInstance__c WHERE Id in: processInstanceIds]);
        
        for (PbxProcessInstance__c pI : trigger.old) {
            //if(pI.PlaybookEntityType__c == 'Opportunity')
            if(pI.Opportunity__r !=null && pI.PlaybookEntityType__c == 'Opportunity')
            {
                Opportunity opp = pIMap.get(pI.Id).Opportunity__r;
                opp.PlaybookName__c = '';
                opp.WinnabilityScore__c = 0;
                opp.RedFlagCount__c = 0;
                oppsToUpdate.add(opp);
            }else if(pI.Lead__r !=null && pI.PlaybookEntityType__c == 'Lead'){
            
            }else if(pI.Account__r !=null && pI.PlaybookEntityType__c == 'Account'){
            }
    
        }
    }
    
    if(oppMap.size()>0){
        //Fatching record according to opportunity Id of processInstance.
        List<Opportunity> oppList = [select id,PlaybookName__c from Opportunity where id in : oppMap.keySet()];
        if(oppList!=null && oppList.size()>0){
            for(Opportunity opp : oppList){
                opp.PlaybookName__c = trigger.isDelete ? '' : oppMap.get(opp.id)==null ? '' : oppMap.get(opp.id).name__c;
            }    
            update oppList;
        }
    }
    
    //Update Opportunity , Account and Lead.
    if(oppsToUpdate.size() > 0){
        update oppsToUpdate;
    }
    if(accToUpdate.size() > 0){
        update accToUpdate;
    }
    if(leadToUpdate.size() > 0){
        update leadToUpdate;
    }
    
}","3870","2016-04-19T13:02:08.000Z","00515000006PjX3AAK","2016-05-13T06:08:34.000Z","00515000006PjX3AAK","2018-06-02T13:54:13.000Z"
