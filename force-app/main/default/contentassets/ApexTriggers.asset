"01q15000001dXxUAAU","","UpdateSortPositionAnswer","PbxAnswer__c","false","true","false","false","true","false","true","false","36.0","Active","false","3.181635158E9","trigger UpdateSortPositionAnswer on PbxAnswer__c (after insert ,before delete) {
    List<PbxAnswer__c>ansList = new List<PbxAnswer__c>();
    
    if(trigger.isInsert){
        map<string,integer> quesMap = new map<string,integer>();
        set<string> ansSet = new set<string>();
        for(PbxAnswer__c obj : trigger.new){
            quesMap.put(obj.question__c,null);
            ansSet.add(obj.id);
            
        }
        
        if(quesMap.size() > 0 && ansSet.size() > 0){
            for(AggregateResult obj : [select question__c pl,Max(sortPosition__c) max from PbxAnswer__c where question__c in : quesMap.keySet() group by question__c ]){
                if(obj.get('pl') != null && obj.get('max') != null){
                   quesMap.put(string.valueOf(obj.get('pl')), integer.valueOf(obj.get('max'))); 
                }        
            }
            
            for(PbxAnswer__c obj : [select id,question__c,sortPosition__c from PbxAnswer__c where id in : ansSet]){
                if(quesMap.get(obj.question__c) != null){
                    obj.sortPosition__c = quesMap.get(obj.question__c) + 1;
                    quesMap.put(obj.question__c,quesMap.get(obj.question__c) + 1);
                }else{
                    obj.sortPosition__c = 0;
                    quesMap.put(obj.question__c,0);
                }
                ansList.add(obj);
            }
            
            if(ansList.size() > 0){
                update ansList;
            }
        }                    
    }else if(trigger.isDelete){
        map<string,decimal> quesMap2 = new map<string,decimal>();
        
        for(PbxAnswer__c obj : trigger.old){
            quesMap2.put(obj.question__c,obj.sortPosition__c);
        }
        if(quesMap2.size() > 0){
            for(PbxAnswer__c obj : [select id , sortPosition__c,question__c from PbxAnswer__c where question__c in : quesMap2.keySet()]){
                if(quesMap2.containsKey(obj.question__c) && obj.sortPosition__c > quesMap2.get(obj.question__c)){
                    obj.sortPosition__c = obj.sortPosition__c - 1;
                    ansList.add(obj);                        
                }
            }
            if(ansList.size() > 0){
                update ansList;
            }            
        }
    }

}","2245","2016-05-19T07:23:37.000Z","00515000006PjX3AAK","2016-05-19T07:23:39.000Z","00515000006PjX3AAK","2018-06-02T13:54:13.000Z"
"01q15000001JBCPAA4","","OnTrackOffTrackCalculation","PbxQuestionInstance__c","true","true","true","true","true","false","true","true","38.0","Active","false","3.858702978E9","trigger OnTrackOffTrackCalculation on PbxQuestionInstance__c (before insert, before update, after insert, after update, before delete, after undelete) {
    
    if((trigger.isUpdate || trigger.isInsert) && trigger.isBefore){
        Map<String, Decimal> singleCHighSMap = new Map<String, Decimal>();
        Map<String, Decimal> questionPointsMap = new Map<String, Decimal>();
    
        //filling question(original record) id to fetch points  
        for(PbxQuestionInstance__c obj: trigger.new){
            if(obj.questionId__c != NULL && obj.questionId__c.trim().length() > 14){
                questionPointsMap.put(obj.questionId__c, NULL);
                //filling singleCHighSMap for single choice only because high score of single choice type ques. should be max(weight__c) of answer instance because user can select only one answer  
                if(obj.responseType__c == 'SingleChoice'){
                    singleCHighSMap.put(obj.id, NULL);
                }
                //playStageMap.put(obj.play__c, NULL);
            }
        }
        //perform all actions when question instances have questionId(original record id)
        if(questionPointsMap.size() > 0){
            //retrieve questions
            for(PbxQuestion__c obj : [SELECT points__c FROM PbxQuestion__c WHERE id IN: questionPointsMap.keySet()]){
                questionPointsMap.put(obj.id, obj.points__c);
            }
            
            //calculate hight score for single choice quest.
            if(singleCHighSMap.size() > 0){
                for(AggregateResult agg : [SELECT questionInstance__c id, Max(weight__c) mxW FROM PbxAnswerInstance__c WHERE questionInstance__c IN :singleCHighSMap.keySet() GROUP BY questionInstance__c]){
                    singleCHighSMap.put((String)agg.get('id'), (Decimal)agg.get('mxW'));
                }
            }
            
            //Calculate Scores at Question Level
            for(PbxQuestionInstance__c obj: trigger.new){
                if(obj.questionId__c != NULL && obj.questionId__c.trim().length() > 14){
                    if(obj.responseType__c == 'SingleChoice'){
                        if(singleCHighSMap.get(obj.id) != NULL && questionPointsMap.get(obj.questionId__c) != NULL){
                            obj.HighestScore__c = (questionPointsMap.get(obj.questionId__c) * singleCHighSMap.get(obj.id));
                        }else{
                            obj.HighestScore__c = 0;
                        }
                    }else{
                        if(questionPointsMap.get(obj.questionId__c) != NULL)
                            obj.HighestScore__c = (questionPointsMap.get(obj.questionId__c) * obj.Total_Allowed_Score__c);
                        else
                            obj.HighestScore__c = 0;
                    }                    
                    if(questionPointsMap.get(obj.questionId__c) != NULL)
                        obj.ActualScore__c = (questionPointsMap.get(obj.questionId__c) * obj.Score__c);
                    else
                        obj.ActualScore__c = 0;
                }
            }
            
                
        }
    }else if((trigger.isUpdate || trigger.isInsert) && trigger.isAfter){
        Map<String, List<PbxStageInstance__c>> stageMap = new Map<String, List<PbxStageInstance__c>>();
        Map<String, Set<String>> stageIdMap = new Map<String, Set<String>>();
        Map<String, Decimal> stageHSMap = new Map<String, Decimal>();
        Map<String, Decimal> stageASMap = new Map<String, Decimal>();
        Map<String, Decimal> stageAnsMap = new Map<String, Decimal>();
        //Calculate Scores at Stage Level
        //getting all process instance ids
        for(PbxQuestionInstance__c obj: trigger.new){
            if(obj.ProcessInstance__c != NULL && String.valueOf(obj.ProcessInstance__c).trim().length() > 14){
                stageIdMap.put(obj.ProcessInstance__c, NULL);
                
            }
            
        }
        if(stageIdMap.size() > 0){
            //retrieve stage records related to perticular process instance
            for(PbxStageInstance__c obj : [SELECT ProcessInstance__c, ActualScore__c, CumulativeScore__c, HighestScore__c 
                                           FROM PbxStageInstance__c 
                                           WHERE ProcessInstance__c IN: stageIdMap.keySet() 
                                           AND ProcessInstance__r.Opportunity__c != NULL //12TH FEB ADDED TO FIRE TRIGGER FOR OPPORTUNITY ONLY
                                           ORDER BY sortPosition__c]){
                Set<String> stageIdSet;
                if(stageIdMap.containsKey(obj.ProcessInstance__c) && stageIdMap.get(obj.ProcessInstance__c) != NULL){
                    stageIdSet = stageIdMap.get(obj.ProcessInstance__c);
                             
                }else{
                    stageIdSet = new Set<String>();
                }
                
                List<PbxStageInstance__c> stageList;
                if(stageIdMap.containsKey(obj.ProcessInstance__c) && stageIdMap.get(obj.ProcessInstance__c) != NULL){
                    stageList = stageMap.get(obj.ProcessInstance__c);
                             
                }else{
                    stageList = new List<PbxStageInstance__c>();
                }
                
                stageIdSet.add(obj.id);
                stageList.add(obj);
                stageIdMap.put(obj.ProcessInstance__c, stageIdSet);
                stageMap.put(obj.ProcessInstance__c, stageList);
            }
            
            //get HighestScore__c ActualScore__c for stages
            for(AggregateResult agg : [SELECT PlayInstance__r.stageInstance__c id, SUM(isAnswered__c) isanswered, SUM(HighestScore__c) hscore, SUM(ActualScore__c) ascore FROM PbxQuestionInstance__c WHERE ProcessInstance__c IN: stageIdMap.keySet() GROUP BY PlayInstance__r.stageInstance__c]){
                stageHSMap.put((String)agg.get('id'), (Decimal)agg.get('hscore'));
                stageASMap.put((String)agg.get('id'), (Decimal)agg.get('ascore'));  
                stageAnsMap.put((String)agg.get('id'), (Decimal)agg.get('isanswered'));     
            }
            system.debug('##stageHSMap##= '+ stageHSMap);
            system.debug('##stageASMap##= '+ stageASMap);
            system.debug('##stageAnsMap##= '+ stageASMap);
            List<PbxStageInstance__c> stageUpdateList = new List<PbxStageInstance__c>();
            for(List<PbxStageInstance__c> stgList : stageMap.values()){
                
                Boolean inFirstTime = false;
                Decimal cumulativeSum = 0;
                Decimal actualSum = 0;
                for(PbxStageInstance__c obj : stgList){
                    //filling Highest Score
                    if(stageHSMap.containsKey(obj.id)){
                        obj.HighestScore__c = stageHSMap.get(obj.id);
                    }
                    
                    //filling Actual Score
                    if(stageASMap.containsKey(obj.id) && actualSum != NULL && stageASMap.get(obj.id) != NULL){
                        obj.ActualScore__c = actualSum + stageASMap.get(obj.id);
                        actualSum += stageASMap.get(obj.id);
                        
                        if(stageAnsMap.get(obj.id) > 0){
                            //filling Cumulative Score
                            if(stageHSMap.containsKey(obj.id) && cumulativeSum != NULL && stageHSMap.get(obj.id) != NULL){
                                obj.CumulativeScore__c = cumulativeSum + stageHSMap.get(obj.id);
                                cumulativeSum += stageHSMap.get(obj.id);
                            }
                        }else{
                            obj.CumulativeScore__c = cumulativeSum;
                        }
                    }
                    system.debug('##Obj##= '+ obj);
                    stageUpdateList.add(obj);
                    inFirstTime = true;        
                }    
            }
            //updating stage level calculation finally
            if(stageUpdateList.size() > 0){
                update stageUpdateList;
            }
        }
    }
}","6947","2016-11-08T14:43:58.000Z","00515000006PhzjAAC","2017-02-23T08:58:34.000Z","00515000006PhzjAAC","2018-06-02T13:54:13.000Z"
