"01q15000001JHudAAG","","LeadConversionTrigger","Lead","false","false","false","true","false","false","true","false","39.0","Active","false","5.96351676E8","trigger LeadConversionTrigger on Lead (After Update) {
    Map<String, String> leadToOpportunityMap = new Map<String, String>();
    
    for(Lead leadObj : Trigger.new){
        if(leadObj.isConverted){
            leadToOpportunityMap.put(leadObj.Id, leadObj.ConvertedOpportunityId);  
