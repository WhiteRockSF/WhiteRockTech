"01q15000001UqpaAAC","","UpdateIdToNameTrigger","PbxStage__c","false","true","false","false","false","false","true","false","36.0","Active","false","2.843885679E9","trigger UpdateIdToNameTrigger on PbxStage__c (after insert) {
    List<PbxStage__c>updateList = new List<PbxStage__c>();
    
    for(PbxStage__c obj : trigger.new){
        PbxStage__c stgObj = new PbxStage__c();
        stgObj.id = obj.id;
        stgObj.name = obj.id;
        updateList.add(stgObj);
    }
    if(updateList.size() > 0){
        update updateList;
    }
