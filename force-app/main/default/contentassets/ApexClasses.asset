    public void updateQuestionNote(){
        try{
            if(questionIdForNote != null && questionIdForNote.trim().length() >= 15){
                pbxQuestionInstance__c obj = new pbxQuestionInstance__c();
                obj.id = questionIdForNote;
                obj.note__c = noteQuestion;
                update obj;
                questionIdForNote = '';
                noteQuestion = '';
                main();     
            }
        }catch(Exception e){
            errorMsg = e.getMessage();
            system.debug('Exception==>'+e.getMessage());
        }
    }
    
    public void fillDataMapresponseMap(){
        try{
            fieldLengthMap = new Map<String, Integer>();
            dataMapResponse = new Map<string,string>();
            List<SObjectField> leadFieldMap = Schema.SObjectType.Lead.fields.getMap().values();
            if(leadFieldMap != null && leadFieldMap.size() > 0){
                for(Schema.SObjectField tempField : leadFieldMap){
                    Schema.DescribeFieldResult field= tempField.getDescribe();
                    fieldLengthMap.put(field.getName(), 0);
                    if(field.isUpdateable() && field.isCustom()){
                        if(field.getType() == Schema.DisplayType.Boolean){
                            dataMapResponse.put(field.getName(),'boolean'); 
                        }else if(field.getType() == Schema.DisplayType.MultiPicklist){
                            dataMapResponse.put(field.getName(),'multipicklist');
                        }else if(field.getType() == Schema.DisplayType.Picklist){
                            dataMapResponse.put(field.getName(),'picklist');
                        }else if(field.getType() == Schema.DisplayType.Currency || field.getType() == Schema.DisplayType.Double){
                            dataMapResponse.put(field.getName(),'double');
                            fieldLengthMap.put(field.getName(), field.getPrecision());
                        }else if(field.getType() == Schema.DisplayType.Date){
                            dataMapResponse.put(field.getName(),'date');
                        }else if(field.getType() == Schema.DisplayType.DateTime){
                            dataMapResponse.put(field.getName(),'datetime');
                        }else{
                            dataMapResponse.put(field.getName(),'text');
                            fieldLengthMap.put(field.getName(), field.getLength());
                        }
                        //system.debug('##length='+ field.getName() + '= ' + field.getLength());    
                        //system.debug('##digits='+ field.getName() + '= ' + field.getPrecision());
                        
                    }
                }
                system.debug('##dataMapResponse='+dataMapResponse);
            }
        }catch(Exception e){
            system.debug('Exception ==>'+e.getMessage());
        }
    }
    
     
       public void saveCallManagementChanges(){
        try{
            
        List<PbxAnswerInstance__c>callMAnsList = new List<PbxAnswerInstance__c>();
        List<PbxAnswerInstance__c>callMAnsListForText = new List<PbxAnswerInstance__c>();
        Lead leadUpdateObj;
        if(CMDMdlList.size() > 0){
            for(CallManagementDiscussionModal obj : CMDMdlList){
                for(DealProgressModal obj2 : obj.qList){
                    String selectedStr = '';
                    if(obj2.text != null){
                        system.debug('##text'+obj2.text);
                    }
                    for(PbxAnswerInstance__c objAns : obj2.qObj.answerInstances__r){
                        system.debug('##objAns.answer__c==<>'+objAns.answer__c);
                        system.debug('##obj2.qObj.responseType__c = '+obj2.qObj.responseType__c);
                        if(obj2.qObj.responseType__c == 'Text' || obj2.qObj.responseType__c == 'Number' || obj2.qObj.responseType__c == 'Date' || obj2.qObj.responseType__c == 'Amount' || obj2.qObj.responseType__c == 'Percent'){
                            objAns.answer__c = obj2.text;
