        public CallManagementAssessmentModal(){
            playSortOrder = 0;
            qList = new List<DealProgressModal>();
            msgList = new List<PbxMessageInstance__c>();
            
        }
    }
    public class DealProgressModal{
        public PbxQuestionInstance__c qObj{get;set;}
        public boolean check{get;set;}
        public string text{get;set;}
        public string datamapStr{get;set;}
        public List<selectoption>choice {get;set;}
        public string selectedSChoice{get;set;}
        public string selectedRating{get;set;}
        public List<string>selectedMChoice {get;set;}
        //below both declarations are used to show answer in red font if flag type = 'Red'
        public Map<String,boolean> selectedMChoiceRedFlagMap {get; set;}
        public boolean selectedSChoiceRedFlag {get; set;}
        
        public DealProgressModal(){
            qObj = new PbxQuestionInstance__c();
            check = false;
            choice = new List<selectoption>();
            selectedMChoice = new List<string>();
            selectedMChoiceRedFlagMap = new Map<String,boolean>();
            
        }    
    }
   
