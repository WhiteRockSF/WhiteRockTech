                                                //Stage
                                                ( SELECT Id, Name__c FROM StageInstances__r ORDER BY SortPosition__c ASC ) 
                                                FROM PbxProcessInstance__c 
                                                WHERE id = :processInstanceIds];
                                            
            List<Opportunity> updateOpps = new List<Opportunity>();
            List<PbxProcessInstance__c> updatePis = new List<PbxProcessInstance__c>();
        
            for (Integer count = 0; count < opportunityIds.size(); count++)
            {
                Opportunity opp = opps.get(count);
                PbxProcessInstance__c pi = pis.get(count);
                
                pi.Opportunity__c = opp.id;
                opp.PlaybookName__c = pis.get(count).Name__c;
                opp.RedFlagCount__c = 0;
                opp.WinnabilityScore__c = 0;
            
            
                //Set opportunity current stage to the stage in Playbook
                if(opp.StageName != null && opp.StageName.length()>0)
                {
                    //for(PbxStage__c st: process.Stages__r)
                    for(PbxStageInstance__c sti : pi.StageInstances__r )
                    {
                        if(sti.Name__c == opp.StageName)
                        {
                            pi.CurrentStage__c = sti.id;
                            break;
                        }
                    }
                }
            
                updateOpps.add(opp);
                updatePis.add(pi);
            }
        
            update updateOpps;
            update updatePis;
        
            
        }catch(Exception e)
        {
            Database.rollback(sp);
            List<String> errors = new List<String>();
            errors.add(e.getMessage() + ' line#:' + e.getLineNumber());
            return errors;
        }
        return processInstanceIds;
    }


    
     // Create multi ProcessInstance for playbooking
     
    webservice static List<Id> publishPlaybookProcess(String processId, Integer numberOfPI)
    {
        Savepoint sp = Database.setSavepoint();
        
        List<String> processInstanceIds = new List<String>();
        for (Integer count = 0; count < numberOfPI; count++)
        {
        
        
        PbxProcessInstance__c pi = new PbxProcessInstance__c();
        PbxProcess__c process;
        try{
            //Process & Stage 
            process = [ SELECT Id, Description__c, Name__c, PlaybookEntityType__c, Points__c, ParentPublishProcess__c, ProgressThreshold__c, Mapping__c,
                        //Stage
                        ( SELECT Id, Description__c, Name__c, SortPosition__c, isLibrary__c FROM Stages__r ORDER BY SortPosition__c ASC ) 
                        FROM PbxProcess__c 
                        WHERE id = :processId AND ParentPublishProcess__c != NULL AND PublishDate__c != NULL AND Active__c = true];
            
            //Create new ProcessInstance
            pi.Description__c = process.Description__c;
            pi.Name__c = process.Name__c;
            pi.ProgressThreshold__c = process.ProgressThreshold__c != null?process.ProgressThreshold__c:0;
            pi.PlaybookEntityType__c = process.PlaybookEntityType__c;
            pi.Process__c = process.ParentPublishProcess__c;
            pi.Mapping__c = process.Mapping__c;
            insert pi;
            //if(process==null)
            //{
            //    throw new Exception();
                //throws new Exception('Publish Process not found.');
            //}
                
            //StageInstances creation    
            Map<Id, PbxStageInstance__c> oldStagesIdToCloneMap = new Map<Id, PbxStageInstance__c>();
            PbxStageInstance__c currentStage;
            for(PbxStage__c st: process.Stages__r)
            {
                PbxStageInstance__c newSi = new PbxStageInstance__c();
                newSi.ProcessInstance__c = pi.Id;
                newSi.Description__c = st.Description__c;
                newSi.Name__c = st.Name__c;
                newSi.SortPosition__c = st.SortPosition__c;
                newSi.isLibrary__c = st.isLibrary__c;
                
                //if(newSi.SortPosition__c == 0)
                //{
                //   currentStage = newSi;
                //}
                oldStagesIdToCloneMap.put(st.Id, newSi);
            }
            insert oldStagesIdToCloneMap.values();
            //Set Current first stage to the first stage.
            //pi.CurrentStage__c = currentStage.id;
            update pi;
            
            //Play
            List<PbxPlay__c> plays = [  SELECT Id, Name, Description__c, Name__c, SortPosition__c, Stage__c,
                                        //Messages
                                        (SELECT Id, Description__c, Link__c, Name__c, SortPosition__c, Tip__c FROM Messages__r),
                                        //Tools
                                        (SELECT id, WorkspaceId__c, DocumentId__c, Link__c, Description__c, Name__c, SortPosition__c, Tip__c FROM Tools__r )
                                        FROM PbxPlay__c
                                        WHERE Stage__r.Process__r.id= :processId
                                        ORDER BY SortPosition__c ASC ]; 
            
            //Create new PlayInstances
            Map<Id, PbxPlayInstance__c> oldPlaysIdToCloneMap = new Map<Id, PbxPlayInstance__c>();            
            for(PbxPlay__c pl: plays)
            {
                PbxPlayInstance__c pli = new PbxPlayInstance__c();
                pli.StageInstance__c = oldStagesIdToCloneMap.get(pl.Stage__c).Id;
                pli.Description__c = pl.Description__c;
                pli.Name__c = pl.Name__c;
                pli.SortPosition__c = pl.SortPosition__c;
                oldPlaysIdToCloneMap.put(pl.Id, pli);
            }
            insert oldPlaysIdToCloneMap.values();            
            
            //Tool & Message
            //List<PbxTool__c> listTools = new List<PbxTool__c>();
            List<SObject> toolInsert = new List<SObject>();
            List<SObject> msgInsert = new List<SObject>();
            for(PbxPlay__c pl: plays)
            {
                for(PbxTool__c tool: pl.Tools__r)
                {
                    PbxToolInstance__c ti = new PbxToolInstance__c();
                    ti.PlayInstance__c = oldPlaysIdToCloneMap.get(pl.Id).Id;
                    ti.Description__c = tool.Description__c;
                    ti.Name__c = tool.Name__c;
                    ti.Link__c = tool.Link__c;
                    ti.SortPosition__c = tool.SortPosition__c;
                    ti.Tip__c = tool.Tip__c;
                    toolInsert.add(ti);
                }
                
                for(PbxMessage__c msg: pl.Messages__r)
                {
                    PbxMessageInstance__c msgi = new PbxMessageInstance__c();
                    msgi.PlayInstance__c = oldPlaysIdToCloneMap.get(pl.Id).Id;
                    msgi.Description__c = msg.Description__c;
                    msgi.Name__c = msg.Name__c;
                    msgi.Link__c = msg.Link__c;
                    msgi.SortPosition__c = msg.SortPosition__c;
                    msgi.Tip__c = msg.Tip__c;
                    msgInsert.add(msgi);
                }
            }
            
           insert toolInsert;
           insert msgInsert;
           
           //Question & Answer & Flags
           List<PbxQuestion__c> questions = [ SELECT Id, Description__c, IncludedInExecSummary__c, IncludedInKeyMilestones__c, Link__c, Name__c, Play__c, Points__c, Process__c, ResponseType__c, SortPosition__c, Tip__c,
                                            //Answer
                                            ( SELECT Id, Answer__c, FlagType__c, Question__c, SortPosition__c, Weight__c FROM Answers__r ORDER BY SortPosition__c ),
                                            //Flags
                                            ( SELECT Id, CompareValue__c, FlagType__c, Operation__c, Question__c FROM ContentFlags__r)
                                            FROM PbxQuestion__c
                                            WHERE Play__r.Stage__r.Process__r.id= :processId
                                            ORDER BY SortPosition__c ASC ];
                                            
            Map<Id, PbxQuestionInstance__c> oldQnsIdToCloneMap = new Map<Id, PbxQuestionInstance__c>();
            List<PbxQuestionInstance__c> updateQuesIScore = new List<PbxQuestionInstance__c>();
            
            Map<String, Schema.SObjectField> m = Schema.SObjectType.Opportunity.fields.getMap();
            
            for(PbxQuestion__c qns: questions)
            {
                PbxQuestionInstance__c qnsi = new PbxQuestionInstance__c();
                qnsi.PlayInstance__c = oldPlaysIdToCloneMap.get(qns.Play__c).Id;
                qnsi.ProcessInstance__c = pi.Id;
                qnsi.IncludedInExecSummary__c = qns.IncludedInExecSummary__c;
                qnsi.IncludedInKeyMilestones__c = qns.IncludedInKeyMilestones__c;
                qnsi.Description__c = qns.Description__c;
                qnsi.Name__c = qns.Name__c;
                qnsi.Link__c = qns.Link__c;
                qnsi.SortPosition__c = qns.SortPosition__c;
                qnsi.Tip__c = qns.Tip__c;
                qnsi.ResponseType__c = qns.ResponseType__c;
                //if(qns.ResponseType__c == 'DataMap')
                //{
                //    qnsi.DataMappingName__c = qns.Answers__r.get(0).Answer__c;
                //}
                
                oldQnsIdToCloneMap.put(qns.Id, qnsi);
            }
            insert oldQnsIdToCloneMap.values();
            
            //Answer & Flags
            List<SObject> flagInsert = new List<SObject>();
            List<PbxAnswerInstance__c> ansInstanceList = new List<PbxAnswerInstance__c>();
                        
            for(PbxQuestion__c qns: questions)
            {
                Double highestWeight = 0;
                Double totalWeight = 0;
                Double score = 0;

                if(process.Points__c > 0)
                {
                    //score = (qns.Points__c / process.Points__c * 100).setScale(0);
                    score = (qns.Points__c / process.Points__c);
                }

                PbxQuestionInstance__c qnsi = new PbxQuestionInstance__c(id=oldQnsIdToCloneMap.get(qns.Id).Id);
                qnsi.HighestScore__c = score;
                updateQuesIScore.add(qnsi);
                
                for( PbxAnswer__c ans: qns.Answers__r )
                {
                    if(ans.Weight__c <= 0){ 
                        continue;
                    }else if(ans.Weight__c > highestWeight)
                    {
                        highestWeight = ans.Weight__c;
                    }
                    totalWeight += ans.Weight__c;
                }
                
                for( PbxAnswer__c ans: qns.Answers__r )
                {
                    PbxAnswerInstance__c ansi = new PbxAnswerInstance__c();
                    ansi.QuestionInstance__c = oldQnsIdToCloneMap.get(qns.Id).Id;
                    ansi.FlagType__c = ans.FlagType__c;
                    ansi.Answer__c = ans.Answer__c;
                    ansi.SortPosition__c = ans.SortPosition__c;
                    
                    //Prepare Normalized Winnability Score.
                    if(qns.Points__c <=0)
                    {
                        ansi.Weight__c = 0;
                    }else{
                        if(ans.Weight__c == 0){
                            ansi.Weight__c = 0;
                        }else if(ans.Weight__c < 0 ){
                            ansi.Weight__c = score * -1;
                        }else if(qns.ResponseType__c == 'SingleChoice'){
                            ansi.Weight__c = ( score * ans.Weight__c / highestWeight );
                        }else if(qns.ResponseType__c == 'MultiChoice'){
                            ansi.Weight__c = ( score * ans.Weight__c / totalWeight );
                        }
                    }
                    ansInstanceList.add(ansi);
                }
                
                for( PbxContentFlag__c flag: qns.ContentFlags__r )
                {
                    PbxContentFlagInstance__c flagi = new PbxContentFlagInstance__c();
                    flagi.QuestionInstance__c = oldQnsIdToCloneMap.get(qns.Id).Id;
                    flagi.CompareValue__c = flag.CompareValue__c;
                    flagi.FlagType__c = flag.FlagType__c;
                    flagi.Operation__c = flag.Operation__c;
                    flagInsert.add(flagi);                
                }
            }                                
            insert flagInsert;
            insert ansInstanceList;
            update updateQuesIScore;
            
        }catch(Exception e)
        {
            Database.rollback(sp);
            List<String> errors = new List<String>();
            errors.add(e.getMessage() + ' line#:' + e.getLineNumber());
            return errors;
        }
            processInstanceIds.add(pi.id);
        }
        return processInstanceIds;
    }
    
    webservice static PbxProcess__c publishProcess(String processId)
    {
        Id newProcessId = PbxProcessWebService.cloneFullProcessTree(processId);
        
        //Delete All Old Published Process.
        List<PbxProcess__c> oldProcesses = [ SELECT Id FROM PbxProcess__c
                                             WHERE ParentPublishProcess__c = :processId
                                           ];
        Delete oldProcesses;
        
        //Update Publish newProcess
        PbxProcess__c newProcess = [SELECT Name, Id, Description__c, Name__c, PublishDate__c, PlaybookEntityType__c, Points__c, ParentPublishProcess__c, ProgressThreshold__c
                                    FROM PbxProcess__c 
                                    WHERE Id = :newProcessId
                                   ];
                                   
        newProcess.ParentPublishProcess__c = processId;
        newProcess.PublishDate__c = Datetime.now();
        newProcess.Name = 'PP' + newProcess.Name;
        
        Update newProcess;
        
        PbxProcess__c selectedProcess = [ SELECT Id, PublishDate__c FROM PbxProcess__c WHERE Id = :processId];
        selectedProcess.PublishDate__c = newProcess.PublishDate__c;
        
        Update selectedProcess;
        
        return newProcess;
    }
    
    webservice static Id cloneFullProcessTree(String processId)
    {
        Savepoint sp = Database.setSavepoint();
        PbxProcess__c newProcess;
        PbxProcess__c process;

        try{
            //Process & Stage 
            process = [ SELECT Id, Name, Active__c, Description__c, Name__c, PlaybookEntityType__c, Points__c, ProgressThreshold__c, Mapping__c, 
                        //Stage
                        ( SELECT Id, Description__c, Name__c, SortPosition__c, isLibrary__c FROM Stages__r ORDER BY SortPosition__c ASC ) 
                        FROM PbxProcess__c 
                        WHERE id = :processId ];
                        
            newProcess = process.clone(false,true);
            insert newProcess;
            
            Map<Id, PbxStage__c> oldStagesIdToCloneMap = new Map<Id, PbxStage__c>();
            for(PbxStage__c st: process.Stages__r)
            {
                PbxStage__c newStage = st.clone(false);
                newStage.Process__c = newProcess.Id;
                oldStagesIdToCloneMap.put(st.Id, newStage);
            }
            insert oldStagesIdToCloneMap.values();
            
            //Play
            List<PbxPlay__c> plays = [  SELECT Id, Description__c, Name__c, SortPosition__c, Stage__c,
                                        //Messages
                                        (SELECT Id, Description__c, Link__c, Name__c, SortPosition__c, Tip__c FROM Messages__r),
                                        //Tools
                                        (SELECT id, WorkspaceId__c, DocumentId__c, Link__c, Description__c, Name__c, SortPosition__c, Tip__c FROM Tools__r )
                                        FROM PbxPlay__c
                                        WHERE Stage__r.Process__r.id= :processId
                                        ORDER BY SortPosition__c ASC ];
                                        
            Map<Id, PbxPlay__c> oldPlaysIdToCloneMap = new Map<Id, PbxPlay__c>();            
            for(PbxPlay__c pl: plays)
            {
                PbxPlay__c newPlay = pl.clone(false);
                newPlay.Stage__c = oldStagesIdToCloneMap.get(pl.Stage__c).Id;
                newPlay.Process__c = newProcess.Id;
                oldPlaysIdToCloneMap.put(pl.Id, newPlay);
            }
            insert oldPlaysIdToCloneMap.values();            
            
            //Tool & Message
            //List<PbxTool__c> listTools = new List<PbxTool__c>();
            List<SObject> cloneToolsInsert = new List<SObject>();
            List<SObject> cloneMessagesInsert = new List<SObject>();
            for(PbxPlay__c pl: plays)
            {
                for(PbxTool__c tool: pl.Tools__r)
                {
                    PbxTool__c newTool = tool.clone(false);
                    newTool.Play__c = oldPlaysIdToCloneMap.get(pl.Id).Id;
                    cloneToolsInsert.add(newTool);
                }
                
                for(PbxMessage__c msg: pl.Messages__r)
                {
                    PbxMessage__c newMsg = msg.clone(false);
                    newMsg.Play__c = oldPlaysIdToCloneMap.get(pl.Id).Id;
                    cloneMessagesInsert.add(newMsg);
                }
            }
            
           insert cloneToolsInsert;
           insert cloneMessagesInsert;
           
           //Question & Answer & Flags
           List<PbxQuestion__c> questions = [ SELECT Id, Description__c, IncludedInExecSummary__c, IncludedInKeyMilestones__c, Link__c, Name__c, Play__c, Points__c, Process__c, ResponseType__c, SortPosition__c, Tip__c,
                                            //Answer
                                            ( SELECT Id, Answer__c, FlagType__c, Question__c, SortPosition__c, Weight__c FROM Answers__r ORDER BY SortPosition__c ),
                                            //Flags
                                            ( SELECT Id, CompareValue__c, FlagType__c, Operation__c, Question__c FROM ContentFlags__r)
                                            FROM PbxQuestion__c
                                            WHERE Play__r.Stage__r.Process__r.id= :processId
                                            ORDER BY SortPosition__c ASC ];
                                            
            Map<Id, PbxQuestion__c> oldQnsIdToCloneMap = new Map<Id, PbxQuestion__c>();            
            for(PbxQuestion__c qns: questions)
            {
                PbxQuestion__c newQns = qns.clone(false);
                newQns.Play__c = oldPlaysIdToCloneMap.get(qns.Play__c).Id;
                newQns.Process__c = newProcess.Id;
                oldQnsIdToCloneMap.put(qns.Id, newQns);
            }
            insert oldQnsIdToCloneMap.values();
            
            //Answer & Flags
            List<SObject> cloneAnsInsert = new List<SObject>();
            List<SObject> cloneFlagsInsert = new List<SObject>();
            
            for(PbxQuestion__c qns: questions)
            {
                for( PbxAnswer__c ans: qns.Answers__r )
                {
                    PbxAnswer__c newAns = ans.clone(false);
                    newAns.Question__c = oldQnsIdToCloneMap.get(qns.Id).Id;
                    cloneAnsInsert.add(newAns);                
                }
                
                for( PbxContentFlag__c flag: qns.ContentFlags__r )
                {
                    PbxContentFlag__c newFlag = flag.clone(false);
                    newFlag.Question__c = oldQnsIdToCloneMap.get(qns.Id).Id;
                    cloneFlagsInsert.add(newFlag);                
                }
            }                                
           insert cloneAnsInsert;
           insert cloneFlagsInsert;                                       
                                       
           return newProcess.Id;
            
        }catch(Exception e)
        {
            Database.rollback(sp);
            //List<String> errors = new List<String>();
            String errors = e.getMessage() + ' line#:' + e.getLineNumber();
            //errors.add();
            return errors;
        }
    }
    
    webservice static Id copyMessageContentToPlay( String playId, String messageId, Integer position)
    {
        if (playId == null || messageId == null || playId.trim() =='' || messageId.trim() == '') {
            throw new NullException('Input Error');
        }
        
        Savepoint sp = Database.setSavepoint();
        
        PbxMessage__c msg;
        PbxMessage__c clone = new PbxMessage__c(); 
        
        try{
            msg = [SELECT Id, Description__c, Link__c, Name__c, SortPosition__c, Tip__c FROM PbxMessage__c WHERE Id = :messageId];

            if(msg == null || msg.id==null)
            {    
                throw new NullException('PbxMessage Not Found');
            }
            
            clone = msg.clone(false);
            clone.SortPosition__c = position;
            clone.Play__c = playId;
            
            insert clone;
            return clone.Id;
            
        }catch(Exception e)
        {
            Database.rollback(sp);
            List<String> errors = new List<String>();
            errors.add(e.getMessage() + ' line#:' + e.getLineNumber());
            return null;
        }
    }
    
