"01p15000006byBsAAI","","PlaybooxBuilderDashboardController","36.0","Active","true","1.514490877E9","public with sharing class PlaybooxBuilderDashboardController{
    public List<PbxProcess__c>processList{get;set;}
    public PbxProcess__c processObj{get;set;}
    public String cloneProcessId{get;set;}
    public List<SelectOption> PlaybookEntityTypeList {get;set;}
    public String PlaybookEntityType {get;set;}
    public String listOrder {get;set;}
    public string playbookIdForInactive{get;set;}
    private Map<string,boolean>playbookActiveMap{get;set;}
    public boolean insfPrivlFalse {get;set;}
    public List<SelectOption> salesProcessList {get; set;}
    
    //3-feb 2017 to show lead processes if user select lead
    public List<SelectOption> leadProcessList {get; set;}
    public String leadBusinessProcessId {get; set;}
    public String oppBusinessProcessId {get; set;}
    
    public PlaybooxBuilderDashboardController(){
        listOrder = 'DESC';
        getPrivilages();
        initializations();
        getProcesses();
        fetchSalesAndLeadProcesses();
        PlaybookEntityTypeList = new List<SelectOption>();
        PlaybookEntityTypeList.add(new SelectOption('Opportunity','Opportunity'));
        PlaybookEntityTypeList.add(new SelectOption('Lead','Lead'));
        // To hide show threshold
        PlaybookEntityType = 'Opportunity';
        
    }
    
    private void getPrivilages(){
      if(UserInfo.getUserId() != null){
        for(user obj : [select id,Pbx_Role__c from user where id = :UserInfo.getUserId()]){
          system.debug('##obj='+obj);
          if(obj.pbx_role__c != null && obj.pbx_role__c == 'Administrator'){
            insfPrivlFalse = true;  
          }
        }
      }
    }
    
    //switch lead process and salesprocess
    // 3-feb-2017
    public void switchBetweenLeadAndSalesProcess(){
        System.debug('##### ' + PlaybookEntityType);
        fetchSalesAndLeadProcesses();
        //salesProcessList.clear();
    }
    private void initializations(){
        processObj = new PbxProcess__c();
        playbookActiveMap = new Map<string,boolean>();
    }
    
    //below method is used to fetch valid sales processes which are currently used in record types only
    private void fetchSalesAndLeadProcesses(){
        salesProcessList = new List<SelectOption>();
        leadProcessList = new List<SelectOption>();
        Set<String> leadOrOppRecordTypeSet = new Set<String>();//used as a collection of all opportunity record types
        Set<String> businessProcessSet = new Set<String>();//used as a collection of all sales process ids because we cannot get sales process name directly
         
        for(RecordTypeInfo info: opportunity.SObjectType.getDescribe().getRecordTypeInfos()) {
            if(info.isAvailable()) {
                leadOrOppRecordTypeSet.add(info.getRecordTypeId());
            }
        }
        
        // now get sales processes if record types are exist for opportunity
        if(leadOrOppRecordTypeSet.size() > 0){
            for(RecordType obj : [SELECT businessProcessid FROM RecordType WHERE id IN: leadOrOppRecordTypeSet]){
                //salesProcessList.add(new SelectOption(obj.businessProcessid,obj.businessProcess.name));  
                businessProcessSet.add(obj.businessProcessid);
            }
            if(businessProcessSet.size() > 0){
                for(BusinessProcess obj : [SELECT name FROM BusinessProcess WHERE id IN: businessProcessSet]){
                    salesProcessList.add(new SelectOption(obj.id,obj.name));  
                }
            }
        }
        leadOrOppRecordTypeSet.clear();
        businessProcessSet.clear();
        
        for(RecordTypeInfo info: Lead.SObjectType.getDescribe().getRecordTypeInfos()) {
            if(info.isAvailable()) {
                leadOrOppRecordTypeSet.add(info.getRecordTypeId());
            }
        }
        
        
        if(leadOrOppRecordTypeSet.size() > 0){
             for(RecordType obj : [SELECT businessProcessid FROM RecordType WHERE id IN: leadOrOppRecordTypeSet]){
                 //salesProcessList.add(new SelectOption(obj.businessProcessid,obj.businessProcess.name));  
                 businessProcessSet.add(obj.businessProcessid);
             }
             if(businessProcessSet.size() > 0){
                 for(BusinessProcess obj : [SELECT name FROM BusinessProcess WHERE id IN: businessProcessSet]){
                     leadProcessList.add(new SelectOption(obj.id,obj.name));  
                 }
             }   
         }
    } 
    
    private void getProcesses(){
        processList = new List<PbxProcess__c>();
        // Added new query with changing order parameter : listOrder
        processList = Database.query('SELECT id,name,Name__c,PlaybookEntityType__c,active__c,description__c,ProgressThreshold__c,Points__c,PublishDate__c FROM PbxProcess__c WHERE ParentPublishProcess__c = NULL and version__c = \'2\' ORDER BY CreatedDate '+String.escapeSingleQuotes(listOrder));
        system.debug('***** SELECT id,name,Name__c,description__c,ProgressThreshold__c,Points__c,PublishDate__c FROM PbxProcess__c WHERE ParentPublishProcess__c = NULL ORDER BY CreatedDate '+listOrder);
        system.debug('*****'+ processList.size());
        if(processList != null && processList.size() > 0){
          for(PbxProcess__c obj : processList){
            playbookActiveMap.put(obj.id,obj.active__c);
          }
          
        }
    }
    
    public void insertProcess(){
        system.debug('##insertProcessIN');
        try{
            if(processObj.name__c != null && processObj.name__c.trim().length() > 0){
                    processObj.PlaybookEntityType__c = PlaybookEntityType;
                    processObj.name = processObj.name__c;
                    processObj.version__c = '2';
                    
                    if(PlaybookEntityType.equalsIgnoreCase('Opportunity'))
                        processObj.BusinessProcessId__c = oppBusinessProcessId;
                    else{
                        processObj.BusinessProcessId__c = leadBusinessProcessId;
                        processObj.ProgressThreshold__c = 0;
                    }
                    insert processObj;
                    getProcesses();
                    initializations();  
                
            }
        }catch(Exception e){
            system.debug('Exception==>'+ e.getMessage());
        }
    }
    //Active / inactive playbook
    public void activeInactivePlaybook(){
      if(playbookIdForInactive != null && playbookIdForInactive.trim().length() >= 15){
        try{
          if(playbookActiveMap.containsKey(playbookIdForInactive)){
            Pbxprocess__c insObj = new Pbxprocess__c();
            insObj.id = playbookIdForInactive;
            insObj.active__c = !playbookActiveMap.get(playbookIdForInactive);
            update insObj;
            initializations();
              getProcesses();
        
          }
        }catch(Exception e){
          system.debug('Exception ==>'+e.getMessage());
        }
      }
    }
    
    // Change order of exist process list based on created date when select exiting process for clone : 3/25/2016
    public void changeProcessListOrder(){       
        system.debug('****** changeProcessListOrder : '+listOrder);
        
        getProcesses();
    }
        
    // Added new function clone exist process : 3/25/2016
    public void cloneExistProcess(){
        system.debug('********* cloneExistProcess');
        
        Savepoint sp = Database.setSavepoint();
        PbxProcess__c newProcess;
        PbxProcess__c process;
        
        system.debug('cloneProcessId : '+cloneProcessId);     
        
        String processId = cloneProcessId;
        
        try{
            //Process & Stage 
            process = [ SELECT Id, Name, Active__c, Description__c, Name__c, PlaybookEntityType__c, Points__c, ProgressThreshold__c, Mapping__c, businessProcessId__c, 
                        //Stage
                        ( SELECT Id, Description__c, Name__c, SortPosition__c, isLibrary__c FROM Stages__r ORDER BY SortPosition__c ASC ) 
                        FROM PbxProcess__c 
                        WHERE id = :processId ];
                        
            newProcess = process.clone(false,true);
            // Add Copy of in name__c before clone information in new record.
            if(String.isNotBlank(newProcess.Name__c)){
                newProcess.Name__c = 'Copy of '+newProcess.Name__c;
            }
            newProcess.version__c = '2';
            insert newProcess;
            
            Map<Id, PbxStage__c> oldStagesIdToCloneMap = new Map<Id, PbxStage__c>();
            for(PbxStage__c st: process.Stages__r)
            {
                PbxStage__c newStage = st.clone(false);
                newStage.Process__c = newProcess.Id;
                oldStagesIdToCloneMap.put(st.Id, newStage);
            }
            insert oldStagesIdToCloneMap.values();
            
            //Play
            List<PbxPlay__c> plays = [  SELECT Id, Description__c, Name__c, SortPosition__c, Stage__c,
                                        //Messages
                                        (SELECT Id, description__c, Link__c, Name__c, SortPosition__c, Tip__c,IncludedInAssessment__c,IncludedInDiscussion__c FROM Messages__r ORDER BY SortPosition__c ASC),
                                        //Tools
                                        (SELECT id, WorkspaceId__c, DocumentId__c, Link__c, Description__c, Name__c, SortPosition__c, Tip__c,IncludedInCompetition__c, IncludedInCallManagementDiscussion__c, IncludedInGeneral__c, IncludedInObjectionHandling__c, IncludedInProduct__c, IncludedInSuccessStories__c FROM Tools__r ORDER BY SortPosition__c ASC)
                                        FROM PbxPlay__c
                                        WHERE Stage__r.Process__r.id= :processId
                                        ORDER BY SortPosition__c ASC ];
                                        
            Map<Id, PbxPlay__c> oldPlaysIdToCloneMap = new Map<Id, PbxPlay__c>();            
            for(PbxPlay__c pl: plays)
            {
                PbxPlay__c newPlay = pl.clone(false);
                newPlay.sortPosition__c = null;
                newPlay.Stage__c = oldStagesIdToCloneMap.get(pl.Stage__c).Id;
                newPlay.Process__c = newProcess.Id;
                oldPlaysIdToCloneMap.put(pl.Id, newPlay);
            }
            insert oldPlaysIdToCloneMap.values();            
            
            //Tool & Message
            //List<PbxTool__c> listTools = new List<PbxTool__c>();
            List<SObject> cloneToolsInsert = new List<SObject>();
            List<SObject> cloneMessagesInsert = new List<SObject>();
            for(PbxPlay__c pl: plays)
            {
                for(PbxTool__c tool: pl.Tools__r)
                {
                    PbxTool__c newTool = tool.clone(false);
                    newTool.sortPosition__c = null;
                    newTool.Play__c = oldPlaysIdToCloneMap.get(pl.Id).Id;
                    cloneToolsInsert.add(newTool);
                }
                
                for(PbxMessage__c msg: pl.Messages__r)
                {
                    PbxMessage__c newMsg = msg.clone(false);
                    newMsg.sortPosition__c = null;
                    newMsg.Play__c = oldPlaysIdToCloneMap.get(pl.Id).Id;
                    cloneMessagesInsert.add(newMsg);
                }
            }
            
           insert cloneToolsInsert;
           insert cloneMessagesInsert;
           
           //Question & Answer & Flags
           List<PbxQuestion__c> questions = [ SELECT Id, Description__c, IncludedInExecSummary__c, IncludedInKeyMilestones__c,IncludedInAssessment__c,IncludedInDealProgress__c,IncludedInDiscussion__c,IncludedInSuccessIndicators__c, Link__c, Name__c, Play__c, Points__c, Process__c, ResponseType__c, SortPosition__c, Tip__c,
                                            //Answer
                                            ( SELECT Id, Answer__c, FlagType__c, Question__c, SortPosition__c, Weight__c FROM Answers__r ORDER BY SortPosition__c ),
                                            //Flags
                                            ( SELECT Id, CompareValue__c, FlagType__c, Operation__c, Question__c FROM ContentFlags__r)
                                            FROM PbxQuestion__c
                                            WHERE Play__r.Stage__r.Process__r.id= :processId
                                            ORDER BY SortPosition__c ASC ];
                                            
            Map<Id, PbxQuestion__c> oldQnsIdToCloneMap = new Map<Id, PbxQuestion__c>();            
            for(PbxQuestion__c qns: questions)
            {
                PbxQuestion__c newQns = qns.clone(false);
                newQns.sortPosition__c = null;
                newQns.Play__c = oldPlaysIdToCloneMap.get(qns.Play__c).Id;
                newQns.Process__c = newProcess.Id;
                oldQnsIdToCloneMap.put(qns.Id, newQns);
            }
            insert oldQnsIdToCloneMap.values();
            
            //Answer & Flags
            List<SObject> cloneAnsInsert = new List<SObject>();
            List<SObject> cloneFlagsInsert = new List<SObject>();
            
            for(PbxQuestion__c qns: questions)
            {
                for( PbxAnswer__c ans: qns.Answers__r )
                {
                    PbxAnswer__c newAns = ans.clone(false);
                    newAns.sortPosition__c = null;
                    newAns.Question__c = oldQnsIdToCloneMap.get(qns.Id).Id;
                    cloneAnsInsert.add(newAns);                
                }
                
                for( PbxContentFlag__c flag: qns.ContentFlags__r )
                {
                    PbxContentFlag__c newFlag = flag.clone(false);
                    newFlag.Question__c = oldQnsIdToCloneMap.get(qns.Id).Id;
                    cloneFlagsInsert.add(newFlag);                
                }
            }                                
           insert cloneAnsInsert;
           insert cloneFlagsInsert;                                       
                                       
           //return newProcess.Id;
           
           // Get new updated process after clone from existing.
           getProcesses();
        }catch(Exception e)
        {
            Database.rollback(sp);
            //List<String> errors = new List<String>();
            /*String errors = e.getMessage() + ' line#:' + e.getLineNumber();
            //errors.add();
            return errors;*/
            system.debug('cloneExistProcess Exception==>'+ e.getMessage());
        }
        
   
    }   
