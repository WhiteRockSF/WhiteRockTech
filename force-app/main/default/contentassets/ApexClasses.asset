    public class CallManagementDiscussionModal{
        public string playName{get;set;}
        public Decimal playSortOrder {get; set;}
        public List<DealProgressModal>qList{get;set;}
        public List<PbxMessageInstance__c>msgList{get;set;}
        public List<PbxToolInstance__c>toolList{get;set;}
        public List<PbxTrainingInstance__c>trainingList{get;set;}
        public CallManagementDiscussionModal(){
            playSortOrder = 0;
            qList = new List<DealProgressModal>();
            msgList = new List<PbxMessageInstance__c>();
            toolList = new List<PbxToolInstance__c>();
            trainingList = new List<PbxTrainingInstance__c>();
        }
    }
    
    
    
    public class CallManagementAssessmentModal{
        public string playName{get;set;}
        public Decimal playSortOrder {get; set;}
