"01p15000006z3xmAAA","","OpportunityDashboardControllerclone","36.0","Active","false","3.820397839E9","public class OpportunityDashboardControllerclone{
    public List<string> oppStagesList {get;set;}
    public Map<string,Integer> oppStageMap {get;set;}
    public List<ScoreboardModal> mdlList {get;set;}
    public string ChkMapKey{get;set;}
    public string currencySymbol{get;set;}
    
    public List<String> selectedStagesFilter  {get;set;}
    public List<SelectOption> stagesFilter {get;set;}
    
    public List<SelectOption> amountFilter {get;set;}
    public String amountSelectedFilter {get;set;}
    
    public List<SelectOption> followUpFilter {get;set;}
    public String followUpSelectedFilter {get;set;}
    
    public List<SelectOption> closeDateFilter {get;set;}
    public String closeDateSelectedFilter {get;set;}
    
    public List<SelectOption> forecastFilter {get;set;}
    public List<String> forecastSelectedFilter {get;set;}
    
    public List<SelectOption> dealConfidenceFilter {get;set;}
    public List<String> dealConfidenceSelectedFilter {get;set;}
    
    public List<SelectOption> ownerFilter {get;set;}
    public String ownerSelectedFilter {get;set;}
    
    public List<SelectOption> playbookFilter {get;set;}
    public String playbookSelectedFilter {get;set;}
    
    public List<SelectOption> accountFilter {get;set;}
    public String accountSelectedFilter {get;set;}
    
    // Inputs for filter
    public String followUpFrom {get;set;}
    public String followUpTo {get;set;}    
    public String closeDateFrom {get;set;}
    public String closeDateTo {get;set;}    
    public String amountMin {get;set;}    
    public String amountMax {get;set;}
    
    public boolean clearFilter {get;set;}
    public String newOption {get;set;}
        
    // Constructor
    public OpportunityDashboardControllerclone(){        
        loadScoreboardFilter(); 
    }
    
    public static String getCurrencySymbolFromIso(String Iso){
         String currencySymbol = ('USD' == Iso ? '$' : ('CAD' == Iso ? '$' : ('EUR' == Iso ? '€' : ('GBP' == Iso ? '£' : ('JPY' == Iso ? '¥' : ('KRW' == Iso ? '?' : ('CNY' == Iso ? '?' : Iso)))))));
         return currencySymbol; 
    }
    
    public void fillScoreboardModal(){
        mdlList = new List<ScoreboardModal>();
        List<PbxProcessInstance__c> PIList = [SELECT opportunity__c,opportunity__r.Name,opportunity__r.nextstep, opportunity__r.Account.Name, opportunity__r.CloseDate, opportunity__r.RedFlagCount__c,opportunity__r.owner.name, opportunity__r.Amount ,opportunity__r.leadsource, opportunity__r.StageName, name__c,(select name__c from StageInstances__r order by sortposition__c LIMIT 1000 ) FROM pbxProcessInstance__c where opportunity__c <> null order by createdDate desc LIMIT 10000];
        if(PIList != null && PIList.size() > 0){
            for(PbxProcessInstance__c obj : PIList){
                ScoreboardModal mdlObj = new ScoreboardModal();
                mdlObj.pIObj = obj;
                
                for(PbxStageInstance__c obj2 : obj.stageInstances__r){
                    if(obj2.name__c != null)
                        mdlObj.stageList.add(obj2.name__c);
                }
                mdlList.add(mdlObj);
            }
        }
    }
    
    public void addNewOption(){
        system.debug('### addNewOption ');
        if(newOption.split('&&').size() ==3){
            //recordName+'||'+recordId+'||'+pickListClass
            if(newOption.split('&&')[2] == 'playbookFilter'){
                playbookFilter = new List<SelectOption>();
                playbookFilter.add(new SelectOption('All', 'All'));  
                playbookFilter.add(new SelectOption(newOption.split('&&')[1], newOption.split('&&')[0]));
                playbookSelectedFilter = newOption.split('&&')[1];  
            }else if(newOption.split('&&')[2] == 'accountFilter'){
                accountFilter = new List<SelectOption>();
                accountFilter.add(new SelectOption('All', 'All')); 
                accountFilter.add(new SelectOption(newOption.split('&&')[1], newOption.split('&&')[0])); 
                accountSelectedFilter = newOption.split('&&')[1];  
            }else if(newOption.split('&&')[2] == 'ownerFilter'){
                ownerFilter = new List<SelectOption>();
                ownerFilter.add(new SelectOption('All', 'All'));  
                ownerFilter.add(new SelectOption(newOption.split('&&')[1], newOption.split('&&')[0]));
                ownerSelectedFilter = newOption.split('&&')[1];  
            }
        }
    }
    
    // Submit new criteria Or cleared criteria 
    public void submitScoreboardFilter(){
        
        system.debug('### call submitScoreboardFilter');
        
        mdlList = new List<ScoreboardModal>();
        String processInstanceQuery = '';
        String amountOrder = '';
        Set<String> opportunityIds = new Set<String>();
        
        Decimal amtMinValue;
        Decimal amtMaxValue; 
        
        Date closeRangeFrom;
        Date closeRangeTo;
        
        Date followRangeFrom;
        Date followRangeTo;        
       
        String accountValue;
        String playbookValue;
        String ownerValue;        
         
        if(!clearFilter){ 
            // Amount
            if(String.isNotBlank(amountSelectedFilter)){
                if(amountSelectedFilter != 'All'){   
                    if(amountSelectedFilter == 'Top'){    
                        amountOrder = ' ORDER BY Opportunity__r.Amount DESC NULLS LAST ';                    
                    }
                    if(amountSelectedFilter == 'Bottom'){
                        amountOrder = ' ORDER BY Opportunity__r.Amount ASC NULLS FIRST '; 
                    }
                    if(amountSelectedFilter == 'Range'){
                        if(String.isNotBlank(amountMin) && String.isNotBlank(amountMax)){
                            amtMinValue = Decimal.valueOf(amountMin);
                            amtMaxValue = Decimal.valueOf(amountMax);
                            processInstanceQuery += ' AND Opportunity__r.Amount >= :amtMinValue AND Opportunity__r.Amount <= :amtMaxValue ';
                        }
                    }                            
                }
                system.debug('$$$$ amountOrder  == >'+amountOrder );
            }
            system.debug(' @@@ Amount :'+processInstanceQuery);
            
            // Closedate
            if(String.isNotBlank(closeDateSelectedFilter)){
                if(!closeDateSelectedFilter.equalsIgnoreCase('All')){                 
                    if(closeDateSelectedFilter == 'Range'){                          
                        try{ 
                            closeRangeFrom = Date.parse(closeDateFrom);
                            closeRangeTo = Date.parse(closeDateTo);
                            processInstanceQuery += ' AND Opportunity__r.CloseDate >= :closeRangeFrom AND Opportunity__r.CloseDate <= :closeRangeTo ';
                        } catch(Exception e){
                            System.debug('invalid Date range in Close date');
                        }                        
                    }
                    if(closeDateSelectedFilter.equalsIgnoreCase('This Month')){
                        processInstanceQuery += ' AND Opportunity__r.CloseDate = THIS_MONTH ';
                    }
                    if(closeDateSelectedFilter.equalsIgnoreCase('Next Month')){
                        processInstanceQuery += ' AND Opportunity__r.CloseDate = NEXT_MONTH ';
                    }
                    if(closeDateSelectedFilter.equalsIgnoreCase('This Quater')){
                        processInstanceQuery += ' AND Opportunity__r.CloseDate = THIS_QUARTER ';
                    }
                    if(closeDateSelectedFilter.equalsIgnoreCase('Next Quater')){
                        processInstanceQuery += ' AND Opportunity__r.CloseDate = NEXT_QUARTER';
                    }
                }
            }   
            system.debug(' @@@ Closedate :'+processInstanceQuery); 
            
            // Follow up date    
            if(String.isNotBlank(followUpSelectedFilter)){    
                if(!followUpSelectedFilter.equalsIgnoreCase('All')){
                    if(followUpSelectedFilter == 'Range'){                     
                        try{ 
                            followRangeFrom = Date.parse(followUpFrom);
                            followRangeTo = Date.parse(followUpTo);
                            processInstanceQuery += ' AND FollowUp__c >= :followRangeFrom AND FollowUp__c <= :followRangeTo ';     
                        } catch(Exception e){
                            System.debug('Invalid date range in following up date');
                        }                        
                    }
                    if(followUpSelectedFilter.equalsIgnoreCase('Today')){
                        processInstanceQuery += ' AND FollowUp__c = TODAY ';
                    }
                    if(followUpSelectedFilter.equalsIgnoreCase('This Week')){
                        processInstanceQuery += ' AND FollowUp__c = THIS_WEEK ';
                    }
                    if(followUpSelectedFilter.equalsIgnoreCase('Next Week')){
                        processInstanceQuery += ' AND FollowUp__c = NEXT_WEEK ';
                    }
                    if(followUpSelectedFilter.equalsIgnoreCase('This Month')){
                        processInstanceQuery += ' AND FollowUp__c = THIS_MONTH ';
                    }
                } 
            }  
            system.debug(' @@@ Follow up date :'+processInstanceQuery);  
                  
            // Account
            if(String.isNotBlank(accountSelectedFilter)){
                if(!accountSelectedFilter.equalsIgnoreCase('All')){
                    accountValue = accountSelectedFilter;
                    processInstanceQuery += ' AND Opportunity__r.AccountId = :accountValue ';
                    system.debug(' @@@ account id value  :'+accountValue);
                }  
            }
            system.debug(' @@@ Account :'+processInstanceQuery);  
            system.debug('@@@@@@@ ===> accountSelectedFilter '+accountSelectedFilter);
                  
            // Playbook
            if(String.isNotBlank(playbookSelectedFilter)){
                if(!playbookSelectedFilter.equalsIgnoreCase('All')){
                    playbookValue = playbookSelectedFilter;
                    processInstanceQuery += ' AND Process__c = :playbookValue ';
                    system.debug(' @@@ Playbook id value  :'+playbookValue);
                }
            }
            system.debug(' @@@ Playbook :'+processInstanceQuery);  
            system.debug('@@@@@@@ ===> playbookSelectedFilter '+playbookSelectedFilter);
            
            // Owner
            if(String.isNotBlank(ownerSelectedFilter)){         
                if(!ownerSelectedFilter.equalsIgnoreCase('All')){                
                    ownerValue = ownerSelectedFilter;
                    processInstanceQuery += ' AND Opportunity__r.OwnerId = :ownerValue ';
                    system.debug(' @@@ owner id value  :'+ownerValue);
                }
            }
            system.debug(' @@@ Owner:'+processInstanceQuery);  
            system.debug('@@@@@@@ ===> ownerSelectedFilter '+ownerSelectedFilter);
            
            // Forecast    
            if(forecastSelectedFilter != null && forecastSelectedFilter.size()>0){
                if(!new Set<String>(forecastSelectedFilter).contains('All')){
                    system.debug(' $$ ===> '+forecastSelectedFilter);
                    processInstanceQuery += ' AND Opportunity__r.ForecastCategoryName IN : forecastSelectedFilter ';
                }   
            }
            system.debug(' @@@ Forecast :'+processInstanceQuery);  
            
            // Deal Confidence
            if(dealConfidenceSelectedFilter != null && dealConfidenceSelectedFilter.size()>0){
                if(!new Set<String>(dealConfidenceSelectedFilter).contains('All')){
                    system.debug(' $$ ===> '+dealConfidenceSelectedFilter);
                    processInstanceQuery += ' AND ConfidenceIndicator__c IN : dealConfidenceSelectedFilter ';
                }
            }
            system.debug(' @@@ Deal Confidence :'+processInstanceQuery);  
            
            // Stage
            if(selectedStagesFilter != null && selectedStagesFilter.size()>0){
                if(!new Set<String>(selectedStagesFilter).contains('All')){
                    system.debug(' $$ ===> '+selectedStagesFilter);
                    processInstanceQuery += ' AND Opportunity__r.StageName IN : selectedStagesFilter ';
                }          
            }        
            system.debug(' @@@ Stage :'+processInstanceQuery);  
            
        }else{
            initAllFilters();
        }
        
        system.debug(' $$ processInstanceQuery :'+processInstanceQuery);
        try{ 
            system.debug('### Try '+clearFilter);
            List<PbxProcessInstance__c> PIList = Database.Query(' SELECT Id, Opportunity__c,opportunity__r.Name,opportunity__r.nextstep, opportunity__r.Account.Name, opportunity__r.CloseDate, opportunity__r.RedFlagCount__c,opportunity__r.owner.name, opportunity__r.Amount ,opportunity__r.leadsource, opportunity__r.StageName, name__c,(select name__c from StageInstances__r order by sortposition__c LIMIT 1000 ) FROM pbxProcessInstance__c where opportunity__c != null '+processInstanceQuery+' '+amountOrder );
            
            if(PIList != null && PIList.size() > 0){
                for(PbxProcessInstance__c obj : PIList){
                    ScoreboardModal mdlObj = new ScoreboardModal();
                    mdlObj.pIObj = obj;
                    
                    for(PbxStageInstance__c obj2 : obj.stageInstances__r){
                        if(obj2.name__c != null)
                            mdlObj.stageList.add(obj2.name__c);
                    }
                    mdlList.add(mdlObj);
                }
            }
            
        }catch(Exception e){
             mdlList = new List<ScoreboardModal>();
        }
    }
    
    private void initAllFilters(){
        system.debug('### init all filter');
        selectedStagesFilter  = new List<String>();        
        stagesFilter = new List<SelectOption>();
        // Set Default 'all' option in stage filter
        stagesFilter.add(new SelectOption('All', 'All'));
        selectedStagesFilter.add('All');        
        
        // Amount
        amountFilter = new List<SelectOption>();
        amountFilter.add(new SelectOption('All', 'All'));
        amountFilter.add(new SelectOption('Top', 'Top'));
        amountFilter.add(new SelectOption('Bottom', 'Bottom'));
        amountFilter.add(new SelectOption('Range', 'Range'));        
        amountSelectedFilter = 'All';
        
        // Follow up
        followUpFilter = new List<SelectOption>();
        followUpFilter.add(new SelectOption('All', 'All'));
        followUpFilter.add(new SelectOption('Today', 'Today'));
        followUpFilter.add(new SelectOption('This Week', 'This Week'));
        followUpFilter.add(new SelectOption('Next Week', 'Next Week'));
        followUpFilter.add(new SelectOption('This Month', 'This Month'));        
        followUpFilter.add(new SelectOption('Range', 'Range'));
        followUpSelectedFilter = 'All';
        
        // Close date
        closeDateFilter = new List<SelectOption>();
        closeDateFilter.add(new SelectOption('All', 'All'));
        closeDateFilter.add(new SelectOption('This Month', 'This Month'));
        closeDateFilter.add(new SelectOption('Next Month', 'Next Month'));
        closeDateFilter.add(new SelectOption('This Quater', 'This Quater'));        
        closeDateFilter.add(new SelectOption('Next Quater', 'Next Quater'));
        closeDateFilter.add(new SelectOption('Range', 'Range'));
        closeDateSelectedFilter = 'All';
        
        // Forecast   
        forecastSelectedFilter = new List<String>();         
        forecastFilter = new List<SelectOption>();     
        forecastFilter.add(new SelectOption('All', 'All'));
        Schema.DescribeFieldResult fieldResult = Opportunity.forecastcategoryname.getDescribe();
        List<Schema.PicklistEntry> ple = fieldResult.getPicklistValues();            
        for( Schema.PicklistEntry f : ple){
          forecastFilter.add(new SelectOption(f.getLabel(), f.getValue()));
        }
        forecastSelectedFilter.add('All');  
        
        // Deal confidence
        dealConfidenceSelectedFilter = new List<String>();        
        dealConfidenceFilter = new List<SelectOption>();
        dealConfidenceFilter.add(new SelectOption('All', 'All'));
        dealConfidenceFilter.add(new SelectOption('High', 'High'));
        dealConfidenceFilter.add(new SelectOption('Medium', 'Medium'));
        dealConfidenceFilter.add(new SelectOption('Low', 'Low'));
        dealConfidenceSelectedFilter.add('All'); 
        
        // Owner
        ownerFilter = new List<SelectOption>();
        ownerFilter.add(new SelectOption('All', 'All'));  
        ownerSelectedFilter = 'All';      
        
        // Playbook
        playbookFilter = new List<SelectOption>();
        playbookFilter.add(new SelectOption('All', 'All'));
        playbookSelectedFilter = 'All';        
        
        // Account
        accountFilter = new List<SelectOption>();
        accountFilter.add(new SelectOption('All', 'All'));
        accountSelectedFilter = 'All';
    }
    
    // Load filter criteria from last saved settings  
    // Set Filters defalut selected value on load page or load filter from last saved.
    public void loadScoreboardFilter(){
    
        // Start init         
        mdlList = new List<ScoreboardModal>();
        
        initAllFilters();
        
        oppStagesList = new List<string>();
        oppStageMap = new Map<string,Integer>();
        for(opportunityStage obj : [select masterLabel,sortOrder,apiName from opportunityStage where isActive = true order by sortOrder]){
            oppStagesList.add(obj.masterLabel);
            oppStageMap.put(obj.masterLabel,obj.sortOrder);      
            stagesFilter.add(new SelectOption(obj.apiName, obj.apiName));      
        }
        if(oppStageMap.size() > 0){
            ChkMapKey = string.valueof(oppStageMap.keyset()).replace('{', '').replace('{', '');
        }
        //fillScoreboardModal();
        string currencyName = UserInfo.getDefaultCurrency();
        if(currencyName != null){
            currencySymbol = getCurrencySymbolFromIso(currencyName);
        }        
    
        //ApexPages.currentPage().setCookies(new Cookie[]{new Cookie('PB_OppFilterConfidenceIndicator', null,null,0,false)});        
        //Cookie cook = new Cookie('counter','My ggg value',null,315569260,false);                 
        //ApexPages.currentPage().setCookies(new Cookie[]{cook});
            
        Map<String,Cookie> allCookies = ApexPages.currentPage().getCookies(); 
        String OppFilterPlaybookStage = allCookies.get('PB_OppFilterPlaybookStage') != null ? allCookies.get('PB_OppFilterPlaybookStage').getValue() : '';
        String OppFilterDealSize = allCookies.get('PB_OppFilterDealSize') != null ? allCookies.get('PB_OppFilterDealSize').getValue() : '';
        String OppFilterCloseDate = allCookies.get('PB_OppFilterCloseDate') != null ? allCookies.get('PB_OppFilterCloseDate').getValue() : '';
        String OppFilterForcast = allCookies.get('PB_OppFilterForcast') != null ? allCookies.get('PB_OppFilterForcast').getValue() : '';
        String OppFilterConfidenceIndicator = allCookies.get('PB_OppFilterConfidenceIndicator') != null ? allCookies.get('PB_OppFilterConfidenceIndicator').getValue() : '';
        String OppFilterAccount = allCookies.get('PB_OppFilterAccount') != null ? allCookies.get('PB_OppFilterAccount').getValue() : '';
        String OppFilterFollowUpDate = allCookies.get('PB_OppFilterFollowUpDate') != null ? allCookies.get('PB_OppFilterFollowUpDate').getValue() : '';
        String OppFilterPlaybook = allCookies.get('PB_OppFilterPlaybook') != null ? allCookies.get('PB_OppFilterPlaybook').getValue() : '';
        String OppFilterOwner = allCookies.get('PB_OppFilterOwner') != null ? allCookies.get('PB_OppFilterOwner').getValue() : '';
        
        //system.debug('#### PB_OppFilterPlaybookStage  '+OppFilterPlaybookStage );
        //system.debug('#### PB_OppFilterDealSize  '+OppFilterDealSize );
        //system.debug('#### PB_OppFilterCloseDate  '+OppFilterCloseDate );
        //system.debug('#### PB_OppFilterForcast  '+OppFilterForcast );
        //system.debug('#### PB_OppFilterConfidenceIndicator  '+OppFilterConfidenceIndicator );
        //system.debug('#### PB_OppFilterAccount  '+OppFilterAccount );
        //system.debug('#### PB_OppFilterFollowUpDate  '+OppFilterFollowUpDate );
        //system.debug('#### PB_OppFilterPlaybook  '+OppFilterPlaybook );
        //system.debug('#### PB_OppFilterOwner  '+OppFilterOwner );
        
        String processInstanceQuery = '';
        String amountOrder = '';
        Set<String> opportunityIds = new Set<String>();
        
        Decimal amtMin;
        Decimal amtMax;
        // Amount
        if(String.isNotBlank(OppFilterDealSize) && OppFilterDealSize != 'null'){
            if(OppFilterDealSize != 'All'){    
                if(OppFilterDealSize == 'Top'){
                    amountOrder = ' ORDER BY Opportunity__r.Amount DESC NULLS LAST ';                    
                }else if(OppFilterDealSize == 'Bottom'){
                    amountOrder = ' ORDER BY Opportunity__r.Amount ASC NULLS FIRST '; 
                }else if(OppFilterDealSize.indexOf('Range') != -1 && OppFilterDealSize.split('&').size()==3 && OppFilterDealSize.indexOf('&') != -1){
                    if(String.isNotBlank(OppFilterDealSize.split('&')[1]) && String.isNotBlank(OppFilterDealSize.split('&')[2])){
                        amtMin = Decimal.ValueOf(OppFilterDealSize.split('&')[1]);
                        amtMax = Decimal.valueOf(OppFilterDealSize.split('&')[2]);
                        processInstanceQuery += ' AND Opportunity__r.Amount >= :amtMin AND Opportunity__r.Amount <= :amtMax ';
                        // Set selected on load
                        amountMin = OppFilterDealSize.split('&')[1];
                        amountMax = OppFilterDealSize.split('&')[2];   
                    }
                }                            
            }
            system.debug('$$$$ amountOrder  == >'+amountOrder );
            amountSelectedFilter = OppFilterDealSize.indexOf('Range') != -1 ? 'Range' : OppFilterDealSize;
        }
        system.debug(' @@@ Amount :'+processInstanceQuery);
        
        Date closeRangeFrom;
        Date closeRangeTo;
        // Closedate
        if(String.isNotBlank(OppFilterCloseDate) && OppFilterCloseDate != 'null'){
            if(!OppFilterCloseDate.equalsIgnoreCase('All')){                 
                if(OppFilterCloseDate.indexOf('Range') != -1){                      
                    try{ 
                        closeRangeFrom = Date.parse(OppFilterCloseDate.split('&')[1]);
                        closeRangeTo = Date.parse(OppFilterCloseDate.split('&')[2]);
                        processInstanceQuery += ' AND Opportunity__r.CloseDate >= :closeRangeFrom AND Opportunity__r.CloseDate <= :closeRangeTo ';
                        // Set selected on load
                        closeDateFrom = (closeRangeFrom.Month()<10 ? '0'+closeRangeFrom.Month() : ''+closeRangeFrom.Month())+'/'+(closeRangeFrom.Day()<10 ? '0'+closeRangeFrom.Day() : ''+closeRangeFrom.Day())+'/'+closeRangeFrom.Year();
                        closeDateTo = (closeRangeTo.Month() < 10 ? '0'+closeRangeTo.Month() : ''+closeRangeTo.Month())+'/'+(closeRangeTo.Day()<10 ? '0'+closeRangeTo.Day() : ''+closeRangeTo.Day())+'/'+closeRangeTo.Year();
                    } catch(Exception e){
                        system.debug('Invalid date in close date range ');  
                    }
                }
               
                if(OppFilterCloseDate.equalsIgnoreCase('This Month')){
                    processInstanceQuery += ' AND Opportunity__r.CloseDate = THIS_MONTH ';
                }
                if(OppFilterCloseDate.equalsIgnoreCase('Next Month')){
                    processInstanceQuery += ' AND Opportunity__r.CloseDate = NEXT_MONTH ';
                }
                if(OppFilterCloseDate.equalsIgnoreCase('This Quater')){
                    processInstanceQuery += ' AND Opportunity__r.CloseDate = THIS_QUARTER ';
                }
                if(OppFilterCloseDate.equalsIgnoreCase('Next Quater')){
                    processInstanceQuery += ' AND Opportunity__r.CloseDate = NEXT_QUARTER';
                }
            }         
            closeDateSelectedFilter = OppFilterCloseDate.indexOf('Range') != -1 ? 'Range' : OppFilterCloseDate;
        }   
        system.debug(' @@@ Closedate :'+processInstanceQuery); 
        
        Date followRangeFrom;
        Date followRangeTo;
        // Follow up date    
        if(String.isNotBlank(OppFilterFollowUpDate) && OppFilterFollowUpDate != 'null'){    
            if(!OppFilterFollowUpDate.equalsIgnoreCase('All')){     
                if(OppFilterFollowUpDate.indexOf('Range') != -1){                    
                    try{
                        followRangeFrom = Date.parse(OppFilterFollowUpDate.split('&')[1]);
                        followRangeTo = Date.parse(OppFilterFollowUpDate.split('&')[2]);     
                        processInstanceQuery += ' AND FollowUp__c >= :followRangeFrom AND FollowUp__c <= :followRangeTo ';                                       
                        // Set selected on load
                        followUpFrom = (followRangeFrom.Month()<10 ? '0'+followRangeFrom.Month() : ''+followRangeFrom.Month() )+'/'+(followRangeFrom.Day()<10 ? '0'+followRangeFrom.Day() : ''+followRangeFrom.Day())+'/'+followRangeFrom.Year();
                        followUpTo = (followRangeTo.Month()<10 ? '0'+followRangeTo.Month() : ''+followRangeTo.Month())+'/'+(followRangeTo.Day() < 10 ? '0'+followRangeTo.Day() : ''+followRangeTo.Day())+'/'+followRangeTo.Year();                                     
                    }catch(Exception e){
                        system.debug('Invalid date in follow up date range ');                          
                    }                     
                }           
                if(OppFilterFollowUpDate.equalsIgnoreCase('Today')){
                    processInstanceQuery += ' AND FollowUp__c = TODAY ';
                }
                if(OppFilterFollowUpDate.equalsIgnoreCase('This Week')){
                    processInstanceQuery += ' AND FollowUp__c = THIS_WEEK ';
                }
                if(OppFilterFollowUpDate.equalsIgnoreCase('Next Week')){
                    processInstanceQuery += ' AND FollowUp__c = NEXT_WEEK ';
                }
                if(OppFilterFollowUpDate.equalsIgnoreCase('This Month')){
                    processInstanceQuery += ' AND FollowUp__c = THIS_MONTH ';
                }
            }     
            followUpSelectedFilter = OppFilterFollowUpDate.indexOf('Range') != -1 ? 'Range' : OppFilterFollowUpDate;
        }  
        system.debug(' @@@ Follow up date :'+processInstanceQuery);  
        
        String accountValue;      
        // Account
        if(String.isNotBlank(OppFilterAccount) && OppFilterAccount != 'null'){
            if(!OppFilterAccount.equalsIgnoreCase('All')){
                accountValue = OppFilterAccount.split('&&')[1];
                processInstanceQuery += ' AND Opportunity__r.AccountId = :accountValue ';
                accountFilter.add(new SelectOption(OppFilterAccount.split('&&')[1], OppFilterAccount.split('&&')[0])); 
                accountSelectedFilter = OppFilterAccount.split('&&')[1];
            }  
        }
        system.debug('@@@@@@@ ===> accountSelectedFilter  '+accountSelectedFilter );
        system.debug(' @@@ Account :'+processInstanceQuery);  
             
        String playbookValue;      
        // Playbook
        if(String.isNotBlank(OppFilterPlaybook) && OppFilterPlaybook != 'null'){
            if(!OppFilterPlaybook.equalsIgnoreCase('All')){
                playbookValue = OppFilterPlaybook.split('&&')[1];
                processInstanceQuery += ' AND Process__c = :playbookValue ';
                playbookFilter.add(new SelectOption(OppFilterPlaybook.split('&&')[1], OppFilterPlaybook.split('&&')[0])); 
                playbookSelectedFilter = OppFilterPlaybook.split('&&')[1];
            }
        }
        system.debug(' @@@ Playbook :'+processInstanceQuery);  
        system.debug('@@@@@@@ ===> playbookSelectedFilter '+playbookSelectedFilter );
        
        String ownerValue;
        // Owner
        if(String.isNotBlank(OppFilterOwner) && OppFilterOwner != 'null'){         
            if(!OppFilterOwner.equalsIgnoreCase('All')){                
                ownerValue = OppFilterOwner.split('&&')[1];
                processInstanceQuery += ' AND Opportunity__r.OwnerId = :ownerValue ';
                ownerFilter.add(new SelectOption(OppFilterOwner.split('&&')[1], OppFilterOwner.split('&&')[0])); 
                ownerSelectedFilter = OppFilterOwner.split('&&')[1]; 
            }
        }
        system.debug(' @@@ Owner:'+processInstanceQuery);  
        system.debug('@@@@@@@ ===> ownerSelectedFilter '+ownerSelectedFilter );
        
        List<String> forecastValues = new list<String>();
        // Forecast    
        if(String.isNotBlank(OppFilterForcast) && OppFilterForcast != 'null'){
            if(!new Set<String>(OppFilterForcast.split('&&')).contains('All')){
                forecastValues = OppFilterForcast.split('&&');
                system.debug(' $$ ===> '+OppFilterForcast.split('&&'));
                processInstanceQuery += ' AND Opportunity__r.ForecastCategoryName IN : forecastValues ';
            }
            forecastSelectedFilter = OppFilterForcast.split('&&');         
        }
        system.debug(' @@@ Forecast :'+processInstanceQuery);  
        
        List<String> dcValues = new List<String>();
        // Deal Confidence
        if(String.isNotBlank(OppFilterConfidenceIndicator) && OppFilterConfidenceIndicator != 'null'){
            if(!new Set<String>(OppFilterConfidenceIndicator.split('&&')).contains('All')){
                dcValues = OppFilterConfidenceIndicator.split('&&');
                system.debug(' $$ ===> '+OppFilterConfidenceIndicator.split('&&'));
                processInstanceQuery += ' AND ConfidenceIndicator__c IN : dcValues ';
            }
            dealConfidenceSelectedFilter = OppFilterConfidenceIndicator.split('&&');         
        }
        system.debug(' @@@ Deal Confidence :'+processInstanceQuery);  
        
        List<String> stageValues = new List<String>();
        // Stage
        if(String.isNotBlank(OppFilterPlaybookStage) && OppFilterPlaybookStage != 'null'){
            if(!new Set<String>(OppFilterPlaybookStage.split('&&')).contains('All')){
                stageValues = OppFilterPlaybookStage.split('&&');
                system.debug(' $$ ===> '+OppFilterPlaybookStage.split('&&'));
                processInstanceQuery += ' AND Opportunity__r.StageName IN : stageValues ';
            }
            selectedStagesFilter = OppFilterPlaybookStage.split('&&');            
        }        
        system.debug(' @@@ Stage :'+processInstanceQuery);  
        
        system.debug(' $$ processInstanceQuery :'+processInstanceQuery);
        
        try{ 
          
            List<PbxProcessInstance__c> PIList = Database.Query(' SELECT Id, Opportunity__c,opportunity__r.Name,opportunity__r.nextstep, opportunity__r.Account.Name, opportunity__r.CloseDate, opportunity__r.RedFlagCount__c,opportunity__r.owner.name, opportunity__r.Amount ,opportunity__r.leadsource, opportunity__r.StageName, name__c,(select name__c from StageInstances__r order by sortposition__c LIMIT 1000 ) FROM pbxProcessInstance__c where opportunity__c != null '+processInstanceQuery+' '+amountOrder );
            
            if(PIList != null && PIList.size() > 0){
                for(PbxProcessInstance__c obj : PIList){
                    system.debug(' ## obj.opportunity__r.amount : '+ obj.opportunity__r.amount);
                    ScoreboardModal mdlObj = new ScoreboardModal();
                    mdlObj.pIObj = obj;
                    
                    for(PbxStageInstance__c obj2 : obj.stageInstances__r){
                        if(obj2.name__c != null)
                            mdlObj.stageList.add(obj2.name__c);
                    }
                    mdlList.add(mdlObj);
                }
            }       
        }catch(Exception e){
            mdlList = new List<ScoreboardModal>();
        }
    }
    
    public class ScoreboardModal{
        public pbxProcessInstance__c pIObj{get;set;}
        public List<string>stageList{get;set;}
        public ScoreboardModal(){
            pIObj = new pbxProcessInstance__c();
            stageList = new List<string>();
        }
    }
    
