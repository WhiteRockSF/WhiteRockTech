        }   
    }
    
    public pagereference insertQuestion(){
        system.debug('##insertQuestionIN='+quesObj.name__c);
        try{
            if(processObj != null && ((string)processObj.Id).trim().length() > 0 && playObjIdForUpdate != null && playObjIdForUpdate.trim().length() > 0){
                quesObj.play__c = playObjIdForUpdate;
                quesObj.process__c  = processObj.Id;
                if(quesObj.responseType__c == 'DataMap'){
                  quesObj.name = quesObj.name__c;
                  //added fields name in case of data map question to get fields in Playmaker PDF
                  if(processObj.mapping__c == NULL || !processObj.mapping__c.contains(quesObj.name__c)){ 
                      if(processObj.mapping__c == NULL || String.isBlank(processObj.mapping__c))
                        processObj.mapping__c = quesObj.name__c;
                      else
                        processObj.mapping__c += ', ' + quesObj.name__c;
                  }
                  update processObj;  
                }
                insert quesObj;
                
                List<PbxAnswer__c>ansUpdateList = new List<PbxAnswer__c>();
                if((quesObj.responseType__c == 'SingleChoice' || quesObj.responseType__c == 'MultiChoice' ) && quesObj.id != null && ((string)quesObj.id).trim().length() > 0 ){
                    for(AnswerModal obj : ansModalList){
                        if(obj.answer != null && obj.answer.trim().length() > 0){
                            PbxAnswer__c ansObj = new PbxAnswer__c();
                            ansObj.name = obj.answer;
                            ansObj.answer__c = obj.answer;
                            ansObj.weight__c = integer.valueOf(obj.weight);
                            if(obj.flagtype){
                                ansObj.flagtype__c= 'Red';
                            }else{
                              ansObj.flagtype__c= 'Green';
                            }
                            ansObj.question__c = quesObj.id;
                            ansUpdateList.add(ansObj);
                        }   
                    }
                }else if(quesObj.responseType__c == 'DataMap'  && dataMMap.size() > 0 && quesObj.id != null && ((string)quesObj.id).trim().length() > 0){
                  if(dataMMap.containsKey(quesObj.name__c)){
                    for(string obj : dataMMap.get(quesObj.name__c)){
                      PbxAnswer__c ansObj = new PbxAnswer__c();
                        ansObj.name = obj;
                        ansObj.answer__c = obj;
                        ansObj.question__c = quesObj.id;
                        ansUpdateList.add(ansObj);
                    }
                  }
                    
                }else if(quesObj.responseType__c == 'Checkbox' && quesObj.id != null && ((string)quesObj.id).trim().length() > 0){
                    PbxAnswer__c ansObj = new PbxAnswer__c();
                    ansObj.name = 'true';
                    ansObj.answer__c = 'true';
                    ansObj.question__c = quesObj.id;
                    ansObj.weight__c = 3;
                    ansUpdateList.add(ansObj);
                    
                    ansObj = new PbxAnswer__c();
                    ansObj.name = 'false';
                    ansObj.answer__c = 'false';
                    ansObj.question__c = quesObj.id;
                    //change request to change unchecked answer's weight from 0 to -1
                    //ansObj.weight__c = 0;
                    ansObj.weight__c = -1;
                    ansUpdateList.add(ansObj);
                }else if(quesObj.responseType__c == 'Rating' && quesObj.id != null && ((string)quesObj.id).trim().length() > 0){
                    PbxAnswer__c ansObj = new PbxAnswer__c();
                    ansObj.name = 'Positive';
                    ansObj.answer__c = 'Positive';
                    ansObj.question__c = quesObj.id;
                    ansUpdateList.add(ansObj);
                    
                    ansObj = new PbxAnswer__c();
                    ansObj.name = 'Neutral';
                    ansObj.answer__c = 'Neutral';
                    ansObj.question__c = quesObj.id;
                    ansUpdateList.add(ansObj);
                    
                    ansObj = new PbxAnswer__c();
                    ansObj.name = 'Negative';
                    ansObj.answer__c = 'Negative';
                    ansObj.question__c = quesObj.id;
                    ansUpdateList.add(ansObj);
                }
                if(ansUpdateList.size() > 0){
                    insert ansUpdateList;
                }
                //initializations();
                
            }
        }catch(Exception e){
            system.debug('Exception==>'+ e.getMessage());
        }
        return new pagereference('/apex/PlaybooxBuilder?id='+processId + '&playid='+playObjIdForUpdate).setRedirect(true);
    }
    
    public pagereference updateQuestion(){
        system.debug('##updateQuestionIN');
        try{
            if(processObj != null && ((string)processObj.Id).trim().length() > 0){
                if(quesObj.responseType__c == 'DataMap'){
                  quesObj.name = quesObj.name__c;
                  //added fields name in case of data map question to get fields in Playmaker PDF
                  if(processObj.mapping__c == NULL || !processObj.mapping__c.contains(quesObj.name__c)){ 
                      if(processObj.mapping__c == NULL || String.isBlank(processObj.mapping__c))
                        processObj.mapping__c = quesObj.name__c;
                      else
                        processObj.mapping__c += ', ' + quesObj.name__c;
                  }
                  /*added fields name in case of data map question to get fields in Playmaker PDF
                  String mapFields = processObj.mapping__c;
                  system.debug('##mapFields=' + mapFields);
                  if(mapFields != NULL && mapFields.trim().length() > 0 && !mapFields.contains(quesObj.name__c)){
                    mapFields += ', ' + quesObj.name__c;
                    system.debug('##processObj.mapping__c not null case');
                  }else{
                    mapFields = quesObj.name__c;
                    system.debug('##processObj.mapping__c null case');
                  }
                  processObj.mapping__c = mapFields;
                  */
                  update processObj;  
                }
                update quesObj;
                
                List<PbxAnswer__c>ansUpdateList = new List<PbxAnswer__c>();
                if((quesObj.responseType__c == 'SingleChoice' || quesObj.responseType__c == 'MultiChoice' ) && quesObj.id != null && ((string)quesObj.id).trim().length() > 0 ){
                    for(AnswerModal obj : ansModalList){
                        if(obj.answer != null && obj.answer.trim().length() > 0){
                            PbxAnswer__c ansObj = new PbxAnswer__c();
                            ansObj.name = obj.answer;
                            ansObj.answer__c = obj.answer;
                            ansObj.weight__c = integer.valueOf(obj.weight);
                            if(obj.flagtype){
                                ansObj.flagtype__c= 'Red';
                            }else{
                              ansObj.flagtype__c= 'Green';
                            }
                            ansObj.question__c = quesObj.id;
                            ansUpdateList.add(ansObj);
                        }   
                    }
                }else if(quesObj.responseType__c == 'DataMap'  && dataMMap.size() > 0 && quesObj.id != null && ((string)quesObj.id).trim().length() > 0){
                  if(dataMMap.containsKey(quesObj.name__c)){
                    for(string obj : dataMMap.get(quesObj.name__c)){
                      PbxAnswer__c ansObj = new PbxAnswer__c();
                        ansObj.name = obj;
                        ansObj.answer__c = obj;
                        ansObj.question__c = quesObj.id;
                        ansUpdateList.add(ansObj);
                    }
                  }
                }else if(quesObj.responseType__c == 'Checkbox' && quesObj.id != null && ((string)quesObj.id).trim().length() > 0){
                    PbxAnswer__c ansObj = new PbxAnswer__c();
                    ansObj.name = 'true';
                    ansObj.answer__c = 'true';
                    ansObj.question__c = quesObj.id;
                    ansObj.weight__c = 3;
                    ansUpdateList.add(ansObj);
                    
                    ansObj = new PbxAnswer__c();
                    ansObj.name = 'false';
                    ansObj.answer__c = 'false';
                    ansObj.question__c = quesObj.id;
                    ansObj.weight__c = -1;
                    ansUpdateList.add(ansObj);
                }else if(quesObj.responseType__c == 'Rating' && quesObj.id != null && ((string)quesObj.id).trim().length() > 0){
                    PbxAnswer__c ansObj = new PbxAnswer__c();
                    ansObj.name = 'Positive';
                    ansObj.answer__c = 'Positive';
                    ansObj.question__c = quesObj.id;
                    ansUpdateList.add(ansObj);
                    
                    ansObj = new PbxAnswer__c();
                    ansObj.name = 'Neutral';
                    ansObj.answer__c = 'Neutral';
                    ansObj.question__c = quesObj.id;
                    ansUpdateList.add(ansObj);
                    
                    ansObj = new PbxAnswer__c();
                    ansObj.name = 'Negative';
                    ansObj.answer__c = 'Negative';
                    ansObj.question__c = quesObj.id;
                    ansUpdateList.add(ansObj);
                }
                List<PbxAnswer__c> ansDelList = [select id from PbxAnswer__c where question__c = :quesObj.id];
                if(ansDelList != null && ansDelList.size() > 0){
                    delete ansDelList;
                }
                if(ansUpdateList.size() > 0){
                    insert ansUpdateList;
                }
                //initializations();
                
            }
        }catch(Exception e){
