    public void getSalesToolsAndTrainingPlays(){
        system.debug('####getSalesTool');
        sToolSectionCount = 0;
        sTrainingSectionCount = 0;
        //--- 11 august 2016
        CompetitionTrainingList = new List<PbxTrainingInstance__c>();
        GeneralTrainingList = new List<PbxTrainingInstance__c>();
        IndustryTrainingList = new List<PbxTrainingInstance__c>();
        ObjHandTrainingList = new List<PbxTrainingInstance__c>();
        ProductTrainingList = new List<PbxTrainingInstance__c>();
        SuccessStoriesTrainingList = new List<PbxTrainingInstance__c>();    
        // end         
        
        sToolsGMdlList = new List<PbxToolInstance__c>();
        sToolsComMdlList = new List<PbxToolInstance__c>();
        sToolsOMdlList = new List<PbxToolInstance__c>();
        sToolsSSMdlList = new List<PbxToolInstance__c>();
        sToolsPMdlList = new List<PbxToolInstance__c>();
        
        if(processInsList != null && processInsList.size() > 0){
            for(PbxToolInstance__c obj : [select id,Tip__c,playInstance__r.stageInstance__c,playInstance__r.stageInstance__r.name__c,playInstance__r.name__c,name__c,description__c,link__c from PbxToolInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInGeneral__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                sToolsGMdlList.add(obj);
            }
            for(PbxToolInstance__c obj : [select id,Tip__c,playInstance__r.stageInstance__c,playInstance__r.stageInstance__r.name__c,playInstance__r.name__c,name__c,description__c,link__c from PbxToolInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInCompetition__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                sToolsComMdlList.add(obj);
            }
            for(PbxToolInstance__c obj : [select id,Tip__c,playInstance__r.stageInstance__c,playInstance__r.stageInstance__r.name__c,playInstance__r.name__c,name__c,description__c,link__c from PbxToolInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInObjectionHandling__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                sToolsOMdlList.add(obj);
            }
            for(PbxToolInstance__c obj : [select id,Tip__c,playInstance__r.stageInstance__c,playInstance__r.stageInstance__r.name__c,playInstance__r.name__c,name__c,description__c,link__c from PbxToolInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInProduct__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                sToolsPMdlList.add(obj);
            }
            for(PbxToolInstance__c obj : [select id,Tip__c,playInstance__r.stageInstance__c,playInstance__r.stageInstance__r.name__c,playInstance__r.name__c,name__c,description__c,link__c from PbxToolInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInSuccessStories__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                sToolsSSMdlList.add(obj);
            }
            
            //manage count for collapse and expand
            if(sToolsGMdlList.size() > 0){
                ++sToolSectionCount;
            }
            if(sToolsComMdlList.size() > 0){
                ++sToolSectionCount;
            }
            if(sToolsOMdlList.size() > 0){
                ++sToolSectionCount;
            }
            if(sToolsPMdlList.size() > 0){
                ++sToolSectionCount;
            }
            if(sToolsSSMdlList.size() > 0){
                ++sToolSectionCount;
            }
            
            // Fill training records : 11 august 2016
            //Competition
            for(PbxTrainingInstance__c obj : [select id, Description__c, Link__c, Name__c, PlayInstance__c, Tip__c, SortPosition__c  from PbxTrainingInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInCompetition__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                CompetitionTrainingList.add(obj);
            }
            //General
            for(PbxTrainingInstance__c obj : [select id, Description__c, Link__c, Name__c, PlayInstance__c, Tip__c, SortPosition__c  from PbxTrainingInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInGeneral__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                GeneralTrainingList.add(obj);
            }
            //Industry
            for(PbxTrainingInstance__c obj : [select id, Description__c, Link__c, Name__c, PlayInstance__c, Tip__c, SortPosition__c  from PbxTrainingInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInIndustry__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                IndustryTrainingList.add(obj);
            }
            //ObjectionHandling
            for(PbxTrainingInstance__c obj : [select id, Description__c, Link__c, Name__c, PlayInstance__c, Tip__c, SortPosition__c  from PbxTrainingInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInObjectionHandling__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                ObjHandTrainingList.add(obj);
            }
            //Product
            for(PbxTrainingInstance__c obj : [select id, Description__c, Link__c, Name__c, PlayInstance__c, Tip__c, SortPosition__c  from PbxTrainingInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInProduct__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                ProductTrainingList.add(obj);
            }
            //SuccessStories
            for(PbxTrainingInstance__c obj : [select id, Description__c, Link__c, Name__c, PlayInstance__c, Tip__c, SortPosition__c  from PbxTrainingInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInSuccessStories__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                SuccessStoriesTrainingList.add(obj);
            }
            //manage training lists count for collapse and expand
            if(CompetitionTrainingList.size() > 0){
                ++sTrainingSectionCount;
            }
            if(GeneralTrainingList.size() > 0){
                ++sTrainingSectionCount;
            }
            if(IndustryTrainingList.size() > 0){
                ++sTrainingSectionCount;
            }
            if(ObjHandTrainingList.size() > 0){
                ++sTrainingSectionCount;
            }
            if(ProductTrainingList.size() > 0){
                ++sTrainingSectionCount;
            }
            if(SuccessStoriesTrainingList.size() > 0){
                ++sTrainingSectionCount;
            }
        }
    }
    
    public void fillPicklistValues(){        
        //Get Lead's status values
        Set<String> avilableStageSet = new Set<String>();//this set is used to fill only those stages which are available on record types
        if(availableRecordTypeStages != NULL && availableRecordTypeStages.trim().length() > 0 && availableRecordTypeStages.endsWith('___')){
            avilableStageSet.addAll(availableRecordTypeStages.split('___'));
        }
        system.debug('##availableRecordTypeStages=' + avilableStageSet);
        system.debug('##avilableStageSet=' + avilableStageSet);
        leadStatusList = new List<string>();
        leadStatusMap = new Map<string,Integer>();
        for(LeadStatus obj : [select masterLabel,sortOrder from LeadStatus order by sortOrder]){ //ask about isConverted logic 
            if(avilableStageSet.size() == 0 || avilableStageSet.contains(obj.masterLabel)){
                leadStatusList.add(obj.masterLabel);
                leadStatusMap.put(obj.masterLabel,obj.sortOrder);            
                if(leadObj.Status == obj.masterLabel){
                    currentStatusExist = true;
                }
            }
        }
        System.debug('#####queryResult=' + [select masterLabel,sortOrder from LeadStatus where IsConverted = true order by sortOrder]);
        System.debug('#####leadStatusList= ' + leadStatusList);
        System.debug('#####leadStatusMap= ' + leadStatusMap);
    }
    
    
    public void playbookBulkInsertion(){
        PbxProcessInstance__c processInsInsertObj = new PbxProcessInstance__c();
        List<PbxStageInstance__c> stageInsInsertList = new List<PbxStageInstance__c>();
        List<PbxPlayInstance__c> playInsInsertList = new List<PbxPlayInstance__c>(); 
        List<PbxQuestionInstance__c> questionInsInsertList = new List<PbxQuestionInstance__c>();
        List<PbxMessageInstance__c> msgInsInsertList = new List<PbxMessageInstance__c>();
        List<PbxToolInstance__c> toolInsInsertList = new List<PbxtoolInstance__c>();
        List<PbxAnswerInstance__c> answerInsInsertList = new List<PbxAnswerInstance__c>();
        // 11 august 2016
        List<PbxTrainingInstance__c> trainingInsertList = new List<PbxTrainingInstance__c>();
        
        try{
            system.debug('###########'+selectedPlaybookID+'.........'+prcMap);
            if(selectedPlaybookID != null && leadObj != null){
                if(prcMap.size() > 0 && prcMap.containsKey(selectedPlaybookID)){
                    PbxProcess__c prcObj = prcMap.get(selectedPlaybookID);
                    processInsInsertObj.name__c = prcObj.name__c;
                    processInsInsertObj.Lead__c = leadObj.id;
                    processInsInsertObj.Process__c = prcObj.id;
                    processInsInsertObj.ProgressThreshold__c = prcObj.ProgressThreshold__c;
                    processInsInsertObj.PlaybookEntityType__c = prcObj.PlaybookEntityType__c;
                    processInsInsertObj.version__c = prcObj.version__c;
                    processInsInsertObj.mapping__c = prcObj.mapping__c;
                    
                    insert processInsInsertObj;
                    
                    //oppObj.PlaybookName__c = processInsInsertObj.name__c;
                    //update oppObj;
                }
                Map<string,string> StageMap = new Map<string,string>(); 
                if(processInsInsertObj.id != null){
                    for(PbxStage__c obj : [select id,name,name__c,sortPosition__c,process__c,description__c,(select id,name__c,description__c from Plays__r) from PbxStage__c where process__c = :selectedPlaybookID]){
                        system.debug('###stage=='+obj);
                        PbxStageInstance__c stgInsObj = new PbxStageInstance__c();
                        stgInsObj.name__c= obj.name__c;
                        stgInsObj.processInstance__c = processInsInsertObj.id; 
                        stgInsObj.description__c = obj.description__c;
                        stgInsObj.sortPosition__c = obj.sortPosition__c;
                        stgInsObj.stageId__c = obj.id;
                        stageInsInsertList.add(stgInsObj);
                    }
                    
                    if(stageInsInsertList.size() > 0){
                        insert stageInsInsertList;
                        
                        for(PbxStageInstance__c obj : stageInsInsertList){
                            StageMap.put(obj.stageId__c,obj.id);
                        }
                        if(StageMap.size() > 0){
                            Map<string,string> playMap = new Map<string,string>();
                            for(PbxPlay__c obj : [select id,name,name__c,sortPosition__c,stage__r.name__c,description__c,(select id,name__c,IncludedInExecSummary__c,IncludedInKeyMilestones__c,Description__c,ResponseType__c,process__c from Questions__r where process__c = :selectedPlaybookID) from PbxPlay__c where Process__c = :selectedPlaybookID order by sortPosition__c]){
                                PbxPlayInstance__c playInsObj = new PbxPlayInstance__c();
                                playInsObj.name__c = obj.name__c;
                                playInsObj.description__c = obj.description__c;
                                playInsObj.sortPosition__c = obj.sortPosition__c;
                                playInsObj.playId__c = obj.id;
                                if(StageMap.get(obj.stage__c) != null){
                                    playInsObj.stageInstance__c = StageMap.get(obj.stage__c);
                                    playInsInsertList.add(playInsObj);  
                                }
                                
                            }
                            if(playInsInsertList.size() > 0){
                                insert playInsInsertList;       
                                
                                if(playInsInsertList[0].id != null){
                                    for(PbxPlayInstance__c obj : playInsInsertList){
                                            playMap.put(obj.playId__c , obj.id);  
                                    }
                                    system.debug('###playMap ==>'+playMap);
                                    //insert tool instance
                                    for(PbxTool__c obj : [select id,name__c,workspaceid__c,documentid__c,tip__c,play__c,play__r.stage__r.name__c,play__r.name__c,Description__c,link__c,IncludedInSuccessStories__c ,IncludedInProduct__c,IncludedInObjectionHandling__c,IncludedInCompetition__c,IncludedInGeneral__c,IncludedInCallManagementDiscussion__c,sortPosition__c from PbxTool__c where play__r.stage__r.process__c = :selectedPlaybookID order by sortPosition__c]){
                                        PbxToolInstance__c toolInsObj = new PbxToolInstance__c();
                                        toolInsObj.name__c = obj.name__c;
                                        toolInsObj.tip__c = obj.tip__c;
                                        toolInsObj.Description__c = obj.Description__c;
                                        toolInsObj.link__c = obj.link__c;
                                        toolInsObj.sortPosition__c = obj.sortPosition__c;
                                        toolInsObj.IncludedInGeneral__c = obj.IncludedInGeneral__c;
                                        toolInsObj.IncludedInCallManagementDiscussion__c = obj.IncludedInCallManagementDiscussion__c;
                                        toolInsObj.IncludedInCompetition__c = obj.IncludedInCompetition__c;
                                        toolInsObj.includedInObjectionHandling__c = obj.includedInObjectionHandling__c;
                                        toolInsObj.IncludedInProduct__c = obj.IncludedInProduct__c;
                                        toolInsObj.IncludedInSuccessStories__c = obj.IncludedInSuccessStories__c;
                                        system.debug('###obj.play__r.stage__r.name__c + + obj.play__r.name__c ==>'+obj.play__r.stage__r.name__c + ';' + obj.play__r.name__c);
                                        system.debug('###toolname='+obj.name__c);
                                        if(playMap.get(obj.play__c) != null){
                                            toolInsObj.playInstance__c = playMap.get(obj.play__c);
                                            toolInsInsertList.add(toolInsObj);
                                        }
                                    }
                                    if(toolInsInsertList.size() > 0){
                                        insert toolInsInsertList;
                                    }
                                    
                                    // 11 august 2016 PbxTrainingInstance__c trainingInsertList
                                    //insert Training instance
                                    for(PbxTraining__c obj : [SELECT Id, Play__c, WorkspaceId__c, DocumentId__c, ExternalId__c, play__r.stage__r.name__c, play__r.name__c, 
                                                             Description__c, IncludedInCallManagementDiscussion__c,
                                                             IncludedInIndustry__c, IncludedInObjectionHandling__c, 
                                                             IncludedInProduct__c, IncludedInSuccessStories__c, Link__c, Name__c, SortPosition__c, Tip__c, 
                                                            IncludedInCompetition__c, IncludedInGeneral__c FROM PbxTraining__c
                                                            WHERE play__r.stage__r.process__c = :selectedPlaybookID order by sortPosition__c]){
                                                                    
                                        PbxTrainingInstance__c trainingInsObj = new PbxTrainingInstance__c();
                                        trainingInsObj.Description__c = obj.Description__c;
                                        trainingInsObj.IncludedInCallManagementDiscussion__c = obj.IncludedInCallManagementDiscussion__c;
                                        trainingInsObj.IncludedInCompetition__c = obj.IncludedInCompetition__c;
                                        trainingInsObj.IncludedInGeneral__c = obj.IncludedInGeneral__c;
                                        trainingInsObj.IncludedInIndustry__c = obj.IncludedInIndustry__c;
                                        trainingInsObj.IncludedInObjectionHandling__c = obj.IncludedInObjectionHandling__c;
                                        trainingInsObj.IncludedInProduct__c = obj.IncludedInProduct__c;
                                        trainingInsObj.IncludedInSuccessStories__c = obj.IncludedInSuccessStories__c;
                                        trainingInsObj.Link__c = obj.Link__c;  
                                        trainingInsObj.Name__c = obj.Name__c;
                                        trainingInsObj.SortPosition__c = obj.SortPosition__c;
                                        trainingInsObj.Tip__c = obj.Tip__c;                                     
                                        
                                        if(playMap.get(obj.play__c) != null){
                                            trainingInsObj.playInstance__c = playMap.get(obj.play__c);
                                            trainingInsertList.add(trainingInsObj);
                                        }
                                    }
                                    if(trainingInsertList.size() > 0){
                                        insert trainingInsertList;
                                    }
                                    // end
                                    
                                    //insert message instance
                                    for(PbxMessage__c obj : [select id,name__c,tip__c,play__r.stage__r.name__c,play__c,play__r.name__c,description__c,link__c,IncludedInAssessment__c,IncludedInDiscussion__c,sortPosition__c from PbxMessage__c where play__r.stage__r.process__c = :selectedPlaybookID order by sortPosition__c]){
                                        PbxMessageInstance__c msgInsObj = new PbxMessageInstance__c();
                                        msgInsObj.name__c = obj.name__c;
                                        msgInsObj.tip__c = obj.tip__c;
                                        msgInsObj.description__c = obj.description__c;
                                        msgInsObj.link__c = obj.link__c;
                                        msgInsObj.sortPosition__c = obj.sortPosition__c;
                                        msgInsObj.IncludedInAssessment__c = obj.IncludedInAssessment__c;
                                        msgInsObj.IncludedInDiscussion__c = obj.IncludedInDiscussion__c;
                                        system.debug('###obj.play__r.stage__r.name__c + + obj.play__r.name__c ==>'+obj.play__r.stage__r.name__c + ';' + obj.play__r.name__c);
                                        system.debug('###messagename='+obj.name__c);
                                        if(playMap.get(obj.play__c) != null){
                                            msgInsObj.playInstance__c = playMap.get(obj.play__c);
                                            msgInsInsertList.add(msgInsObj);
                                        }
                                    }
                                    if(msgInsInsertList.size() > 0){
                                        insert msgInsInsertList;
                                    }
                                    //insert question instance
                                    Map<string,string> questionMap = new Map<string,string>();
                                    set<string>answerIds = new set<string>();
                                    
                                    for(PbxQuestion__c obj : [select id,name__c,play__r.stage__r.name__c,tip__c,IncludedInExecSummary__c,IncludedInSuccessIndicators__c,IncludedInDealProgress__c,play__c,play__r.name__c,IncludedInKeyMilestones__c,Description__c,ResponseType__c,process__c,IncludedInAssessment__c,IncludedInDiscussion__c,sortPosition__c,(select id,answer__c,SortPosition__c,flagtype__c,Weight__c from Answers__r) from PbxQuestion__c where process__c = :selectedPlaybookID order by sortPosition__c]){
                                        PbxQuestionInstance__c quesInsObj = new PbxQuestionInstance__c();
                                        quesInsObj.name__c = obj.name__c;
                                        quesInsObj.tip__c = obj.tip__c;
                                        quesInsObj.IncludedInExecSummary__c = obj.IncludedInExecSummary__c;
                                        quesInsObj.IncludedInKeyMilestones__c = obj.IncludedInKeyMilestones__c;
                                        quesInsObj.IncludedInDealProgress__c = obj.IncludedInDealProgress__c;
                                        quesInsObj.IncludedInSuccessIndicators__c = obj.IncludedInSuccessIndicators__c;
                                        quesInsObj.Description__c = obj.Description__c;
                                        quesInsObj.ResponseType__c = obj.ResponseType__c;
                                        quesInsObj.sortPosition__c = obj.sortPosition__c;
                                        quesInsObj.IncludedInAssessment__c = obj.IncludedInAssessment__c;
                                        quesInsObj.IncludedInDiscussion__c = obj.IncludedInDiscussion__c;
                                        quesInsObj.questionId__c = obj.id;
                                        system.debug('###quesname='+obj.name__c);
                                        //system.debug('###obj.play__r.stage__r.name__c + + obj.play__r.name__c ==>'+obj.play__r.stage__r.name__c + ';' + obj.play__r.name__c);
                                        
                                        if(playMap.get(obj.play__c) != null){
                                            quesInsObj.playInstance__c = playMap.get(obj.play__c);
                                            quesInsObj.processInstance__c = processInsInsertObj.id;         
                                            questionInsInsertList.add(quesInsObj);
                                        }
                                        system.debug('###answers ==>'+obj.description__c + '===>' +obj.Answers__r);
                                        for(PbxAnswer__c obj2 : obj.Answers__r){
                                            if(obj2.answer__c != null)
                                            answerIds.add(obj2.id); 
                                        }
                                        //questionMap.put(obj.play__r.name__c + '_' + obj.description__c ,null);               
                                    }
                                    system.debug('###answerIds ==>'+answerIds);
                                    if(questionInsInsertList.size() > 0){
                                        insert questionInsInsertList;   
                                        
                                        if(questionInsInsertList[0].id != null && answerIds.size() > 0){
                                            for(PbxQuestionInstance__c obj : questionInsInsertList){
                                                questionMap.put(obj.questionId__c , obj.id);  
                                            }
                                            system.debug('###questionMap ==>'+questionMap);
                                            for(PbxAnswer__c obj : [select id,answer__c,question__r.play__r.name__c,question__r.name__c,question__r.description__c,SortPosition__c,flagtype__c,Weight__c from PbxAnswer__c where id in :answerIds order by sortPosition__c]){
                                                system.debug('###answerInn==>'+questionMap.get(obj.question__r.name__c + '_' + obj.question__r.description__c) );
                                                PbxAnswerInstance__c ansInsObj = new PbxAnswerInstance__c();
                                                ansInsObj.answer__c = obj.answer__c;
                                                ansInsObj.SortPosition__c = obj.SortPosition__c;
                                                ansInsObj.flagtype__c = obj.flagtype__c;
                                                ansInsObj.Weight__c = obj.Weight__c;
                                                system.debug('###ans=obj.question__r.play__r.name__c +  + obj.question__r.description__c='+obj.question__r.play__r.name__c + '_' + obj.question__r.description__c);
                                                if(questionMap.get(obj.question__c) != null){
                                                    ansInsObj.questionInstance__c = questionMap.get(obj.question__c);
                                                    answerInsInsertList.add(ansInsObj);
                                                }               
                                            }
                                            if(answerInsInsertList.size() > 0){
                                                insert answerInsInsertList; 
                                            
                                            }
                                        }
                                    }
                                }
                                
                            }           
                        }  
                    }
                    
                }       
            }
            init(); 
            
        }catch(Exception e){
            system.debug('Exception @==>'+e.getMessage());
        }   
    }
    
