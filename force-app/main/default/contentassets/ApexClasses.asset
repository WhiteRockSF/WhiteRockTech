        }
    }
    
    static testMethod void copyMessageContentToPlayMethod()
    {
        Test.startTest();
        
        PbxProcess__c process = new PbxProcess__c();
        process.ProgressThreshold__c = 70;
        process.PublishDate__c = date.newinstance(1960, 2, 17);
        process.Name__c = 'Test Process Name'; 
        process.Active__c = true;
        process.Description__c ='Process description';
        process.PlaybookEntityType__c ='Opportunity';
        //process.Points__c = 24;
        insert process;
        
        PbxPlay__c play0 = new PbxPlay__c();
        play0.Process__c = process.id;
        play0.Name__c = 'Play0 name';
        play0.Description__c = 'Play0 Description';
        play0.SortPosition__c=0;
        insert play0;
        
        PbxMessage__c msg = new PbxMessage__c();
        msg.Description__c = 'aaaaaaaaaabbbbbbbbbbbbbbcccccccccccccc';
        msg.Link__c ='http://www.google.com';
        msg.Name__c ='Message';
        msg.Play__c = play0.id;
        msg.SortPosition__c = 0;
        msg.Tip__c ='TIPPPP';
        insert msg;
        
        Id msgId = PbxProcessWebService.copyMessageContentToPlay(play0.id,msg.id,2);
        PbxMessage__c msgResult = [SELECT SortPosition__c, Play__c, id
                                   FROM PbxMessage__c 
                                   WHERE id = :msgId];
                                   
        System.assertEquals(msgResult.SortPosition__c, 2);
        System.assertEquals(msgResult.Play__c, play0.id);
        System.assertNotEquals(msgResult.id, msg.id);
        
        try {

            msgId = PbxProcessWebService.copyMessageContentToPlay(null,null,2);
        } catch (Exception e) {
            System.assertEquals(e.getMessage(),'Input Error');
        }
    }
    
