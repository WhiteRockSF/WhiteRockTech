"01p15000006akBkAAI","","PbxController","26.0","Active","true","1.039998172E9","public class PbxController {

      public PbxController() {
            
      }
      
      public String getEntityType()
      {
          String entityType = ApexPages.currentPage().getParameters().get('type');
          if(entityType != null )
          {
              if(entityType.endsWithIgnoreCase('lead'))
              {
                  return 'Lead';
              }else if (entityType.equalsIgnoreCase('account'))
              {
                  return 'Account';
              }
          }
          
          return 'Opportunity';
      }
      
      public String getDeepLinkParameter()
      {
          Id id = ApexPages.currentPage().getParameters().get('id');
          
          if(id != null)
          {
              String entityType = getEntityType();
              List<PbxProcessInstance__c> pis;
              
              if(entityType.equals('Opportunity'))
              {
                  pis = [SELECT Id FROM PbxProcessInstance__c WHERE Opportunity__c =:id];
              }else if(entityType.equals('Lead'))
              {
                  pis = [SELECT Id FROM PbxProcessInstance__c WHERE Lead__c =:id];
              }else if(entityType.equals('Account'))
              {
                  pis = [SELECT Id FROM PbxProcessInstance__c WHERE Account__c =:id];
              }
              
              if(pis.size() == 1)//with Playboox
              {
                  return '&piId='+ pis.get(0).Id;
              }else if(pis.size() == 0)
              {
                  return '&entityId=' + Id;
              }
          }
          return '';
      }
