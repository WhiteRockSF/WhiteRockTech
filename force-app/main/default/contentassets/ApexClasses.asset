        PbxProcessInstance__c process = TestCoverageUtility.createPbxProcessInstance(opp.id,'test gut_feel');
        process.name__c = 'test process';
        insert process;
        system.assertEquals([select id,PlaybookName__c from Opportunity where id=:opp.id].PlaybookName__c ,process.name__c);
        
        PbxQuestionInstance__c ques = new PbxQuestionInstance__c();
        ques.ProcessInstance__C = process.id;
        insert ques;
        
        process.opportunity__c = opp1.id;
        process.PlaybookEntityType__c = 'Opportunity';
        update process;
        
        system.assertEquals([select id,WinnabilityScore__c from Opportunity where id=:opp.id].WinnabilityScore__c ,process.score__c);
        
        List<PbxProcessInstance__c> PIList= [SELECT Id, PlaybookEntityType__c, Opportunity__r.Id FROM PbxProcessInstance__c WHERE Id=:process.id];
        system.debug('##........'+PIList[0].opportunity__r);
        process.Opportunity__r = PIList[0].opportunity__r;
        process.PlaybookEntityType__c = 'Opportunity';
        update process;
        Delete PIList;
    }
