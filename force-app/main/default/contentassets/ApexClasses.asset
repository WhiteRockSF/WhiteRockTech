"01p150000074tjIAAQ","","LeadConversionTriggerHandler","39.0","Active","false","4.46695642E8","/*
    Name            :            LeadConversionTriggerHandler
    Date            :            13th feb 2017
    Author          :
    Description     :            It is a handler class for LeadConversionTrigger....
*/

public class LeadConversionTriggerHandler{

    @future(callout=true)
    public static void createPlaybooxAttachmentForConvertedOpportunity(Map<String, String> leadToOpportunityMap){
        List<Attachment> attachmentList = new List<Attachment>();
        for(PbxProcessInstance__c processInstanceObj : [SELECT Id, Name, Lead__c
                                                        FROM PbxProcessInstance__c 
                                                        WHERE Lead__c IN :leadToOpportunityMap.keySet()]){
            Attachment attachmentRec = new Attachment();
            PageReference pdf = Page.LeadPlaymakerPDF;
            pdf.getParameters().put('processInstanceId', processInstanceObj.Id);
            pdf.setRedirect(true);
            Blob pageContent;
            if(! Test.isRunningTest())
                pageContent = pdf.getContent();
            else
                pageContent = Blob.valueOf('test');
                
            attachmentRec.Name = 'LeadPlayMakerPdf-' + processInstanceObj.Name + '.pdf';
            attachmentRec.body = pageContent;
            attachmentRec.ParentId = leadToOpportunityMap.get(processInstanceObj.Lead__c);
            attachmentList.add(attachmentRec);
        }
        
        insert attachmentList;
    }
}","1257","2017-02-12T12:12:50.000Z","00515000006PhzjAAC","2017-02-15T07:18:56.000Z","00515000006PhzjAAC","2018-06-02T13:54:13.000Z"
"01p15000006cF5CAAU","","PbxUtils","36.0","Active","true","9.31839628E8","public with sharing class PbxUtils {
    public static string getNameSpace(){
        //15 Sep 2016: Changed the query to get the correct name space.
        //List<ApexClass>lst = [SELECT NamespacePrefix FROM ApexClass limit 1];
        List<ApexClass>lst = [SELECT NamespacePrefix FROM ApexClass WHERE Name = 'PbxUtils' limit 1];
        if(lst != null && lst.size() > 0 && lst.get(0).NamespacePrefix != null){
            return lst.get(0).NamespacePrefix;
        }else{
            return null;
        }
    }
    public static PbxQuestion__c getQuestion(Id questionId){
      List<PbxQuestion__c> questions =  [ SELECT Id, Description__c, IncludedInExecSummary__c, IncludedInKeyMilestones__c,
       									 IncludedInAssessment__c, IncludedInDealProgress__c, IncludedInDiscussion__c, IncludedInSuccessIndicators__c,
                                         Link__c, Name__c, Play__c, Points__c, Process__c, ResponseType__c, 
                                         SortPosition__c, Tip__c, Play__r.Stage__r.Name__c, 
                                         ( SELECT Id, Answer__c, FlagType__c, Question__c, SortPosition__c, Weight__c FROM Answers__r ORDER BY SortPosition__c ),
                                         ( SELECT Id, CompareValue__c, FlagType__c, Operation__c, Question__c FROM ContentFlags__r)
                                          FROM PbxQuestion__c
                                          WHERE Id =: questionId 
                                          ORDER BY SortPosition__c ASC ];
        
        if(questions.size() > 0)
            return questions.get(0); 
        throw new PbxPlayBookException('No Question Found!');
    }
    
    //Returns all questions of all plays
    public static List<PbxQuestion__c> getQuestions(Set<Id> playIds){
      return [ SELECT Id, Description__c, IncludedInExecSummary__c, IncludedInKeyMilestones__c, 
                                         IncludedInAssessment__c, IncludedInDealProgress__c, IncludedInDiscussion__c, IncludedInSuccessIndicators__c,
                                         Link__c, Name__c, Play__c, Points__c, Process__c, ResponseType__c, 
                                         SortPosition__c, Tip__c, Play__r.Stage__r.Name__c, 
                                         ( SELECT Id, Answer__c, FlagType__c, Question__c, SortPosition__c, Weight__c FROM Answers__r ORDER BY SortPosition__c ),
                                         ( SELECT Id, CompareValue__c, FlagType__c, Operation__c, Question__c FROM ContentFlags__r)
                                          FROM PbxQuestion__c
                                          WHERE Play__c IN: playIds 
                                          ORDER BY SortPosition__c ASC ];
    }
    
    public static PbxPlay__c getPlay(Id playId){
        List<PbxPlay__c> plays = [ SELECT Id, Name, CreatedDate, LastModifiedDate, Process__c, Description__c, ExternalId__c, 
                                Name__c, SortPosition__c, Stage__c, PbxPlay__c.Stage__r.Process__c
                                FROM PbxPlay__c
                                WHERE Id = :playId ORDER BY SortPosition__c ASC];
        system.debug('**** Queryed plays : '+plays+' : plays size : '+plays.size());
         
        if(plays.size() > 0){
            system.debug('*** plays.get(0) : '+plays.get(0));
            return plays.get(0); 
        }else{
            throw new PbxPlayBookException('No Play Found!');
        }
    }
    
    public static List<PbxPlay__c> getPlays(Set<Id> stageIds){
        return [ SELECT Id, Name, CreatedDate, LastModifiedDate, Process__c, Description__c, ExternalId__c, 
                                Name__c, SortPosition__c, Stage__c, PbxPlay__c.Stage__r.Process__c,
                                (SELECT Play__c, description__c, ExternalId__c, Link__c, Name__c, SortPosition__c, Tip__c, IncludedInAssessment__c, IncludedInDiscussion__c, Name, Id 
                                FROM Messages__r ORDER BY SortPosition__c ASC),
                                (SELECT Play__c, Description__c, DocumentId__c, ExternalId__c, Link__c, Name__c, SortPosition__c, Tip__c, WorkspaceId__c, IncludedInCompetition__c, IncludedInCallManagementDiscussion__c, IncludedInGeneral__c, IncludedInObjectionHandling__c, IncludedInProduct__c, IncludedInSuccessStories__c, Name, Id 
                                FROM Tools__r ORDER BY SortPosition__c ASC)
                                FROM PbxPlay__c
                                WHERE Stage__c in: stageIds ORDER BY SortPosition__c ASC];
        
    }
    
    public static String getQuery(Type sobjType, String whereClause, String orderBy){
        String query = '';
        if(sobjType.equals(PbxStage__c.class)){
            query = 'SELECT Process__c, Description__c, ExternalId__c, Name__c, SalesforceStageId__c, SortPosition__c, ' +
                    'isLibrary__c, Id, Name ' +
                    'FROM PbxStage__c ';       
        }else if(sobjType.equals(PbxQuestion__c.class)){
            query = 'SELECT Id, Description__c, IncludedInExecSummary__c, IncludedInKeyMilestones__c, ' + 
                    'IncludedInAssessment__c, IncludedInDealProgress__c, IncludedInDiscussion__c, IncludedInSuccessIndicators__c, ' +
                    'Link__c, Name__c, Play__c, Points__c, Process__c, ResponseType__c, ' +  
                    'SortPosition__c, Tip__c, Play__r.Stage__r.Name__c, ' + 
                    '( SELECT Id, Answer__c, FlagType__c, Question__c, SortPosition__c, Weight__c FROM Answers__r ORDER BY SortPosition__c ), ' + 
                    '( SELECT Id, CompareValue__c, FlagType__c, Operation__c, Question__c FROM ContentFlags__r) ' + 
                    ' FROM PbxQuestion__c';
        }
        
        if(whereClause != null && whereClause.trim().length() > 0){
            query += ' WHERE ' + whereClause;
        }
        
        if(orderBy != null && orderBy.trim().length() > 0){
            query += ' ORDER BY ' + orderBy;
        }
        
        return query;
    }
    
    public static List<PbxStage__c> getStages(Id processId){
        String query = getQuery(PbxStage__c.class, 'Process__c =: processId', null);
        return Database.query(query);
    }
    
   
    public static PbxStage__c getStage(Id stageId){
        String query = getQuery(PbxStage__c.class, 'Id =: stageId', null);
        List<PbxStage__c> stages = Database.query(query);
        return stages.size() > 0 ? stages.get(0) : null;
    }
    
     public static List<PbxQuestion__c>  getProcessQuestions(Id processId){
        String query = getQuery(PbxQuestion__c.class, 'Play__r.Stage__r.Process__r.id =: processId', 'SortPosition__c ASC');
        return Database.query(query);
    }
    
    public static List<PbxMessage__c>  getProcessMessages(Id processId){
        return [SELECT Play__c,Play__r.Stage__r.name__c, description__c, ExternalId__c, Link__c, Name__c, SortPosition__c, Tip__c, IncludedInAssessment__c, IncludedInDiscussion__c, Name, Id 
                FROM PbxMessage__c
                WHERE Play__r.Stage__r.Process__r.id =: processId ORDER BY SortPosition__c ASC];
    }
    
    //Returns all messages of specified plays
    public static List<PbxMessage__c>  getMessages(Set<Id> playIds){
        return [SELECT Play__c, description__c, ExternalId__c, Link__c, Name__c, SortPosition__c, Tip__c, IncludedInAssessment__c, IncludedInDiscussion__c, Name, Id 
                FROM PbxMessage__c
                WHERE Play__c IN: playIds ORDER BY SortPosition__c ASC];
    }
    
    //Returns a message
    public static PbxMessage__c  getMessage(Id messageId){
        List<PbxMessage__c> messages =  [SELECT Play__c, description__c, ExternalId__c, Link__c, Name__c, SortPosition__c, 
                                         Tip__c, IncludedInAssessment__c, IncludedInDiscussion__c, Name, Id, Play__r.Stage__r.Name__c
                                        FROM PbxMessage__c
                                        WHERE Id =: messageId];
        
        return messages.size() > 0 ? messages.get(0) : null;
    }
    
    //Returns all tools of specified plays
    public static List<PbxTool__c> getTools(Set<Id> playIds){
        return [SELECT Play__c, Description__c, DocumentId__c, ExternalId__c, Link__c, Name__c, SortPosition__c, Tip__c, 
                WorkspaceId__c, IncludedInCompetition__c, IncludedInCallManagementDiscussion__c, IncludedInGeneral__c, IncludedInObjectionHandling__c, IncludedInProduct__c, IncludedInSuccessStories__c, 
                Name, Id 
                FROM PbxTool__c
                WHERE Play__c IN: playIds ORDER BY SortPosition__c ASC];
    }
    
    //Returns all trainings of specified plays
    public static List<PbxTraining__c> getTrainings(Set<Id> playIds){
        return [SELECT Play__c, Description__c, DocumentId__c, ExternalId__c, Link__c, Name__c, SortPosition__c, Tip__c, 
                WorkspaceId__c, IncludedInCompetition__c, IncludedInGeneral__c, IncludedInObjectionHandling__c, IncludedInIndustry__c, IncludedInSuccessStories__c, IncludedInCallManagementDiscussion__c, IncludedInProduct__c, 
                Name, Id 
                FROM PbxTraining__c
                WHERE Play__c IN: playIds ORDER BY SortPosition__c ASC];
    }
    
    public static List<PbxTool__c>  getProcessTools(Id processId){
        return [SELECT Play__c,Play__r.Stage__r.name__c, Description__c, DocumentId__c, ExternalId__c, Link__c, Name__c, SortPosition__c, Tip__c, 
                WorkspaceId__c, IncludedInCompetition__c, IncludedInCallManagementDiscussion__c, IncludedInGeneral__c, IncludedInObjectionHandling__c, IncludedInProduct__c, IncludedInSuccessStories__c, 
                Name, Id 
                FROM PbxTool__c
                WHERE Play__r.Stage__r.Process__r.id =: processId ORDER BY SortPosition__c ASC];
    }
    
    public static List<PbxTraining__c>  getProcessTrainings(Id processId){
        return [SELECT Play__c,Play__r.Stage__r.name__c, Description__c, DocumentId__c, ExternalId__c, Link__c, Name__c, SortPosition__c, Tip__c, 
                WorkspaceId__c, IncludedInCompetition__c, IncludedInGeneral__c, IncludedInObjectionHandling__c, IncludedInIndustry__c, IncludedInSuccessStories__c, IncludedInCallManagementDiscussion__c, IncludedInProduct__c, 
                Name, Id 
                FROM PbxTraining__c
                WHERE Play__r.Stage__r.Process__r.id =: processId ORDER BY SortPosition__c ASC];
    }
    
    //Returns a tool object
    public static PbxTool__c getTool(Id toolId){
        List<PbxTool__c> tools = [SELECT Play__c, Description__c, DocumentId__c, ExternalId__c, Link__c, Name__c, SortPosition__c, 
                                  Tip__c, WorkspaceId__c, IncludedInCompetition__c, IncludedInCallManagementDiscussion__c, IncludedInGeneral__c, IncludedInObjectionHandling__c, IncludedInProduct__c, IncludedInSuccessStories__c, 
                                  Name, Id, Play__r.Stage__r.Name__c
                                    FROM PbxTool__c
                                    WHERE Id =: toolId];
        return tools.size() > 0 ? tools.get(0) : null;
    }
    
    //Returns a training object
    public static PbxTraining__c getTraining(Id trainingId){
        List<PbxTraining__c> trainings = [SELECT Play__c, Description__c, DocumentId__c, ExternalId__c, Link__c, Name__c, SortPosition__c, 
                                  Tip__c, IncludedInCompetition__c, IncludedInGeneral__c, IncludedInObjectionHandling__c, IncludedInIndustry__c, IncludedInSuccessStories__c, IncludedInCallManagementDiscussion__c, IncludedInProduct__c, 
                                  Name, Id, Play__r.Stage__r.Name__c
                                    FROM PbxTraining__c
                                    WHERE Id =: trainingId];
        return trainings.size() > 0 ? trainings.get(0) : null;
    }
    
    public static Id cloneQuestion(Id playId, Id questionId){
        if (playId == null || questionId == null) {
            throw new PbxPlayBookException('Play or Question is missing!');
        }
        
        PbxQuestion__c question = getQuestion(questionId);
        system.debug('***** question obj : '+question);
        
        PbxQuestion__c cloneQues = new PbxQuestion__c();    
            
        cloneQues = question.clone(false,true);
     
        system.debug('**** new quest inserted id : '+cloneQues.Id);        
        
        PbxPlay__c play = getPlay(playId);
        system.debug('***** playId:'+playId);
        system.debug('***** play.Stage__r.Process__c :'+play.Stage__r.Process__c);
        cloneQues.sortPosition__c = null;
        cloneQues.Play__c = playId;
        cloneQues.Process__c = play.Stage__r.Process__c;
        
        insert cloneQues;
        system.debug('**** got plays obj : '+play);
        system.debug('***** cloneQues obj : '+cloneQues);
        
        //if(newPosition != null)
            //cloneQues.SortPosition__c = newPosition;
        
        cloneAnswers(cloneQues.Id, cloneQues.Answers__r);
        cloneFlags(cloneQues.Id, cloneQues.ContentFlags__r);
        system.debug('*** return new id : '+cloneQues.Id);
        return cloneQues.Id;
    }
    
    public static Id cloneMessage(Id playId, Id messageId){
        if (playId == null || messageId == null) {
            throw new PbxPlayBookException('Play or Message is missing!');
        }
        
        PbxMessage__c message = getMessage(messageId);
        PbxMessage__c cloneMessage = message.clone(false,true);
        system.debug('**** new cloneMessage inserted id : '+cloneMessage.Id);        
        cloneMessage.sortPosition__c = null;
        cloneMessage.Play__c = playId;
        insert cloneMessage;
        return cloneMessage.Id;
    }
    
    public static Id cloneTool(Id playId, Id toolId){
        if (playId == null || toolId == null) {
            throw new PbxPlayBookException('Play or Tool is missing!');
        }
        
        PbxTool__c tool = getTool(toolId);
        PbxTool__c cloneTool = tool.clone(false,true);
        system.debug('**** new cloneTool inserted id : '+cloneTool.Id);        
        cloneTool.sortPosition__c = null;
        cloneTool.Play__c = playId;
        insert cloneTool;
        return cloneTool.Id;
    }
    
    public static Id cloneTraining(Id playId, Id trainingId){
        if (playId == null || trainingId == null) {
            throw new PbxPlayBookException('Play or Training is missing!');
        }
        
        PbxTraining__c training = getTraining(trainingId);
        PbxTraining__c cloneTraining = training.clone(false,true);
        system.debug('**** new cloneTraining inserted id : '+cloneTraining.Id);        
        cloneTraining.sortPosition__c = null;
        cloneTraining.Play__c = playId;
        insert cloneTraining;
        return cloneTraining.Id;
    }
    
    public static void cloneAnswers(Id parentQuesId, List<PbxAnswer__c> answers){
        List<PbxAnswer__c> cloneAnswers = new List<PbxAnswer__c>();
        for( PbxAnswer__c ans: answers ){
            PbxAnswer__c cloneAns = ans.clone(false);
            cloneAns.sortPosition__c = null;
            cloneAns.Question__c = parentQuesId;
            cloneAnswers.add(cloneAns);
        } 
        
        insert cloneAnswers;
    }
    
    public static void cloneFlags(Id parentQuesId, List<PbxContentFlag__c> flags){
        List<PbxContentFlag__c> cloneFlags = new List<PbxContentFlag__c>();
        for( PbxContentFlag__c flag : flags ){
            PbxContentFlag__c cloneFlag = flag.clone(false);
            cloneFlag.Question__c = parentQuesId;
            cloneFlags.add(cloneFlag);
        } 
        
        insert cloneFlags;
    }
    
    public static PbxProcess__c getProcess(Id processId){
        List<PbxProcess__c> processes = [SELECT Active__c, Description__c, ExternalId__c, Mapping__c, Name__c, ParentPublishProcess__c, 
                                        PlaybookEntityType__c, ProgressThreshold__c, PublishDate__c, Points__c, Id, Name 
                                        FROM PbxProcess__c
                                        WHERE Id =:processId
                                      ];
        return processes.size() > 0 ? processes.get(0) : null;
    }
    
    public static void deleteProcess(Id processId){
        PbxProcess__c process = getProcess(processId);
        if(process != null){
            delete process;
        }
    }
    
    public static void deleteStage(Id stageId){
        PbxStage__c stage = getStage(stageId);
        if(stage != null){
            deletePlays(new Set<Id>{stageId});
            delete stage;
        }
            
    }
    
    public static void deletePlay(Id playId){
        PbxPlay__c play = getPlay(playId);
        if(play != null){
            deleteQuestions(new Set<Id>{playId});
            delete play;
        }
    }
    
    public static void deletePlays(Set<Id> stageIds){
        List<PbxPlay__c> plays = getPlays(stageIds);
        Set<Id> playIds = new Set<Id>();
        for(PbxPlay__c play : plays){
            playIds.add(play.Id);
        }
        
        deleteQuestions(playIds);
        delete plays;
    }
    public static void deleteQuestion(Id quesId){
        PbxQuestion__c question = getQuestion(quesId);
        if(question != null)
            delete question;
    }
    
    public static void deleteQuestions(Set<Id> playIds){
        delete getQuestions(playIds);
    }    
    
    public static void deleteMessage(Id messageId){
        PbxMessage__c message = getMessage(messageId);
        if(message != null)
            delete message;
    }
    
    public static void deleteTool(Id toolId){
        PbxTool__c tool = getTool(toolId);
        if(tool != null)
            delete tool;
    }
    
    public static void deleteTraining(Id trainingId){
        PbxTraining__c training = getTraining(trainingId);
        if(training != null)
            delete training;
    }
