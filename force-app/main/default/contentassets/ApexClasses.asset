        ans0.Weight__c = 12;
        insert ans0;
        
        PbxAnswerInstance__c ans1 = new PbxAnswerInstance__c();
        ans1.Answer__c = 'Answer1';
        ans1.FlagType__c = 'Green';
        ans1.QuestionInstance__c = qns0.id;
