    public pagereference deletePlaybook(){
        system.debug('##deletePlaybookIN');
        try{
            if(processId != null && processId.trim().length() > 0){
                delete [select id from PbxProcess__c where id = : processId];
                return new pagereference('/apex/PlaybooxBuilderDashboard').setRedirect(true);
            }
        }catch(Exception e){
            system.debug('Exception==>'+ e.getMessage());
        }
        return null;
    }
    
