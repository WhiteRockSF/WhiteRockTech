            }
        
        }
    }
    
    private void getProcessIns(){
        //get process instance of correspondence oppr.
        processInsList = [select id,score__c,gut_feel__c, mapping__c, ProgressThreshold__c, opportunity__r.winnabilityScore__c, Score_percent__c from PbxProcessInstance__c where Opportunity__c = :oppObj.id and version__c = '2' LIMIT 1];
        //used to empty error message because this method calls in saving methods
        errorMsg = '';
    }
    
    public void getCurrentOppRecordType(){
        if(oppObj != NULL && oppObj.id != NULL && recordTypeFieldForQuery != NULL && recordTypeFieldForQuery.trim().length() > 0 && oppObj.get('recordtypeid') != NULL){
            for(RecordType obj : [SELECT businessProcessId, name FROM RecordType WHERE id = :(String)oppObj.get('recordTypeid')]){
                currentBusinessProcessId = obj.businessProcessId;   
            }
        }
    }
    
    public void init(){
        showSelectPlaybook = true;
        //List<Opportunity> opps = [select id,name,stageName,createdbyid,createdby.name,createddate,lastmodifieddate,lastmodifiedbyid,lastmodifiedby.name,DeliveryInstallationStatus__c,TrackingNumber__c,MainCompetitors__c,CurrentGenerators__c,ExpectedRevenue,type,leadsource,NextStep,probability,Campaign.name,Campaignid,OrderNumber__c,isPrivate,accountid,account.name,ownerid,owner.name,closedate,amount, recordTypeId from opportunity where Id =: oppId];
        retrieveOppRecord();
        if(oppObj != NULL && oppObj.id != NULL && String.valueOf(oppObj.id).trim().length() > 14){
            processSelectList = new List<PbxProcess__c>();
            processInsList = new List<PbxProcessInstance__c>();
            selectedStage = oppObj.stageName;
            //get process instance of correspondence oppr.
            getProcessIns();         
            system.debug('###proSize='+processInsList.size());
            // Get Current proces id to export deal summary 
            currentProcessId = ( processInsList == null || processInsList.size() == 0 ) ? '' : processInsList.get(0).Id ;                
            //fill processinstance list for select playbook if process instance not found of corresponde oppr
            if(processInsList == null || processInsList.size() == 0){
                prcMap = new Map<string,PbxProcess__c>();
                getCurrentOppRecordType();
                String query = 'SELECT id,name,name__c, mapping__c, ProgressThreshold__c,PlaybookEntityType__c,version__c,(select id,name from ChildPublishProcesses__r LIMIT 2000) from PbxProcess__c where version__c = \'2\' and Active__c = true';
                if(currentBusinessProcessId != NULL && currentBusinessProcessId.trim().length() > 14){
                    query += ' AND businessProcessId__c = :currentBusinessProcessId ';
                }
                system.debug('##currentBusinessProcessId=' + currentBusinessProcessId);
                for( PbxProcess__c obj : Database.query(query + ' order by createdDate LIMIT 2000')){
                    if(obj.ChildPublishProcesses__r != null && obj.ChildPublishProcesses__r.size() > 0){
                        processSelectList.add(obj); 
                        prcMap.put(obj.id,obj); 
                        system.debug('##########prcMap'+prcMap);
                    }       
                }
            }
            //this method includes DML and now it is calling from here because now init method will not call from controller : change on 14 Nov
            insertKeyStackeholdersIfNotExist();
            main(); 
        }
        
    }
