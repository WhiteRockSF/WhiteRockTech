    }
    
    static testMethod void copyToolContentToPlayMethod()
    {
        Test.startTest();
        //PbxTool__c result = PbxProcessWebService.copyToolContentToPlay('','',0);
        //result should be null
        //System.assertEquals(result, null);
        
        PbxProcess__c process = new PbxProcess__c();
        process.ProgressThreshold__c = 70;
        process.PublishDate__c = date.newinstance(1960, 2, 17);
        process.Name__c = 'Test Process Name'; 
        process.Active__c = true;
        process.Description__c ='Process description';
        process.PlaybookEntityType__c ='Opportunity';
        //process.Points__c = 24;
        insert process;
        
        PbxPlay__c play1 = new PbxPlay__c();
        play1.Process__c = process.id;
        play1.Name__c = 'Play1 name';
        play1.Description__c = 'Play1 Description';
        play1.SortPosition__c=0;
        insert play1;
        
        PbxTool__c tool = new PbxTool__c();
        tool.Description__c = 'aaaa';
        tool.Link__c ='http://www.google.com';
        tool.Name__c ='TOOL TEST';
        tool.Play__c = play1.id;
        tool.SortPosition__c = 0;
        tool.Tip__c ='TIPPPP';
        insert tool;
        
        Id toolId = PbxProcessWebService.copyToolContentToPlay(play1.id,tool.id,2);
        PbxTool__c toolResult = [SELECT SortPosition__c, Play__c, id
                                   FROM PbxTool__c 
                                   WHERE id = :toolId];
        System.assertEquals(toolResult.SortPosition__c, 2);
        System.assertEquals(toolResult.Play__c, play1.id);
        System.assertNotEquals(toolResult.id, tool.id);
        
        try {
            toolId = PbxProcessWebService.copyToolContentToPlay(null,null,2);
        } catch (Exception e) {
            System.assertEquals(e.getMessage(),'Input Error');
        }
        
        try {
            toolId = PbxProcessWebService.copyToolContentToPlay('123','123',2);
        } catch (Exception e) {
            System.assertEquals(e.getMessage(),'PbxTool Not Found');
        }
    }
    
    static testMethod void copyQuestionContentToPlayMethod()
    {
        Test.startTest();
        //PbxQuestion__c result = PbxProcessWebService.copyQuestionContentToPlay('','',0);
        //System.assertEquals(result, null);
        
        PbxProcess__c process = new PbxProcess__c();
        process.ProgressThreshold__c = 70;
        process.PublishDate__c = date.newinstance(1960, 2, 17);
        process.Name__c = 'Test Process Name'; 
        process.Active__c = true;
        process.Description__c ='Process description';
        process.PlaybookEntityType__c ='Opportunity';
        insert process;
        
        PbxStage__c stage0 = new PbxStage__c();
        stage0.Name__c = 'stage0 name';
        stage0.Description__c = 'stage0 description';
        stage0.SortPosition__c =0;
        stage0.Process__c = process.id;
        insert stage0;
        
        PbxPlay__c play0 = new PbxPlay__c();
        play0.Process__c = process.id;
        play0.Name__c = 'Play1 name';
        play0.Description__c = 'Play1 Description';
        play0.SortPosition__c=0;
        play0.Stage__c = stage0.id;
        insert play0;
        
        PbxQuestion__c qns0 = new PbxQuestion__c();
        qns0.Process__c = process.id;
        qns0.Description__c = 'dddddddeeeeeeee';
        qns0.IncludedInExecSummary__c = false;
        qns0.Link__c ='http://www.google.com';
        qns0.Name__c ='Question1';
        qns0.Play__c = play0.id;
        qns0.Points__c = 12;
        qns0.SortPosition__c = 0;
        qns0.ResponseType__c = 'WholeNumber';
        qns0.Tip__c ='TIPPPP';
        insert qns0;
        
        PbxContentFlag__c flag = new PbxContentFlag__c();
        flag.CompareValue__c ='123';
        flag.FlagType__c ='Red';
        flag.Operation__c = '==';
        flag.Question__c = qns0.id;
        insert flag;
        
        //System.assertEquals(qns0.id, play0.id);
                
        Id qnsId = PbxProcessWebService.copyQuestionContentToPlay(play0.id,qns0.id,2);

        PbxQuestion__c qnsResult = [SELECT Id, Play__c, Name__c, Description__c, Link__c, SortPosition__c, Tip__c, IncludedInExecSummary__c, Points__c, ResponseType__c, 
                                    ( SELECT Id, Answer__c, FlagType__c, SortPosition__c, Weight__c FROM Answers__r ORDER BY SortPosition__c ASC ),
                                    ( SELECT Id, CompareValue__c, FlagType__c, Operation__c FROM ContentFlags__r )
                                   FROM PbxQuestion__c 
                                   WHERE id = :qnsId];
                                   
        System.assertEquals(qnsResult.SortPosition__c, 2);
        System.assertEquals(qnsResult.Play__c, play0.id);
        System.assertNotEquals(qnsResult.id, qns0.id);
        //ContentFlag
        System.assertEquals(qnsResult.ContentFlags__r.size(), 1);
        System.assertEquals(qnsResult.ContentFlags__r.get(0).FlagType__c, 'Red');
        System.assertNotEquals(qnsResult.ContentFlags__r.get(0).id, flag.id);           
        
        PbxQuestion__c qns1 = new PbxQuestion__c();
        qns1.Process__c = process.id;
        qns1.Description__c = 'TEST';
        qns1.IncludedInExecSummary__c = true;
        qns1.Link__c ='http://www.google.com';
        qns1.Name__c ='TEST';
        qns1.Play__c = play0.id;
        qns1.Points__c = 0;
        qns1.SortPosition__c = 1;
        qns1.ResponseType__c = 'SingleChoice';
        qns1.Tip__c ='TIPPPP';
        insert qns1;
        
        PbxAnswer__c ans20 = new PbxAnswer__c();
        ans20.Answer__c = 'Answer0';
        ans20.FlagType__c = 'Red';
        ans20.Question__c = qns1.id;
        ans20.SortPosition__c = 0;
        ans20.Weight__c = -10;
        insert ans20;
        
        Id qnsId1 = PbxProcessWebService.copyQuestionContentToPlay(play0.id,qns1.id,2);
        PbxQuestion__c qnsResult1 = [SELECT Id, Play__c, Name__c, Description__c, Link__c, SortPosition__c, Tip__c, IncludedInExecSummary__c, Points__c, ResponseType__c, 
                                    ( SELECT Id, Answer__c, FlagType__c, SortPosition__c, Weight__c FROM Answers__r ORDER BY SortPosition__c ASC ),
                                    ( SELECT Id, CompareValue__c, FlagType__c, Operation__c FROM ContentFlags__r )
                                   FROM PbxQuestion__c 
                                   WHERE id = :qnsId1];
                                   
        System.assertEquals(qnsResult1.SortPosition__c, 2);
        System.assertEquals(qnsResult1.Play__c, play0.id);
        System.assertNotEquals(qnsResult1.id, qns0.id);
        //ContentFlag
        System.assertEquals(qnsResult1.ContentFlags__r.size(), 0);
        //ContentAnswer
        System.assertEquals(qnsResult1.Answers__r.size(), 1);
        System.assertEquals(qnsResult1.Answers__r.get(0).FlagType__c, 'Red');
        System.assertNotEquals(qnsResult1.Answers__r.get(0).id, ans20.id); 
        
        
        try {
            qnsId1 = PbxProcessWebService.copyQuestionContentToPlay(null,null,2);
        } catch (Exception e) {
            System.assertEquals(e.getMessage(),'Input Error');
        }
        
        try {
            qnsId1 = PbxProcessWebService.copyQuestionContentToPlay('123','123',2);
        } catch (Exception e) {
            System.assertEquals(e.getMessage(),'List has no rows for assignment to SObject');
        }
    }
    
    
