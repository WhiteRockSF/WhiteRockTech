Name            :            TestPlaybooxBuilderDashboardController
Date            :            9 May,2016
Author          :
Description     :            This test class provide code coverage and control flow of class 'PlaybooxBuilderDashboardController'
**/
@isTest
public class TestPlaybooxBuilderDashboardController{
    
    @isTest
    private static void testFlow(){
        
        Profile p = [SELECT Id FROM Profile WHERE Name='Standard User']; 
        User u = new User(Alias = 'standt', Email='standarduser@testorg.com', 
        EmailEncodingKey='UTF-8', LastName='Testing', LanguageLocaleKey='en_US', 
        LocaleSidKey='en_US', ProfileId = p.Id,Pbx_Role__c = 'Administrator', 
        TimeZoneSidKey='America/Los_Angeles', UserName='testingUser232@testorg.com');
        
        //code to insert a record of PbxProcess__c 
        PbxProcess__c  pbxPrcs = new PbxProcess__c( name = 'Testing EnterPrise', Name__c='Testing EnterPrise', active__c=true, description__c='Testing record', ProgressThreshold__c=70, PublishDate__c= system.today(),version__C = '2');
        insert pbxPrcs;  
        
        //code to insert a record of PbxStage__c
        PbxStage__c pbxStage = new PbxStage__c(Process__c = [select id from PbxProcess__c where id=: pbxPrcs.id].id,Name__c='Testing Stage');
        insert pbxStage;
        
        //code to insert a record of PbxPlay__c
        PbxPlay__c play = new PbxPlay__c(Process__c = [select id from PbxProcess__c where id=: pbxPrcs.id].id,Name__c = 'Testing play',Stage__c = [select id from PbxStage__c where id=:pbxStage.id].id);
        insert play;
        
        //code to insert a record of PbxTool__c
        PbxTool__c tool = new PbxTool__c(Play__c = [select id from PbxPlay__c where id=: play.id].id,Name__c='Testing tool');
        insert tool;
        
        //code to insert a record of PbxMessage__c
        PbxMessage__c msg = new PbxMessage__c( Play__c = [select id from PbxPlay__c where id=: play.id].id, description__c = 'This is a Test Message', Name__c='Test Message');
        insert msg;
        
        //code to insert a record of PbxQuestion__c
        PbxQuestion__c qtns = new PbxQuestion__c(Process__c = [select id from PbxProcess__c where id=: pbxPrcs.id].id, Name__c = 'Testing question', Play__c= [select id from PbxPlay__c where id=: play.id].id);
        insert qtns;
        
        //code to insert a record of PbxAnswer__c
        PbxAnswer__c ans = new PbxAnswer__c(Name = 'Testing answer',Question__c =[select id from PbxQuestion__c where id=: qtns.id].id );
        insert ans;
        
        // code to insert a record of PbxContentFlag__c
        PbxContentFlag__c flag = new PbxContentFlag__c(Question__c=[select id from PbxQuestion__c where id=: qtns.id].id,Name = 'Testing flag');
        insert flag;
        
        System.runAs(u) {
            
            //controller variable
            PlaybooxBuilderDashboardController  classobj = new PlaybooxBuilderDashboardController();
            
            //assertion to check that controller has changed the value of insfPrivlFalse member to true
            system.assert(classobj.insfPrivlFalse==true);
            //assert that checks controller's processList congtains some records
            system.assertEquals(classobj.processList.size(),1);
            classobj.playbookIdForInactive =[select id from PbxProcess__c where id=: pbxPrcs.id].id; 
            classobj.activeInactivePlaybook();
            //assertion that verifies that the value of active__c has been updated after calling function 'activeInactivePlaybook'
            system.assertEquals([select active__c from PbxProcess__c where id=: pbxPrcs.id].active__c,false);
            classobj.processObj = new PbxProcess__c( name = 'Testing EnterPrise', Name__c='Testing EnterPrise', active__c=true, description__c='Testing record', ProgressThreshold__c=70, PublishDate__c= system.today());  
            classobj.insertProcess(); 
            //assertion checks that PbxProcess__c has been inserted successfully!!!
            system.assert([select id from PbxProcess__c where name ='Testing EnterPrise'].size()>0);
            classobj.changeProcessListOrder();
            classobj.cloneProcessId = [select id from PbxProcess__c where id=: pbxPrcs.id].id; 
            classobj.cloneExistProcess();      
        }   
    }
