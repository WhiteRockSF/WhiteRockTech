            for(PbxQuestionInstance__c obj : [select id,playInstance__r.stageInstance__c,playInstance__r.stageInstance__r.name__c,playInstance__r.name__c,name__c,description__c,(select id,answer__c,selected__c,SortPosition__c,flagtype__c,Weight__c from AnswerInstances__r order by sortPosition__c) from PbxQuestionInstance__c where processInstance__c = :processInsList.get(0).id and ResponseType__c = 'Checkbox' and IncludedInDealProgress__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c, sortPosition__c]){
                DealProgressModal mdlObj = new DealProgressModal();
                //for(PbxQuestionInstance__c obj2 : obj.)
                mdlObj.qObj = obj;
