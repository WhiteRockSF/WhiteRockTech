                }
                if(followUpSelectedFilter.equalsIgnoreCase('This Month')){
                    //processInstanceQuery += ' AND FollowUp__c = THIS_MONTH ';
                    openActivityCondition = ' activityDate = THIS_MONTH ';
                }
                //get events for open activity
                for(Event obj : Database.query('SELECT whatid from Event where ' + openActivityCondition + ' LIMIT 20000')){
                    if(obj.whatid != NULL && (String.valueOf(obj.whatid)).trim().length() > 0)  
                        opportunityIds.add(obj.whatid);
                }
                //get tasks for open activity
                for(Task obj : Database.query('SELECT whatid from Task where ' + openActivityCondition + ' LIMIT 20000')){
                    if(obj.whatid != NULL && (String.valueOf(obj.whatid)).trim().length() > 0)  
                        opportunityIds.add(obj.whatid);
                }
