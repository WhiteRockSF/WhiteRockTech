                    ansObj.weight__c = -1;
                    ansUpdateList.add(ansObj);
                }else if(quesObj.responseType__c == 'Rating' && quesObj.id != null && ((string)quesObj.id).trim().length() > 0){
                    PbxAnswer__c ansObj = new PbxAnswer__c();
