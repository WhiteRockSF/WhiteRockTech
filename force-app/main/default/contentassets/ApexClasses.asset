    public void setFormatString(String i) {
        formatString = i;
    }
    
    public String getFormattedValue() {
        return null;
    }
    
    public Integer getFormatString() {
        return Integer.valueOf(formatString==null||formatString.trim()==''?'0':formatString);
    }*/
