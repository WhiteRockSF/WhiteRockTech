     public LeadPlaymakerController(){        
        initializations();
        leadId = ApexPages.currentPage().getParameters().get('id');
        //We are fetching opportunity record below , because we are not calling init() from here now , it will be called from page after gether available stages for currect record type(SOAP API)
        //init();
        retrieveLeadRecord();
    }
    
    private void retrieveLeadRecord(){
        recordTypeFieldForQuery = '';
        //we are fetching record type infos here also because if any org has no record types for opportunity then our code will not break
        for(RecordTypeInfo info: Lead.SObjectType.getDescribe().getRecordTypeInfos()) {
            if(info.isAvailable() && !info.isMaster()) {
                recordTypeFieldForQuery = ', recordTypeId';
            }
        }     
        List<Lead> leads = Database.query('select id,name,Status,createdbyid,createdby.name,createddate,lastmodifieddate,lastmodifiedbyid,lastmodifiedby.name ' + recordTypeFieldForQuery +' from Lead where Id =: leadId');
        
        if(leads != NULL && leads.size() > 0){
            leadObj = leads.get(0);
            if(recordTypeFieldForQuery.trim().length() > 0)
              currentRecordTypeId = (String)leadObj.get('recordTypeId');
        }  
        
        System.debug('##### leadObj' + leadObj);
        System.debug('##### currentRecId' + currentRecordTypeId);
        System.debug('##### recordtypefield' + recordTypeFieldForQuery);
    }
    public void getCurrentLeadRecordType(){
        if(leadObj != NULL && leadObj.id != NULL && recordTypeFieldForQuery != NULL && recordTypeFieldForQuery.trim().length() > 0 && leadObj.get('recordtypeid') != NULL){
            for(RecordType obj : [SELECT businessProcessId, name FROM RecordType WHERE id = :(String)leadObj.get('recordTypeid')]){
                currentBusinessProcessId = obj.businessProcessId;   
            }
        }
    }
    private void initializations(){
        // initialization start
        processInsList = new List<PbxProcessInstance__c>();
        //get process instance of correspondence oppr.
        processSelectList = new List<PbxProcess__c>();
        leadStatusMap = new Map<string,Integer>();
        CMAMdlList = new List<CallManagementAssessmentModal>();
        CMDMdlList = new List<CallManagementDiscussionModal>();
        CompetitionTrainingList = new List<PbxTrainingInstance__c>();
        GeneralTrainingList = new List<PbxTrainingInstance__c>();
        IndustryTrainingList = new List<PbxTrainingInstance__c>();
        ObjHandTrainingList = new List<PbxTrainingInstance__c>();
        ProductTrainingList = new List<PbxTrainingInstance__c>();
        SuccessStoriesTrainingList = new List<PbxTrainingInstance__c>();    
        sToolsGMdlList = new List<PbxToolInstance__c>();
        sToolsComMdlList = new List<PbxToolInstance__c>();
        sToolsOMdlList = new List<PbxToolInstance__c>();
        sToolsSSMdlList = new List<PbxToolInstance__c>();
        sToolsPMdlList = new List<PbxToolInstance__c>();

        
        
        // initialization end
    }
    
    public void init(){
        showSelectPlaybook = true;
        
        retrieveLeadRecord();
        
        if(leadObj != NULL && leadObj.id != NULL && String.valueOf(leadObj.id).trim().length() > 14){
            processSelectList = new List<PbxProcess__c>();
            processInsList = new List<PbxProcessInstance__c>();
            selectedStage = leadObj.Status;
            //get process instance of correspondence oppr.
            getProcessIns();         
            system.debug('###proSize='+processInsList.size());
            // Get Current proces id to export deal summary 
            currentProcessId = ( processInsList == null || processInsList.size() == 0 ) ? '' : processInsList.get(0).Id ;                
            //fill processinstance list for select playbook if process instance not found of corresponde oppr
            if(processInsList == null || processInsList.size() == 0){
                prcMap = new Map<string,PbxProcess__c>();
                getCurrentLeadRecordType();
                String query = 'SELECT id,name,name__c, mapping__c, ProgressThreshold__c,PlaybookEntityType__c,version__c,(select id,name from ChildPublishProcesses__r LIMIT 2000) from PbxProcess__c where version__c = \'2\' and Active__c = true';
                if(currentBusinessProcessId != NULL && currentBusinessProcessId.trim().length() > 14){
                    query += ' AND businessProcessId__c = :currentBusinessProcessId ';
                }
                system.debug('##########currentBusinessProcessId=' + currentBusinessProcessId);
                for( PbxProcess__c obj : Database.query(query + ' order by createdDate LIMIT 2000')){
                    if(obj.ChildPublishProcesses__r != null && obj.ChildPublishProcesses__r.size() > 0){
                        processSelectList.add(obj); 
                        prcMap.put(obj.id,obj); 
                        system.debug('##########prcMap '+prcMap);
                    }       
                }
            }
            system.debug('##########processSelectList '+processSelectList);
            
            main(); 
        }
    }
    
    private void getProcessIns(){
        //get process instance of correspondence oppr.
        processInsList = [select id,score__c,gut_feel__c, mapping__c, ProgressThreshold__c, opportunity__r.winnabilityScore__c, Score_percent__c from PbxProcessInstance__c where Lead__c = :leadObj.id and version__c = '2' LIMIT 1];
        //used to empty error message because this method calls in saving methods
        errorMsg = '';
    }
    
     public void getDiscussionPlays(){
        CMDMdlList = new List<CallManagementDiscussionModal>(); 
        try{
            if(processInsList!= null && processInsList.size() > 0){
                    Map<string,CallManagementDiscussionModal>callManagMdlMap = new Map<string,CallManagementDiscussionModal>();
                    system.debug('## Current Stage In Discussion=' + selectedStage);
                    
                    for(PbxQuestionInstance__c obj : [select id,Tip__c,note__c,ResponseType__c, playInstance__r.sortPosition__c, playInstance__r.stageInstance__c,playInstance__r.stageInstance__r.name__c,playInstance__c,playInstance__r.name__c,name__c,description__c,(select id,answer__c,selected__c,SortPosition__c,flagtype__c,Weight__c from AnswerInstances__r order by sortPosition__c) from PbxQuestionInstance__c where processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and IncludedInDiscussion__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                        CallManagementDiscussionModal mdlObj;
                        DealProgressModal qMdlObj = new DealProgressModal();    
                        
                        qMdlObj.qObj = obj;
                        if(callManagMdlMap.containsKey(obj.playInstance__c)){
                            mdlObj = callManagMdlMap.get(obj.playInstance__c);  
                        }else{
                            mdlObj = new CallManagementDiscussionModal();   
                        }
                        //get response type for show checkbox, dropdown etc.
                        if(obj.name__c != null && dataMapResponse != null){
                            system.debug('##dataMapResponse.containsKey(obj.name__c)='+dataMapResponse.containsKey(obj.name__c) + ' + '+obj.name__c);
                            system.debug('##2dataMapResponse.containsKey(obj.name__c)='+dataMapResponse.get(obj.name__c));
                        }
                        if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'double'){
                            qMdlObj.datamapStr = 'decimal';
                        }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'date'){
                            qMdlObj.datamapStr = 'date';
                        }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'datetime'){
                            qMdlObj.datamapStr = 'datetime';
                        }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null &&  dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'text'){
                            qMdlObj.datamapStr = 'text';
                        }// to make datamap boolean shown 
                        else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null &&  dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'boolean'){
                            qMdlObj.datamapStr = 'checkbox';
                        }
                        
                        for(PbxAnswerInstance__c obj2 : obj.answerInstances__r){
                            if(obj2.answer__c != null && obj2.answer__c.trim().length() > 0){ 
                                system.debug('***********obj.ResponseType__c'+obj.ResponseType__c+'**** obj.name__c ' + obj.name__c+'**** dataMapResponse.get(obj.name__c) ' + dataMapResponse.get(obj.name__c)  + '----' + dataMapResponse.containsKey(obj.name__c) );
                                if(obj.ResponseType__c == 'Checkbox'){
                                    if(obj2.answer__c.toLowerCase() == 'true' && obj2.selected__c == true){
                                        qMdlObj.check = true;        
                                    }
                                }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'boolean'){
                                    system.debug('^^^^^^^obj.ResponseType__c'+obj.ResponseType__c+'**** obj.name__c ' + obj.name__c+'**** dataMapResponse.get(obj.name__c) ' + dataMapResponse.get(obj.name__c)  + '----' + dataMapResponse.containsKey(obj.name__c) );
                                    if(obj2.answer__c.toLowerCase() == 'true' && obj2.selected__c == true){
                                        qMdlObj.check = true;
                                        qMdlObj.datamapStr = 'checkbox';        
                                    }
                                
                                }else if(obj.ResponseType__c == 'SingleChoice'){
                                    qMdlObj.choice.add(new selectoption(obj2.answer__c,obj2.answer__c));
                                    if(obj2.selected__c){
                                        qMdlObj.selectedSChoice = obj2.answer__c;
                                        qMdlObj.selectedSChoiceRedFlag = obj2.FlagType__c == 'Red' ? true : false;   
                                    }   
                                }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null &&  dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'picklist'){
                                    qMdlObj.choice.add(new selectoption(obj2.answer__c,obj2.answer__c));
                                    if(obj2.selected__c){
                                        qMdlObj.selectedSChoice = obj2.answer__c;
                                        qMdlObj.selectedSChoiceRedFlag = obj2.FlagType__c == 'Red' ? true : false;    
                                    }
                                    qMdlObj.datamapStr = 'singlechoice';    
                                }else if(obj.ResponseType__c == 'MultiChoice'){
                                    qMdlObj.choice.add(new selectoption(obj2.answer__c,obj2.answer__c));    
                                    if(obj2.selected__c){
                                        qMdlObj.selectedMChoice.add(obj2.answer__c);
                                        qMdlObj.selectedMChoiceRedFlagMap.put(obj2.answer__c, obj2.FlagType__c == 'Red' ? true : false);    
                                    }
                                }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'multipicklist'){
                                    qMdlObj.choice.add(new selectoption(obj2.answer__c,obj2.answer__c));    
                                    if(obj2.selected__c){
                                        qMdlObj.selectedMChoice.add(obj2.answer__c);    
                                        qMdlObj.selectedMChoiceRedFlagMap.put(obj2.answer__c, obj2.FlagType__c == 'Red' ? true : false);
                                    }
                                    qMdlObj.datamapStr = 'multichoice';
                                }else if(obj.ResponseType__c == 'Rating'){
                                    qMdlObj.choice.add(new selectoption(obj2.answer__c,obj2.answer__c));    
                                    if(obj2.selected__c){
                                        qMdlObj.selectedRating = obj2.answer__c;    
                                    }
                                }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'double'){
                                    qMdlObj.text = obj2.answer__c;
                                    qMdlObj.datamapStr = 'decimal';
                                }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'date'){
                                    qMdlObj.text = obj2.answer__c;
                                    qMdlObj.datamapStr = 'date';
                                }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'datetime'){
                                    qMdlObj.text = obj2.answer__c;
                                    qMdlObj.datamapStr = 'datetime';
                                }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null &&  dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'text'){
                                    qMdlObj.text = obj2.answer__c;
                                    qMdlObj.datamapStr = 'text';
                                }else{
                                    qMdlObj.text = obj2.answer__c;
                                    
                                }
                                system.debug('##ansObjAfterFill'+ obj2);
                            }
                        }
                        
                    
                        system.debug('##qMdlObj1='+ qMdlObj);
                        mdlObj.playName = obj.playInstance__r.name__c;
                        mdlObj.playSortOrder = obj.playInstance__r.sortPosition__c;
                        mdlObj.qList.add(qMdlObj);
                        callManagMdlMap.put(obj.playInstance__c,mdlObj);
                    }
                    
                    for(PbxMessageInstance__c obj : [select id,Tip__c, playInstance__r.sortPosition__c, playInstance__r.stageInstance__c,playInstance__r.stageInstance__r.name__c,playInstance__c,playInstance__r.name__c,name__c,description__c from PbxMessageInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and IncludedInDiscussion__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                        CallManagementDiscussionModal mdlObj;   
                        if(callManagMdlMap.containsKey(obj.playInstance__c)){
                            mdlObj = callManagMdlMap.get(obj.playInstance__c);  
                        }else{
                            mdlObj = new CallManagementDiscussionModal();   
                        }
                        mdlObj.playName = obj.playInstance__r.name__c;
                        mdlObj.playSortOrder = obj.playInstance__r.sortPosition__c;
                        mdlObj.msgList.add(obj);
                        callManagMdlMap.put(obj.playInstance__c,mdlObj);
                    }
                    //Call Management Discussion tools
                    for(PbxToolInstance__c obj : [select id,Tip__c, playInstance__r.sortPosition__c, playInstance__r.stageInstance__c,playInstance__r.stageInstance__r.name__c,playInstance__c,playInstance__r.name__c,name__c,description__c,link__c from PbxToolInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInCallManagementDiscussion__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                        CallManagementDiscussionModal mdlObj;
                        if(callManagMdlMap.containsKey(obj.playInstance__c)){
                            mdlObj = callManagMdlMap.get(obj.playInstance__c);
                        }else{
                            mdlObj = new CallManagementDiscussionModal();
                        }
                        system.debug('####testPlay='+obj.playInstance__r.name__c);
                        mdlObj.playName = obj.playInstance__r.name__c;
                        mdlObj.playSortOrder = obj.playInstance__r.sortPosition__c;
                        mdlObj.toolList.add(obj);
                        callManagMdlMap.put(obj.playInstance__c,mdlObj);
                        
                    }
                    //Call Management Discussion training
                    for(PbxTrainingInstance__c obj : [select id,Tip__c, playInstance__r.sortPosition__c, playInstance__r.stageInstance__r.processInstance__c,playInstance__r.stageInstance__c,playInstance__r.stageInstance__r.name__c,playInstance__c,playInstance__r.name__c,name__c,description__c,link__c from PbxTrainingInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInCallManagementDiscussion__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                        CallManagementDiscussionModal mdlObj;
                        if(callManagMdlMap.containsKey(obj.playInstance__c)){
                            mdlObj = callManagMdlMap.get(obj.playInstance__c);
                        }else{
                            mdlObj = new CallManagementDiscussionModal();
                        }
                        system.debug('####testPlay='+obj.playInstance__r.name__c);
                        mdlObj.playName = obj.playInstance__r.name__c;
                        mdlObj.playSortOrder = obj.playInstance__r.sortPosition__c;
                        mdlObj.trainingList.add(obj);
                        callManagMdlMap.put(obj.playInstance__c,mdlObj);
                        
                    }
                    
                    if(callManagMdlMap.size() > 0){
                        CMDMdlList.addAll(callManagMdlMap.values());    
                        //Manual sorting operation because we have fetched all plays by SOQL on different objects
                        for(Integer outerCounter = 0; outerCounter < CMDMdlList.size(); outerCounter++){
                            for(Integer innerCounter = outerCounter + 1; innerCounter < CMDMdlList.size(); innerCounter++){
                                CallManagementDiscussionModal swapObj;
                                if(CMDMdlList[outerCounter].playSortOrder > CMDMdlList[innerCounter].playSortOrder){
                                    swapObj = CMDMdlList[outerCounter];
                                    CMDMdlList[outerCounter] = CMDMdlList[innerCounter];
                                    CMDMdlList[innerCounter] = swapObj;
                                }
                            }   
                        }
                    }
                    system.debug('##CMDMdlList=' +CMDMdlList);
            }
        }catch(Exception e){
            system.debug('Exception ==>'+e.getMessage());
        }
    }
    
