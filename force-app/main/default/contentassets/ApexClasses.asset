    static testMethod void testPbxControllerMethod()
    {
        PbxController controller = new PbxController();
        
        System.assertEquals(controller.getEntityType(),'Opportunity');
        
        ApexPages.currentPage().getParameters().put('type', 'LEAD');
        System.assertEquals(controller.getEntityType(),'Lead');
        
        ApexPages.currentPage().getParameters().put('type', 'aCcOuNt');
        System.assertEquals(controller.getEntityType(),'Account');
        
        System.assertEquals(controller.getDeepLinkParameter(),'');
        
        //Test for deeplink opportunity
        Opportunity opp = new Opportunity();
        opp.Name='test';
        opp.CloseDate = Date.today();
        opp.StageName= 'Prospect/Client Presentation'; 
        insert opp;
        
        //Test for account
        Account acc = new Account();
        acc.Name = 'test';
        insert acc;
        
        //Test for lead
        Lead lead = new Lead();
        lead.FirstName = 'Joe'; 
        lead.LastName ='Smith'; 
        lead.LeadSource = 'API';
        lead.Company = 'TEST COMPANY';
        insert lead;
        
        PbxProcessInstance__c pi = new PbxProcessInstance__c();
        pi.Account__c = acc.id;
        pi.Lead__c = lead.id;
        pi.Opportunity__c = opp.id;
        pi.Name__c = 'test';
        insert pi;
        
        ApexPages.currentPage().getParameters().put('type', 'aCcOuNt');
        ApexPages.currentPage().getParameters().put('id', acc.id);
        System.assertEquals(controller.getDeepLinkParameter(),'&piId=' +pi.id);
        
        ApexPages.currentPage().getParameters().put('type', 'lead');
        ApexPages.currentPage().getParameters().put('id', lead.id);
        System.assertEquals(controller.getDeepLinkParameter(),'&piId=' +pi.id);
        
        ApexPages.currentPage().getParameters().put('type', 'opportunity');
        ApexPages.currentPage().getParameters().put('id', opp.id);
        System.assertEquals(controller.getDeepLinkParameter(),'&piId=' +pi.id);
        
        //Test2 for account
        Account acc2 = new Account();
        acc2.Name = 'test2';
        insert acc2;
        
        ApexPages.currentPage().getParameters().put('id', acc2.id);
        ApexPages.currentPage().getParameters().put('type', 'aCcOuNt');
        System.assertEquals(controller.getDeepLinkParameter(),'&entityId=' +acc2.id);
    }
    
