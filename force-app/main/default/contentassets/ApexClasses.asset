                    ansObj = new PbxAnswer__c();
                    ansObj.name = 'Negative';
                    ansObj.answer__c = 'Negative';
                    ansObj.question__c = quesObj.id;
                    ansUpdateList.add(ansObj);
                }
                List<PbxAnswer__c> ansDelList = [select id from PbxAnswer__c where question__c = :quesObj.id];
                if(ansDelList != null && ansDelList.size() > 0){
                    delete ansDelList;
                }
                if(ansUpdateList.size() > 0){
                    insert ansUpdateList;
                }
                //initializations();
                
