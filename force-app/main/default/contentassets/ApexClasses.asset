    public pagereference publishPlaybook(){
        system.debug('##publishPlaybookIN');
        try{
            if(processObj != null && ((string)processObj.Id).trim().length() > 0){
                processObj.publishDate__c = system.now();
                
                update processObj;
                List<PbxProcess__c>tempPList = new List<PbxProcess__c>();
                tempPList = [select id,name,Active__c,description__c,publishdate__c,Points__c,ProgressThreshold__c from PbxProcess__c where ParentPublishProcess__c = :processId];
                if(tempPList != null && tempPList.size() > 0){
                    delete tempPList;   
                }
                PbxProcess__c childPObj = processObj.clone();
                childPObj.name = 'PP' +  childPObj.name;
                childPObj.ParentPublishProcess__c  = processObj.id;
                childPObj.name__c = childPObj.name;
                insert childPObj;
                
                return new pagereference('/apex/PlaybooxBuilderDashboard').setRedirect(true);   
            }
        }catch(Exception e){
            system.debug('Exception==>'+ e.getMessage());
        }
        return null;    
    }
    
