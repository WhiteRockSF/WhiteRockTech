                    }
                    //Call Management Discussion tools
                    for(PbxToolInstance__c obj : [select id,Tip__c, playInstance__r.sortPosition__c, playInstance__r.stageInstance__c,playInstance__r.stageInstance__r.name__c,playInstance__c,playInstance__r.name__c,name__c,description__c,link__c from PbxToolInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInCallManagementDiscussion__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                        CallManagementDiscussionModal mdlObj;
                        if(callManagMdlMap.containsKey(obj.playInstance__c)){
                            mdlObj = callManagMdlMap.get(obj.playInstance__c);
