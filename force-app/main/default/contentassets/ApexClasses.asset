                        mdlObj.playName = obj.playInstance__r.name__c;
                        mdlObj.playSortOrder = obj.playInstance__r.sortPosition__c;
                        mdlObj.toolList.add(obj);
                        callManagMdlMap.put(obj.playInstance__c,mdlObj);
                        
                    }
                    //Call Management Discussion training
                    for(PbxTrainingInstance__c obj : [select id,Tip__c, playInstance__r.sortPosition__c, playInstance__r.stageInstance__r.processInstance__c,playInstance__r.stageInstance__c,playInstance__r.stageInstance__r.name__c,playInstance__c,playInstance__r.name__c,name__c,description__c,link__c from PbxTrainingInstance__c where playInstance__r.stageInstance__r.processInstance__c = :processInsList.get(0).id and playInstance__r.stageInstance__r.name__c = :selectedStage and  IncludedInCallManagementDiscussion__c = true order by playInstance__r.stageInstance__r.sortPosition__c,playInstance__r.sortPosition__c,sortPosition__c]){
                        CallManagementDiscussionModal mdlObj;
                        if(callManagMdlMap.containsKey(obj.playInstance__c)){
                            mdlObj = callManagMdlMap.get(obj.playInstance__c);
                        }else{
                            mdlObj = new CallManagementDiscussionModal();
                        }
                        system.debug('####testPlay='+obj.playInstance__r.name__c);
                        mdlObj.playName = obj.playInstance__r.name__c;
                        mdlObj.playSortOrder = obj.playInstance__r.sortPosition__c;
                        mdlObj.trainingList.add(obj);
                        callManagMdlMap.put(obj.playInstance__c,mdlObj);
                        
                    }
                    
                    if(callManagMdlMap.size() > 0){
                        CMDMdlList.addAll(callManagMdlMap.values());    
                        //Manual sorting operation because we have fetched all plays by SOQL on different objects
                        for(Integer outerCounter = 0; outerCounter < CMDMdlList.size(); outerCounter++){
                            for(Integer innerCounter = outerCounter + 1; innerCounter < CMDMdlList.size(); innerCounter++){
                                CallManagementDiscussionModal swapObj;
                                if(CMDMdlList[outerCounter].playSortOrder > CMDMdlList[innerCounter].playSortOrder){
                                    swapObj = CMDMdlList[outerCounter];
                                    CMDMdlList[outerCounter] = CMDMdlList[innerCounter];
                                    CMDMdlList[innerCounter] = swapObj;
                                }
                            }   
                        }
                    }
                    system.debug('##CMDMdlList=' +CMDMdlList);
            }
        }catch(Exception e){
            system.debug('Exception ==>'+e.getMessage());
        }
    }
    
