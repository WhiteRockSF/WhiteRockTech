    public void insertKeyStackeholder(){
        system.debug('###stackeholder INN0');
        try{
            if(oppObj != null && processInsList != null && processInsList.size() > 0){
                system.debug('###stackeholder INN1');
                if(PIContactInsertObj.contact__c != null && PIContactInsertObj.role__c != null){
                    opportunityContactRole OCRObj = new opportunityContactRole();
                    OCRObj.contactid = PIContactInsertObj.contact__c;
                    OCRObj.role = PIContactInsertObj.role__c;
                    OCRObj.opportunityid = oppObj.id;
                    system.debug('###stackeholder INN2');
                    insert OCRObj;  
                }
                PIContactInsertObj.processInstance__c = processInsList.get(0).id;
                insert PIContactInsertObj;
                
                main(); 
            }
        }catch(Exception e){
            system.debug('Exception ==>'+e.getMessage());   
        }   
    }
    
    public void insertNote(){
        system.debug('###note INN');
        try{
            if(oppObj != null && noteInsertObj != null && noteInsertObj.title != null && noteInsertObj.title.trim().length() > 0){
                noteInsertObj.parentId = oppObj.id;
                insert noteInsertObj;
                
                main();  
            }
        }catch(Exception e){
            system.debug('Exception ==>'+e.getMessage());   
        }
    }
    
    public void insertTask(){
        system.debug('###task INN');
        try{
            if(oppObj != null && taskInsertObj != null){
                taskInsertObj.whatId = oppObj.id;
                taskInsertObj.ownerId = UserInfo.getUserId();
                if(taskRemDateTimeStr != null && taskRemDateTimeStr.trim().length() > 0){
                    taskInsertObj.reminderDateTime = DateTime.parse(taskRemDateTimeStr);
                }
                insert taskInsertObj;
                
                main();  
            }
        }catch(Exception e){
            system.debug('Exception ==>'+e.getMessage());   
        }
    }
    
    public void insertMeetEvent(){
        system.debug('###event INN');
        try{
            if(oppObj != null && evntMeetInsertObj != null){
                evntMeetInsertObj.whatId = oppObj.id;
                evntMeetInsertObj.ownerId = UserInfo.getUserId();
                
                if(meetStartDateTimeStr != null && meetStartDateTimeStr.trim().length() > 0){
                    evntMeetInsertObj.startDateTime = DateTime.parse(meetStartDateTimeStr);     
                }
                if(meetEndDateTimeStr != null && meetEndDateTimeStr.trim().length() > 0){
                    evntMeetInsertObj.endDateTime = DateTime.parse(meetEndDateTimeStr);     
                }
                insert evntMeetInsertObj;
                
                main();  
            }
        }catch(Exception e){
            system.debug('Exception ==>'+e.getMessage());   
        }
    }
    
    public void insertCompetitor(){
        try{
            if(oppObj != null){
                if(competitorInsertObj.competitorName != null && competitorInsertObj.competitorName.trim().length() > 0){
                    competitorInsertObj.opportunityid = oppObj.id;
                    insert competitorInsertObj;     
                    main(); 
                }
            }
        }catch(Exception e){
            system.debug('Exception ==>' + e.getMessage()); 
        }
    }
    public pagereference sendMail(){
        try{
            List<Messaging.SingleEmailMessage> emailList = new List<Messaging.SingleEmailMessage>();
                
            if(mailRecpt != null && mailRecpt.trim().length() > 0 && oppObj != null){
                Messaging.SingleEmailMessage email = new Messaging.SingleEmailMessage();
                
                if(mailAttc.name != null && mailAttc.name.trim().length() > 0 && mailAttc.body != null){
                    Messaging.EmailFileAttachment efa1 = new Messaging.EmailFileAttachment();
                    efa1.setFileName(mailAttc.name);
                    efa1.setBody(mailAttc.body);
                    email.setFileAttachments(new Messaging.EmailFileAttachment[] {efa1});
                }
                        
                String addresses;
                if(mailSubject != null && mailSubject.trim().length() > 0){
                    email.setSubject( mailSubject );
                }
                email.setToAddresses( mailRecpt.split(','));
                if(mailBody != null && mailBody.trim().length() > 0){
                    email.setPlainTextBody(mailBody);
                }
                emailList.add(email);
            }
            if(emailList.size() > 0){
                Messaging.SendEmailResult [] mailResult = Messaging.sendEmail(emailList);
                if(mailResult[0].isSuccess()){
                    Task tObj = new Task();
                    tObj.subject = 'Email: ';
                    if(mailSubject != null && mailSubject.trim().length() > 0){
                        tObj.subject += mailSubject;
                    }
                    tObj.description = 'Addition To : '+ mailRecpt + '\n';
                    tObj.description += 'CC: \n';
                    tObj.description += 'BCC: \n';
                    tObj.description += 'Attachment: \n\n';
                    tObj.description += 'Subject: '+ mailSubject + '\n';
                    tObj.description += 'Body: \n';
                    tObj.description += mailBody;
                    
                    tObj.activityDate = system.today();
                    tObj.status = 'Completed';
                    tObj.whatId = oppObj.id;
                    tObj.priority = 'Normal';
                    tObj.ownerid = UserInfo.getUserId();
                    
                    insert tObj;
                    
                    if(tObj.id != null && mailAttc.name != null && mailAttc.name.trim().length() > 0 && mailAttc.body != null){
                        mailAttc.parentid = tObj.id;
                        insert mailAttc;
                        
                    }
                }
                mailAttc = new attachment();
                mailRecpt = '';
                mailSubject = '';
                mailBody = '';
                //return new pagereference('/apexpage'+ oppObj.id + '?email=sent&assessSec='+expandClassAssStr + '&disSec=' + expandClassDisStr);    
                
            }
        }catch(Exception e){
            system.debug('Exception ==>'+e.getMessage());
        }
        sentEmail = true;
        return null;    
    }
    
