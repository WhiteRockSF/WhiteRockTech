"01p15000006akBrAAI","","testPbxTriggers","25.0","Active","false","2.844114557E9","@isTest
private class testPbxTriggers
{
    static testMethod void testOpportunityTriggerMethod()
    {
        Opportunity o = new Opportunity();
        o.Name = 'Test Job';
        o.Probability = 50;
        o.StageName = 'Prospect';
        o.CloseDate = System.today();
        
        insert o;
    
        PbxProcessInstance__c pi = new PbxProcessInstance__c();
        pi.Name__c = 'Test ProcessInstance Name'; 
        pi.Opportunity__c = o.id;
        pi.PlaybookEntityType__c = 'Opportunity';
        
        insert pi;
        
        Test.startTest();
        delete o;
        
        List< PbxProcessInstance__c > results = [SELECT id FROM PbxProcessInstance__c WHERE id = :pi.id];
        
        System.assertEquals(results.size(), 0);
    }
    
    static testMethod void testUpdatePlaybookEntityAfterUpdateMethod()
    {
        Opportunity o = new Opportunity();
        o.Name = 'Test Job';
        o.Probability = 50;
        o.StageName = 'Prospect';
        o.CloseDate = System.today();
        
        insert o;
    
        PbxProcessInstance__c pi = new PbxProcessInstance__c();
        pi.Name__c = 'Test ProcessInstance Name'; 
        pi.Opportunity__c = o.id;
        pi.PlaybookEntityType__c = 'Opportunity';
        
        insert pi;
        
        PbxQuestionInstance__c qi = new PbxQuestionInstance__c();
        qi.ProcessInstance__c = pi.id;
        insert qi;
        
        PbxAnswerInstance__c ai = new PbxAnswerInstance__c();
        ai.QuestionInstance__c = qi.id;
        ai.FlagType__c = 'Red';
        ai.Selected__c = true;
        ai.Weight__c = 10;
        ai.Answer__c = 'Test';
        
        insert ai;
        
        pi.Name__c = 'Update ProcessInstance Test';
        update pi;
        
        Opportunity op = [SELECT WinnabilityScore__c, RedFlagCount__c FROM Opportunity WHERE id = :o.id];
        PbxProcessInstance__c testPi = [SELECT Score__c, RedFlagCount__c FROM PbxProcessInstance__c WHERE id=:pi.id];
        
        System.assertEquals(op.WinnabilityScore__c, testPi.Score__c);
        System.assertEquals(op.RedFlagCount__c, testPi.RedFlagCount__c);
    }
    
    static testMethod void testUpdatePlaybookEntityBeforeDeleteMethod()
    {
        Opportunity o = new Opportunity();
        o.Name = 'Test Job';
        o.Probability = 50;
        o.StageName = 'Prospect';
        o.CloseDate = System.today();
        o.PlaybookName__c = 'test';
        o.WinnabilityScore__c = 100;
        o.RedFlagCount__c = 5;
        
        insert o;
    
        PbxProcessInstance__c pi = new PbxProcessInstance__c();
        pi.Name__c = 'Test ProcessInstance Name'; 
        pi.Opportunity__r = o;
        pi.PlaybookEntityType__c = 'Opportunity';
        insert pi;
        
        Test.startTest();
        delete pi;
        
        Opportunity op = [SELECT WinnabilityScore__c, RedFlagCount__c, PlaybookName__c FROM Opportunity WHERE id = :o.id];
        //System.assertEquals(op.WinnabilityScore__c, 0);
        //System.assertEquals(op.RedFlagCount__c, 0);
        //System.assertEquals(op.PlaybookName__c, '');   
    }
        
