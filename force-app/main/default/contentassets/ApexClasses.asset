    private void fillOpportunityFieldsMap(){
      oppFieldMap = new Map<string,SObjectField>();
      
      //13th feb to correct the logic and make dynamic for datamap
      if(processObj.PlaybookEntityType__c == 'Lead')
          oppFieldMap = Schema.SObjectType.Lead.fields.getMap();
      else
          oppFieldMap = Schema.SObjectType.opportunity.fields.getMap();
    }
    public void fillStageSortPositionMap(){
      stageSortMap = new Map<String,Integer>();
        if(processObj.PlaybookEntityType__c == 'Lead')
            for(LeadStatus obj : [select masterLabel,sortOrder from LeadStatus LIMIT 1000])
                stageSortMap.put(obj.masterLabel,obj.sortOrder);
        else
            for(opportunityStage obj : [select masterLabel,sortOrder from opportunityStage LIMIT 1000])
                stageSortMap.put(obj.masterLabel,obj.sortOrder);
    }
