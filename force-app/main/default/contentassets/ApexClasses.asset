        parentProcess.Name__c = 'Test Process Name'; 
        parentProcess.ProgressThreshold__c = 0;
        insert parentProcess;
        
        process.ParentPublishProcess__c = parentProcess.id;
        process.PublishDate__c = date.newinstance(1960, 2, 17);
        
        update process;
        // End of Dummy Data
        
        Test.startTest();
        LIST<String> resultIdList = PbxProcessWebService.publishOpportunity(process.id,opportunityIds);
        String resultId = resultIdList.get(0);
        //result Id not null
        System.assertNotEquals(resultId, null);
        
        Opportunity saveOpp = [SELECT PlaybookName__c, RedFlagCount__c, WinnabilityScore__c, StageName
                               FROM Opportunity];
        
        PbxProcessInstance__c clone = [SELECT id, Name__c, CurrentStage__r.Name__c, Opportunity__c
                                       FROM PbxProcessInstance__c WHERE id = :resultId];

        //Check if new clone is created
        System.assertNotEquals(clone, null);
        
        //Check if ProcessInstance is link to Opportunity
        System.assertEquals(clone.Opportunity__c, opp.id);
        
        //Check if Opportunity PlaybookName is reset
        System.assertEquals(saveOpp.PlaybookName__c, clone.Name__c);

        //Check if Opportunity RedFlagCount__c is reset
        System.assertEquals(saveOpp.RedFlagCount__c, 0);
        
        //Check if Opportunity WinnabilityScore__c is reset
        System.assertEquals(saveOpp.WinnabilityScore__c, 0); 
        
        //Check if Opportunity.StageName is the same as ProcessInstance CurrentStage is reset
        System.assertEquals(saveOpp.StageName, clone.CurrentStage__r.Name__c);        
       
       
        PbxProcessWebService.pushDealNoteToChatter(saveOpp.Id, 'test');
       
        List<String> fake = new List<String>();
        fake.add('123');
        try {
            resultIdList = PbxProcessWebService.publishOpportunity(process.id,fake);
        } catch (Exception e) {
            System.assertEquals(e.getMessage(),'123');
        }
        
        try {
            resultIdList = PbxProcessWebService.publishOpportunity('33',opportunityIds);

        } catch (Exception e) {

            System.assertEquals(e.getMessage().containsAny('Invalid id: List has no rows for assignment to SObject'),true);
        }

    }

    static testMethod void playbookPublishProcessMethod()
    {
        Map<String, SObject> data = getProcessTreeDummyData();
        PbxProcess__c process = (PbxProcess__c) data.get('process');
        
        PbxProcess__c parentProcess = new PbxProcess__c();
        parentProcess.Name__c = 'Test Process Name'; 
        parentProcess.ProgressThreshold__c = 0;
        insert parentProcess;
        
        process.ParentPublishProcess__c = parentProcess.id;
        process.PublishDate__c = date.newinstance(1960, 2, 17);
        
        update process;
                
        Test.startTest();
        LIST<String> resultIdList = PbxProcessWebService.publishPlaybookProcess(process.id,6);
        String resultId = resultIdList.get(0);
        //result Id not null
        System.assertNotEquals(resultId, null);
        //result Id not equal to process Id
        System.assertNotEquals(resultId, process.id);
        
        PbxProcessInstance__c clone = [SELECT id FROM PbxProcessInstance__c WHERE id = :resultId];
        //Check if new clone is created
        System.assertNotEquals(clone, null);
        
        List<PbxStageInstance__c>stages = [SELECT id, Name__c FROM PbxStageInstance__c WHERE ProcessInstance__c = :resultId ORDER BY SortPosition__c];
        //Check if two stage is created
        System.assertEquals(2, stages.size());
        
        //Check if stage one is clone.
        System.assertEquals(stages.get(0).Name__c, ((PbxStage__c)data.get('stage0')).Name__c);
        
        List<PbxPlayInstance__c>plays = [SELECT Name__c FROM PbxPlayInstance__c WHERE StageInstance__c = :stages.get(0).Id ORDER BY SortPosition__c];
        //Check if one play is created
        System.assertEquals(1, plays.size());
        //Check if play one is clone.
        System.assertEquals(plays.get(0).Name__c, ((PbxPlay__c) data.get('play00')).Name__c);        
        
        List<PbxMessageInstance__c>msgs = [SELECT Link__c FROM PbxMessageInstance__c WHERE PlayInstance__c = :plays.get(0).Id];
        //Check if one play is created
        System.assertEquals(1, msgs.size());
        //Check if play one is clone.
        System.assertEquals(msgs.get(0).Link__c, ((PbxMessage__c) data.get('msg000')).Link__c);        
        
        List<PbxToolInstance__c>tools = [SELECT Link__c FROM PbxToolInstance__c WHERE PlayInstance__r.StageInstance__c = :stages.get(1).Id];
        //Check if one play is created
        System.assertEquals(1, tools.size());
        //Check if play one is clone.
        System.assertEquals(tools.get(0).Link__c, ((PbxTool__c) data.get('tool100')).Link__c);          

        List<PbxQuestionInstance__c>question0s = [SELECT HighestScore__c ,Link__c FROM PbxQuestionInstance__c WHERE PlayInstance__r.StageInstance__c = :stages.get(1).Id ORDER BY SortPosition__c];
        //Check if one play is created
        //Single select question.
        System.assertEquals(3, question0s.size());
        System.assertEquals(0.40, question0s.get(0).HighestScore__c);
        //Check if play one is clone.
        System.assertEquals(question0s.get(0).Link__c, ((PbxQuestion__c) data.get('qns101')).Link__c);
        
        List<PbxAnswerInstance__c>answers = [SELECT Answer__c FROM PbxAnswerInstance__c WHERE QuestionInstance__c = :question0s.get(0).Id ORDER BY SortPosition__c];
        //Check if one play is created
        System.assertEquals(2, answers.size());
        //Check if play one is clone.
        System.assertEquals(answers.get(0).Answer__c, ((PbxAnswer__c) data.get('ans1010')).Answer__c);   
        
        List<PbxQuestionInstance__c>question1s = [SELECT Link__c FROM PbxQuestionInstance__c WHERE PlayInstance__c = :plays.get(0).Id];
        //Check if one play is created
        System.assertEquals(1, question1s.size());
        //Check if play one is clone.
        System.assertEquals(question1s.get(0).Link__c, ((PbxQuestion__c)data.get('qns001')).Link__c);

        List<PbxContentFlagInstance__c>flags = [SELECT Operation__c FROM PbxContentFlagInstance__c WHERE QuestionInstance__c = :question1s.get(0).Id];
        //Check if one play is created
        System.assertEquals(1, flags.size());
        //Check if play one is clone.
        System.assertEquals(flags.get(0).Operation__c, ((PbxContentFlag__c)data.get('flag0010')).Operation__c);
        
        try {
            resultIdList = PbxProcessWebService.publishPlaybookProcess('33',6);

        } catch (Exception e) {
            System.assertEquals(e.getMessage().contains('Invalid id: List has no rows for assignment to SObject'),true);
        }
    }
    static testMethod void cloneFullProcessTreeMethod()
    {
