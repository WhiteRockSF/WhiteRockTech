    public pagereference insertTool(){
        system.debug('##insertToolIN='+contVersion);
        system.debug('##selectedToolStr='+selectedToolStr);
        
        try{
            if(processObj != null && ((string)processObj.Id).trim().length() > 0 && playObjIdForUpdate != null && playObjIdForUpdate.trim().length() > 0){
                if(toolObj.id == null || ((string)toolObj.id).trim().length() == 0){
                    toolObj.play__c = playObjIdForUpdate;
                }
                if(previousStoredLink != toolObj.link__c && selectedToolStr == 'link'){
                    toolObj.documentId__c = null;
                    toolObj.workspaceId__c = null;
                }
                if(selectedToolStr != null && selectedToolStr == 'upload' && contVersion.versionData != null && contVersion.versionData.size() > 0 && contVersion.title != null && contVersion.title.trim().length() > 0){
                    contVersion.pathOnClient=contVersion.title;
                    if(selectedLibId !=  null && selectedLibId.trim().length() > 0){
                        contVersion.FirstPublishLocationID = selectedLibId; 
                    }else{
                        contVersion.FirstPublishLocationID = UserInfo.getUserId();
                    }
                    insert contVersion;
                    
                    if(contVersion.id != null && ((string)contVersion.id).trim().length() > 0){
                        toolObj.documentId__c = contVersion.id;
                        toolObj.workspaceId__c = contVersion.FirstPublishLocationID;
                        toolObj.link__c = System.URL.getSalesforceBaseUrl().toExternalForm() + '/' +contVersion.id;     
                    }
                }else if(selectedToolStr != null && selectedToolStr == 'content'){
                    toolObj.documentId__c = selectedContentId;
                    toolObj.workspaceId__c = selectedLibId;
                    toolObj.link__c = System.URL.getSalesforceBaseUrl().toExternalForm() + '/' + selectedContentId;
                }else if(selectedToolStr != null && selectedToolStr == 'library'){
                    toolObj.documentId__c = null;
                    toolObj.workspaceId__c = selectedLibId;
                    toolObj.link__c = System.URL.getSalesforceBaseUrl().toExternalForm() + '/' + selectedLibId;
                }
                if(toolObj.id != null && ((string)toolObj.id).trim().length() > 0){
                    update toolObj;
                }else{
                    insert toolObj; 
                }
            }
        }catch(Exception e){
            system.debug('Exception==>'+ e.getMessage());
        }
        return new pagereference('/apex/PlaybooxBuilder?id='+processId + '&playid='+playObjIdForUpdate).setRedirect(true);
    }
    
