"01p15000006zG2cAAE","","TestUpdateSortPositionMessage","36.0","Active","false","8.61622482E8","/*
        Name        :    TestUpdateSortPositionMessage
        Date        :    12 May 2016
        Author      :
        Description :    
*/
@isTest
public Class TestUpdateSortPositionMessage{
    static testMethod void unitTest1(){
        PbxProcess__c process = TestCoverageUtility.createPbxProcess(70,'test');
        insert process;
        
        PbxStage__c Stage = TestCoverageUtility.createPbxStage('testStage',process.id);
        insert stage;
        
        PbxPlay__c play = TestCoverageUtility.createPbxPlay('test play',process.id,stage.id);
        insert play;
        
        PbxMessage__c msg = TestCoverageUtility.createPbxMessage('test Message','test description',play.id);
        insert msg;
        
        system.assertEquals([select id,sortPosition__c from PbxMessage__c where id =:msg.id].sortPosition__c,0);
        
        PbxMessage__c msgs = TestCoverageUtility.createPbxMessage('test Message','test description',play.id);
        msgs.sortPosition__c = 6;
        insert msgs;
        
        system.assertEquals([select id,sortPosition__c from PbxMessage__c where id =:msgs.id].sortPosition__c,7);
        
        delete msg;
        system.assertEquals([select id,sortPosition__c from PbxMessage__c where id =:msgs.id].sortPosition__c,6);
    }
