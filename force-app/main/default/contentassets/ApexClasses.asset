"01p150000074tM9AAI","","LeadPlaymakerPDFController","39.0","Active","false","1.720233941E9","public with sharing class LeadPlaymakerPDFController {

  
    private PbxProcessInstance__c pi;
    //private Opportunity opp;
    private Lead leadObj;
    private List<Note> notes = new List<Note>();
    private List<PbxQuestionInstance__c> qis = new List<PbxQuestionInstance__c>();
    private List<PbxQuestionInstance__c> qis_assessment = new List<PbxQuestionInstance__c>();
    private List<PbxQuestionInstance__c> qis_discussion = new List<PbxQuestionInstance__c>();
   // private List<PbxProcessInstanceContact__c> contacts = new List<PbxProcessInstanceContact__c>();
    private String formatString = '';

    public LeadPlaymakerPDFController() {
        String value = ApexPages.currentPage().getParameters().get('processInstanceId');
        
        List<PbxProcessInstance__c> piList = [SELECT Id, Name__c, Score__c, Score_percent__c, FollowUp__c, RedFlagCount__c, Account__r.Name, Opportunity__c, Lead__c, ProgressThreshold__c, Mapping__c,
                (SELECT Id
                    FROM StageInstances__r 
                    ORDER BY SortPosition__c)
                FROM PbxProcessInstance__c 
                WHERE Id = :value];
                
         if(piList != null && piList.size()>0){
             pi = piList.get(0);
                          
            //Opportunity
            String lead_id = pi.Lead__c;
            String mapping_str = '';
            if (pi.Mapping__c != null && pi.Mapping__c.length() > 0) mapping_str = ', '+pi.Mapping__c;
            String queryStr = 'SELECT Id, Name, Status ' +mapping_str + ' FROM Lead ' + 'WHERE Id = :lead_id';
            //opp = [ SELECT Id, Name, Amount, AccountId, CloseDate, StageName
            //        FROM Opportunity
            //        WHERE Id = :pi.Opportunity__c ];
            leadObj = Database.query(queryStr);
            system.debug('@@@@@ opp :'+queryStr);
            //Notes
            notes = [ SELECT Title, CreatedDate, CreatedBy.FirstName, CreatedBy.LastName, Body 
                      FROM Note
                      WHERE ParentId = :pi.Lead__c
                      ORDER BY CreatedDate Desc];
            
                        
           
            //Query all the Play in stage
            List<PbxPlayInstance__c> playlist = new List<PbxPlayInstance__c>([ SELECT Id, StageInstance__c
                                                                              FROM PbxPlayInstance__c
                                                                              WHERE StageInstance__r.ProcessInstance__c = :value
                                                                              Order By SortPosition__c]);
                                                  
            //QuestionInstance
            List<PbxQuestionInstance__c> unsortedQns = new List<PbxQuestionInstance__c>(
                                                            [ SELECT Id, Description__c, RedFlagCount__c, IncludedInAssessment__c,
                                                                 IncludedInDiscussion__c, HighestScore__c, Link__c, Name__c, 
                                                                 ResponseType__c, Tip__c,  Note__c, Score__c,
                                                                 //Parent PlayInstance__c,
                                                                 PlayInstance__c,
                                                                 //Answer  
                                                                 (SELECT Id, Answer__c, FlagType__c, Selected__c FROM AnswerInstances__r ORDER BY SortPosition__c)
                                                                 FROM PbxQuestionInstance__c 
                                                                 WHERE ProcessInstance__c = :value
                                                                 ORDER BY SortPosition__c]);
                    
            qis = sort(pi, playlist, unsortedQns);
                    
            for (PbxQuestionInstance__c q : qis)
            {
                if(q.ResponseType__c=='DataMap')
                {
                    String answer_str = String.valueOf(leadObj.get(q.name__c));
                    String format_answer = '';
                    if(q.AnswerInstances__r.size()>0)
                        q.AnswerInstances__r.get(0).Selected__c = true;
                    if(answer_str != NULL){    
                        for(String ans : answer_str.split(';'))
                        {
                            format_answer += ans + ' \n\r ';
                        }
                    }
                    if(q.AnswerInstances__r.size()>0)
                        q.AnswerInstances__r.get(0).Answer__c = format_answer;
                }else{
                    for(PbxAnswerInstance__c ans : q.AnswerInstances__r)
                    {
                        if(q.ResponseType__c=='Currency' || q.ResponseType__c=='Number' || q.ResponseType__c=='WholeNumber')
                        {
                            Double answer = 0.0;
                            if(ans.Answer__c != null){
                                answer = Double.valueof(ans.Answer__c.trim());
                            }
                            list<String> args = new String[]{'0','number','###,###,##0.00'};
                            ans.Answer__c = String.format(answer.format(), args);
                        }
                    }
                }
                system.debug('##ques=' + q);
                if(q.IncludedInAssessment__c) qis_assessment.add(q);
                if(q.IncludedInDiscussion__c) qis_discussion.add(q);
                
            }
         }else{
             pi = new PbxProcessInstance__c();
         }
        
    }
    
    private List<PbxQuestionInstance__c> sort(PbxProcessInstance__c process, List<PbxPlayInstance__c> playlist, List<PbxQuestionInstance__c> qnslist){
        List<PbxQuestionInstance__c> result = new List<PbxQuestionInstance__c>();
        List<PbxPlayInstance__c> newPlayOrder = new List<PbxPlayInstance__c>();
        
        //Sort Play base on Stage Order
        for(PbxStageInstance__c stagei: process.StageInstances__r){
            for(PbxPlayInstance__c playi: playlist){
                if(stagei.Id == playi.StageInstance__c)
                {
                    newPlayOrder.add(playi);
                }
            }
        }
        
        //Sort Question base on Play Order
        for(PbxPlayInstance__c playi: newPlayOrder){
            for(PbxQuestionInstance__c q: qnslist){
                if(playi.Id == q.PlayInstance__c)
                {
                    result.add(q);
                }
            }
        }
        System.debug('##### result = ' + result);
        return result;
    }
    
    public String getMappingValue(String api_name) {
        return api_name;
    }
    
    public Lead getLead() {
        return leadObj;
    }
    
    public PbxProcessInstance__c getProcessInstance() {
        return pi;
    }
    
       
    public List<PbxQuestionInstance__c> getQuestionInstance() {
        return qis;
    }
    
    public List<PbxQuestionInstance__c> getQuestionInstanceMilestones() {
        return qis_assessment;
    }
    
    public List<PbxQuestionInstance__c> getQuestionInstanceExecSummary() {
        return qis_discussion;
    }
    
    public List<PbxQuestionInstance__c> getQuestionInstanceAssessment() {
        return qis_assessment;
    }
    
    public List<PbxQuestionInstance__c> getQuestionInstanceDiscussion() {
        return qis_discussion;
    }
    
    public List<Note> getNotes() {
        return notes;
    }
    
    /* 
    public List<PbxProcessInstanceContact__c> getContacts() {
        return contacts;
    }*/
