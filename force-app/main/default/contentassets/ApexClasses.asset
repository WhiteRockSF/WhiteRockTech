             for(Schema.SObjectField tempField : leadFieldMap){
                Schema.DescribeFieldResult field= tempField.getDescribe();
                  if(field.isUpdateable() && field.isCustom()){
                      if(field.getType() == Schema.DisplayType.Boolean){
                        dataMMap.put(field.getName(),new List<string>{'true','false'});  
                      }else if(field.getType() == Schema.DisplayType.MultiPicklist || field.getType() == Schema.DisplayType.Picklist){
                        List<string> tempList = new List<string>();
                        for(Schema.PicklistEntry obj : field.getPicklistValues()){
                          tempList.add(obj.getValue());
                        }
                        dataMMap.put(field.getName(),tempList);
                      }
                  }
            }
            
