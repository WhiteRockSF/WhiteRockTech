    public String getNamespacePrifix(){
        List<ApexClass> apexClassList = [SELECT namespaceprefix FROM apexclass WHERE name = 'PlaybooxBuilderController'];
        return apexClassList != NULL && apexClassList.size() > 0 && apexClassList.get(0).namespaceprefix != NULL && apexClassList.get(0).namespaceprefix.trim().length() > 0 ? apexClassList.get(0).namespaceprefix + '__' : '';
    }
    
    private void getPrivilages(){
      if(UserInfo.getUserId() != null){
        for(user obj : [select id,Pbx_Role__c from user where id = :UserInfo.getUserId()]){
