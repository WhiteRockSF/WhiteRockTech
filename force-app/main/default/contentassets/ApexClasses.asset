@isTest
public Class TestDeleteProcessRecords{
    static testMethod void unitTest1(){
        PbxProcess__c  process = TestCoverageUtility.createPbxProcess(70,'test process');
        insert process;
        
        PbxProcess__c  Childprocess = TestCoverageUtility.createPbxProcess(70,'test process');
        Childprocess.ParentPublishProcess__c = process.id;
        insert Childprocess ;
        
        delete process;
        system.assertEquals([select id from PbxProcess__c where id=:Childprocess .id].size(),0);
    }
