    public void fillModalValuesForEditQuestion(){
        if(questionIdForUpdate != null && questionIdForUpdate.trim().length() >= 15){
            List<PbxQuestion__c>quesList = [select id,name,name__c,points__c,(select id,name,answer__c,weight__c,flagtype__c from answers__r order by sortPosition__c),description__c,IncludedInAssessment__c,IncludedInDiscussion__c,IncludedInDealProgress__c,IncludedInExecSummary__c,IncludedInKeyMilestones__c,IncludedInSuccessIndicators__c,Tip__c,ResponseType__c from PbxQuestion__c where id = :questionIdForUpdate];   
            
            if(quesList != null && quesList.size() > 0 && quesList[0].answers__r != null){
                quesObj = quesList.get(0);
                ansModalList = new List<AnswerModal>();
                dataMapList = new List<selectoption>();
                dataMMap = new Map<string,List<string>>();
                
                if(quesObj.responseType__c == 'SingleChoice' || quesObj.responseType__c == 'MultiChoice'){
                    for(PbxAnswer__c obj : quesObj.answers__r){
                        AnswerModal mdlObj = new AnswerModal();
                        mdlObj.id= obj.id;
                        mdlObj.answer= obj.answer__c;
                        if(obj.flagtype__c == 'Red'){
                          mdlObj.flagtype= true;
                        }
                        mdlObj.weight= string.valueOf(obj.weight__c);
                        
                        ansModalList.add(mdlObj);
                    }
                }else if(quesObj.responseType__c == 'DataMap'){
                  if(oppFieldMap != null && oppFieldMap.size() > 0){
                for(Schema.SObjectField tempField : oppFieldMap.values()){
                    Schema.DescribeFieldResult field= tempField.getDescribe();
                      if(field.isUpdateable() && field.isCustom()){
                          dataMapList.add(new selectoption(field.getName(),field.getLabel()));
                          if(field.getType() == Schema.DisplayType.Boolean){
                            dataMMap.put(field.getName(),new List<string>{'true','false'});  
                          }else if(field.getType() == Schema.DisplayType.MultiPicklist || field.getType() == Schema.DisplayType.Picklist){
                            List<string> tempList = new List<string>();
                            for(Schema.PicklistEntry obj : field.getPicklistValues()){
                              tempList.add(obj.getValue());
                            }
                            dataMMap.put(field.getName(),tempList);
                          }
                      }
                }
              }
                }
            }
        }
    }
    
    public void fillModalValuesForEditMessage(){
        if(messageIdForUpdate != null && messageIdForUpdate.trim().length() >= 15){
            List<PbxMessage__c>msgTempList = [select id,name__c,description__c,IncludedInAssessment__c,IncludedInDiscussion__c,Tip__c from PbxMessage__c where id = :messageIdForUpdate];   
            
            if(msgTempList != null && msgTempList.size() > 0){
                msgObj = msgTempList.get(0);
            }
        }
    }
    public void fillModalValuesForEditTool(){
        if(toolIdForUpdate != null && toolIdForUpdate.trim().length() >= 15){
            contVersion = new contentVersion();
            List<PbxTool__c>toolTempList = [select id,name__c,description__c,Tip__c,DocumentId__c,WorkspaceId__c,Link__c,IncludedInCompetition__c, IncludedInCallManagementDiscussion__c, IncludedInGeneral__c, IncludedInObjectionHandling__c, IncludedInProduct__c, IncludedInSuccessStories__c from Pbxtool__c where id = :toolIdForUpdate];   
            
            if(toolTempList != null && toolTempList.size() > 0){
                toolObj = toolTempList.get(0);
                
                if(toolObj.documentId__c != null && toolObj.workspaceId__c != null){
                    selectedContentId = toolObj.documentId__c;
                    selectedLibId = toolObj.workspaceId__c;
                    
                }
                selectedToolStr = 'link';
                previousStoredLink = toolObj.link__c;
            }
        }
    }
    
    public void fillModalValuesForEditTraining(){
        if(trainingIdForUpdate != null && trainingIdForUpdate.trim().length() >= 15){
            contVersion = new contentVersion();
            List<PbxTraining__c>trainingTempList = [select id, name__c, description__c, Tip__c, DocumentId__c, WorkspaceId__c, Link__c, IncludedInCompetition__c, IncludedInGeneral__c, IncludedInObjectionHandling__c, IncludedInIndustry__c, IncludedInSuccessStories__c, IncludedInCallManagementDiscussion__c, IncludedInProduct__c from PbxTraining__c where id = :trainingIdForUpdate];   
            
            if(trainingTempList != null && trainingTempList.size() > 0){
                trainingObj = trainingTempList.get(0);
                
                if(trainingObj.documentId__c != null && trainingObj.workspaceId__c != null){
                    selectedContentId = trainingObj.documentId__c;
                    selectedLibId = trainingObj.workspaceId__c;
                    
                }
                selectedTrainingStr = 'link';
                previousStoredLink = trainingObj.link__c;
            }
        }
    }
    
    public void showHideAnsContent(){
        ansModalList = new List<AnswerModal>();
        dataMapList = new List<selectoption>();
        dataMMap = new Map<string,List<string>>();
        if(quesObj.ResponseType__c == 'SingleChoice' || quesObj.ResponseType__c == 'MultiChoice'){
            ansModalList.add(new AnswerModal());
        }else if(quesObj.ResponseType__c == 'DataMap'){
          if(oppFieldMap != null && oppFieldMap.size() > 0){
            for(Schema.SObjectField tempField : oppFieldMap.values()){
                Schema.DescribeFieldResult field= tempField.getDescribe();
                  if(field.isUpdateable() && field.isCustom()){
                      dataMapList.add(new selectoption(field.getName(),field.getLabel()));
                      if(field.getType() == Schema.DisplayType.Boolean){
                        dataMMap.put(field.getName(),new List<string>{'true','false'});  
                      }else if(field.getType() == Schema.DisplayType.MultiPicklist || field.getType() == Schema.DisplayType.Picklist){
                        List<string> tempList = new List<string>();
                        for(Schema.PicklistEntry obj : field.getPicklistValues()){
                          tempList.add(obj.getValue());
                        }
                        dataMMap.put(field.getName(),tempList);
                      }
                  }
            }
          }
        }
        
    } 
