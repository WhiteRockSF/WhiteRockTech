    public static String getCurrencySymbolFromIso(String Iso){
         String currencySymbol = ('USD' == Iso ? '$' : ('CAD' == Iso ? '$' : ('EUR' == Iso ? '€' : ('GBP' == Iso ? '£' : ('JPY' == Iso ? '¥' : ('KRW' == Iso ? '?' : ('CNY' == Iso ? '?' : Iso)))))));
         return currencySymbol; 
    }
    //get opportunity custom field's display type
    public void fillDataMapresponseMap(){
        try{
            dataMapResponse = new Map<string,string>();
            List<SObjectField> oppFieldMap = Schema.SObjectType.opportunity.fields.getMap().values();
            if(oppFieldMap != null && oppFieldMap.size() > 0){
                for(Schema.SObjectField tempField : oppFieldMap){
                    Schema.DescribeFieldResult field= tempField.getDescribe();
                    if(field.isUpdateable() && field.isCustom()){
                        if(field.getType() == Schema.DisplayType.Boolean){
                            dataMapResponse.put(field.getName(),'boolean'); 
                        }else if(field.getType() == Schema.DisplayType.MultiPicklist){
                            dataMapResponse.put(field.getName(),'multipicklist');
                        }else if(field.getType() == Schema.DisplayType.Picklist){
                            dataMapResponse.put(field.getName(),'picklist');
                        }else if(field.getType() == Schema.DisplayType.Currency || field.getType() == Schema.DisplayType.Double){
                            dataMapResponse.put(field.getName(),'double');
                        }else if(field.getType() == Schema.DisplayType.Date){
                            dataMapResponse.put(field.getName(),'date');
                        }else if(field.getType() == Schema.DisplayType.DateTime){
                            dataMapResponse.put(field.getName(),'datetime');
                        }else{
                            dataMapResponse.put(field.getName(),'text');
                        }
                        //system.debug('##length='+ field.getName() + '= ' + field.getLength());    
                        //system.debug('##digits='+ field.getName() + '= ' + field.getPrecision());
                        
                    }
                }
                system.debug('##dataMapResponse='+dataMapResponse);
            }
        }catch(Exception e){
            system.debug('Exception ==>'+e.getMessage());
        }
    }
    
    public void fillOpenActivities(){
        if(openActivityMap.size() > 0){
            for(Task obj : [select Status, ActivityDate, Subject, whatid, whoid, who.name from task where whatid in :openActivityMap.keySet() and status != 'Completed' order by createddate]){
                List<OpenActivityModal> openActModalList;
                OpenActivityModal openActModalObj = new OpenActivityModal();
                
                if(openActivityMap.containsKey(obj.whatid) && openActivityMap.get(obj.whatid) != NULL){
                    openActModalList = openActivityMap.get(obj.whatid); 
                }else{
                    openActModalList = new List<OpenActivityModal>();
                }
                openActModalObj.activityId = obj.id;
                openActModalObj.whoName = obj.who.name;
                if(obj.activityDate != NULL)
                    openActModalObj.activityDate = obj.activityDate; 
                openActModalObj.subject = obj.subject;
                openActModalList.add(openActModalObj);
                openActivityMap.put(obj.whatid, openActModalList);          
            }
            
            for(Event obj : [select ActivityDate, Subject, whatid, whoid, who.name from Event where whatid in :openActivityMap.keySet() and endDateTime > :system.now() order by createddate]){
                List<OpenActivityModal> openActModalList;
                OpenActivityModal openActModalObj = new OpenActivityModal();
                
                if(openActivityMap.containsKey(obj.whatid) && openActivityMap.get(obj.whatid) != NULL){
                    openActModalList = openActivityMap.get(obj.whatid); 
                }else{
                    openActModalList = new List<OpenActivityModal>();
                }
                openActModalObj.activityId = obj.id;
                openActModalObj.whoName = obj.who.name;
                if(obj.activityDate != NULL)
                    openActModalObj.activityDate = obj.activityDate; 
                openActModalObj.subject = obj.subject;
                openActModalList.add(openActModalObj);
                openActivityMap.put(obj.whatid, openActModalList);  
            }
            system.debug('##activityMap' + openActivityMap);
        }
    }
    
    public void fetchDealSummary(){
        if(dealSummaryMap.size() > 0){
            for(PbxQuestionInstance__c obj : [select id, name__c, processInstance__c, ResponseType__c, description__c,(select id,answer__c,selected__c, flagtype__c from AnswerInstances__r order by sortPosition__c) from PbxQuestionInstance__c where processInstance__c IN :dealSummaryMap.keySet() and IncludedInExecSummary__c = true order by playInstance__r.stageInstance__r.sortPosition__c, playInstance__r.sortPosition__c,sortPosition__c LIMIT 50000]){
                DealSummaryModal qMdlObj = new DealSummaryModal();    
                qMdlObj.quesDesc = obj.description__c;
                qMdlObj.responseType = obj.responseType__c;
                
                for(PbxAnswerInstance__c obj2 : obj.answerInstances__r){
                    if(obj2.answer__c != null && obj2.answer__c.trim().length() > 0){ 
                        if(obj.ResponseType__c == 'Checkbox'){
                            if(obj2.answer__c.toLowerCase() == 'true' && obj2.selected__c == true){
                                qMdlObj.check = true;        
                            }
                        }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'boolean'){
                            if(obj2.answer__c.toLowerCase() == 'true' && obj2.selected__c == true){
                                qMdlObj.check = true;
                                qMdlObj.datamapStr = 'checkbox';        
                            }
                        
                        }else if(obj.ResponseType__c == 'SingleChoice'){
                            qMdlObj.choice.add(new selectoption(obj2.answer__c,obj2.answer__c));
                            if(obj2.selected__c){
                                qMdlObj.selectedSChoice = obj2.answer__c; 
                                qMdlObj.selectedSChoiceRedFlag = obj2.FlagType__c == 'Red' ? true : false;  
                            }   
                        }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null &&  dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'picklist'){
                            qMdlObj.choice.add(new selectoption(obj2.answer__c,obj2.answer__c));
                            if(obj2.selected__c){
                                qMdlObj.selectedSChoice = obj2.answer__c;   
                                qMdlObj.selectedSChoiceRedFlag = obj2.FlagType__c == 'Red' ? true : false;
                            }
                            qMdlObj.datamapStr = 'singlechoice';    
                        }else if(obj.ResponseType__c == 'MultiChoice'){
                            qMdlObj.choice.add(new selectoption(obj2.answer__c,obj2.answer__c));    
                            if(obj2.selected__c){
                                qMdlObj.selectedMChoice.add(obj2.answer__c); 
                                qMdlObj.selectedMChoiceRedFlagMap.put(obj2.answer__c, obj2.FlagType__c == 'Red' ? true : false);   
                            }
                        }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'multipicklist'){
                            qMdlObj.choice.add(new selectoption(obj2.answer__c,obj2.answer__c));    
                            if(obj2.selected__c){
                                qMdlObj.selectedMChoice.add(obj2.answer__c);
                                qMdlObj.selectedMChoiceRedFlagMap.put(obj2.answer__c, obj2.FlagType__c == 'Red' ? true : false);    
                            }
                            qMdlObj.datamapStr = 'multichoice';
                        }else{
                            qMdlObj.text = obj2.answer__c;
                            qMdlObj.datamapStr = 'text';
                        }
                        system.debug('##ansObjAfterFill'+ obj2);
                    }
                }
                List<DealSummaryModal> dSTempList;
                dSTempList = dealSummaryMap.get(obj.processInstance__c);
                if(dSTempList == NULL) dSTempList = new List<DealSummaryModal>();
                if(dSTempList.size() < 1000)
                    dSTempList.add(qMdlObj);
                dealSummaryMap.put(obj.processInstance__c, dSTempList); 
                system.debug('##302=dealSummaryMap=='+dealSummaryMap);   
            }
        }   
    }
    
