    public void fillPicklistValues(){
        //Get gut feel picklist values
        Schema.DescribeFieldResult pi = PbxProcessInstance__c.gut_feel__c.getDescribe();
        List<Schema.PicklistEntry> Pe = pi.getPicklistValues();
        gutFeelValues = new List<selectoption>();
        for(Schema.PicklistEntry obj : pe){
            gutFeelValues.add(new selectoption(obj.getValue(),obj.getLabel()));         
        }
        //Get stance__c picklist values
        stancePicklistValues = new List<selectoption>();
        pi = PbxProcessInstanceContact__c.Stance__c.getDescribe();
        Pe = pi.getPicklistValues();
        for(Schema.PicklistEntry obj : pe){
            stancePicklistValues.add(new selectoption(obj.getValue(),obj.getLabel()));          
        }
        //Get influence__c picklist values
        influencePicklistValues = new List<selectoption>();
        pi = PbxProcessInstanceContact__c.influence__c.getDescribe();
        Pe = pi.getPicklistValues();
        for(Schema.PicklistEntry obj : pe){
            influencePicklistValues.add(new selectoption(obj.getValue(),obj.getLabel()));           
        }
        //Get priority__c picklist values
        priorityPicklistValues = new List<selectoption>();
        pi = PbxProcessInstanceContact__c.priority__c.getDescribe();
        Pe = pi.getPicklistValues();
        for(Schema.PicklistEntry obj : pe){
            priorityPicklistValues.add(new selectoption(obj.getValue(),obj.getLabel()));            
        }
        //Get Opportunity's stage values
        Set<String> avilableStageSet = new Set<String>();//this set is used to fill only those stages which are available on record types
        if(availableRecordTypeStages != NULL && availableRecordTypeStages.trim().length() > 0 && availableRecordTypeStages.endsWith('___')){
            avilableStageSet.addAll(availableRecordTypeStages.split('___'));
        }
        system.debug('##avilableStageSet=' + avilableStageSet);
        oppStagesList = new List<string>();
        oppStageMap = new Map<string,Integer>();
        for(opportunityStage obj : [select masterLabel,sortOrder from opportunityStage where isActive = true order by sortOrder]){
            if(avilableStageSet.size() == 0 || avilableStageSet.contains(obj.masterLabel)){
                oppStagesList.add(obj.masterLabel);
                oppStageMap.put(obj.masterLabel,obj.sortOrder);            
                if(oppObj.stageName == obj.masterLabel){
                    currentStageExist = true;
                }
            }
        }
    }
    
    public void getDealNotes(){
        dealNoteList = new List<note>();
        if(oppObj != null){
            dealNoteList = [select id,title,owner.name,createdDate from note where parentid = :oppObj.id order by createddate];
        }
    }
    
    public void getNextSteps(){
        nextStepList = new List<task>();
        if(oppObj != null){
            nextStepList = [select id,Priority,Status,ActivityDate,Subject,description from task where whatid = :oppObj.id and status != 'Completed' order by createddate];
            nextStepEvtList = [select id,startDateTime,Subject from event where whatid = :oppObj.id and endDateTime > :system.now() order by createddate];
        }
    }
    public void getKeyMilestoneList(){
        milestoneList = new List<DealProgressModal>(); 
        if(processInsList != null && processInsList.size() > 0){
            for(PbxQuestionInstance__c obj : [select id,ResponseType__c,Tip__c,note__c,playInstance__r.stageInstance__c,playInstance__r.stageInstance__r.name__c,playInstance__r.name__c,name__c,description__c,(select id,answer__c,selected__c,SortPosition__c,flagtype__c,Weight__c from AnswerInstances__r order by sortPosition__c) from PbxQuestionInstance__c where processInstance__c = :processInsList.get(0).id and ResponseType__c = 'Date' and IncludedInKeyMilestones__c = true order by playInstance__r.stageInstance__r.sortPosition__c, playInstance__r.sortPosition__c,sortPosition__c]){
                DealProgressModal mdlObj = new DealProgressModal();
                mdlObj.qObj = obj;
                for(PbxAnswerInstance__c obj2 : obj.answerInstances__r){
                    mdlObj.text = obj2.answer__c;
                }
                milestoneList.add(mdlObj);    
            }
        }
    }
    
    public void getDealSummary(){
        summaryList = new List<DealProgressModal>(); 
        if(processInsList != null && processInsList.size() > 0){
            for(PbxQuestionInstance__c obj : [select id,ResponseType__c,Tip__c,note__c,playInstance__r.stageInstance__c,playInstance__r.stageInstance__r.name__c,playInstance__r.name__c,name__c,description__c,(select id,answer__c,selected__c,SortPosition__c,flagtype__c,Weight__c from AnswerInstances__r order by sortPosition__c) from PbxQuestionInstance__c where processInstance__c = :processInsList.get(0).id and IncludedInExecSummary__c = true order by playInstance__r.stageInstance__r.sortPosition__c, playInstance__r.sortPosition__c,sortPosition__c]){
                DealProgressModal qMdlObj = new DealProgressModal();    
                
                qMdlObj.qObj = obj;
                
                //get response type for show checkbox, dropdown etc.
                if(obj.name__c != null && dataMapResponse != null){
                    system.debug('##dataMapResponse.containsKey(obj.name__c)='+dataMapResponse.containsKey(obj.name__c) + ' + '+obj.name__c);
                    system.debug('##2dataMapResponse.containsKey(obj.name__c)='+dataMapResponse.get(obj.name__c));
                }
                
                if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'double'){
                    qMdlObj.datamapStr = 'decimal';
                }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'date'){
                    qMdlObj.datamapStr = 'date';
                }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'datetime'){
                    qMdlObj.datamapStr = 'datetime';
                }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null &&  dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'text'){
                    qMdlObj.datamapStr = 'text';
                }// to make datamap boolean shown 
                else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null &&  dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'boolean'){
                    qMdlObj.datamapStr = 'checkbox';
                }
                
                for(PbxAnswerInstance__c obj2 : obj.answerInstances__r){
                    if(obj2.answer__c != null && obj2.answer__c.trim().length() > 0){ 
                        if(obj.ResponseType__c == 'Checkbox'){
                            if(obj2.answer__c.toLowerCase() == 'true' && obj2.selected__c == true){
                                qMdlObj.check = true;        
                            }
                        }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'boolean'){
                            if(obj2.answer__c.toLowerCase() == 'true' && obj2.selected__c == true){
                                qMdlObj.check = true;
                                qMdlObj.datamapStr = 'checkbox';        
                            }
                        
                        }else if(obj.ResponseType__c == 'SingleChoice'){
                            qMdlObj.choice.add(new selectoption(obj2.answer__c,obj2.answer__c));
                            if(obj2.selected__c){
                                qMdlObj.selectedSChoice = obj2.answer__c; 
                                qMdlObj.selectedSChoiceRedFlag = obj2.FlagType__c == 'Red' ? true : false;  
                            }   
                        }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null &&  dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'picklist'){
                            qMdlObj.choice.add(new selectoption(obj2.answer__c,obj2.answer__c));
                            if(obj2.selected__c){
                                qMdlObj.selectedSChoice = obj2.answer__c;   
                                qMdlObj.selectedSChoiceRedFlag = obj2.FlagType__c == 'Red' ? true : false;
                            }
                            qMdlObj.datamapStr = 'singlechoice';    
                        }else if(obj.ResponseType__c == 'MultiChoice'){
                            qMdlObj.choice.add(new selectoption(obj2.answer__c,obj2.answer__c));    
                            if(obj2.selected__c){
                                qMdlObj.selectedMChoice.add(obj2.answer__c); 
                                qMdlObj.selectedMChoiceRedFlagMap.put(obj2.answer__c, obj2.FlagType__c == 'Red' ? true : false);   
                            }
                        }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'multipicklist'){
                            qMdlObj.choice.add(new selectoption(obj2.answer__c,obj2.answer__c));    
                            if(obj2.selected__c){
                                qMdlObj.selectedMChoice.add(obj2.answer__c);
                                qMdlObj.selectedMChoiceRedFlagMap.put(obj2.answer__c, obj2.FlagType__c == 'Red' ? true : false);    
                            }
                            qMdlObj.datamapStr = 'multichoice';
                        }else if(obj.ResponseType__c == 'Rating'){
                            qMdlObj.choice.add(new selectoption(obj2.answer__c,obj2.answer__c));    
                            if(obj2.selected__c){
                                qMdlObj.selectedRating = obj2.answer__c;    
                            }
                        }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'double'){
                            qMdlObj.text = obj2.answer__c;
                            qMdlObj.datamapStr = 'decimal';
                        }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'date'){
                            qMdlObj.text = obj2.answer__c;
                            qMdlObj.datamapStr = 'date';
                        }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null && dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'datetime'){
                            qMdlObj.text = obj2.answer__c;
                            qMdlObj.datamapStr = 'datetime';
                        }else if(obj.ResponseType__c == 'DataMap' && obj.name__c != null && dataMapResponse != null &&  dataMapResponse.containsKey(obj.name__c) && dataMapResponse.get(obj.name__c) == 'text'){
                            qMdlObj.text = obj2.answer__c;
                            qMdlObj.datamapStr = 'text';
                        }else{
                            qMdlObj.text = obj2.answer__c;
                            
                        }
                        system.debug('##ansObjAfterFill'+ obj2);
                    }
                }
                summaryList.add(qMdlObj);
                    
            }
        }   
    }
    
    public void getRiskScore(){
        integer highCnt=0;
        integer mediumCnt=0;
        integer lowCnt=0;
        /*if(sIndicatorsList.size() > 0){
            for(PbxAnswerInstance__c obj : sIndicatorsList){
                if(obj.answer__c == 'Negative'){
                    ++highCnt;  
                }else if(obj.answer__c == 'Neutral'){
                    ++mediumCnt;    
                }else if(obj.answer__c == 'Positive'){
                    ++lowCnt;   
                }   
            }
        }*/
        if(stackeholderList.size() > 0){
            for(StackeholderModal mdlObj : stackeholderList){
                PbxProcessInstanceContact__c obj = mdlObj.kObj;
                 
                if(obj.Stance__c == 'Against'){
                    ++highCnt;  
                }else if(obj.Stance__c == 'Neutral'){
                    ++mediumCnt;    
                }else if(obj.Stance__c == 'For'){
                    ++lowCnt;   
                }
                
                if(obj.influence__c == 'Low'){
                    ++highCnt;  
                }else if(obj.influence__c == 'Medium'){
                    ++mediumCnt;    
                }else if(obj.influence__c == 'High'){
                    ++lowCnt;   
                }
                
                if(obj.priority__c == 'Low'){
                    ++highCnt;  
                }else if(obj.priority__c == 'Medium'){
                    ++mediumCnt;    
                }else if(obj.priority__c == 'High'){
                    ++lowCnt;   
                }
                    
            }
        }
        
        if(highCnt >= 5){
            riskScore = 'High';
        }else if(mediumCnt >= 3 && mediumCnt <= 4){
            riskScore = 'Medium';
        }else{
            riskScore = 'Low';  
        }
    }
    
    public void getKeyStackeholders(){
        stackeholderList = new List<StackeholderModal>(); 
        if(processInsList != null && processInsList.size() > 0){
            Map<string,opportunityContactRole> ocrMap = new Map<string,opportunityContactRole>();
            for(opportunityContactRole obj : [select id,contactid,role,isPrimary from opportunityContactRole where opportunityid = :oppObj.id]){
                ocrMap.put(obj.contactid,obj);  
            }
            for(PbxProcessInstanceContact__c obj : [select id,name,Contact__c,contact__r.name,contact__r.title,Influence__c,Priority__c,Stance__c  from PbxProcessInstanceContact__c where processInstance__c = :processInsList.get(0).id]){
                StackeholderModal mdlObj = new StackeholderModal();
                mdlObj.kObj = obj;
                if(ocrMap.containsKey(obj.contact__c)){
                    mdlObj.ocrObj = ocrMap.get(obj.contact__c);     
                }
                stackeholderList.add(mdlObj);
            }      
        }
    }
    
