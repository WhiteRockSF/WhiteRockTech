    public PlaybooxBuilderDashboardTwoController(){
        initializations();
        getPrivilages();
        getParameter();
        getProcessRecord();
        fillStageSortPositionMap();
        fillOpportunityFieldsMap();
        //for ckeditor dynamic id
        getNamespacePrifix();   
    }
    
    public void fetchAvailableStagesOnly(){//this method is used to fetch only available stages on record type of opportunity thats why this method calls from page when page loads , after SOAP api script, Sales Process functionality
      //fill Stages in modal
        system.debug('##fetchAvailableStagesOnly==IN');
        fillStageModal();
        fillPicklistValues();
    }
    
    public String getNamespacePrifix(){
      List<ApexClass> apexClassList = [SELECT namespaceprefix FROM apexclass WHERE name = 'PlaybooxBuilderController'];
      return apexClassList != NULL && apexClassList.size() > 0 && apexClassList.get(0).namespaceprefix != NULL && apexClassList.get(0).namespaceprefix.trim().length() > 0 ? apexClassList.get(0).namespaceprefix + '__' : '';
    }
    
    private void getPrivilages(){
      if(UserInfo.getUserId() != null){
        for(user obj : [select id,Pbx_Role__c from user where id = :UserInfo.getUserId()]){
          if(obj.pbx_role__c == 'Administrator'){
            insfPrivlFalse = true;  
          }
        }
      }
    }
    private void fillOpportunityFieldsMap(){
      oppFieldMap = new Map<string,SObjectField>();
      oppFieldMap = Schema.SObjectType.opportunity.fields.getMap();
    }
    public void fillStageSortPositionMap(){
      stageSortMap = new Map<String,Integer>();
      for(opportunityStage obj : [select masterLabel,sortOrder from opportunityStage LIMIT 1000]){
        stageSortMap.put(obj.masterLabel,obj.sortOrder);
      }
    }
    public void initializations(){
        stageMdlList = new List<StageModal>();
        playNameMap = new Map<string,string>();
        stageObj = new PbxStage__c();
        playObj = new PbxPlay__c();
        questionList = new List<PbxQuestion__c>();
        messageList = new List<PbxMessage__c>();
        toolList = new List<PbxTool__c>();
        trainingList = new List<PbxTraining__c>();
        quesObj = new PbxQuestion__c();
        msgObj = new PbxMessage__c();
        contVersion = new contentVersion();
        toolObj = new PbxTool__c();
        trainingObj = new PbxTraining__c();
        ansModalList = new List<AnswerModal>();ansModalList.add(new AnswerModal());
        dataMapList = new List<selectoption>();
        dataMMap = new Map<string,List<string>>();
        libraryList = new List<selectoption>();
        contentList = new List<selectoption>();
        responsePicklist = new List<selectoption>();
        salesProcessList = new List<SelectOption>();
    }
    
    public void initializeQuestion(){
        quesObj = new PbxQuestion__c();
        ansModalList = new List<AnswerModal>();ansModalList.add(new AnswerModal());
        dataMapList = new List<selectoption>();
        dataMMap = new Map<string,List<string>>();
    }
    public void initializeMessage(){
        msgObj = new PbxMessage__c();
    }
    public void initializeTool(){
        toolObj = new PbxTool__c();
        contVersion = new contentVersion();
        selectedToolStr = '';
        selectedLibId = '';
        previousStoredLink = '';
        fillPicklistValues();
        
    }
    
    public void initializeTraining(){
        trainingObj = new PbxTraining__c();
        contVersion = new contentVersion();
        selectedTrainingStr = '';
        selectedLibId = '';
        previousStoredLink = '';
        fillPicklistValues();
    }
    
    public void fillModalValuesForEditQuestion(){
        if(questionIdForUpdate != null && questionIdForUpdate.trim().length() >= 15){
            List<PbxQuestion__c>quesList = [select id,name,name__c,points__c,(select id,name,answer__c,weight__c,flagtype__c from answers__r order by sortPosition__c),description__c,IncludedInAssessment__c,IncludedInDiscussion__c,IncludedInDealProgress__c,IncludedInExecSummary__c,IncludedInKeyMilestones__c,IncludedInSuccessIndicators__c,Tip__c,ResponseType__c from PbxQuestion__c where id = :questionIdForUpdate];   
            
            if(quesList != null && quesList.size() > 0 && quesList[0].answers__r != null){
                quesObj = quesList.get(0);
                ansModalList = new List<AnswerModal>();
                dataMapList = new List<selectoption>();
                dataMMap = new Map<string,List<string>>();
                
                if(quesObj.responseType__c == 'SingleChoice' || quesObj.responseType__c == 'MultiChoice'){
                    for(PbxAnswer__c obj : quesObj.answers__r){
                        AnswerModal mdlObj = new AnswerModal();
                        mdlObj.id= obj.id;
                        mdlObj.answer= obj.answer__c;
                        if(obj.flagtype__c == 'Red'){
                          mdlObj.flagtype= true;
                        }
                        mdlObj.weight= string.valueOf(obj.weight__c);
                        
                        ansModalList.add(mdlObj);
                    }
                }else if(quesObj.responseType__c == 'DataMap'){
                  if(oppFieldMap != null && oppFieldMap.size() > 0){
                for(Schema.SObjectField tempField : oppFieldMap.values()){
                    Schema.DescribeFieldResult field= tempField.getDescribe();
                      if(field.isUpdateable() && field.isCustom()){
                          dataMapList.add(new selectoption(field.getName(),field.getLabel()));
                          if(field.getType() == Schema.DisplayType.Boolean){
                            dataMMap.put(field.getName(),new List<string>{'true','false'});  
                          }else if(field.getType() == Schema.DisplayType.MultiPicklist || field.getType() == Schema.DisplayType.Picklist){
                            List<string> tempList = new List<string>();
                            for(Schema.PicklistEntry obj : field.getPicklistValues()){
                              tempList.add(obj.getValue());
                            }
                            dataMMap.put(field.getName(),tempList);
                          }
                      }
                }
              }
                }
            }
        }
    }
    
    public void fillModalValuesForEditMessage(){
        if(messageIdForUpdate != null && messageIdForUpdate.trim().length() >= 15){
            List<PbxMessage__c>msgTempList = [select id,name__c,description__c,IncludedInAssessment__c,IncludedInDiscussion__c,Tip__c from PbxMessage__c where id = :messageIdForUpdate];   
            
            if(msgTempList != null && msgTempList.size() > 0){
                msgObj = msgTempList.get(0);
            }
        }
    }
    public void fillModalValuesForEditTool(){
        if(toolIdForUpdate != null && toolIdForUpdate.trim().length() >= 15){
            contVersion = new contentVersion();
            List<PbxTool__c>toolTempList = [select id,name__c,description__c,Tip__c,DocumentId__c,WorkspaceId__c,Link__c,IncludedInCompetition__c, IncludedInCallManagementDiscussion__c, IncludedInGeneral__c, IncludedInObjectionHandling__c, IncludedInProduct__c, IncludedInSuccessStories__c from Pbxtool__c where id = :toolIdForUpdate];   
            
            if(toolTempList != null && toolTempList.size() > 0){
                toolObj = toolTempList.get(0);
                
                if(toolObj.documentId__c != null && toolObj.workspaceId__c != null){
                    selectedContentId = toolObj.documentId__c;
                    selectedLibId = toolObj.workspaceId__c;
                    
                }
                selectedToolStr = 'link';
                previousStoredLink = toolObj.link__c;
            }
        }
    }
    
    public void fillModalValuesForEditTraining(){
        if(trainingIdForUpdate != null && trainingIdForUpdate.trim().length() >= 15){
            contVersion = new contentVersion();
            List<PbxTraining__c>trainingTempList = [select id, name__c, description__c, Tip__c, DocumentId__c, WorkspaceId__c, Link__c, IncludedInCompetition__c, IncludedInGeneral__c, IncludedInObjectionHandling__c, IncludedInIndustry__c, IncludedInSuccessStories__c, IncludedInCallManagementDiscussion__c, IncludedInProduct__c from PbxTraining__c where id = :trainingIdForUpdate];   
            
            if(trainingTempList != null && trainingTempList.size() > 0){
                trainingObj = trainingTempList.get(0);
                
                if(trainingObj.documentId__c != null && trainingObj.workspaceId__c != null){
                    selectedContentId = trainingObj.documentId__c;
                    selectedLibId = trainingObj.workspaceId__c;
                    
                }
                selectedTrainingStr = 'link';
                previousStoredLink = trainingObj.link__c;
            }
        }
    }
    
    public void showHideAnsContent(){
        ansModalList = new List<AnswerModal>();
        dataMapList = new List<selectoption>();
        dataMMap = new Map<string,List<string>>();
        if(quesObj.ResponseType__c == 'SingleChoice' || quesObj.ResponseType__c == 'MultiChoice'){
            ansModalList.add(new AnswerModal());
        }else if(quesObj.ResponseType__c == 'DataMap'){
          if(oppFieldMap != null && oppFieldMap.size() > 0){
            for(Schema.SObjectField tempField : oppFieldMap.values()){
                Schema.DescribeFieldResult field= tempField.getDescribe();
                  if(field.isUpdateable() && field.isCustom()){
                      dataMapList.add(new selectoption(field.getName(),field.getLabel()));
                      if(field.getType() == Schema.DisplayType.Boolean){
                        dataMMap.put(field.getName(),new List<string>{'true','false'});  
                      }else if(field.getType() == Schema.DisplayType.MultiPicklist || field.getType() == Schema.DisplayType.Picklist){
                        List<string> tempList = new List<string>();
                        for(Schema.PicklistEntry obj : field.getPicklistValues()){
                          tempList.add(obj.getValue());
                        }
                        dataMMap.put(field.getName(),tempList);
                      }
                  }
            }
          }
        }
        
    } 
    public void increaseAnswerContent(){
        ansModalList.add(new AnswerModal());
    }
    public void removeAnswerContent(){
        if(ansModalList.size() > 1 && removeAnsIndex != null){
            ansModalList.remove(removeAnsIndex);
        }
    }
    public void getParameter(){
        //Get process id from query string
        if(ApexPages.currentPage().getParameters().containsKey('id')){
            processId = ApexPages.currentPage().getParameters().get('id');
        }
        
        //open play modal after insert or update tool
        if(ApexPages.currentPage().getParameters().containsKey('playid')){
            string str = ApexPages.currentPage().getParameters().get('playid');
            if(str != null && str.trim().length() >= 15){
                playObjIdForUpdate = str;
            }
        }
    }
    
    public void getProcessRecord(){
        
        //get Process Record
        List<PbxProcess__c> processList = [select id,name,name__c,mapping__c, Active__c,description__c,publishdate__c,Points__c,ProgressThreshold__c, businessProcessId__c from PbxProcess__c where id = :processId and version__c = '2'];
        if(processList != null && processList.size() > 0){
            processObj = processList.get(0);
            //if(processObj.businessProcessId__c != NULL && processObj.businessProcessId__c.trim().length() > 14){
              fetchSalesProcesses();
            //}    
        }       
    }
    
    //below method is used to fetch valid sales processes which are currently used in record types only
    private void fetchSalesProcesses(){
      salesProcessList = new List<SelectOption>();
      Boolean businessProcessValid = false;
      Map<Id,Schema.RecordTypeInfo> rtMapById = opportunity.SObjectType.getDescribe().getRecordTypeInfosById();
      Set<String> opprecordTypeSet = new Set<String>();//used as a collection of all opportunity record types
    salesPRecordTypeId = '';
    // now get sales processes if record types are exist for opportunity
    if(rtMapById != NULL && rtMapById.size() > 0){
      for(RecordType obj : [SELECT name, businessProcessid FROM RecordType WHERE id IN: rtMapById.keySet()]){
        //salesProcessList.add(new SelectOption(obj.businessProcessid,obj.businessProcess.name));  
        opprecordTypeSet.add(obj.businessProcessid);
        if(processObj.businessProcessId__c != NULL && String.valueOf(obj.businessProcessid).subString(0,15) == processObj.businessProcessId__c.subString(0,15)){
          system.debug('##record type name=' + obj.name);
          salesPRecordTypeId = obj.id;
          businessProcessValid = true;
        }
          
      }
      if(opprecordTypeSet.size() > 0){
        for(BusinessProcess obj : [SELECT name FROM BusinessProcess WHERE id IN: opprecordTypeSet]){
           salesProcessList.add(new SelectOption(obj.id,obj.name));
           if(processObj.businessProcessId__c != NULL && String.valueOf(obj.id).subString(0,15) == processObj.businessProcessId__c.subString(0,15)){   
               currentSalesProcess = obj.name;  
           }
        }
      }
    }
    }
    
    public void fillPicklistValues(){
        //Get stage picklist values
        Schema.DescribeFieldResult pi = opportunity.stageName.getDescribe();
        List<Schema.PicklistEntry> Pe = pi.getPicklistValues();
        stagePicklist = new List<selectoption>();
        Set<String> avilableStageSet = new Set<String>();//this set is used to check sin stage records that record is available on record type or not
        if(availableRecordTypeStages != NULL && availableRecordTypeStages.trim().length() > 0 && availableRecordTypeStages.endsWith('___')){
          avilableStageSet.addAll(availableRecordTypeStages.split('___'));
        }
        for(Schema.PicklistEntry obj : pe){
            if(avilableStageSet.size() == 0 || avilableStageSet.contains(obj.getValue())){
              stagePicklist.add(new selectoption(obj.getValue(),obj.getLabel()));         
            }
        }
        system.debug('##stagePicklist=' + stagePicklist);
        
        //Get response picklist values
        pi = PbxQuestion__c.responseType__c.getDescribe();
        Pe = pi.getPicklistValues();
        responsePicklist = new List<selectoption>();
        for(Schema.PicklistEntry obj : pe){
            responsePicklist.add(new selectoption(obj.getValue(),obj.getLabel()));         
        }
        
        //get content workspace records
        libraryList = new List<selectoption>();
        for(contentWorkspace obj : [select id,name from contentWorkspace LIMIT 1000]){
            libraryList.add(new selectoption(obj.id,obj.name));
        }
        if(libraryList.size() > 0){
            selectedLibId = libraryList.get(0).getValue();
        }
        //get content list
        fillContents();
        
    }
    public void fillContents(){
        //get content list
        system.debug('##selectedLibId='+selectedLibId);
        system.debug('##selectedToolStr='+selectedToolStr);
        contentList = new List<selectoption>();
        for(contentDocument obj : [select id,title from contentDocument where parentid = :selectedLibId LIMIT 1000]){
            contentList.add(new selectoption(obj.id,obj.title));
        }
        selectedContentId ='';
        if(contentList.size() > 0){
            selectedContentId = contentList.get(0).getValue();
        }
        system.debug('##contentList='+contentList);
    }
    
    public void getPlayDetails(){
        if(playObjIdForUpdate != null && playObjIdForUpdate.trim().length() > 0){
            questionList = [select id,name__c,points__c,play__c,(select id,name,answer__c,weight__c,flagtype__c from answers__r order by sortPosition__c),description__c,IncludedInDealProgress__c,IncludedInExecSummary__c,IncludedInKeyMilestones__c,IncludedInSuccessIndicators__c,Tip__c,ResponseType__c,IncludedInAssessment__c,IncludedInDiscussion__c from PbxQuestion__c where Play__c = :playObjIdForUpdate order by sortPosition__c];   
            messageList = [select id,name__c,description__c,play__c,Tip__c,IncludedInAssessment__c,IncludedInDiscussion__c from PbxMessage__c where Play__c = :playObjIdForUpdate order by sortPosition__c]; 
            toolList = [select id,name__c,description__c,play__c,Tip__c,DocumentId__c,WorkspaceId__c,Link__c,IncludedInCompetition__c, IncludedInCallManagementDiscussion__c, IncludedInGeneral__c, IncludedInObjectionHandling__c, IncludedInProduct__c, IncludedInSuccessStories__c from Pbxtool__c where Play__c = :playObjIdForUpdate order by sortPosition__c];   
            trainingList = [select id, name__c, description__c, Play__c, Tip__c, DocumentId__c, WorkspaceId__c, Link__c, IncludedInCompetition__c, IncludedInGeneral__c, IncludedInObjectionHandling__c, IncludedInIndustry__c, IncludedInSuccessStories__c, IncludedInCallManagementDiscussion__c, IncludedInProduct__c from PbxTraining__c where Play__c = :playObjIdForUpdate order by sortPosition__c];
            
            if(playNameMap != null && playNameMap.containsKey(playObjIdForUpdate)){
                playNameForModal = playNameMap.get(playObjIdForUpdate);
            }
            fillStageModal();
        }
    }
    public void fillStageModal(){
        stageMdlList = new List<StageModal>();
        playNameMap = new Map<string,string>();
        Set<String> avilableStageSet = new Set<String>();//this set is used to check sin stage records that record is available on record type or not
        if(availableRecordTypeStages != NULL && availableRecordTypeStages.trim().length() > 0 && availableRecordTypeStages.endsWith('___')){
          avilableStageSet.addAll(availableRecordTypeStages.split('___'));
        }
        //playOldOrders = new Map<String,List<PbxPlay__c>>();
        system.debug('##avilableStageSet' + avilableStageSet);
        if(processId != null && processId.trim().length() > 0){
            stagesForDuplicate = '';
            for(PbxStage__c obj : [select id,name__c,description__c,isLibrary__c,( select id,name__c,description__C from Plays__r order by sortPosition__c) from PbxStage__c where process__c = :processId order by SortPosition__c]){
                if(avilableStageSet.size() == 0 || avilableStageSet.contains(obj.name__c)){
                  StageModal mdlObj = new StageModal();
                  mdlObj.stgObj = obj;
                  stagesForDuplicate += obj.name__c + ';';
                  for(PbxPlay__c innerObj : obj.plays__r){
                      mdlObj.pList.add(innerObj);
                      playNameMap.put(innerObj.id,innerObj.name__c);    
                  }
                  stageMdlList.add(mdlObj);
                }    
            }
            system.debug('##avilableStageSet=' + avilableStageSet);
            system.debug('##stageMdlList=' + stageMdlList);
            if(stagesForDuplicate.length() > 0){
                stagesForDuplicate = stagesForDuplicate.subString(0,stagesForDuplicate.length()-1);        
            }
        }    
    }
    
    public void insertStage(){
        system.debug('##insertStageIN');
        try{
            if(processId != null && processId.trim().length() > 0){
                if(stageObj.name__c != null && stageObj.name__c.trim().length() > 0){
                    stageObj.name = stageObj.name__c;
                    stageObj.process__c = processId;
                    if(stageSortMap.containsKey(stageObj.name__c)){
                      stageObj.sortPosition__c = stageSortMap.get(stageObj.name__c);
                    }
                    insert stageObj;
                    stageObj = new PbxStage__c();
                    //initializations();
                    fillStageModal();
                      
                }
            }
        }catch(Exception e){
            system.debug('Exception==>'+ e.getMessage());
        }
    }
    public void updateStage(){
        try{
            if(processId != null && processId.trim().length() > 0){
                if(stageObj.name__c != null && stageObj.name__c.trim().length() > 0 && stageObjIdForUpdate != null && stageObjIdForUpdate.trim().length() > 0){
