    public LeadPlaymakerController(ApexPages.StandardController sc){
        initializations();
        leadId = sc.getId();
        //We are fetching opportunity record below , because we are not calling init() from here now , it will be called from page after gether available stages for currect record type(SOAP API)
        //init();
