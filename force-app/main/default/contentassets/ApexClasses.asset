    {
        Savepoint sp = Database.setSavepoint();
        
        List<Opportunity> opps = [ SELECT Id, StageName
                                   FROM Opportunity
                                   WHERE id = :opportunityIds ];
        
        if(opps == null || opps.size() != opportunityIds.size() )
        {
