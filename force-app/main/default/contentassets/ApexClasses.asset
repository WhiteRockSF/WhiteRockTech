"01p15000006zG2IAAU","","TestUpdateSortPositionQuestion","36.0","Active","false","2.919581548E9","/*
        Name        :    TestUpdateSortPositionQuestion
        Date        :    12 May 2016
        Author      :
        Description :    
*/
@isTest
public Class TestUpdateSortPositionQuestion{
    static testMethod void unitTest1(){
        PbxProcess__c process = TestCoverageUtility.createPbxProcess(70,'test');
        insert process;
        
        PbxStage__c Stage = TestCoverageUtility.createPbxStage('testStage',process.id);
        insert stage;
        
        PbxPlay__c play = TestCoverageUtility.createPbxPlay('test play',process.id,stage.id);
        insert play;
        
        PbxQuestion__c ques = TestCoverageUtility.createPbxQuestion('Test ques',process.id);
        ques.play__c = play.id;
        insert ques;
        system.assertEquals([select id,sortPosition__c from PbxQuestion__c where id =:ques.id].sortPosition__c,0);
        
        PbxQuestion__c quest = TestCoverageUtility.createPbxQuestion('Test ques',process.id);
        quest.play__c = play.id;
        quest.sortPosition__c = 2;
        insert quest;
        
        //sorting answer
        PbxAnswer__c ans1 = new PbxAnswer__c ();
        ans1.Question__c= quest.id;
        ans1.sortPosition__c = 1;
        insert ans1 ;
        
        PbxAnswer__c ans2 = new PbxAnswer__c ();
        ans2.Question__c= quest.id;
        ans2.sortPosition__c = 2;
        insert ans2 ;
        
        ans1.sortPosition__c = 2;
        update ans1;
        
        delete ans1;
        
        system.assertEquals([select id,sortPosition__c from PbxQuestion__c where id =:quest.id].sortPosition__c,3);
        delete ques;
        system.assertEquals([select id,sortPosition__c from PbxQuestion__c where id =:quest.id].sortPosition__c,2);
    }
