"01p15000006alrbAAA","","LightningRecordDetailHeaderController","35.0","Active","false","2.948855499E9","public class LightningRecordDetailHeaderController{
    public opportunity oppObj{get;set;} 
    
    
    public List<task> getNextTaskList(){
        system.debug('##='+oppObj.id);
        
        if(oppObj != null && oppObj.id != null){
            List<task> taskList = [select id,Priority,Status,ActivityDate,Subject,description from task where whatid = :oppObj.id and status != 'Completed' ];
            if(taskList != null && taskList.size() > 0)
                return taskList;
            else
                return new List<task>(); 
        }
        return new List<task>(); 
    }
    
    public List<task> getPastTaskList(){
        system.debug('##='+oppObj.id);
        
        if(oppObj != null && oppObj.id != null){
            List<task> taskList = [select id,Priority,Status,Subject,ActivityDate,description from task where whatid = :oppObj.id and status = 'Completed' ];
            if(taskList != null && taskList.size() > 0)
                return taskList;
            else
                return new List<task>(); 
        }
        return new List<task>(); 
    }
