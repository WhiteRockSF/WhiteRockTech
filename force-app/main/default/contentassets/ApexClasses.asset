    /*
  Update play's stage when drag play and drop to other stage. 
  */
  @RemoteAction 
  global static string updatePlayLocation(string playId, string stageId, boolean isParentChanged, Integer playOldPosition, Integer playNewPosition, string oldStageId){
      try{    
           //system.debug('playId == > '+playId);
          //system.debug('stageId == > '+stageId);
          //system.debug('isParentChanged == > '+isParentChanged);
          //system.debug('playOldPosition == > '+playOldPosition);
          //system.debug('playNewPosition == > '+playNewPosition);
          //system.debug('oldStageId == > '+oldStageId);         
           //[SELECT Stage__c FROM PbxPlay__c WHERE Id = : playId];  
           
           // Update current droped play.    
          PbxPlay__c play = new PbxPlay__c();
          play.Id = playId;              
      play.Stage__c = stageId;
      play.SortPosition__c = playNewPosition;
      update play;     
        
        List<PbxPlay__c> stagePlayOrders = new List<PbxPlay__c>();
        
        // Update play order in same stage.
        if(!isParentChanged){
          // Updating play's sort order of same stage
              // Drop down to up
              if(playOldPosition > playNewPosition){
                for(PbxPlay__c playObj : [SELECT Id, SortPosition__c FROM PbxPlay__c WHERE SortPosition__c >= :playNewPosition AND SortPosition__c < :playOldPosition AND Stage__c = :stageId AND Id != :play.Id]){
                  if(playObj.SortPosition__c == null){
                    playObj.SortPosition__c = 0;
                  }
                  playObj.SortPosition__c ++;
                  stagePlayOrders.add(playObj);                  
                }
              }
              // Drop up to down
              else if(playOldPosition < playNewPosition){
                for(PbxPlay__c playObj : [SELECT Id, SortPosition__c FROM PbxPlay__c WHERE SortPosition__c > :playOldPosition AND SortPosition__c <= :playNewPosition AND Stage__c = :stageId AND Id != :play.Id] ){
                  if(playObj.SortPosition__c == null){
                    playObj.SortPosition__c = 0;  
                  }                
                  playObj.SortPosition__c --; 
                  stagePlayOrders.add(playObj);
                }
              }         
              
        } else {
          
          // Updating play's sort order of different stage
              // Get new parent stage orders to update
              for(PbxPlay__c playObj : [SELECT Id, SortPosition__c FROM PbxPlay__c WHERE SortPosition__c >= : playNewPosition AND Stage__c =: stageId AND Id != :play.Id]){
                if(playObj.SortPosition__c == null){
                  playObj.SortPosition__c = 0;
                }                
                playObj.SortPosition__c ++;
                stagePlayOrders.add(playObj);                
              }
              
              // Get old parent stage orders to update
              for(PbxPlay__c playObj : [SELECT Id, SortPosition__c FROM PbxPlay__c WHERE SortPosition__c > : playOldPosition AND Stage__c =: oldStageId AND Id != :play.Id] ){
                if(playObj.SortPosition__c == null){
                  playObj.SortPosition__c = 0;
                }
                playObj.SortPosition__c --; 
                stagePlayOrders.add(playObj);
              }
              
        }
          
          update stagePlayOrders;
          return 'Success: Saved successfully!'; 
       }catch(Exception e){         
         return 'Error: '+e.getMessage();                        
      }
  }
    
