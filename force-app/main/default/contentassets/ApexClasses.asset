@isTest
public Class TestUpdateSortPositionTool {
    static testMethod void unitTest1(){
        PbxProcess__c process = TestCoverageUtility.createPbxProcess(70,'test');
        insert process;
        
        PbxStage__c Stage = TestCoverageUtility.createPbxStage('testStage',process.id);
        insert stage;
        
        PbxPlay__c play = TestCoverageUtility.createPbxPlay('test play',process.id,stage.id);
        insert play;
        
        PbxTool__c tool1 = TestCoverageUtility.createPbxTool('test tool',play.id);
        insert tool1;
        system.assertEquals([select id,sortPosition__c from PbxTool__c where id =:tool1.id].sortPosition__c,0);
        
        PbxTool__c tool = TestCoverageUtility.createPbxTool('test tool',play.id);
        tool.sortPosition__c = 3;
        insert tool;
        system.assertEquals([select id,sortPosition__c from PbxTool__c where id =:tool.id].sortPosition__c,4);
        
        delete tool1;
        system.assertEquals([select id,sortPosition__c from PbxTool__c where id =:tool.id].sortPosition__c,3);
    }
