    private void retrieveOppRecord(){
        String opportunityFields = '';
        recordTypeFieldForQuery = '';
        //we are fetching record type infos here also because if any org has no record types for opportunity then our code will not break
        for(RecordTypeInfo info: opportunity.SObjectType.getDescribe().getRecordTypeInfos()) {
            if(info.isAvailable() && !info.isMaster()) {
                recordTypeFieldForQuery = ', recordTypeId';
            }
        }    
        
        /** fetching fields for opportunity*/         
        Map<String, Schema.SObjectField> schemaFieldMap = Schema.SObjectType.Opportunity.fields.getMap();
        for(String field : schemaFieldMap.keySet()){
            if(!field.equalsIgnoreCase('recordtypeid'))
                opportunityFields += field + ',';
        }
        /** */
        
        System.debug('@@@@@ ' + opportunityFields);
        //List<Opportunity> opps = Database.query('select id,name,SICCode_Mapping__c,stageName,createdbyid,createdby.name,createddate,lastmodifieddate,lastmodifiedbyid,lastmodifiedby.name,DeliveryInstallationStatus__c,TrackingNumber__c,MainCompetitors__c,CurrentGenerators__c,ExpectedRevenue,type,leadsource,NextStep,probability,Campaign.name,Campaignid,OrderNumber__c,isPrivate,accountid,account.name,ownerid,owner.name,closedate,amount ' + recordTypeFieldForQuery +' from opportunity where Id =: oppId');
        List<Opportunity> opps = Database.query('select ' + opportunityFields  + 'createdby.name,lastmodifiedby.name,Campaign.name,account.name,owner.name ' + recordTypeFieldForQuery +' from opportunity where Id =: oppId');
        
        if(opps != NULL && opps.size() > 0){
            oppObj = opps.get(0);
            if(recordTypeFieldForQuery.trim().length() > 0)
                currentRecordTypeId = (String)oppObj.get('recordTypeId');
        }   
    }
    
