"09915000000b0eYAAQ","","LightningRecordDetailHeaderComponent","35.0","LightningRecordDetailHeaderComponent","","2","LightningRecordDetailHeaderController","<apex:component controller=""LightningRecordDetailHeaderController"" allowDML=""true"">

<script>
    var assetsLocation = '{!URLFOR($Resource.slds)}';

    $.aljsInit({
        assetsLocation: assetsLocation,
        scoped: true
    });
</script>  
<apex:attribute name=""opp"" type=""opportunity"" description=""get opportunity object"" assignTo=""{!oppObj}"" required=""true""/>      
<html xmlns=""http://www.w3.org/2000/svg"" xmlns:xlink=""http://www.w3.org/1999/xlink"">
    <apex:variable value=""{!if(oppObj.StageName != null ,true,false)}"" var=""statusFlag""/>
    <head>
        <style>
            <!-- For make checkbox blue -->    
            <!--
            .slds .slds-checkbox [type=""checkbox""]:checked ~ .slds-checkbox--faux:after {
               border-bottom: 2px solid white;
               border-left: 2px solid white;
            }
           .slds-checkbox--faux{
               background-color:#1589ee;            
           }
           .slds .slds-checkbox .slds-checkbox--faux{
               background-color:#1589ee;
               border:0;
           }
           .slds .slds-checkbox [type=""checkbox""]:focus:checked ~ .slds-checkbox--faux {
               background-color:#1589ee;
           }
           -->
           <!-- For make checkbox blue -->  
           
            
        </style>
     </head>
     
    <body class=""slds"">
        <div class=""slds-page-header"" role=""banner"">
          <div class=""slds-grid slds-wrap"">
            <div class=""slds-col slds-has-flexi-truncate"">
              <div class=""slds-media"">
                <div class=""slds-media__figure"">
                  <svg aria-hidden=""true"" class=""slds-icon slds-icon--large slds-icon-standard-opportunity"">
                    <use xlink:href=""{!URLFOR($Resource.slds, 'assets/icons/standard-sprite/svg/symbols.svg#opportunity')}""></use>
                  </svg>
                </div>
                <div class=""slds-media__body"">
                  <p class=""slds-text-heading--label"">OPPORTUNITY</p>
                  <div class=""slds-grid"">
                    <h1 class=""slds-text-heading--medium slds-m-right--small slds-truncate slds-align-middle oppName"" title=""{!oppObj.name}"">{!oppObj.name}</h1>
                    <div class=""slds-col slds-shrink-none"">
                      <button class=""slds-button slds-button--neutral slds-not-selected"" aria-live=""assertive"">
                        <span class=""slds-text-not-selected"">
                          <svg aria-hidden=""true"" class=""slds-button__icon--stateful slds-button__icon--left"">
                            <use xlink:href=""{!URLFOR($Resource.slds, 'assets/icons/utility-sprite/svg/symbols.svg#add')}""></use>
                          </svg>Follow</span>
                        <span class=""slds-text-selected"">
                          <svg aria-hidden=""true"" class=""slds-button__icon--stateful slds-button__icon--left"">
                            <use xlink:href=""{!URLFOR($Resource.slds, 'assets/icons/utility-sprite/svg/symbols.svg#check')}""></use>
                          </svg>Following</span>
                        <span class=""slds-text-selected-focus"">
                          <svg aria-hidden=""true"" class=""slds-button__icon--stateful slds-button__icon--left"">
                            <use xlink:href=""{!URLFOR($Resource.slds, 'assets/icons/utility-sprite/svg/symbols.svg#close')}""></use>
                          </svg>Unfollow</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class=""slds-col slds-no-flex slds-align-bottom"">
              <div class=""slds-button-group"" role=""group"">
                <button class=""slds-button slds-button--neutral"">Edit</button>
                <button class=""slds-button slds-button--neutral"">Delete</button>
                <button class=""slds-button slds-button--neutral"">Clone</button>
                <div class=""slds-button--last"">
                  <button class=""slds-button slds-button--icon-border-filled"">
                    <svg aria-hidden=""true"" class=""slds-button__icon"">
                      <use xlink:href=""{!URLFOR($Resource.slds, 'assets/icons/utility-sprite/svg/symbols.svg#down')}""></use>
                    </svg>
                    <span class=""slds-assistive-text"">More</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
          <div class=""slds-grid slds-page-header__detail-row slds-m-left--medium slds-m-top--medium"">
            <div class=""slds-col--padded slds-size--1-of-4 slds-m-left--x-large"">
              <dl>
                <dt>
                  <p class=""slds-text-heading--label slds-truncate"" title=""ACCOUNT NAME"">ACCOUNT NAME</p>
                </dt>
                <dd>
                  <p><a class=""accName"" href=""/{!oppObj.accountid}"">{!oppObj.account.name}</a></p>
                </dd>
              </dl>
            </div>
            <div class=""slds-col--padded slds-size--1-of-4"">
              <dl>
                <dt>
                  <p class=""slds-text-heading--label slds-truncate"" title=""CLOSE DATE"">CLOSE DATE</p>
                </dt>
                <dd>
                  <p class=""slds-text-body--regular closeDate"">{!oppObj.closedate}</p>
                </dd>
              </dl>
            </div>
            <div class=""slds-col--padded slds-size--1-of-4"">
              <dl>
                <dt>
                  <p class=""slds-text-heading--label slds-truncate"" title="""">AMOUNT</p>
                </dt>
                <dd><p class=""slds-text-body--regular oppAmount"">{!oppObj.amount}</p></dd>
              </dl>
            </div>
            <div class=""slds-col--padded slds-size--1-of-4"">
              <dl>
                <dt>
                  <p class=""slds-text-heading--label slds-truncate"" title=""OPPORTUNITY OWNER"">OPPORTUNITY OWNER</p>
                </dt>
                <dd>
                  <p>
                    <a class=""oppOwner"" href=""/{!oppObj.ownerid}"">{!oppObj.owner.name}</a>
                  </p>
                </dd>
              </dl>
            </div>
          </div>
        </div>  
        <!-- record header finish -->
        <div class=""slds-grid slds-wrap slds-m-left--medium slds-m-top--medium"">
            <div class=""slds-col--padded slds-size--9-of-12"">
                <center>
                    <apex:variable value=""false"" var=""statusGreyFlag""/>
            
                    <div class=""slds-tabs--path"" role=""application tablist"">
                      <ul class=""slds-tabs--path__nav"" role=""presentation"">
                        <li class=""slds-tabs--path__item {!if(statusFlag ,if(oppObj.StageName == 'Prospecting','slds-is-current','slds-is-complete'),'slds-is-incomplete')}"" role=""presentation"">
                          <a class=""slds-tabs--path__link"" aria-selected=""false"" tabindex=""-1"" role=""tab"" href=""#void"" aria-live=""assertive"">
                            <span class=""slds-tabs--path__stage"">
                              <svg aria-hidden=""true"" class=""slds-icon slds-icon--x-small"">
                                <use xlink:href=""{!URLFOR($Resource.slds, 'assets/icons/utility-sprite/svg/symbols.svg#check')}""></use>
                              </svg>
                            </span>
                            <span class=""slds-tabs--path__title"">Prospecting </span>
                          </a>
                          
                        </li>
                        
                        <apex:variable value=""{!if(oppObj.StageName == 'Prospecting','true',statusGreyFlag)}"" var=""statusGreyFlag""/>
                        
                        <li class=""slds-tabs--path__item {!if(statusFlag ,if(oppObj.StageName == 'Qualification','slds-is-current',if(statusGreyFlag == 'true','slds-is-incomplete','slds-is-complete')),'slds-is-incomplete')}"" role=""presentation"">
                          <a class=""slds-tabs--path__link"" aria-selected=""false"" tabindex=""-1"" role=""tab"" href=""#void"" aria-live=""assertive"">
                            <span class=""slds-tabs--path__stage"">
                              <svg aria-hidden=""true"" class=""slds-icon slds-icon--x-small"">
                                <use xlink:href=""{!URLFOR($Resource.slds, 'assets/icons/utility-sprite/svg/symbols.svg#check')}""></use>
                              </svg>
                              <span class=""slds-assistive-text"">Stage Complete</span>
                            </span>
                            <span class=""slds-tabs--path__title"">Qualification</span>
                          </a>
                        </li>
                        
                        <apex:variable value=""{!if(oppObj.StageName == 'Qualification','true',statusGreyFlag)}"" var=""statusGreyFlag""/>
                        
                        <li class=""slds-tabs--path__item {!if(statusFlag ,if(oppObj.StageName == 'Needs Analysis','slds-is-current',if(statusGreyFlag == 'true','slds-is-incomplete','slds-is-complete')),'slds-is-incomplete')}"" role=""presentation"">
                          <a class=""slds-tabs--path__link"" aria-selected=""false"" tabindex=""-1"" role=""tab"" href=""#void"" aria-live=""assertive"">
                            <span class=""slds-tabs--path__stage"">
                              <svg aria-hidden=""true"" class=""slds-icon slds-icon--x-small"">
                                <use xlink:href=""{!URLFOR($Resource.slds, 'assets/icons/utility-sprite/svg/symbols.svg#check')}""></use>
                              </svg>
                              <span class=""slds-assistive-text"">Stage Complete</span>
                            </span>
                            <span class=""slds-tabs--path__title"">Needs Analysis</span>
                          </a>
                        </li>
                        
                        <apex:variable value=""{!if(oppObj.StageName == 'Needs Analysis','true',statusGreyFlag)}"" var=""statusGreyFlag""/>
                        
                        <li class=""slds-tabs--path__item {!if(statusFlag ,if(oppObj.StageName == 'Value Proposition','slds-is-current',if(statusGreyFlag == 'true','slds-is-incomplete','slds-is-complete')),'slds-is-incomplete')}"" role=""presentation"">
                          <a class=""slds-tabs--path__link"" aria-selected=""false"" tabindex=""0"" role=""tab"" href=""#void"" aria-live=""assertive"">
                            <span class=""slds-tabs--path__stage"">
                              <svg aria-hidden=""true"" class=""slds-icon slds-icon--x-small"">
                                <use xlink:href=""{!URLFOR($Resource.slds, 'assets/icons/utility-sprite/svg/symbols.svg#check')}""></use>
                              </svg>
                            </span>
                            <span class=""slds-tabs--path__title"">Value Proposition</span>
                          </a>
                        </li>
                        
                        <apex:variable value=""{!if(oppObj.StageName == 'Value Proposition','true',statusGreyFlag)}"" var=""statusGreyFlag""/>
                        
                        <li class=""slds-tabs--path__item {!if(statusFlag ,if(oppObj.StageName == 'Id. Decision Makers','slds-is-current',if(statusGreyFlag == 'true','slds-is-incomplete','slds-is-complete')),'slds-is-incomplete')}"" role=""presentation"">
                          <a class=""slds-tabs--path__link"" aria-selected=""false"" tabindex=""-1"" role=""tab"" href=""#void"" aria-live=""assertive"">
                            <span class=""slds-tabs--path__stage"">
                              <svg aria-hidden=""true"" class=""slds-icon slds-icon--x-small"">
                                <use xlink:href=""{!URLFOR($Resource.slds, 'assets/icons/utility-sprite/svg/symbols.svg#check')}""></use>
                              </svg>
                            </span>
                            <span class=""slds-tabs--path__title"">Id. Decision Makers</span>
                          </a>
                        </li>
                        
                        <apex:variable value=""{!if(oppObj.StageName == 'Id. Decision Makers','true',statusGreyFlag)}"" var=""statusGreyFlag""/>
                        
