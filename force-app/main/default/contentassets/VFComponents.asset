                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">Close Date</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <apex:outputField value=""{!oppObj.closedate}"" />
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>
                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">Account Name</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <a href=""/{!oppObj.accountid}""><apex:outputField styleclass=""slds-text-body--regular "" value=""{!oppObj.account.name}"" /></a>
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>
                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">Next Step</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <apex:outputField value=""{!oppObj.NextStep}""/>
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>
                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">Type</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <apex:outputField value=""{!oppObj.type}""/>
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>
                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">Stage</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <apex:outputField value=""{!oppObj.stagename}""/>
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>
                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">Lead Source</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <apex:outputField value=""{!oppObj.LeadSource}""/>
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>
                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">Probability</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <apex:outputField value=""{!oppObj.Probability}""/>
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>
                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">Order Number</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <apex:outputField value=""{!oppObj.OrderNumber__c}""/>
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>
                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">  Primary Campaign Source</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <apex:outputField value=""{!oppObj.Campaign.name}""/>
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>
                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">Current Generator(s)</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <apex:outputField value=""{!oppObj.CurrentGenerators__c}""/>
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>
                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">Main Competitor(s)</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <apex:outputField value=""{!oppObj.MainCompetitors__c}""/>
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>
                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">Delivery/Installation Status</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <apex:outputField value=""{!oppObj.DeliveryInstallationStatus__c}""/>
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>
                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">Tracking Number</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <apex:outputField value=""{!oppObj.TrackingNumber__c}""/>
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>    
                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">Created By</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <a href=""/{!oppObj.createdbyid}""><apex:outputField value=""{!oppObj.createdby.name}""/></a>, <apex:outputField value=""{!oppObj.createddate}""/>
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>    
                            <div class=""slds-large-size--1-of-2 slds-col--padded"">
                                <div class=""slds-form-element"">
                                    
                                    <label class=""slds-text-body--small slds-form-element__label slds-form-element__label--small"">Last Modified By</label>
                                    <div class=""slds-form-element__control slds-p-top--xx-small"">
                                        <a href=""/{!oppObj.lastmodifiedbyid}""><apex:outputField value=""{!oppObj.lastmodifiedby.name}""/></a>, <apex:outputField value=""{!oppObj.lastmodifieddate}""/>
                                    </div>
                                </div>
                                <hr style=""margin-top:10px;margin-bottom:0px""/>
                            </div>  
                        </div>        
                    </div>
                </div>
            </div>
            <div class=""slds-col--padded slds-size--4-of-12"">
            </div>
        </div>
        
        
        
        
        
        <script>
            $(document).ready(function() {
                $('[data-aljs=""tabs""]').tabs();
            });
            
        </script>
    </body>
</html>
