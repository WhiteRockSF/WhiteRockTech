"066150000039rMKAAY","","LeadPlaymakerPDF","26.0","LeadPlaymakerPDF","","2","LeadPlaymakerPDFController","false","false","<apex:page showHeader=""false"" controller=""LeadPlaymakerPDFController"" renderAs=""PDF"">
<head>
    <meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"" />
    <style type=""text/css"">
        html {
            font-size: 100%;
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }
        body {
            margin: 0;
            font-family: ""Helvetica Neue"",Helvetica,Arial,sans-serif;
            font-size: 12px;
            line-height: 16px;
            color: #333;
            background-color: white;
        }
        h4 {
            font-size: 17.5px;
        }
        h5 {
            font-size: 14px;
        }
        h1, h2, h3, h4, h5, h6 {
            margin: 0;
            font-family: inherit;
            font-weight: bold;
            line-height: 20px;
            color: inherit;
            text-rendering: optimizelegibility;
        }
        
        .container {
            margin-right: auto;
            margin-left: auto;
            width: 690px;
        }
        
        .row {
            margin-left: -20px;
        }
        
        .span12 {
            width: 690px;
            float: left;
            min-height: 1px;
            margin-left: 20px;
        }
        
        .Red {
            color:red;
        }
        
        .table {
            width: 100%;
            margin-bottom: 20px;
            background-color: transparent;
            border-collapse: collapse;
        }
        
        .table th, .table td {
            padding: 8px;
            text-align: left;
            vertical-align: top;
            /*border-top: 1px solid #DDD;*/
            
        }
        
        .textbackground {
            background:#dbe5f1;
        }
        .headerText {
            color:#17365e;
            font-weight:bold;
        }
        .content {
            font-style:italic;
            font-size:12;
        }
        
        .answer {
            font-size:12;
        }
        
        .Table{
            max-width: 100%;
            background-color: transparent;
            border-collapse: collapse;
            font-size: 12px;
            border-spacing: 0;
        }
        
        .table td {
            border-top:1px solid #17365e;
            border-bottom:1px solid #17365e;
        }
        
        .table td img {
            vertical-align:middle;
            margin-right:10px;
        }
        
        .radio, .checkbox {
            min-height: 20px;
            padding-left: 20px;
        }
        label {
            display: block;
            margin-bottom: 5px;
        }
        
        label, input, button, select, textarea {
            font-size: 12px;
            font-weight: normal;
            line-height: 20px;
        }
    </style>
</head>
<body>
    <apex:form >
        <div class=""container"">
            <div class=""row"">
                <div class=""span12"" style=""background:#17365e; color:#fff;"">
                    <div style=""padding:10px;"">
                        <h4>Summary | <span style=""font-style:italic"">{!Lead.Name}</span></h4>
                    </div>
                </div>
            </div>
            <div class=""row"">
                <div class=""span12"">
                    <table class=""table"">
                        <tbody>
                            
                            <tr>
                                <td class=""textbackground headerText"">Status</td>
                                <td class=""headerText""><apex:outputField value=""{!Lead.Status}""/></td>
                            </tr>                    
                            <tr>
                                <td class=""textbackground headerText"">Red Flags</td>
                                <td class=""headerText"" style=""color:red"">{!ProcessInstance.RedFlagCount__c}</td>
                             </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <apex:outputPanel layout=""block"" rendered=""{!QuestionInstanceDiscussion.size > 0}"">
                <div class=""row"">
                    <div class=""span12"" style=""background:#17365e; color:#fff;"">
                        <div style=""padding:10px;"">
                        <h5>Call Management-Discussion</h5>
                        </div>
                    </div>
                </div>
                <div class=""row"" >
                    <div class=""span12"">
                        <table class=""table""  >
                            <tbody>
                            <apex:repeat value=""{!QuestionInstanceDiscussion}"" var=""qns"" id=""theRepeat"">
                                <tr>
                                    <td style=""width:40%;border-bottom:1px solid #17365e;"" class=""textbackground content""><apex:outputText value=""{!qns.Description__c}"" id=""theValue""/></td>
                                    <td style=""vertical-align:middle;border-bottom:1px solid #17365e;"" class=""answer"">
                                        <apex:repeat var=""ans"" value=""{!qns.AnswerInstances__r}"">
                                            <apex:outputLabel styleClass=""checkbox"" rendered=""{!ans.Selected__c}"" style=""{!IF(ans.FlagType__c=='Red' && ans.Selected__c ==true,'color:red','')}"">
                                            <apex:outputText value=""$"" rendered=""{!IF(qns.ResponseType__c=='Currency'&& ans.Selected__c ==true,true,false)}""/>
                                            <apex:outputField value=""{!ans.Answer__c}"" rendered=""{!ans.Selected__c}""/>                                
                                            </apex:outputLabel>
                                        </apex:repeat>
                                        <apex:outputField value=""{!qns.Note__c}"" rendered=""{!IF(ISBLANK(qns.Note__c) , false , true)}"" />
                                    </td>
                                </tr>
                            </apex:repeat>
                            </tbody>
                        </table>
                    </div>
                </div>
            </apex:outputPanel>
            <apex:outputPanel layout=""block"" rendered=""{!QuestionInstanceAssessment.size > 0}"">
                <div class=""row"">
                    <div class=""span12"" style=""background:#17365e; color:#fff;"">
                        <div style=""padding:10px;"">
                        <h5>Call Management-Assessment</h5>
                        </div>
                    </div>
                </div>
                <div class=""row"" >
                    <div class=""span12"">
                        <table class=""table"">
                            <tbody>
                            <apex:repeat value=""{!QuestionInstanceAssessment}"" var=""qns"" id=""theRepeatMilestone"">
                                <tr>
                                    <td style=""width:40%;border-bottom:1px solid #17365e;"" class=""textbackground content""><apex:outputText value=""{!qns.Description__c}"" id=""theValue""/></td>
                                    <td style=""vertical-align:middle;border-bottom:1px solid #17365e;"" class=""answer"">
                                        <apex:repeat var=""ans"" value=""{!qns.AnswerInstances__r}"">
                                            <apex:outputLabel styleClass=""checkbox"" rendered=""{!ans.Selected__c}"" style=""{!IF(ans.FlagType__c=='Red' && ans.Selected__c ==true,'color:red','')}"">
                                                <apex:outputText value=""$"" rendered=""{!IF(qns.ResponseType__c=='Currency'&& ans.Selected__c ==true,true,false)}""/>
                                                <apex:outputField value=""{!ans.Answer__c}"" rendered=""{!ans.Selected__c}""/>   
                                            </apex:outputLabel>
                                        </apex:repeat>
                                        <apex:outputField value=""{!qns.Note__c}"" rendered=""{!IF(ISBLANK(qns.Note__c) , false , true)}"" />
                                    </td>
                                </tr>
                            </apex:repeat>
                            </tbody>
                        </table>
                    </div>
                </div>
            </apex:outputPanel>
            <apex:outputPanel layout=""block"" rendered=""{!Notes.size > 0}"">
                <div class=""row"">
                    <div class=""span12"" style=""background:#17365e; color:#fff;"">
                        <div style=""padding:10px;"">
                        <h5>Deal Notes</h5>
                        </div>
                    </div>
                </div>
                <div class=""row"" >
                    <div class=""span12"">
                        <table class=""table"" >
                            <tbody>
                                <apex:repeat value=""{!Notes}"" var=""note"" id=""noteList"">
                                <tr>
                                    <td style=""border-bottom:1px solid #17365e;""><strong style=""float:left""><apex:outputText value=""{!note.Title}"" /></strong>
                                    <span style=""float:right""><apex:outputText value=""Posted by {!note.CreatedBy.FirstName} {!note.CreatedBy.LastName}, {0,date,MMMM dd', 'yyyy HH:mm:ss a}"">
                                        <apex:param value=""{!note.CreatedDate}"" />
                                    </apex:outputText></span>
                                        <p style=""clear:both""><apex:outputField value=""{!note.body}"" /></p>
                                    </td>
                                </tr>
                                </apex:repeat>
                            </tbody>
                        </table>
                    </div>
                </div>
            </apex:outputPanel>
        </div><!-- end of container -->
    </apex:form>
</body>
</apex:page>","2017-02-10T11:24:40.000Z","00515000006PhzjAAC","2017-02-15T11:52:22.000Z","00515000006PhzjAAC","2017-02-15T11:52:22.000Z"
