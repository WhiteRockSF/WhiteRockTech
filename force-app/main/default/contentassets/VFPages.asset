                        '{!$RemoteAction.PlaybooxBuilderController.updateMessageLocation}',
                        messageId,
                        playId,
                        parseInt(messageOldPosition), 
                        parseInt(messageNewPosition), 
                        function(result, event){
                            if (event.status) {
                               $('[id$=Status] [id$=start]').hide();
                               console.log('Saved successfully!');
