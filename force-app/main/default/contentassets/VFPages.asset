                        $('[id$=createMessageMsg]').last().remove();
                      else{
                        $('.cke_button_on').addClass('cke_button_off').removeClass('cke_button_on');
                      }
                      //$('.cke_editor_thePage:frm:createMessageMsg:textAreaDelegate_' + '{!NamespacePrifix}' + 'Description__c').last().remove();
                            
                  }
