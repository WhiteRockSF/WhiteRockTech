                                            <div class=""slds-form-element__control slds-input-has-icon slds-input-has-icon--right"">
                                                <svg aria-hidden=""true"" class=""slds-input__icon"" >
                                                  <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#event')}""></use>
                                                </svg> 
                                                <input id=""meetEndDate"" type=""Text""  Class=""dt slds-input"" placeholder=""Pick a Date""/>
                                            </div>
                                        </div>
                                        <div class=""slds-size--3-of-12"">
                                            <div class=""slds-form-element__control slds-input-has-icon slds-input-has-icon--right"">
                                                <svg aria-hidden=""true"" class=""meetEndSvg slds-input__icon"">
                                                  <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#clock')}""></use>
                                                </svg>
                                                <input type=""Text""  Class=""meetEndTime slds-input"" placeholder=""Pick a time""/>
                                            </div>
                                            <div class=""meetEndTimeDiv""></div>
                                        </div>
                                        <div class=""slds-size--5-of-12""></div>
                                    </div>
                                    <apex:inputHidden id=""meetEndTimeHidden"" value=""{!meetEndDateTimeStr}""/>
                                </div>
                                
                                <div class=""slds-form-element"">
                                    <label class=""formLabel slds-form-element__label"">Description</label>
                                    <div class=""slds-form-element__control"">
                                        <apex:inputField value=""{!evntMeetInsertObj.description}"" styleclass=""slds-textarea""/>
                                    </div>
                                </div>
                                
                            </div>
                            <div class=""slds-modal__footer"">
                                <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Cancel</button>
                                <button class=""slds-button slds-button--neutral slds-button--brand""  onclick=""updateEventDateTimeFields();return false"">Save</button>
                            </div>
                        </div>
                  </div>
                  <!--  create meeting event end -->
              </apex:actionRegion>
              <!--  send email modal start -->
              <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""sendEmailModal"">
                    <div class=""slds-modal__container"">
                        <div class=""slds-modal__header"">
                            <h2 class=""slds-text-heading--medium"">Compose</h2>
                            <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                                <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                                <span class=""slds-assistive-text"">Close</span>
                            </button>
                        </div>
                        <div class=""slds-modal__content"">
                            <div class=""slds-notify-container emailNotify""  style=""position:relative;display:none"">
                              <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                                <span class=""slds-assistive-text"">Info</span>
                                  
                                <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close"" onclick=""$('.emailNotify').hide(100);"">
                                  <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                                  <span class=""slds-assistive-text"">Close</span>
                                </a>
                                <div class=""notify__content"">
                                  <h2 class=""slds-text-heading--small"">
                                      <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                        <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                      </svg>
                                      <span class=""emailErrorMsg""></span>
                                  </h2>
                                </div>
                              </div>
                            </div>
                            
                            <div class=""slds-form-element"">
                                <label class=""formLabel slds-form-element__label"">To</label>
                                <div class=""slds-form-element__control"">
                                    <apex:inputText id=""emailTo"" value=""{!mailRecpt}"" styleclass=""slds-input""/>
                                </div>
                            </div>
                            
                            <div class=""slds-form-element"">
                                <label class=""formLabel slds-form-element__label"">Subject</label>
                                <div class=""slds-form-element__control"">
                                    <apex:inputText value=""{!mailSubject}"" styleclass=""slds-input""/>
                                </div>
                            </div>
                            
                            <div class=""slds-form-element "">
                                <label class=""formLabel slds-form-element__label"">Body</label>
                                <div class=""slds-form-element__control"">
                                    <apex:inputTextarea rows=""5"" value=""{!mailBody}"" styleclass=""slds-input""/>
                                </div>
                            </div>
                           
                            <div class=""slds-form-element slds-m-top--medium"">
                                <div class=""slds-form-element__control"">
                                    <div class=""fileUpload slds-button"">
                                        <c:SVGComponent styleClass=""slds-button__icon--stateful slds-icon--small"" path=""/assets/icons/utility-sprite/svg/symbols.svg#attach""/>
                                        <apex:inputFile styleclass=""upload"" value=""{!mailAttc.body}"" filename=""{!mailAttc.name}"" onchange=""$('.emailFileName').text($(this).val().split('\\').pop())""/>
                                        <span class=""emailFileName""></span>
                                    </div>
                                </div>
                            </div>  
                            
                        </div>
                        <div class=""slds-modal__footer"">
                            <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Cancel</button>
                            <apex:commandButton value=""Send"" styleclass=""slds-button slds-button--neutral slds-button--brand"" onclick=""$('[id$=callDisHidden]').val(expandClassDis);$('[id$=callAssHidden]').val(expandClassAss)"" action=""{!sendMail}""/>
                            
                        </div>
                    </div>
              </div>
              <!--  send email modal end -->
          </apex:form>
          
          
          <script>
              var selectedPlaybookID;
              
              var objIconMap = {};
              var iconClassMap1 = {};
              objIconMap[""contact""] = ""{!URLFOR($Resource.slds, 'assets/icons/standard-sprite/svg/symbols.svg#contact')}"";
              objIconMap[""lead""] = ""{!URLFOR($Resource.slds, 'assets/icons/standard-sprite/svg/symbols.svg#lead')}"";
              iconClassMap1[""{!URLFOR($Resource.slds, 'assets/icons/standard-sprite/svg/symbols.svg#contact')}""] = ""slds-icon-standard-contact"";
              iconClassMap1[""{!URLFOR($Resource.slds, 'assets/icons/standard-sprite/svg/symbols.svg#lead')}""] = ""slds-icon-standard-lead"";
              var addIcon = ""{!URLFOR($Resource.slds, 'assets/icons/utility-sprite/svg/symbols.svg#add')}"";
              var dashIcon = ""{!URLFOR($Resource.slds, 'assets/icons/utility-sprite/svg/symbols.svg#dash')}"";
                    
              var expandClassDis = '';
              var expandClassAss = '';
              
              var dateHtml = '';
              
              //used to show error notification in case of exception
              function showNotify(msg){
                if(msg != undefined && msg.trim().length > 0){
                    $('.NotificationBoxText').text(msg);
                    $('.NotificationBox').slideDown(400);
                }else{
                    $('.NotificationBox').slideUp(400);
                }
              }
               
              function changeTab(btnId){
                  $('[id$=ProcessManagement]').hide();
                  $('[id$=DealManagement]').hide();
                  $('[id$=CallManagement]').hide();
                  $('[id$=SalesTools]').hide();
                  $('[id$=SalesTraining]').hide();
                  
                  $('[id$=ProcessManagementBtn]').removeAttr('style');
                  $('[id$=DealManagementBtn]').removeAttr('style');
                  $('[id$=CallManagementBtn]').removeAttr('style');
                  $('[id$=SalesToolsBtn]').removeAttr('style');
                  $('[id$=SalesTrainingBtn]').removeAttr('style');
                  $('[id$=' + btnId.substr(0,btnId.length-3) + ']').show(500);
                  //$('[id$=' + btnId + ']').css('background','#215968').css('border','1px solid #215968');
                  $('[id$=' + btnId + ']').css('background','#00599c').css('border','1px solid #00599c');
                      
              }
              
              function updateTaskDateTimeFields(){
                  
                  $('[id$=taskReminderHidden]').val($('[id$=taskRemDate]').val() + ' ' +$('.taskRemTime').val());
                  checkValidation('Task');
              } 
              
              function updateEventDateTimeFields(){
                  $('[id$=meetEndTimeHidden]').val($('[id$=meetEndDate]').val() + ' ' +$('.meetEndTime').val());
                  $('[id$=meetStartTimeHidden]').val($('[id$=meetStartDate]').val() + ' ' +$('.meetStartTime').val());
                  checkValidation('MeetEvent');
                  
              } 
              
              function allowNumbersOnly(e,ele){
                  
                  //var code = e.which;
                  //console.log('#='+code);
                  if($(ele).val() != undefined && $(ele).val().trim().length > 0){
                      $(ele).val($(ele).val().replace(/[^0-9]+/, ''));   
                  }
                  /*if((code < 48 || code > 57) && (code < 96 || code > 105)){
                    if(code != 8 && code != 190 && code != 110){
                        //console.log('code = '+code);
                        e.preventDefault();
                    }
                  }*/
              }
              
              function allowPercentOnly(e,ele){
                  
                  //var code = e.which;
                  //console.log('#='+code);
                  if($(ele).val() != undefined && $(ele).val().trim().length > 0){
                      $(ele).val($(ele).val().replace(/[^0-9 .]+/, ''));   
                  }
                  /*if((code < 48 || code > 57) && (code < 96 || code > 105)){
                    if(code != 8 && code != 190 && code != 110){
                        //console.log('code = '+code);
                        e.preventDefault();
                    }
                  }*/
              }
              
              function changeCollapseBtn(cls,txtCls,size){
                  setTimeout(function() {
                   
                      var openFlag = false;
                      var closeFlag = false;
                      
                      for(var i = 1 ; i <= size ; i++){
                          if($('.'+cls+i).css('display') == 'none'){
                              closeFlag = true;
                              
                          }else{
                              closeFlag = false;
                              break;
                          }       
                      }
                      for(var i = 1 ; i <= size ; i++){
                          if($('.'+cls+i).css('display') != 'none'){
                              openFlag = true;
                          }else{
                              openFlag = false;
                              break;
                          }       
                      }
                      console.log('##openflag='+openFlag);
                      console.log('##closeflag='+closeFlag);
                          
                      if(openFlag){
                          $('.'+txtCls).text('Close All');
                          var svgIcon = $('.'+txtCls).prev().children().children().attr('xlink:href');
                          $('.'+txtCls).prev().children().attr('xlink:href',dashIcon);
                      }else if(closeFlag){
                          $('.'+txtCls).text('Open All');
                          var svgIcon = $('.'+txtCls).prev().children().children().attr('xlink:href');
                          $('.'+txtCls).prev().children().attr('xlink:href',addIcon);
                      }
                  },300);         
              }
              
              
              function collapseToggleAll(cls,txtCls,size){
                  if(size != undefined && size > 0){
                      if($('.'+txtCls).text() == 'Open All'){
                          for(var i = 1 ; i <= size ; i++){
                              $('.'+cls+i).show(250);
                              console.log('#' + cls+i)
                          }
                      }else if($('.'+txtCls).text() == 'Close All'){
                          for(var i = 1 ; i <= size ; i++){
                              $('.'+cls+i).hide(250);
                              console.log('#' + cls+i)
                          }
                      }
                      changeCollapseBtn(cls,txtCls,size);  
                  }
              }
              
              //check Validations
              function checkValidation(mdl){
                  
                  if(mdl == 'CreateNote'){
                      if($('[id$=createNoteTitle]').val() != undefined && $('[id$=createNoteTitle]').val() != null && $('[id$=createNoteTitle]').val().trim().length > 0){
                          $('.createNoteNotify').hide();
                          $('[id$=createNoteTitle]').parent().removeClass('slds-has-error');
                          $('.errorMsg').remove();
                          $('[id$=noteModal]').modal('dismiss');
                          createNote();
                      }else{
                          $('.createNoteNotify').show();
                          $('.createNoteErrorMsg').text('You must have to fill title!');
                          $('[id$=createNoteTitle]').parent().addClass('slds-has-error');
                          if($('.errorMsg').length == 0){
                              var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                              $('[id$=createNoteTitle]').after(ele);
                          }
                      }
                  }else if(mdl == 'Competitor'){
                      if($('[id$=createCompetitorName]').val() != undefined && $('[id$=createCompetitorName]').val() != null && $('[id$=createCompetitorName]').val().trim().length > 0){
                          $('.createCompetitorNotify').hide();
                          $('[id$=createCompetitorName]').parent().removeClass('slds-has-error');
                          $('.errorMsg').remove();
                          $('[id$=competitorModal]').modal('dismiss');
                          createCompetitor();
                      }else{
                          $('.createCompetitorNotify').show();
                          $('.createCompetitorErrorMsg').text('You must have to fill Competitor Name!');
                          $('[id$=createCompetitorName]').parent().addClass('slds-has-error');
                          if($('.errorMsg').length == 0){
                              var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                              $('[id$=createCompetitorName]').after(ele);
                          }
                      }
                  }else if(mdl == 'KeyStackeholder'){
                      
                      if($('[id$=cLKName]').val() != undefined && $('[id$=cLKName]').val() != null && $('[id$=cLKName]').val().trim().length > 0){
                          $('.stackeholderNotify').hide();
                          $('[id$=stackeholderPICName]').parent().parent().removeClass('slds-has-error');
                          $('.errorMsg').remove();
                          $('[id$=keystackeholderModal]').modal('dismiss');
                          createStackeholder();
                      }else{
                          $('.stackeholderNotify').show();
                          $('.stackeholderErrorMsg').text('You must have to select contact!');
                          $('[id$=cLKName]').parent().parent().addClass('slds-has-error');
                          if($('.errorMsg').length == 0){
                              var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                              $('[id$=cLKName]').parent().after(ele);
                          }
                      }
                  }else if(mdl == 'Task'){
                      if($('[id$=taskSubject]').val() === undefined || $('[id$=taskSubject]').val() === null || $('[id$=taskSubject]').val().trim().length == 0){   
                          $('.taskNotify').show();
                          $('.taskErrorMsg').text('You must have to fill Subject!');
                          $('[id$=taskSubject]').parent().addClass('slds-has-error');
                          if($('.errorMsg').length == 0){
                              var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                              $('[id$=taskSubject]').after(ele);
                          }   
                      }else{
                          $('.taskNotify').hide();
                          $('[id$=taskSubject]').parent().removeClass('slds-has-error');
                          $('.errorMsg').remove();
                          $('[id$=taskModal]').modal('dismiss');
                          createTask();
                      }
                  }else if(mdl == 'MeetEvent'){
                      if(($('[id$=meetStartDate]').val() === undefined || $('[id$=meetStartDate]').val() === null || $('[id$=meetStartDate]').val().trim().length == 0) || ($('.meetStartTime').val() === undefined || $('.meetStartTime').val() === null || $('.meetStartTime').val().trim().length == 0)){    
                          $('[id$=meetEndDate]').parent().removeClass('slds-has-error');
                          $('.meetEndTime').parent().removeClass('slds-has-error');
                          $('.errorMsg2').remove();
                          $('[id$=eventSubject]').parent().removeClass('slds-has-error');
                          $('.eventSubject').parent().removeClass('slds-has-error');
                          $('.errorMsg').remove();
                          
                          
                          $('.eventNotify').show();
                          $('.eventErrorMsg').text('You must have to fill Start Date & Time!');
                          $('[id$=meetStartDate]').parent().addClass('slds-has-error');
                          $('.meetStartTime').parent().addClass('slds-has-error');
                          if($('.errorMsg1').length == 0){
                              var ele = '<span class=""errorMsg1 slds-form-element__help"" style=""color:darkred"">This field is required</span>';
                              $('[id$=meetStartDate]').parent().after(ele);
                          }   
                      }else if(($('[id$=meetEndDate]').val() === undefined || $('[id$=meetEndDate]').val() === null || $('[id$=meetEndDate]').val().trim().length == 0) || ($('.meetEndTime').val() === undefined || $('.meetEndTime').val() === null || $('.meetEndTime').val().trim().length == 0)){  
                          $('[id$=meetStartDate]').parent().removeClass('slds-has-error');
                          $('.meetStartTime').parent().removeClass('slds-has-error');
                          $('.errorMsg1').remove();
                          
                          $('.eventNotify').show();
                          $('.eventErrorMsg').text('You must have to fill End Date & Time!');
                          $('[id$=meetEndDate]').parent().addClass('slds-has-error');
                          $('.meetEndTime').parent().addClass('slds-has-error');
                          if($('.errorMsg2').length == 0){
                              var ele = '<span class=""errorMsg2 slds-form-element__help"" style=""color:darkred"">This field is required</span>';
                              $('[id$=meetEndDate]').parent().after(ele);
                          }   
                      }else if(($('[id$=eventSubject]').val() === undefined || $('[id$=eventSubject]').val() === null || $('[id$=eventSubject]').val().trim().length == 0)){    
                          $('[id$=meetStartDate]').parent().removeClass('slds-has-error');
                          $('.meetStartTime').parent().removeClass('slds-has-error');
                          $('[id$=meetEndDate]').parent().removeClass('slds-has-error');
                          $('.meetEndTime').parent().removeClass('slds-has-error');
                          $('.errorMsg2').remove();
                          $('.errorMsg1').remove();
                          
                          $('.eventNotify').show();
                          $('.eventErrorMsg').text('You must have to fill subject!');
                          $('[id$=eventSubject]').parent().addClass('slds-has-error');
                          if($('.errorMsg').length == 0){
                              var ele = '<span class=""errorMsg slds-form-element__help"" style=""color:darkred"">This field is required</span>';
                              $('[id$=eventSubject]').parent().after(ele);
                          }   
                      }else{
                          
                          
                          $('.eventNotify').hide();
                          $('[id$=meetStartDate]').parent().removeClass('slds-has-error');
                          $('.meetStartTime').parent().removeClass('slds-has-error');
                          $('[id$=meetEndDate]').parent().removeClass('slds-has-error');
                          $('.meetEndTime').parent().removeClass('slds-has-error');
                          
                          $('.errorMsg1').remove();
                          $('.errorMsg2').remove();
                          $('[id$=meetingEventModal]').modal('dismiss');
                          createMeetEvent();
                      }
                  }else if(mdl == 'Mail'){
                      if($('[id$=emailTo]').val() === undefined || $('[id$=emailTo]').val() === null || $('[id$=emailTo]').val().trim().length == 0){   
                          $('.emailNotify').show();
                          $('.emailErrorMsg').text('You must have to give atleast one recipient');
                          $('[id$=emailTo]').parent().addClass('slds-has-error');
                          if($('.errorMsg').length == 0){
                              var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                              $('[id$=emailTo]').after(ele);
                          }   
                      }else{
                          $('.emailNotify').hide();
                          $('[id$=emailTo]').parent().removeClass('slds-has-error');
                          $('.errorMsg').remove();
                          $('[id$=sendEmailModal]').modal('dismiss');
                          sendMail();
                      }
                  }
              }
              
              function enaDisSaveBtn(flag , cls){
                  if(flag){
                      $('.'+cls).attr('disabled','disabled');
                  } 
              }
              
              function clearModal(id){
                  var ele = $('[id$=' + id + ']').html();
                  $('[id$=' + id + ']').html('').html(ele);
                  $('.emailFileName').text('');
                  $('[data-aljs=""modal""]').modal({onShow: manageBackdrop()});
                  $('.dt').datepicker();
                  $('[data-aljs=""tooltip""]').tooltip();
                  
                  createTimePicker('taskRemTimeDiv','taskRemTime','taskRemSvg');
                  createTimePicker('meetStartTimeDiv','meetStartTime','meetStartSvg');
                  createTimePicker('meetEndTimeDiv','meetEndTime','meetEndSvg');
                  $('.slds-notify-container').hide();
                  $('.slds-has-error').removeClass('slds-has-error');
                  $('.errorMsg').remove();
                  $('.errorMsg1').remove();
                  $('.errorMsg2').remove();
                  
              }
              function expandAfterSave(){
                  if(expandClassDis.trim().length > 0){
                      var arr = expandClassDis.split("";"");
                      for(i = 0 ; i < arr.length ; i++){
                          if(arr[i].trim().length > 0){
                              $('.'+ arr[i]).show();
                          }
                      }
                  }
                  if(expandClassAss.trim().length > 0){
                      var arr2 = expandClassAss.split("";"");
                      for(i = 0 ; i < arr2.length ; i++){
                          if(arr2[i].trim().length > 0){
                              $('.'+ arr2[i]).show();
                          }
                      }
                  } 
                  expandClassDis = '';
                  expandClassAss = '';    
              }
              
              $(document).ready(function() {
                   //To show scroll bar in case of ipad
                   (function(){
                       try{
                           var a=navigator.userAgent;
                               if((a.indexOf('Salesforce')!=-1)&&(a.indexOf('iPhone')!=-1||a.indexOf('iPad')!=-1)&&(a.indexOf('OS')!=-1||a.indexOf('OS')!=-1)&&(a.indexOf('Safari')==-1)){
                                   var s=document.createElement('style');
                                   s.innerHTML=""html,html body{overflow: auto;-webkit-overflow-scrolling:touch;}body{position:absolute;left:0;right:0;top:0;bottom:0;}"";
                                   document.getElementsByTagName('head')[0].appendChild(s);
                           }
                   
                       }catch(e){}
                   })();
                  //$('[data-aljs=""modal""]').modal();
                  createLookup('cLKDiv','cLKName','cLKId','contact','{!URLFOR($Resource.slds, 'assets/icons/standard-sprite/svg/symbols.svg#contact')}','slds-icon-standard-contact');
                  createLookup('taskWhoDiv','taskWhoName','taskWhoId','contact','{!URLFOR($Resource.slds, 'assets/icons/standard-sprite/svg/symbols.svg#contact')}','slds-icon-standard-contact');
                  createLookup('meetWhoDiv','meetWhoName','meetWhoId','contact','{!URLFOR($Resource.slds, 'assets/icons/standard-sprite/svg/symbols.svg#contact')}','slds-icon-standard-contact');
                  createTimePicker('taskRemTimeDiv','taskRemTime','taskRemSvg');
                  createTimePicker('meetStartTimeDiv','meetStartTime','meetStartSvg');
                  createTimePicker('meetEndTimeDiv','meetEndTime','meetEndSvg');
                  
                  //open call management tab after send mail
                  
                  if({!sentEmail}){
                    changeTab('CallManagementBtn'); enaDisSaveBtn({!CMDMdlList.size == 0 && CMAMdlList.size == 0} , 'CMSaveBtn');
                    if('{!expandClassDisStr}' != null && '{!expandClassDisStr}'.trim().length > 0){
                        expandClassDis = '{!expandClassDisStr}';
                    }
                    if('{!expandClassAssStr}' != null && '{!expandClassAssStr}'.trim().length > 0){
                        expandClassAss = '{!expandClassAssStr}';
                    }
                    expandAfterSave();
                    
                  }
                  
                  //onCompleteTasks('{!errorMsg}');
                  init(availableStageStr, ''); return false;
              });
              
              function onCompleteTasks(errorMsg){
                  $('[data-aljs=""modal""]').modal({onShow: manageBackdrop()});
                  $('.dt').datepicker();
                  $('[data-aljs=""tooltip""]').tooltip();
                  manageStickyNote();
                  manageThousandSeprator();
                  showNotify(errorMsg);
              }
              
              //used to show thousand seprator in case of number answer
              function manageThousandSeprator(){
                  var currentLocale = '{!UserLocale}';
                  
                  console.log('locale=' + currentLocale);
                  if(currentLocale.length > 0){
                      //replace _ with - for eg: en_US with en-US
                      if(currentLocale.indexOf('_') != -1) currentLocale = currentLocale.replace('_','-');
                      $('.applyThousandSeprator').each(function(){
                          if($(this).text() != undefined && $(this).text().length > 0){
                              $(this).text(parseInt($(this).text()).toLocaleString(currentLocale));     
                          }       
                      });
                  }
              }
              
              function manageStickyNote(){
                  //sticky note visibility correction by put <br> 
                  $('.stickyNoteAnchor').each(function(){
                      var titleTxt = $(this).attr('title');
                      if(titleTxt != undefined && titleTxt.trim().length > 40){
                          var titleRepTxt = '';
                          var loopobj = titleTxt.split(' '); 
                          //console.log('%%=;' + loopobj);
                          var loopStr = '';
                          var replacedStr = '';
                          for(var icounter = 0; icounter < loopobj.length; icounter++){
                              loopStr += loopobj[icounter] + ' ';
                              if(loopStr.length >  40){
                                  loopStr += '<br />';  
                                  replacedStr += loopStr;
                                  loopStr = ''; 
                              }     
                          }
                          //console.log('##=replacedStr=' + replacedStr + loopStr);
                          $(this).attr('title', replacedStr + loopStr);             
                      }
                  });
              }
              //used to prevent too much grey background on show popup again and again
              function manageBackdrop(){
                  $('.aljs-modal-container').remove();
                  $('.slds').append('<div class=""aljs-modal-container""><div class=""slds-backdrop slds-backdrop--open""></div></div>');
              }
              /*function redirectToDetailPage(recordId){
                  alert('out');
                  if (typeof(sforce) == 'undefined') {                  
                      alert('inn');
                      window.location.href = '/'+recordId;
                  }else{
                    alert('else');
                  }
              }*/
              
              function selectPlaybookId(ele,pId){
                //$('.selectPlaybookTbl td').removeClass('slds-theme--shade');
                //$(ele).addClass('slds-theme--shade');   
                selectedPlaybookID = pId;
                $('.selectPlaybookTd').css('background','transparent');
                $(ele).css('background','#CCC');
                
              }
              
              //for hide time picker
              $(document).click(function(event) {
                  ele = event.target;
                  if($(ele).prop('tagName') == 'HTML' || $(ele).prop('tagName') == 'FORM' || $(ele).prop('tagName') == 'DIV'){
                      if($('.taskRemTimeDiv') != undefined){
                          $('.taskRemTimeDiv').hide();  
                      }
                      if($('.meetStartTimeDiv') != undefined){
                          $('.meetStartTimeDiv').hide();  
                      }
                      if($('.meetEndTimeDiv') != undefined){
                          $('.meetEndTimeDiv').hide();  
                      }
                  }
              });
              
              
           </script>
           <script>
              //timepicker
              function createTimePicker(mainDivclass,textClass,svgClass){
                  $('.'+mainDivclass).addClass('slds-datepicker--time');
                  $('.'+mainDivclass).css('border','1px solid #CCC').css('border-radius','5px').css('display','none');
                  
                  var ele = '<ul class=""slds-datepicker--time__list"">';
                  ele += '<li aria-selected=""false"" onclick=""$(\'.'+ textClass + '\').val($(this).children().html());$(\'.' + mainDivclass +'\').hide()""><span>12:00 AM</span></li>';
                  ele += '<li aria-selected=""false"" onclick=""$(\'.'+ textClass + '\').val($(this).children().html());$(\'.' + mainDivclass +'\').hide()""><span>12:30 AM</span></li>';
                  for(var i = 1 ; i<= 11 ; i++){
                      ele += '<li aria-selected=""false"" onclick=""$(\'.'+ textClass + '\').val($(this).children().html());$(\'.' + mainDivclass +'\').hide()""><span>' + i + ':00 AM</span></li>';
                      ele += '<li aria-selected=""false"" onclick=""$(\'.'+ textClass + '\').val($(this).children().html());$(\'.' + mainDivclass +'\').hide()""><span>' + i + ':30 AM</span></li>';  
                  }
                  ele += '<li aria-selected=""false"" onclick=""$(\'.'+ textClass + '\').val($(this).children().html());$(\'.' + mainDivclass +'\').hide()""><span>12:00 PM</span></li>';
                  ele += '<li aria-selected=""false"" onclick=""$(\'.'+ textClass + '\').val($(this).children().html());$(\'.' + mainDivclass +'\').hide()""><span>12:30 PM</span></li>';
                  for(var i = 1 ; i<= 11 ; i++){
                      ele += '<li aria-selected=""false"" onclick=""$(\'.'+ textClass + '\').val($(this).children().html());$(\'.' + mainDivclass +'\').hide()""><span>' + i + ':00 PM</span></li>';
                      ele += '<li aria-selected=""false"" onclick=""$(\'.'+ textClass + '\').val($(this).children().html());$(\'.' + mainDivclass +'\').hide()""><span>' + i + ':30 PM</span></li>';  
                  }
                  ele += '</ul>';                           
                  $('.'+mainDivclass).html(ele);
                                              
                  $('.'+svgClass).attr(""onclick"",""$('.""+ mainDivclass +""').show()"");                          
                  $('.'+textClass).attr(""onfocus"",""$('.""+ mainDivclass +""').show()"");
                  
                  
              } 
              
              //for hide time picker
              $(document).click(function(event) {
                  ele = event.target;
                  if($(ele).prop('tagName') == 'HTML' || $(ele).prop('tagName') == 'FORM' || $(ele).prop('tagName') == 'DIV'){
                      if($('.taskRemTimeDiv') != undefined){
                          $('.taskRemTimeDiv').hide();  
                      }
                  }
                  
              });

            /*Added for debug datetime plugin*/
            function showDatePicker(){
               
                $('.dt').focus(function(){             
  
                  setTimeout(function(){  
                      if($('.slds-datepicker').parent().hasClass('rem-sec')){
                        $('.slds-datepicker').css('left','15px');
                        $('.slds-datepicker').css('position','fixed');
                      }
                  }, 100);
  
                });
                
                $('.taskRemTime').focus(function(){             
  
                  setTimeout(function(){  
                        $('.taskRemTimeDiv').css('z-index','9999');
                        $('.taskRemTimeDiv').css('position','fixed');
                        $('.taskRemTimeDiv').css('background','#fff');
                  }, 100);
  
                });
               
           }
           /*Added for debug datetime plugin*/
           function meetingDateTime(){
                $('.dt').focus(function(){             
  
                  setTimeout(function(){  
                      if($('.slds-datepicker').parent().hasClass('meetstart-sec') ||                       
                      $('.slds-datepicker').parent().hasClass('meetend-sec')){
                        $('.slds-datepicker').css('left','15px');
                        $('.slds-datepicker').css('position','fixed');
                      }
                  }, 100);
  
                });
                
          
               $('.meetEndTime').focus(function(){             
  
                  setTimeout(function(){  
                        $('.meetEndTimeDiv').css('z-index','9999');
                        $('.meetEndTimeDiv').css('position','fixed');
                        $('.meetEndTimeDiv').css('background','#fff');
                  }, 100);
  
                });
               
               $('.meetStartTime').focus(function(){             
  
                  setTimeout(function(){  
                        $('.meetStartTimeDiv').css('z-index','9999');
                        $('.meetStartTimeDiv').css('position','fixed');
                        $('.meetStartTimeDiv').css('background','#fff');
                  }, 100);
  
                });
           }
           
           //This function is used to validate percent field
           function validatePercent(x,ele) {
                if(x != undefined && x.trim().length > 0){
                    var validate = true;
                    var parts = x.split(""."");
                    if (typeof parts[1] == ""string"" && (parts[1].length == 0 || parts[1].length > 2))
                        validate = false;
                    var n = parseFloat(x);
                    if (isNaN(n))
                        validate = false;
                    if (n < 0 || n > 100)
                        validate = false;
                    
                    if(!validate){
                        alert('Please enter valid percentage!');
                        $(ele).focus();
                    }
                }
           }
           </script>
           
      </body>
  </html>    
</apex:page>","2016-01-19T13:57:21.000Z","00515000006PjX3AAK","2017-05-16T13:41:43.000Z","00515000006PhzjAAC","2017-05-16T13:41:43.000Z"
