                                      </apex:repeat>
                                  </tbody>
                                 </table>                                 
                              </apex:outputPanel>                           
                        </div>
                    </div>
                    
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""cloneTool(rowToolId); return false"">Select</button>
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=toolPromptModal]').modal('show');manageBackdrop();"">Cancel</button>                     
