                                  <apex:outputPanel id=""processManagementDiv"">
                                      <apex:outputpanel layout=""none"" rendered=""{!dPModalList.size > 0}"">
                                       <div class=""slds-grid slds-wrap"">
                                           <div class=""slds-size--12-of-12 slds-m-bottom--small"">
                                               <apex:outputText styleclass=""slds-section-title"" rendered=""{!dPModalList.size > 0}"" value=""DEAL PROGRESS"" />
                                               <apex:commandButton styleclass=""slds-button slds-button--brand slds-button--small slds-float--right saveButton"" rendered=""{!dPModalList.size > 0}"" onclick=""saveProcessManagementDemo() ; return false;"" value=""Save"" />
                                           </div>
                                       </div>
                                       <table class=""dealPTbl slds-table"">
                                           <thead>
                                             <tr style=""color:white;background:#215968"">
                                               <!--<th scope=""col"" style=""width:15%;white-space:normal"" class=""tdBorder"">
                                                 <span >Forecast Type</span>
                                               </th>-->
                                               <th scope=""col"" style=""width:15%;white-space:normal"" class=""tdBorder"">
                                                 <span >Stage</span>
                                               </th>
                                               <th scope=""col"" style=""width:60%;white-space:normal"" class=""tdBorder"">
                                                 <span >Deal Progress</span>
                                               </th>
                                               <th scope=""col"" style=""width:10%;text-align:center;white-space:normal"" class=""tdBorder"">
                                                 <span >Status</span>
                                               </th>
                                             </tr>
                                           </thead>
                                           <tbody>
                                             <apex:variable value=""{!0}"" var=""cnt""/>
                                             <apex:variable value="""" var=""FCIds""/>
                                             <apex:variable value="""" var=""SIds""/>
                                             <apex:repeat value=""{!dPModalList}"" var=""dp"">
                                                 <apex:variable value=""{!cnt + 1}"" var=""cnt""/>
                                                 <tr class=""slds-hint-parent"">
                                                     <!--<td style=""background:#DBEEF4;white-space:normal"" class=""{!if(CONTAINS(FCIds,dp.ForecastCategory),'tdBorderL tdBorderR','tdBorderL tdBorderR tdBorderT')} {!if(cnt == dPModalList.size,' tdBorderB','')}"">
                                                         <apex:variable value=""{!if(CONTAINS(FCIds,dp.forecastCategory),FCIds,'')}"" var=""FCIds""/>            
                                                         <p  style=""font-weight:900 ; display: {!if(CONTAINS(FCIds,dp.ForecastCategory),'none','')}"">{!dp.forecastCategory}</p>
                                                         <apex:variable value=""{!if(CONTAINS(FCIds,dp.forecastCategory),SIds,'')}"" var=""SIds""/>            
                                                         <apex:variable value=""{!FCIds}{!dp.forecastCategory},"" var=""FCIds""/>
                                                                     
                                                     </td>-->
                                                     <td style=""white-space:normal"" class=""{!if(CONTAINS(SIds,dp.qObj.playInstance__r.StageInstance__c),'tdBorderL tdBorderR','tdBorderL tdBorderR tdBorderT')} {!if(cnt == dPModalList.size,' tdBorderB','')} slds-theme--shade""> 
                                                         <b><p  style=""display: {!if(CONTAINS(SIds,dp.qObj.playInstance__r.StageInstance__c),'none','')}"">{!dp.qObj.playInstance__r.stageInstance__r.Name__c}</p></b>
                                                         <apex:variable value=""{!SIds}{!dp.qObj.playInstance__r.StageInstance__c},"" var=""SIds""/>
                                                        
                                                     </td>
                                                     <td style=""white-space:normal"" class=""tdBorder slds-theme--shade"">
                                                         <p >{!dp.qObj.Description__c}</p>
                                                         
                                                     </td>
                                                     <td class=""tdBorder"" style=""text-align:center;white-space:normal"">
                                                         <div class=""slds-form-element__control"">
                                                             <label class=""slds-checkbox"">
                                                                <apex:inputCheckbox value=""{!dp.check}"" />
                                                                <span class=""slds-checkbox--faux""></span>
                                                             </label> 
                                                         </div>
                                                       
                                                     </td>
                                                 </tr>
                                             </apex:repeat>
                                           </tbody>
                                       </table>
                                   </apex:outputpanel>
                                  </apex:outputPanel>
                                  <!-- Process Management -->    
                              </div>
                              <!-- Deal Management start -->
                              <div id=""DealManagement""  class=""slds-m-top--large slds-m-horizontal--medium"" style=""display:none"">
                              
                              <apex:actionStatus id=""dMStatus"" >
                                <apex:facet name=""start""> 
                                 <apex:outputPanel id=""tstpopupDM""> 
                                    <apex:outputPanel styleClass=""popupBackground"" layout=""block"" style=""width:100%""/> 
                                    <apex:outputPanel styleClass=""custPopup"" layout=""block""> 
                                        <div class=""slds-spinner--medium"">
                                            <img src=""{!URLFOR($Resource.slds, 'assets/images/spinners/slds_spinner_brand.gif')}"" alt=""Loading..."" style=""margin-top:150%""/>
                                        </div>
                                    </apex:outputPanel> 
                                 </apex:outputPanel> 
                                </apex:facet> 
                              </apex:actionStatus>
                              
                              <apex:outputPanel id=""dealManagementDiv"">
                                  <div class=""slds-grid slds-wrap"">
                                      <div class=""slds-size--12-of-12"">
                                          <div class=""slds-text-align--center"">
                                              <a href=""javascript:void(0)"" class="""" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""keystackeholderModal"" onclick=""clearModal('keystackeholderModal');"">
                                                    <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                                                    <!-- <svg aria-hidden=""true"" class=""slds-button__icon--stateful slds-button__icon--left"">
                                                      <use xlink:href=""/assets/icons/utility-sprite/svg/symbols.svg#add""></use>
                                                    </svg>Follow -->
                                                    Add Key Stakeholder
                                              </a>
                                              <a href=""javascript:void(0)"" class="""" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""competitorModal"" onclick=""clearModal('competitorModal');"" style=""margin-left:4px"">
                                                    <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                                                    New Competitor
                                              </a>
                                              <!-- <a href=""javascript:void(0)"" class=""slds-m-left--small"" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""meetingEventModal"" onclick=""clearModal('meetingEventModal');"" style=""margin-left:4px"">
                                                    <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                                                    New Event
                                              </a>
                                              <a href=""javascript:void(0)"" class="""" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""taskModal"" onclick=""clearModal('taskModal');"" style=""margin-left:4px"">
                                                    <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                                                    New Task
                                              </a>
                                              <a href=""javascript:void(0)"" class="""" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""noteModal"" onclick=""clearModal('noteModal');"" style=""margin-left:4px"">
                                                    <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                                                    New Note
                                              </a>
                                              -->
                                              <apex:commandButton styleclass=""slds-button slds-button--brand slds-button--small slds-m-bottom--small  slds-float--right saveButton"" onclick=""saveDealManagementChanges() ; return false;"" value=""Save"" />
                                          </div>
                                      </div>
                                  </div>
                                  <div class=""slds-grid slds-wrap"">
                                      <div class=""slds-size--12-of-12"">
                                          <table>    
                                              <tr>
                                                  <td style=""width:40%; vertical-align:top"">            
                                                     <h2 class=""slds-section-title"">DEAL SCORECARD</h2>
                                                     <table class=""slds-table slds-table--bordered slds-m-top--small"">
                                                           <thead>
                                                             <tr style=""color:white;background:#558ED5"">
                                                               <th scope=""col"">
                                                                 <span class=""slds-truncate"">Factor</span>
                                                               </th>
                                                               <th scope=""col"" style=""text-align:center"">
                                                                 <span class=""slds-truncate"">Score</span>
                                                               </th>
                                                             </tr>
                                                           </thead>
                                                           <tbody>
                                                             <tr>
                                                                 <td style=""width:60%;background:#DBEEF4"">
                                                                     <p class=""slds-truncate"">Winnability Score</p>
                                                                 </td>
                                                                 <td style=""width:40%;text-align:center"">
                                                                     <span style=""color: {!if(!stageObj.OnTrack__c, 'red', '')}"">{!ROUND(stageObj.WinnabilityScore__c,0)}%</span>
                                                                 </td>
                                                             </tr>
                                                             
                                                             <tr>
                                                                 <td style=""width:60%;background:#DBEEF4"" class=""slds-theme--shade"">
                                                                     <p class=""slds-truncate"">Risk Score</p>
                                                                 </td>
                                                                 <td style=""width:40%;text-align:center"">
                                                                     {!riskScore}
                                                                 </td>
                                                             </tr>
                                                             
                                                             <tr>
                                                                 <td style=""width:60%;background:#DBEEF4"" class=""slds-theme--shade"">
                                                                     <p class=""slds-truncate"">Confidence</p>
                                                                 </td>
                                                                 <td style=""width:40%;text-align:center"" onmouseover=""if($('.gfPicklist').css('display') == 'none'){$('.editGF').show();$('.editGF').css('cursor','pointer');}"" onmouseout=""if($('.gfPicklist').css('display') == 'none'){$('.editGF').css('display','none');$('.editGF').css('cursor','none');}"">
                                                                    <span class=""gfText"">
                                                                        {!processInsList[0].gut_feel__c}
                                                                     </span>
                                                                     <apex:selectList styleClass=""gfPicklist slds-select"" value=""{!processInsList[0].gut_feel__c}"" size=""1"" style=""display:none"" onChange=""$('.gfPicklist').hide();$('.gfText').show();renderDealManagementDiv(); return false;"">
                                                                        <apex:selectoptions value=""{!gutFeelValues}""/>
                                                                     </apex:selectList>
                                                                     <a href=""javascript:void(0)"" class=""editGF"" onclick=""$(this).hide();$('.gfPicklist').show();$('.gfText').hide();"" style=""display:none;"">
                                                                        <c:SVGComponent styleClass=""editGF slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                     </a>
                                                                 </td>
                                                              </tr>
                                                              
                                                              <tr>
                                                                 <td style=""width:60%;background:#DBEEF4"">
                                                                     <p class=""slds-truncate"">Deal Status</p>
                                                                 </td>
                                                                 <td style=""width:40%;text-align:center"">
                                                                     {!if(stageObj.OnTrack__c, 'On Track', 'Off Track')}
                                                                 </td>
                                                             </tr>
                                                             
                                                            </tbody>
                                                       </table>
                                                       
                                                   </td>
                                                   <td style=""width:60%;vertical-align:top"">
                                                    <!-- Success Indicator -->
                                                   </td>
                                                  
                                               </tr>
                                           </table>
                                      </div>
                                  </div>
                                  <!-- Executive Summary -->
                                  <div class=""slds-size--12-of-12 {!if(summaryList.size > 0 , 'slds-m-top--large' ,'')}""> 
                                      <apex:outputText styleclass=""slds-section-title"" rendered=""{!summaryList.size > 0}"" value=""EXECUTIVE SUMMARY"" />
                                      <!-- <apex:outputpanel layout=""none"" rendered=""{!summaryList.size == 0}"">
                                          <p class=""slds-text-body--regular slds-m-top--medium"">No Deal Summary exist! </p>
                                      </apex:outputpanel> -->
                                      <apex:outputpanel layout=""none"" rendered=""{!summaryList.size > 0}"">
                                          <table class=""slds-table slds-table--bordered slds-m-top--small"">
                                              <thead>
                                                <tr style=""color:white;background:#558ED5"">
                                                  <th scope=""col"" style=""width:60%;white-space:normal"">
                                                    <span >Question</span>
                                                  </th>
                                                  <th scope=""col"" style=""width:40%;white-space:normal"">
                                                    <span >Answer</span>
                                                  </th>
                                                </tr>
                                              </thead>
                                              <tbody>
                                                <apex:variable value=""{!0}"" var=""cntDS""/>
                                                <apex:repeat value=""{!summaryList}"" var=""q"">
                                                    <apex:variable value=""{!cntDS + 1}"" var=""cntDS""/>
                                                    <tr class=""slds-hint-parent"">
                                                        <td style=""background:#DBEEF4;"" class=""wordWrapClass"">
                                                            <span>{!q.qObj.Description__c}</span>
                                                            
                                                            <!-- <apex:outputPanel layout=""none"" rendered=""{!q.qObj.Tip__c != null && LEN(q.qObj.Tip__c) > 0}"">
                                                                <div style=""float:right"">
                                                                    <a href=""javascript:void(0)"" class=""slds-theme--shade"" style=""padding:5px""  data-aljs=""tooltip"" data-aljs-placement=""top"" title=""{!q.qObj.Tip__c}"">Tip</a>
                                                                </div>
                                                            </apex:outputPanel> -->        
                                                        </td>
                                                        <td class=""wordWrapClass"" onmouseover=""if($('.dSInput{!cntDS}').css('display') == 'none'){$('.editDS{!cntDS}').show();}"" onmouseout=""if($('.dSInput{!cntDS}').css('display') == 'none'){$('.editDS{!cntDS}').hide();$('.editDS{!cntDS}').hide();}"">
                                                            <table class=""dealSumTd2InnerTbl"">
                                                                <tr>
                                                                <td class=""wordWrapClass"" style=""width:93%"">        
                                                                    <apex:outputPanel rendered=""{! (q.qObj.ResponseType__c == 'Text' || (q.qObj.ResponseType__c == 'DataMap' && q.datamapStr == 'text'))}"" layout=""none"">
                                                                        <ul class="""">
                                                                               <li >
                                                                                    <span class=""dSText{!cntDS}"">{!q.text}</span>
                                                                                   
                                                                                   <apex:inputTextArea rendered=""{!(q.qObj.ResponseType__c == 'DataMap' && fieldLengthMap[q.qObj.Name__c] > 500) || q.qObj.ResponseType__c != 'DataMap'}"" value=""{!q.text}"" styleClass=""dSInput{!cntDS} slds-textarea"" style=""display:none;width:100%""/>
                                                                                   <apex:inputText maxlength=""{!fieldLengthMap[q.qObj.Name__c]}""  rendered=""{!(q.qObj.ResponseType__c == 'DataMap' && fieldLengthMap[q.qObj.Name__c] < 500)}"" value=""{!q.text}"" styleClass=""dSInput{!cntDS} slds-textarea"" style=""display:none;width:100%""/>
                                                                                <a href=""javascript:void(0)"" class=""editDS{!cntDS} "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.dSInput{!cntDS}').show();$('.dSText{!cntDS}').hide();"" style=""display:none;"">
                                                                                       <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                   </a>
                                                                               </li>
                                                                            
                                                                        </ul>
                                                                    </apex:outputPanel>
                                                                    
                                                                    <apex:outputPanel rendered=""{! (q.qObj.ResponseType__c == 'Number' || q.qObj.ResponseType__c == 'Amount' || (q.qObj.ResponseType__c == 'DataMap' && q.datamapStr == 'decimal'))}"" layout=""none"">
                                                                        <span class=""dSText{!cntDS}"">{!if(q.qObj.ResponseType__c == 'Amount' && q.text != null && LEN(TRIM(q.text)) > 0, '$','')}</span><span class=""dSText{!cntDS} applyThousandSeprator"">{!q.text}</span>
                                                                        <apex:inputText maxlength=""{!if(q.qObj.ResponseType__c == 'DataMap', fieldLengthMap[q.qObj.Name__c], 100)}"" value=""{!q.text}"" styleClass=""dSInput{!cntDS} slds-input "" style=""display:none;width:100%"" html-onpaste=""allowNumbersOnly(event,this);"" onkeyup=""allowNumbersOnly(event,this);""/>
                                                                        <a href=""javascript:void(0)"" class=""editDS{!cntDS} "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.dSInput{!cntDS}').show();$('.dSText{!cntDS}').hide();"" style=""display:none;"">
                                                                            <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                        </a>
                                                                             
                                                                    </apex:outputPanel>
                                                                    <apex:outputPanel rendered=""{! (q.qObj.ResponseType__c == 'Percent')}"" layout=""none"">
                                                                        <span class=""dSText{!cntDS}"">{!q.text}{!if(q.text != NULL && LEN(TRIM(q.text)) > 0, '%','')}</span>
                                                                        <apex:inputText value=""{!q.text}"" styleClass=""dSInput{!cntDS} slds-input"" style=""display:none;width:100%"" html-onpaste=""allowPercentOnly(event,this);"" onkeyup=""allowPercentOnly(event,this);"" onblur=""if($(this).length > 0) validatePercent($(this).val(),this);""/>
                                                                        <a href=""javascript:void(0)"" class=""editDS{!cntDS} "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.dSInput{!cntDS}').show();$('.dSText{!cntDS}').hide();"" style=""display:none;"">
                                                                            <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                        </a>
                                                                    </apex:outputPanel>
                                                                    <apex:outputPanel rendered=""{! (q.qObj.ResponseType__c == 'Date' || (q.qObj.ResponseType__c == 'DataMap' && (q.datamapStr == 'date' || q.datamapStr == 'datetime')))}"" layout=""none"">
                                                                        <ul class="""">
                                                                               <li>
                                                                                    <span class=""dSText{!cntDS}"">{!q.text}</span>
                                                                                   <div class=""dSInput{!cntDS} slds-form-element"" style=""display:none;width:100%;float:left"">
                                                              
                                                                                        <div class=""slds-form-element__control slds-input-has-icon slds-input-has-icon--right"">
                                                                                            <c:SVGComponent styleClass=""slds-input__icon slds-icon-text-default""  path=""assets/icons/utility-sprite/svg/symbols.svg#event"" clickOperation=""""/>
                                                                                            <apex:inputText value=""{!q.text}"" styleClass=""dt slds-input"" html-placeholder=""Pick a date""/>
                                                                                       </div>
                                                                                   </div>
                                                                                   <a href=""javascript:void(0)"" class=""editDS{!cntDS} "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.dSInput{!cntDS}').show();$('.dSText{!cntDS}').hide();"" style=""display:none;"">
                                                                                       <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                   </a>
                                                                               </li>
                                                                            
                                                                        </ul>
                                                                    </apex:outputPanel>
                                                                    
                                                                    
                                                                    <apex:outputPanel rendered=""{!q.qObj.ResponseType__c == 'Checkbox' || (q.qObj.ResponseType__c == 'DataMap' &&  q.datamapStr == 'checkbox')}"" layout=""none"">
                                                                        <ul class="""">
                                                                            <li>
                                                                                <div class=""slds-form-element__control"">
                                                                                     <label class=""slds-checkbox"">
                                                                                         <apex:inputCheckbox value=""{!q.check}""/>
                                                                                         <span class=""slds-checkbox--faux""></span>
                                                                                     </label> 
                                                                                 </div>
                                                                             </li>
                                                                         </ul>
                                                                    </apex:outputPanel>
                                                                    <apex:outputPanel rendered=""{!q.qObj.ResponseType__c == 'SingleChoice' || (q.qObj.ResponseType__c == 'DataMap' &&  q.datamapStr == 'singlechoice')}"" layout=""none"">
                                                                        <ul class="""">
                                                                            <li >
                                                                                <span class=""dSText{!cntDS}"" style=""{!if(q.selectedSChoiceRedFlag, 'Color: Red;', '')}"">{!q.selectedSChoice}</span>
                                                                                <apex:selectList value=""{!q.selectedSChoice}"" size=""1"" styleClass=""dSInput{!cntDS} slds-select"" style=""display:none;width:100%"">
                                                                                    <apex:selectoption itemValue="""" itemLabel=""None""/>
                                                                                    <apex:selectoptions value=""{!q.choice}""/>
                                                                                </apex:selectList>
                                                                                <a href=""javascript:void(0)"" class=""editDS{!cntDS} "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.dSInput{!cntDS}').show();$('.dSText{!cntDS}').hide();"" style=""display:none;"">
                                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                </a>
                                                                            </li>
                                                                            
                                                                        </ul>
                                                                    </apex:outputPanel>
                                                                    
                                                                    <apex:outputPanel rendered=""{!q.qObj.ResponseType__c == 'Rating'}"" layout=""none"">
                                                                        <ul class="""">
                                                                            <li >
                                                                                <span class=""dSText{!cntDS}"">{!q.selectedRating}</span>
                                                                                <apex:selectList value=""{!q.selectedRating}"" size=""1"" styleClass=""dSInput{!cntDS} slds-select"" style=""display:none;width:100%"">
                                                                                    <apex:selectoption itemValue="""" itemLabel=""None""/>
                                                                                    <apex:selectoptions value=""{!q.choice}""/>
                                                                                </apex:selectList> 
                                                                                <a href=""javascript:void(0)"" class=""editDS{!cntDS}"" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.dSInput{!cntDS}').show();$('.dSText{!cntDS}').hide();"" style=""display:none;"">
                                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                </a>
                                                                            </li>
                                                                            
                                                                        </ul>
                                                                    </apex:outputPanel>
                                                                    
                                                                    <apex:outputPanel rendered=""{!q.qObj.ResponseType__c == 'MultiChoice' || (q.qObj.ResponseType__c == 'DataMap' &&  q.datamapStr == 'multichoice')}"" layout=""none"">
                                                                                        <!-- <apex:outputPanel styleclass=""dSText{!cntDS}"" rendered=""{!q.selectedMChoice.size == 0}"">
                                                                                            <ul class="""" style=""float:left"">
                                                                                                <li>None</li>
                                                                                            </ul>
                                                                                        </apex:outputPanel>   -->
                                                                                        <apex:outputPanel styleclass=""dSText{!cntDS}"" rendered=""{!q.selectedMChoice.size > 0}"">
                                                                                            <ul class="""" style=""float:left"">
                                                                                                <apex:repeat value=""{!q.selectedMChoice}"" var=""str"">
                                                                                                    <li style=""{!if(q.selectedMChoiceRedFlagMap[str], 'Color: Red;', '')}"">
                                                                                                        {!str}
                                                                                                    </li>
                                                                                                </apex:repeat>
                                                                                            </ul>
                                                                                        </apex:outputPanel>  
                                                                                        <apex:selectList value=""{!q.selectedMChoice}"" multiselect=""true"" size=""3"" styleClass=""dSInput{!cntDS} slds-select"" style=""display:none;width:100%"">
                                                                                            <apex:selectoptions value=""{!q.choice}""/>
                                                                                        </apex:selectList>
                                                                                        <a href=""javascript:void(0)"" class=""editDS{!cntDS} "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.dSInput{!cntDS}').show();$('.dSText{!cntDS}').hide();"" style=""display:none;"">
                                                                                            <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                        </a>
                                                                    </apex:outputPanel>
                                                                </td>
                                                                <td style=""width:7%"">
                                                                    <!-- Note -->
                                                                    <apex:outputPanel layout=""none"" rendered=""{!q.qObj.Note__c != null && LEN(q.qObj.Note__c) > 0}"">
                                                                        <div style=""float:right;"">
                                                                               <a href=""javascript:void(0)"" class=""stickyNoteAnchor"" data-aljs=""tooltip"" data-aljs-placement=""left"" title=""{!if(q.qObj.note__c == null ,'Note',q.qObj.note__c)}""><!-- onclick=""$('[id$=noteQuestionModal]').modal('show');$('[id$=createNoteQuestion]').val('{!q.qObj.note__c}');$('[id$=questionIdForNote]').val('{!q.qObj.id}');"" -->
                                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default {!if(q.qObj.Note__c == null ,'svgLightblue','')}"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#page"" cssStyle=""height:20px;width:20px""/>
                                                                               </a>
                                                                        </div>
                                                                    </apex:outputPanel>
                                                                </td>
                                                                </tr>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                </apex:repeat>    
                                              </tbody>
                                          </table>
                                      </apex:outputpanel>
                                  </div>
                                  <!-- Executive Summary --End -->
                                  
                                  <!-- key milestone -->
                                  <div class=""slds-size--12-of-12 {!if(milestoneList.size > 0 , 'slds-m-top--large' , '')}""> 
                                      <apex:outputText styleclass=""slds-section-title"" rendered=""{!milestoneList.size > 0}"" value=""KEY MILESTONES"" />
                                      <!-- <apex:outputpanel layout=""none"" rendered=""{!milestoneList.size == 0}"">
                                          <p class=""slds-text-body--regular slds-m-top--medium"">No Key Milestone exist! </p>
                                      </apex:outputpanel> -->
                                      <apex:outputpanel layout=""none"" rendered=""{!milestoneList.size > 0}"">
                                          <table class=""slds-table slds-table--bordered slds-m-top--small"">
                                              <thead>
                                                <tr style=""color:white;background:#558ED5"">
                                                  <th scope=""col"" style=""width:60%;white-space:normal"">
                                                    <span >Action Item</span>
                                                  </th>
                                                  <th scope=""col"" style=""width:40%;white-space:normal"">
                                                    <span >Date</span>
                                                  </th>
                                                </tr>
                                              </thead>
                                              <tbody>
                                                <apex:variable value=""{!0}"" var=""cntkM""/>
                                                <apex:repeat value=""{!milestoneList}"" var=""m"">
                                                <apex:variable value=""{!cntkM +1}"" var=""cntkM""/>
                                                    <tr class=""slds-hint-parent"">
                                                        <td style=""background:#DBEEF4;"" class=""wordWrapClass"">
                                                            <p >{!m.qObj.Description__c}</p>
                                                        </td>
                                                        <td class=""wordWrapClass"" onmouseover=""if($('.kMInput{!cntkM}').css('display') == 'none'){$('.editkM{!cntkM}').show();}"" onmouseout=""if($('.kMInput{!cntkM}').css('display') == 'none'){$('.editkM{!cntkM}').hide();$('.editkM{!cntkM}').hide();}"">
                                                            <span class=""kMText{!cntkM}"">{!m.text}</span>
                                                            <div class=""kMInput{!cntkM} slds-form-element"" style=""display:none;width:100%;float:left"">
                                                              <div class=""slds-form-element__control slds-input-has-icon slds-input-has-icon--right"">
                                                                  <!-- <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" path=""assets/icons/utility-sprite/svg/symbols.svg#event""/> -->
                                                                  <!-- <svg aria-hidden=""true"" class=""slds-input__icon"" >
                                                                    <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#event')}""></use>
                                                                  </svg> --> 
                                                                  <c:SVGComponent styleClass=""slds-input__icon slds-icon-text-default""  path=""assets/icons/utility-sprite/svg/symbols.svg#event"" clickOperation=""""/>
                                                                  <apex:inputText value=""{!m.text}"" styleClass=""dt slds-input"" html-placeholder=""Pick a date""/>
                                                              </div>
                                                            </div>
                                                            <a href=""javascript:void(0)"" class=""editkM{!cntkM}"" onclick=""$(this).hide();$('.kMInput{!cntkM}').show();$('.kMText{!cntkM}').hide();"" style=""display:none;"">
                                                                <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                            </a>
                                                            <!-- <c:SVGComponent styleClass=""kMCheck{!cntkM} slds-icon slds-icon--small slds-icon-text-default"" clickOperation=""$(this).hide();$('.kMInput{!cntkM}').hide();$('.kMText{!cntkM}').show();renderDealManagementDiv(); return false"" path=""assets/icons/utility-sprite/svg/symbols.svg#check"" cssStyle=""cursor:pointer;display:none;height:20px;width:20px""/> -->    
                                                        </td>
                                                    </tr>
                                                </apex:repeat>
                              
                                              </tbody>
                                          </table>
                                      </apex:outputpanel>
                                  </div>
                                  <!-- key stackholders -->
                                  <div class=""slds-grid slds-wrap "">    
                                      <div class=""slds-size--12-of-12 slds-m-top--large""> 
                                          <apex:outputText styleclass=""slds-section-title"" rendered=""{!stackeholderList.size > 0}"" value=""KEY STAKEHOLDERS"" />
                                          <!-- <button class=""slds-button slds-button--brand slds-button--small slds-float--right slds-m-bottom--small"" rendered=""{!dPModalList.size > 0}"" onclick=""saveProcessManagementDemo() ; return false;"" value=""Save"" /> -->
                                          
                                          <!-- <apex:outputpanel layout=""none"" rendered=""{!stackeholderList.size == 0}"">
                                              <p class=""slds-text-body--regular slds-m-top--medium"">No Stackeholder exist! </p>
                                          </apex:outputpanel> -->
                                          <apex:outputpanel layout=""none"" rendered=""{!stackeholderList.size > 0}"">
                                              <div class=""slds-scrollable--y"">
                                              <table class=""slds-table slds-table--bordered slds-m-top--small"">
                                                  <thead>
                                                    <tr style=""color:white;background:#558ED5"">
                                                      <th scope=""col"" style=""width:22%;white-space:normal"">
                                                        <span >Name</span>
                                                      </th>
                                                      <th scope=""col"" style=""width:23%;white-space:normal"">
                                                        <span >Title</span>
                                                      </th>
                                                      <th scope=""col"" style=""width:10%;white-space:normal"">
                                                        <span >Main</span>
                                                      </th>
                                                      <th scope=""col"" style=""width:15%;white-space:normal"">
                                                        <span >Perception</span>
                                                      </th>
                                                      <th scope=""col"" style=""width:15%;white-space:normal"">
                                                        <span >Influence</span>
                                                      </th>
                                                      <th scope=""col"" style=""width:15%;white-space:normal"">
                                                        <span >Priority</span>
                                                      </th>
                                                    </tr>
                                                  </thead>
                                                  <tbody>
                                                    <apex:variable value=""{!0}"" var=""cntSH""/>
                                                    <apex:repeat value=""{!stackeholderList}"" var=""sh"">
                                                        <apex:variable value=""{!cntSH + 1}"" var=""cntSH""/>
                                                        
                                                        <tr class=""slds-hint-parent"" onmouseover=""if($('.sHPicklist{!cntSH}').css('display') == 'none'){$('.sHText{!cntSH}').show();} if($('.sHPicklistTwo{!cntSH}').css('display') == 'none'){$('.sHTextTwo{!cntSH}').show();} if($('.sHPicklistThree{!cntSH}').css('display') == 'none'){$('.sHTextThree{!cntSH}').show();}"" onmouseout=""$('.sHText{!cntSH}').hide(); $('.sHTextTwo{!cntSH}').hide(); $('.sHTextThree{!cntSH}').hide();"">
                                                            <td style=""background:#DBEEF4;white-space:normal"">
                                                                <a class=""detailAnchor"" href=""/{!sh.kObj.contact__c}"" target=""{! if($User.UIThemeDisplayed == 'Theme3','_top','') }"">{!sh.kObj.contact__r.name}</a>
                                                            </td>
                                                            
                                                            <td style=""border-right:1px solid #CCC; white-space:normal"">
                                                                <p >{!sh.kObj.contact__r.title}</p>
                                                            </td>
                                                            <td style=""border-right:1px solid #CCC; white-space:normal"">
                                                                <div class=""slds-form-element__control"" style=""height:15px;width:15px"">
                                                                    <label class=""slds-checkbox"">
                                                                        <apex:inputCheckbox value=""{!sh.ocrObj.isPrimary}""/>
                                                                        <span class=""slds-checkbox--faux""></span>
                                                                    </label>
                                                                </div>
                                                            </td>
                                                            <td style=""border-right:1px solid #CCC;white-space:normal;background:{!if(sh.kObj.Stance__c == 'For','#00B050',if(sh.kObj.Stance__c == 'Neutral','#FFC000',if(sh.kObj.Stance__c == 'Against','#C00000','')))}"" onmouseover=""if($('.sHPicklist{!cntSH}').css('display') == 'none'){$('.editSH{!cntSH}').css('display','inline-block');$('.editSH{!cntSH}').css('cursor','pointer');}"" onmouseout=""if($('.sHPicklist{!cntSH}').css('display') == 'none'){$('.editSH{!cntSH}').css('display','none');$('.editSH{!cntSH}').css('cursor','none');}"">
                                                                <span class=""sHText{!cntSH}"" style=""display:none;color:black"">
                                                                   {!sh.kObj.Stance__c}
                                                                </span>
                                                                <apex:selectList styleClass=""sHPicklist{!cntSH} slds-select"" value=""{!sh.kObj.Stance__c}"" size=""1"" style=""display:none"" onChange=""$('.sHPicklist{!cntSH}').hide();$('.sHText{!cntSH}').show();renderDealManagementDiv(); return false;"">
                                                                   <apex:selectoptions value=""{!stancePicklistValues}""/>
                                                                </apex:selectList>
                                                                <a href=""javascript:void(0)"" class=""editSH editSH{!cntSH}"" onclick=""$(this).hide();$('.sHPicklist{!cntSH}').show();$('.sHText{!cntSH}').hide();"" style=""display:none;"">
                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                </a>
                                                            </td>
                                                            <td style=""border-right:1px solid #CCC;white-space:normal;background:{!if(sh.kObj.influence__c == 'High','#00B050',if(sh.kObj.influence__c == 'Medium','#FFC000',if(sh.kObj.influence__c == 'Low','#C00000','')))}""  onmouseover=""if($('.sHPicklistTwo{!cntSH}').css('display') == 'none'){$('.editSHTwo{!cntSH}').css('display','inline-block');$('.editSHTwo{!cntSH}').css('cursor','pointer');}"" onmouseout=""if($('.sHPicklistTwo{!cntSH}').css('display') == 'none'){$('.editSHTwo{!cntSH}').css('display','none');$('.editSHTwo{!cntSH}').css('cursor','none');}"">
                                                                <span class=""sHTextTwo{!cntSH}"" style=""display:none;color:black"">
                                                                   {!sh.kObj.Influence__c}
                                                                </span>
                                                                <apex:selectList styleClass=""sHPicklistTwo{!cntSH} slds-select"" value=""{!sh.kObj.Influence__c}"" size=""1"" style=""display:none"" onChange=""$('.sHPicklistTwo{!cntSH}').hide();$('.sHTextTwo{!cntSH}').show();renderDealManagementDiv(); return false;"">
                                                                   <apex:selectoptions value=""{!influencePicklistValues}""/>
                                                                </apex:selectList>
                                                                <a href=""javascript:void(0)"" class=""editSHTwo{!cntSH}"" onclick=""$(this).hide();$('.sHPicklistTwo{!cntSH}').show();$('.sHTextTwo{!cntSH}').hide();"" style=""display:none;"">
                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                </a>
                                                            </td>
                                                            <td style=""white-space:normal;background:{!if(sh.kObj.Priority__c == 'High','#00B050',if(sh.kObj.Priority__c == 'Medium','#FFC000',if(sh.kObj.Priority__c == 'Low','#C00000','')))}""   onmouseover=""if($('.sHPicklistThree{!cntSH}').css('display') == 'none'){$('.editSHThree{!cntSH}').css('display','inline-block');$('.editSHThree{!cntSH}').css('cursor','pointer');}"" onmouseout=""if($('.sHPicklistThree{!cntSH}').css('display') == 'none'){$('.editSHThree{!cntSH}').css('display','none');$('.editSHThree{!cntSH}').css('cursor','none');}"">
                                                                <span class=""sHTextThree{!cntSH}"" style=""display:none;color:black"">
                                                                   {!sh.kObj.Priority__c}
                                                                </span>
                                                                <apex:selectList styleClass=""sHPicklistThree{!cntSH} slds-select"" value=""{!sh.kObj.Priority__c}"" size=""1"" style=""display:none"" onChange=""$('.sHPicklistThree{!cntSH}').hide();$('.sHTextThree{!cntSH}').show();renderDealManagementDiv(); return false;"">
                                                                   <apex:selectoptions value=""{!influencePicklistValues}""/>
                                                                </apex:selectList>
                                                                <a href=""javascript:void(0)"" class=""editSHThree{!cntSH}"" onclick=""$(this).hide();$('.sHPicklistThree{!cntSH}').show();$('.sHTextThree{!cntSH}').hide();"" style=""display:none;"">
                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                </a>
                                                            </td>
                                                            
                                                        </tr>
                                                    </apex:repeat>
                                                   </tbody>
                                              </table>
                                              </div>
                                          </apex:outputpanel>
                                      </div>
                                      
                                      <!-- key Competitor -->
                                      <div class=""slds-size--12-of-12 slds-m-top--large""> 
                                          <apex:outputText styleclass=""slds-section-title"" rendered=""{!competitorList.size > 0}"" value=""KEY COMPETITORS"" />
                                          <!-- <apex:outputpanel layout=""none"" rendered=""{!competitorList.size == 0}"">
                                              <p class=""slds-text-body--regular slds-m-top--medium"">No Key Competitor exist! </p>
                                          </apex:outputpanel> -->
                                          <apex:outputpanel layout=""none"" rendered=""{!competitorList.size > 0}"">
                                              <table class=""slds-table slds-table--bordered slds-m-top--small"">
                                                  <thead>
                                                    <tr style=""color:white;background:#558ED5"">
                                                      <th scope=""col"" style=""width:25%;white-space:normal"">
                                                        <span >Name</span>
                                                      </th>
                                                      <th scope=""col"" style=""width:37.5%;white-space:normal;"">
                                                        <span >Risk</span>
                                                      </th>
                                                      <th scope=""col"" style=""width:37.5%;white-space:normal"">
                                                        <span >Why Us</span>
                                                      </th>
                                                    </tr>
                                                  </thead>
                                                  <tbody>
                                                    <apex:variable value=""{!0}"" var=""cntkC""/>
                                                    <apex:repeat value=""{!competitorList}"" var=""m"">
                                                    <apex:variable value=""{!cntkC +1}"" var=""cntkC""/>
                                                        <tr class=""slds-hint-parent"">
                                                            <td style=""background:#DBEEF4;"" class=""wordWrapClass"">
                                                                <p >{!m.competitorName}</p>
                                                            </td>
                                                            <td class=""wordWrapClass"" style=""border-right:1px solid #CCC;"" onmouseover=""if($('.kCRInput{!cntkC}').css('display') == 'none'){$('.editkCR{!cntkC}').show();}"" onmouseout=""if($('.kCRInput{!cntkC}').css('display') == 'none'){$('.editkCR{!cntkC}').hide();$('.editkCR{!cntkC}').hide();}"">
                                                                <span class=""kCRText{!cntkC}"">{!m.strengths}</span>
                                                                <div class=""kCRInput{!cntkC} slds-form-element"" style=""display:none;"">
                                                                  <div class=""slds-form-element__control slds-input-has-icon slds-input-has-icon--right"">
                                                                      <apex:inputTextArea value=""{!m.strengths}"" styleClass=""slds-input""/>
                                                                  </div>
                                                                </div>
                                                                <a href=""javascript:void(0)"" class=""editkCR{!cntkC}"" onclick=""$(this).hide();$('.kCRInput{!cntkC}').show();$('.kCRText{!cntkC}').hide();"" style=""display:none;"">
                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                </a>
                                                            </td>
                                                            <td class=""wordWrapClass"" onmouseover=""if($('.kCWInput{!cntkC}').css('display') == 'none'){$('.editkCW{!cntkC}').show();}"" onmouseout=""if($('.kCWInput{!cntkC}').css('display') == 'none'){$('.editkCW{!cntkC}').hide();$('.editkCW{!cntkC}').hide();}"">
                                                                <span class=""kCWText{!cntkC}"">{!m.weaknesses}</span>
                                                                <div class=""kCWInput{!cntkC} slds-form-element"" style=""display:none;"">
                                                                  <div class=""slds-form-element__control slds-input-has-icon slds-input-has-icon--right"">
                                                                      <apex:inputTextArea value=""{!m.weaknesses}"" styleClass=""slds-input""/>
                                                                  </div>
                                                                </div>
                                                                <a href=""javascript:void(0)"" class=""editkCW{!cntkC}"" onclick=""$(this).hide();$('.kCWInput{!cntkC}').show();$('.kCWText{!cntkC}').hide();"" style=""display:none;"">
                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    </apex:repeat>
                                                   </tbody>
                                              </table>
                                          </apex:outputpanel>
                                      </div>
                                      
                                      <!-- Deal Notes -->
                                      <div class=""slds-size--12-of-12  slds-m-top--large""> 
                                          <apex:outputText styleclass=""slds-section-title"" rendered=""{!dealNoteList.size > 0}"" value=""DEAL NOTES"" />
                                          <!-- <apex:outputpanel layout=""none"" rendered=""{!dealNoteList.size == 0}"">
                                              <p class=""slds-text-body--regular slds-m-top--medium"">No notes available! </p>
                                          </apex:outputpanel> -->
                                          <apex:outputpanel layout=""none"" rendered=""{!dealNoteList.size > 0}"">
                                              <table class=""slds-table slds-table--bordered slds-m-top--small"">
                                                  <thead>
                                                    <tr style=""color:white;background:#558ED5"">
                                                      <th scope=""col"" style=""white-space:normal;width:25%;"">
                                                        <span>Deal Note</span>
                                                      </th>
                                                      <th scope=""col"" style=""white-space:normal;width:37.5%;"">
                                                        <span>Owner</span>
                                                      </th>
                                                      <th scope=""col"" style=""white-space:normal;width:37.5%;"">
                                                        <span>Date</span>
                                                      </th>
                                                    </tr>
                                                  </thead>
                                                  <tbody>
                                                    <apex:repeat value=""{!dealNoteList}"" var=""n"">
                                                        <tr class=""slds-hint-parent"">
                                                            <td style=""background:#DBEEF4;"" class=""wordWrapClass"">
                                                                <apex:outputPanel rendered=""{!$User.UIThemeDisplayed == 'Theme3'}"">
                                                                    <a href=""/{!n.id}"" target=""_top"">{!n.title}</a>
                                                                </apex:outputPanel>
                                                                <apex:outputPanel rendered=""{!$User.UIThemeDisplayed != 'Theme3'}"">
                                                                    <a href=""javascript:void(0)"" onclick=""javascript:sforce.one.navigateToURL('/{!n.id}')"">{!n.title}</a>
                                                                </apex:outputPanel>
                                                                
                                                            </td>
                                                            <td class=""wordWrapClass"" style=""border-right:1px solid #CCC;"">
                                                                <p >{!n.owner.name}</p>
                                                            </td>
                                                            <td class=""wordWrapClass"">
                                                                <p >
                                                                 <apex:outputText value=""{0, date, MM.dd.yyyy}"">
                                                                    <apex:param value=""{!n.createdDate}"" />
                                                                 </apex:outputText>
                                                                </p>
                                                            </td>
                                                        </tr>
                                                    </apex:repeat>
                                                   </tbody>
                                              </table>
                                          </apex:outputpanel>
                                      </div>
                                      </div>
                                      <!-- Next Steps -->
                                      <div class=""slds-size--12-of-12 slds-m-top--large""> 
                                          <apex:outputText styleclass=""slds-section-title"" rendered=""{!nextStepList.size > 0}"" value=""NEXT STEPS"" />
                                          <!-- <apex:outputpanel layout=""none"" rendered=""{!nextStepList.size == 0}"">
                                              <p class=""slds-text-body--regular slds-m-top--medium"">No task remains! </p>
                                          </apex:outputpanel> -->
                                          <apex:outputpanel layout=""none"" rendered=""{!nextStepList.size > 0}"">
                                              <table class=""slds-table slds-table--bordered slds-m-top--small"">
                                                  <thead>
                                                    <tr style=""color:white;background:#558ED5"">
                                                      <th scope=""col"" style=""width:60%;white-space:normal"">
                                                        <span >Subject</span>
                                                      </th>
                                                      <th scope=""col"" style=""width:40%;white-space:normal"">
                                                        <span >Due Date</span>
                                                      </th>
                                                    </tr>
                                                  </thead>
                                                  <tbody>
                                                    <apex:repeat value=""{!nextStepList}"" var=""t"">
                                                        <tr class=""slds-hint-parent"">
                                                            <td style=""background:#DBEEF4;"" class=""wordWrapClass"">
                                                                <a class=""detailAnchor"" href=""/{!t.id}"" target=""{! if($User.UIThemeDisplayed == 'Theme3','_top','') }"">{!t.subject}</a>
                                                            </td>
                                                            <td class=""wordWrapClass"">
                                                                <p >
                                                                 <apex:outputText value=""{0, date, MM.dd.yyyy}"">
                                                                    <apex:param value=""{!t.activityDate}"" />
                                                                </apex:outputText>
                                                                </p>
                                                            </td>
                                                        </tr>
                                                    </apex:repeat>
                                                    <apex:repeat value=""{!nextStepEvtList}"" var=""e"">
                                                        <tr class=""slds-hint-parent"">
                                                            <td style=""background:#DBEEF4;"" class=""wordWrapClass"">
                                                                <a class=""detailAnchor"" href=""/{!e.id}"" target=""{! if($User.UIThemeDisplayed == 'Theme3','_top','') }"">{!e.subject}</a>
                                                            </td>
                                                            <td class=""wordWrapClass"">
                                                                <p >
                                                                 <apex:outputText value=""{0, date, MM.dd.yyyy}"">
                                                                    <apex:param value=""{!e.startDateTime}"" />
                                                                </apex:outputText>
                                                                </p>
                                                            </td>
                                                        </tr>
                                                    </apex:repeat>
                                                   </tbody>
                                              </table>
                                          </apex:outputpanel>
                                  </div>
                                  <apex:commandButton styleclass=""slds-button slds-button--brand slds-button--small slds-m-top--small  slds-float--right saveButton"" onclick=""saveDealManagementChanges() ; return false;"" value=""Save"" />
                                  </apex:outputPanel>
                              </div>
                              <!-- Deal Management end -->    
                          </div>
                      </div>
                  </apex:outputpanel>
                  
                  <!--  Select Playbook modal start -->
                  <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""selectPlaybookModal"">
                        <div class=""slds-modal__container "">
                            <div class=""slds-modal__header"">
                                <h2 class=""slds-text-heading--medium"">Playbook Opportunity</h2>
                                <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                                    <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/> 
                                    <span class=""slds-assistive-text"">Close</span>
                                </button>
                            </div>
                            <div class=""slds-modal__content slds-scrollable--y"">
                                <div>
                                    <h2 class=""slds-text-heading--small"">Choose Playbook you would like to use :</h2>
                                    <apex:outputpanel layout=""none"" rendered=""{!processSelectList.size == 0}"">
                                        <p class=""slds-text-body--regular slds-m-top--medium"">Playbook not exist! </p>
                                    </apex:outputpanel>
                                    <apex:outputpanel layout=""none"" rendered=""{!processSelectList.size > 0}"">
                                        <table class=""selectPlaybookTbl slds-table slds-table--bordered slds-m-top--medium"" style=""max-height:350px !important"">
                                            <tbody>
                                              <apex:repeat value=""{!processSelectList}"" var=""p"">
                                                  <tr class=""slds-hint-parent"">
                                                      <td class=""selectPlaybookTd""  onclick=""selectPlaybookId(this,'{!p.id}');"" style=""cursor:pointer"">
                                                          <p class=""slds-truncate"">{!p.name__c}</p>
                                                      </td>
                                                  </tr>
                                              </apex:repeat>
                                            </tbody>
                                        </table>
                                    </apex:outputpanel>
                                </div>
                            </div>
                            <div class=""slds-modal__footer"">
                                <!-- <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Cancel</button> -->
                                <apex:outputpanel layout=""none"" rendered=""{!processSelectList.size > 0}"">
                                    <button class=""slds-button slds-button--neutral slds-button--brand"" data-aljs-dismiss=""modal"" onclick=""bulkInsertion(''+selectedPlaybookID) ; return false"">Select</button>
                                </apex:outputpanel>
                                <apex:outputpanel layout=""none"" rendered=""{!processSelectList.size == 0}"">
                                    <button class=""slds-button slds-button--neutral slds-button--brand"" data-aljs-dismiss=""modal""  onclick=""bulkInsertion(''+selectedPlaybookID) ; return false"" disabled=""disabled"">Select</button>
                                </apex:outputpanel>
                            </div>
                        </div>
                  </div>
                  <!-- Select Playbook modal end -->
                  
                  </apex:outputpanel>
                  
                  <!--  create question note modal start -->
                  <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""noteQuestionModal"">
                        <div class=""slds-modal__container"">
                            <div class=""slds-modal__header"">
                                <h2 class=""slds-text-heading--medium"">Note</h2>
                                <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                                    <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                                    <span class=""slds-assistive-text"">Close</span>
                                </button>
                            </div>
                            <div class=""slds-modal__content"">
                                <div class=""slds-form-element"">
                                    <div class=""slds-form-element__control "">
                                        <apex:inputTextArea id=""createNoteQuestion"" rows=""5"" value=""{!noteQuestion}"" styleclass=""slds-textarea""/>    
