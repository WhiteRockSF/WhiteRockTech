                    </div>
                </div>
                
            </div>
            <!-- Training Clone modal -->
            
            <!-- Question prompt modal -->
            <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""questionpromptmodal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium"">Create New Question</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop(); return false"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button> 
                    </div>
                    <div class=""slds-modal__content"">
                        <h4>Choose starting point to create new question</h4>
                        <br/>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" aria-live=""assertive"" onclick=""loadQuestions();return false"">Copy existing</a>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" onclick=""initializeQuestion();return false"" aria-live=""assertive"" >Create from blank</a>
                        <br/>
                        <br/>
                    </div>
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop(); return false"" >Cancel</button>                     
                    </div>
                </div>
            </div>
            <!-- End Quetions Model -->
          
            <!-- Message prompt modal -->
            <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""messagePromptModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium"">Create New Message</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop(); return false"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button> 
                    </div>
                    <div class=""slds-modal__content"">
                        <h4>Choose starting point to create new message</h4>
                        <br/>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" aria-live=""assertive"" onclick=""loadMessages();return false"">Copy existing</a>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" onclick=""initializeMessage();return false"" aria-live=""assertive"" >Create from blank</a>
                        <br/>
                        <br/>
                    </div>
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop(); return false"" >Cancel</button>                     
                    </div>
                </div>
            </div>
            
            <!-- Tools prompt modal -->
            <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""toolPromptModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium"">Create New Tool</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop(); return false"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button> 
                    </div>
                    <div class=""slds-modal__content"">
                        <h4>Choose starting point to create new tool</h4>
                        <br/>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" aria-live=""assertive"" onclick=""loadTools(); return false"" >Copy existing</a>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" onclick=""initializeTool();return false"" aria-live=""assertive"" >Create from blank</a>
                        <br/>
                        <br/>
                    </div>
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop(); return false"" >Cancel</button>                     
                    </div>
                </div>
            </div>
            
            <!-- Trainings prompt modal -->
            <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""trainingPromptModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium"">Create New Training</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop(); return false"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button> 
                    </div>
                    <div class=""slds-modal__content"">
                        <h4>Choose starting point to create new training</h4>
                        <br/>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" aria-live=""assertive"" onclick=""loadTrainings(); return false"" >Copy existing</a>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" onclick=""initializeTraining();return false"" aria-live=""assertive"" >Create from blank</a>
                        <br/>
                        <br/>
                    </div>
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop(); return false"" >Cancel</button>                     
                    </div>
                </div>
            </div>
            
         <!-- Play Modal Start -->
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""playModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium playMdlHeading"">New Play</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button>
                    </div>
                    <div class=""slds-modal__content"">
                        
                        <div class=""slds-notify-container createPlayNotify""  style=""position:relative;display:none"">
                          <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                            <span class=""slds-assistive-text"">Info</span>
                              
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close""  onclick=""$('.createPlayNotify').hide(100);"">
                              <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                              <span class=""slds-assistive-text"">Close</span>
                            </a>
                            <div class=""notify__content"">
                              <h2 class=""slds-text-heading--small"">
                                  <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                    <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                  </svg>
                                  <span class=""createPlayErrorMsg""></span>
                              </h2>
                            </div>
                          </div>
                        </div>
                        <div class=""slds-form-element slds-is-required"">
                            <!--6th feb making dynamic according to opportunity or lead -->
                            <apex:outputPanel layout=""none"" rendered=""{!IF(processObj.PlaybookEntityType__c == 'Opportunity', true, false)}"">
                                <label class=""formLabel slds-form-element__label"">Current Stage</label>
                            </apex:outputPanel>
                            <apex:outputPanel layout=""none"" rendered=""{!IF(processObj.PlaybookEntityType__c == 'Lead', true, false)}"">
                                <label class=""formLabel slds-form-element__label"">Current Status</label>
                            </apex:outputPanel>
                            <div class=""slds-form-element__control"">
                                <input type=""text"" id=""curStageForPlay"" value=""Stage Name"" class=""slds-input"" readonly=""true""/>
                            </div>
                        </div>
                        <div class=""slds-form-element slds-is-required"">
                            <label class=""formLabel slds-form-element__label"">Play Name</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputText id=""playNameId"" value=""{!playObj.Name__c}"" styleclass=""slds-input""/>
                            </div>
                        </div>
                        <div class=""slds-form-element"">
                            <label class=""formLabel slds-form-element__label"">Description</label>
                            <div class=""slds-form-element__control "">
                                <apex:inputTextArea id=""playDescId"" value=""{!playObj.Description__c}"" styleclass=""slds-textarea""/>    
                            </div>
                        </div>
                        
                        
                    </div>
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Cancel</button>
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""checkValidation('CreatePlay');return false"">Save</button>
                    </div>
                </div>
          </div>
          <!-- Play Modal End -->
          
          
          <!--  playbook delete modal start-->
          <div>
            <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""deleteModal"">
              <div class=""slds-modal__container  slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium"">Delete Playbook</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <apex:outputpanel id=""deletemodalTextPanel"">
                        <p>Are you sure to delete {!processObj.Name__c}?</p>
                    </apex:outputpanel>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                  <apex:commandbutton action=""{!deletePlaybook}"" styleclass=""slds-button slds-button--neutral"" value=""Yes""/>
                  <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">No</button>
                </div>
              </div>
            </div>
            
          </div>
          <!--  playbook delete modal start-->
          
          <!--  delete modal start-->
          <div>
            <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""deleteMainModal"">
              <div class=""slds-modal__container  slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium deleteMdlHeading"">Delete Playbook</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <p>Are you sure to delete?</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                  <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" onclick=""$('[id$=deleteMainModal]').modal('dismiss');deleteRecord();return false"">Yes</a>
                  <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">No</button>
                </div>
              </div>
            </div>
            
          </div>
          <!-- delete modal start-->
          
          <!--  playbook publish modal start-->
          <div>
            <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""publishModal"">
              <div class=""slds-modal__container  slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium"">Publish Playbook</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <apex:outputpanel id=""publishmodalTextPanel"">
                        <p>Are you sure you are ready to publish {!processObj.Name__c}.</p>
                    </apex:outputpanel>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                  <apex:commandButton styleclass=""slds-button slds-button--neutral"" action=""{!publishPlaybook}"" value=""Yes""/>
                  <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">No</button>
                </div>
              </div>
            </div>
            
          </div>
          <!--  playbook publish modal start-->
          
          <!--  playbook publish ok modal start-->
          <div>
            <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""publishOkModal"">
              <div class=""slds-modal__container  slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium"">Publish Playbook</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <p>Playbook {!processObj.name} has been published.</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                  <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Ok</button>
                </div>
              </div>
            </div>
            
          </div>
          <!--  playbook publish ok modal start-->
          
          <!-- Process Modal Start -->
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""processModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium processMdlHeading"">Edit Playbook</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button>
                    </div>
                    <div class=""slds-modal__content"">
                           <div class=""slds-notify-container createProcessNotify""  style=""position:relative;display:none"">
                          <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                            <span class=""slds-assistive-text"">Info</span>
                              
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close""  onclick=""$('.createProcessNotify').hide(100);"">
                              <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                              <span class=""slds-assistive-text"">Close</span>
                            </a>
                            <div class=""notify__content"">
                              <h2 class=""slds-text-heading--small"">
                                  <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                    <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                  </svg>
                                  <span class=""createProcessErrorMsg""></span>
                              </h2>
                            </div>
                          </div>
                        </div>
                        <apex:outputPanel id=""processModalId"">
                            
                            <div class=""slds-form-element slds-is-required"">
                                <label class=""formLabel slds-form-element__label"">Playbook Name</label>
                                <div class=""slds-form-element__control"">
                                    <apex:inputText id=""createProcessName"" value=""{!processObj.Name__c}"" styleclass=""slds-input""/>
                                </div>
                            </div>
                            <div class=""slds-form-element"">
                                <label class=""formLabel slds-form-element__label"">Playbook Description</label>
                                <div class=""slds-form-element__control "">
                                    <apex:inputTextArea id=""createProcessDesc"" value=""{!processObj.Description__c}"" styleclass=""slds-textarea""/>    
                                </div>
                            </div>
                            <!-- Added new field to select sales process if exist -->
                            <!-- <apex:outputPanel layout=""none"" rendered=""{!currentSalesProcess != null && LEN(TRIM(currentSalesProcess)) > 0}"">
                                <div class=""slds-form-element"">
                                    <label class=""formLabel slds-form-element__label"">Sales Process</label>                            
                                    <div class=""slds-form-element__control"">
                                          <input type=""Text"" value=""{!currentSalesProcess}"" disabled=""disabled"" class=""slds-input""/>
                                    </div>
                                </div>
                            </apex:outputPanel> -->
                            <!-- Added new field to select sales process if exist -->
                            <apex:outputPanel layout=""none"" rendered=""{!salesProcessList.size > 0}"">
                                <div class=""slds-form-element"">
                                    <apex:outputPanel layout=""none"" rendered=""{!IF(processObj.PlaybookEntityType__c == 'Opportunity', true, false)}"">
                                        <label class=""formLabel slds-form-element__label"">Sales Process</label>    
                                    </apex:outputPanel>         
                                    <apex:outputPanel layout=""none"" rendered=""{!IF(processObj.PlaybookEntityType__c == 'Lead', true, false)}"">
                                        <label class=""formLabel slds-form-element__label"">Lead Process</label>    
                                    </apex:outputPanel>               
                                    <div class=""slds-form-element__control"">
                                      <div class=""slds-select_container"">                              
                                        <apex:selectList value=""{!processObj.BusinessProcessId__c}"" StyleClass=""slds-select"" size=""1"">
                                            <apex:selectOption itemLabel=""None"" itemValue=""""/>
                                            <apex:selectOptions value=""{!salesProcessList}""/>
                                        </apex:selectList>
                                      </div>
                                    </div>                       
                                </div>
                            </apex:outputPanel>
                            <apex:outputPanel layout=""none"" rendered=""{!IF(processObj.PlaybookEntityType__c == 'Opportunity', true, false)}"">                                   
                                <div class=""slds-form-element"">
                                    <label class=""formLabel slds-form-element__label"">ProgressThreshold(%)</label>
                                    <div class=""slds-form-element__control"">
                                        <apex:inputText id=""createProcessProgressT"" value=""{!processObj.ProgressThreshold__c}"" styleclass=""slds-input""/>
                                    </div>
                                </div>
                            </apex:outputPanel>
                        </apex:outputPanel>
                    </div>
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Cancel</button>
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""checkValidation('CreateProcess');return false"">Save</button>
                    </div>
                </div>
          </div>
          <!-- Process Modal End -->
          
          <!-- question Modal Start -->
              
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""questionModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium questionMdlHeading"">New Question</h2>
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </a>
                    </div>
                    <div class=""slds-modal__content"">
                        <apex:actionStatus id=""StatusQuestion"" >
                            <apex:facet name=""start"">
                             <apex:outputPanel id=""tstpopupQuestion""> 
                                <apex:outputPanel styleClass=""popupBackground"" layout=""block"" style=""width:100%""/> 
                                <apex:outputPanel styleClass=""custPopup"" layout=""block""> 
                                    <div class=""slds-spinner--medium"">
                                        <img src=""{!URLFOR($Resource.slds, 'assets/images/spinners/slds_spinner_brand.gif')}"" alt=""Loading..."" style=""margin-top:150%"" />
                                    </div>
                                </apex:outputPanel> 
                             </apex:outputPanel> 
                            </apex:facet> 
                        </apex:actionStatus>
                        
                        <div class=""slds-notify-container createQuestionNotify""  style=""position:relative;display:none"">
                          <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                            <span class=""slds-assistive-text"">Info</span>
                              
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close""  onclick=""$('.createQuestionNotify').hide(100);"">
                              <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                              <span class=""slds-assistive-text"">Close</span>
                            </a>
                            <div class=""notify__content"">
                              <div class=""slds-grid"">
                                <div class=""slds-size--3-of-10"">
                                  <h2 class=""slds-text-heading--small"">
                                    <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                      <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                    </svg>
                                  </h2>
                                </div>
                                <div class=""slds-size--7-of-10"">
                                    <h2 class=""slds-text-heading--small"">
                                        <span class=""createQuestionErrorMsg"" style=""white-space:normal""></span>
                                    </h2>
                                </div>
                              </div>
                              
                            </div>
                          </div>
                        </div>
                        
                        <apex:outputPanel id=""questionModalDiv"">
                        <div class=""slds-form-element slds-is-required"" style=""margin-top:0 !important"">
                            <label class=""slds-form-element__label formLabel"">Question</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputTextarea id=""createQuestionDesc"" value=""{!quesObj.Description__c}"" styleclass=""slds-textarea""/>
                            </div>
                        </div>
                        </apex:outputPanel>
                        <div class=""slds-form-element"">
                            <label class=""slds-form-element__label formLabel"">Tip</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputTextArea richtext=""true"" id=""createQuestionTip"" value=""{!quesObj.Tip__c}"" styleclass=""slds-input""/>
                            </div>
                        </div>
                        <apex:outputPanel id=""questionModalDiv2"">
                            <!--21 feb to make dynamic according to lead and opportunity -->
                            <apex:outputPanel layout=""none"" rendered=""{!IF(processObj.PlaybookEntityType__c == 'Opportunity', true, false)}"">
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label slds-is-required formLabel"">Importance</label>
                                    <div class=""slds-form-element__control "">
                                        <apex:selectList id=""createQuestionImportance"" value=""{!quesObj.Points__c}"" size=""1"" styleclass=""slds-select""> 
                                            <apex:selectOption itemLabel=""Not Important"" itemValue=""0"" />
                                            <apex:selectOption itemLabel=""Somewhat Important"" itemValue=""1"" />
                                            <apex:selectOption itemLabel=""Important"" itemValue=""2"" />
                                            <apex:selectOption itemLabel=""Very Important"" itemValue=""3"" />
                                        </apex:selectList>
                                            
                                    </div>
                                </div>
                            </apex:outputPanel>
                            <div class=""slds-grid slds-wrap slds-form-element"">
                                <div class=""slds-size--1-of-1"">
                                    <label class=""slds-form-element__label formLabel"">Include in:</label>
                                </div>
                            </div>
                            <div class=""slds-grid slds-wrap"">
                                <!--6th feb to make dynamic according to lead and opportunity -->
                                <apex:outputPanel layout=""none"" rendered=""{!IF(processObj.PlaybookEntityType__c == 'Opportunity', true, false)}"">
                                    <div class=""slds-size--1-of-2"">
                                        <div class=""slds-form--horizontal"">
                                            <div class="""" style=""text-align:left"">
                                                
                                                <div class=""slds-form-element__control"" style=""width:10% !important"">
                                                    <label class=""slds-checkbox"">
                                                       <apex:inputCheckbox id=""createQuestionIIDealP"" styleClass=""sectionCheckboxGroup1"" value=""{!quesObj.IncludedInDealProgress__c}"" onchange=""uncheckAllsectionCheckboxGroup1(this,this.checked)""/>
                                                       <span class=""slds-checkbox--faux""></span>
                                                    </label>
                                                </div>
                                                <label class=""slds-form-element__label"" style=""max-width:100% !important"">Deal Progress</label>
                                            </div>
                                        </div>
                                    </div>
                                </apex:outputPanel>
                                <div class=""slds-size--1-of-2"">
                                    <div class=""slds-form--horizontal"">
                                        <div class="""" style=""text-align:left"">
                                            
                                            <div class=""slds-form-element__control"" style=""width:10% !important"">
                                                <label class=""slds-checkbox"">
                                                   <apex:inputCheckbox id=""createQuestionIIDis"" styleClass=""sectionCheckboxGroup2"" value=""{!quesObj.IncludedInDiscussion__c}"" onchange=""uncheckAllsectionCheckboxGroup2(this,this.checked)""/>
                                                   <span class=""slds-checkbox--faux""></span>
                                                </label>
                                            </div>
                                            <label class=""slds-form-element__label"" style=""max-width:100% !important"">Call Management – Discussion</label>
                                        </div>
                                    </div>
                                </div>
                                
                                <apex:outputPanel layout=""none"" rendered=""{!IF(processObj.PlaybookEntityType__c == 'Opportunity', true, false)}"">
                                    <div class=""slds-size--1-of-2 slds-m-top--small"">
                                        <div class=""slds-form--horizontal"">
                                            <div class="""" style=""text-align:left"">
                                                
                                                <div class=""slds-form-element__control"" style=""width:10% !important"">
                                                    <label class=""slds-checkbox"">
                                                       <apex:inputCheckbox id=""createQuestionIIExecS"" styleClass=""sectionCheckboxGroup3"" value=""{!quesObj.IncludedInExecSummary__c}"" onchange=""$('[id$=createQuestionIISuccessI]').prop('checked',false);""/>
                                                       <span class=""slds-checkbox--faux""></span>
                                                    </label>
                                                </div>
                                                <label class=""slds-form-element__label"" style=""max-width:100% !important"">Executive Summary</label>
                                            </div>
                                        </div>
                                    </div>
                                </apex:outputPanel>
                                <div class=""slds-size--1-of-2   {!IF(processObj.PlaybookEntityType__c == 'Opportunity', 'slds-m-top--small', '')}"">
                                    <div class=""slds-form--horizontal"">
                                        <div class="""" style=""text-align:left"">
                                            
                                            <div class=""slds-form-element__control"" style=""width:10% !important"">
                                                <label class=""slds-checkbox"">
                                                   <apex:inputCheckbox id=""createQuestionIIAss"" styleClass=""sectionCheckboxGroup2"" value=""{!quesObj.IncludedInAssessment__c}"" onchange=""uncheckAllsectionCheckboxGroup2(this,this.checked)""/>
                                                   <span class=""slds-checkbox--faux""></span>
                                                </label>
                                            </div>
                                            <label class=""slds-form-element__label"" style=""max-width:100% !important"">Call Management – Assessment</label>
                                        </div>
                                    </div>
                                </div>
                                
                                <apex:outputPanel layout=""none"" rendered=""{!IF(processObj.PlaybookEntityType__c == 'Opportunity', true, false)}"">
                                    <div class=""slds-size--1-of-2 slds-m-top--small"">
                                        <div class=""slds-form--horizontal"">
                                            <div class="""" style=""text-align:left"">
                                                <div class=""slds-form-element__control"" style=""width:10% !important"">
                                                    <label class=""slds-checkbox"">
                                                       <apex:inputCheckbox id=""createQuestionIIKeyM"" styleClass=""sectionCheckboxGroup1"" value=""{!quesObj.IncludedInKeyMilestones__c}"" onchange=""uncheckAllsectionCheckboxGroup1(this,this.checked)""/>
                                                       <span class=""slds-checkbox--faux""></span>
                                                    </label>
                                                </div>
                                                <label class=""slds-form-element__label"" style=""max-width:100% !important"">Key Milestones</label>
                                            </div>
                                        </div>
                                    </div>
                                </apex:outputPanel> 
                                <!-- <div class=""slds-size--1-of-2 slds-m-top--small"">
                                    <div class=""slds-form--horizontal"">
                                        <div class="""" style=""text-align:left"">
                                            
                                            <div class=""slds-form-element__control"" style=""width:10% !important"">
                                                <label class=""slds-checkbox"">
                                                   <apex:inputCheckbox id=""createQuestionIISuccessI"" styleClass=""sectionCheckboxGroup1"" value=""{!quesObj.IncludedInSuccessIndicators__c}"" onchange=""uncheckAllsectionCheckboxGroup(this,this.checked)""/>
                                                   <span class=""slds-checkbox--faux""></span>
                                                </label>
                                            </div>
                                            <label class=""slds-form-element__label"" style=""max-width:100% !important"">Success Indicators</label>
                                        </div>
                                    </div>
                                </div> -->
                                
                            </div>    
                            <div class=""slds-form-element slds-is-required"">
                                <label class=""slds-form-element__label formLabel"">Answer Type</label>
                                <div class=""slds-form-element__control "">
                                    <apex:selectList id=""createQuestionAnsType"" value=""{!quesObj.ResponseType__c}"" size=""1"" styleclass=""slds-select"" onchange=""showHideAnsContent();return false""> 
                                        <apex:selectoptions value=""{!responsePicklist}""/>
                                    </apex:selectList>    
                                </div>
                            </div>
                            <apex:outputPanel rendered=""{!dataMapList.size > 0}"">
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label formLabel"">Choose Field</label>
                                    <div class=""slds-form-element__control "">
                                        <apex:selectList id=""createQuestionDataMap"" value=""{!quesObj.Name__c}"" size=""1"" styleclass=""slds-select""> 
                                            <apex:selectoptions value=""{!dataMapList}""/>
                                        </apex:selectList>    
                                    </div>
                                </div>
                            </apex:outputPanel>
                            <apex:outputPanel rendered=""{!ansModalList.size > 0}"">
                                <div class=""slds-form-element answerContentDiv slds-is-required"">
                                    <label class=""slds-form-element__label formLabel"">Answer Content</label>
                                    <div class=""slds-form-element__control"">
                                        <apex:variable value=""{!-1}"" var=""ansIndex""/>
                                        <apex:repeat value=""{!ansModalList}"" var=""ans"">
                                        <apex:variable value=""{!ansIndex + 1}"" var=""ansIndex""/>
                                        
                                        <div style=""margin-bottom:5px"">
                                            <table cellpadding=""3"">
                                                <tr>
                                                    <td style=""width:{!IF(processObj.PlaybookEntityType__c == 'Opportunity', '58%', '78%')}"" >
                                                        <apex:inputText value=""{!ans.answer}"" styleclass=""slds-input answers"" />
                                                    </td>
                                                    <td style=""width:17%;padding-left:10px !important;text-align:center"" >
                                                        <label class=""slds-checkbox"">
                                                           <apex:inputCheckbox value=""{!ans.flagType}""/>
                                                           <span class=""slds-checkbox--faux""></span>
                                                        </label>
                                                        <i class=""fa fa-flag"" aria-hidden=""true"" style=""color: red;font-size:20px; vertical-align : middle !important;""/>
                                                        
                                                        
                                                    </td>
                                                    
                                                    <td style=""width:20%;padding-left:10px !important; display: {!IF(processObj.PlaybookEntityType__c != 'Opportunity', 'none', '')};"">
                                                        <!--21 feb to make dynamic according to lead and opportunity -->
                                                        <apex:outputPanel layout=""none"" rendered=""{!IF(processObj.PlaybookEntityType__c == 'Opportunity', true, false)}"">
                                
                                                            <apex:selectList styleclass=""slds-select""  value=""{!ans.weight}"" size=""1"">
                                                                <apex:selectOption itemValue=""-1"" itemLabel=""-1""/>
                                                                <apex:selectOption itemValue=""0"" itemLabel=""0""/>
                                                                <apex:selectOption itemValue=""1"" itemLabel=""1""/>
                                                                <apex:selectOption itemValue=""2"" itemLabel=""2""/>
                                                                <apex:selectOption itemValue=""3"" itemLabel=""3""/>
                                                            </apex:selectList>
                                                        </apex:outputPanel>
                                                    </td>
                                                    <td style=""width:5%;padding-left:10px !important"">
                                                        <a href=""javascript:void(0)"" class="""" style=""text-decoration:none;margin-left:5px""  onclick=""removeAnswerContent({!ansIndex});return false"">
                                                            <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""height:17px;width:17px""/>
                                                        </a>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                        
                                        </apex:repeat>
                                        
                                        <div style=""margin-bottom:10px"">
                                            <a href=""javascript:void(0)"" class="""" style=""text-decoration:none""  onclick=""increaseAnswerContent(); return false"">
                                                <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#add"" cssStyle=""height:17px;width:17px""/>
                                            </a>
                                        </div>    
                                    </div>
                                </div>
                            </apex:outputPanel>
                        </apex:outputPanel>
                    </div>
                    <div class=""slds-modal__footer"">
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">Cancel</a>
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""checkValidation('CreateQuestion');return false"">Save</button>
                    </div>
                </div>
          </div>
          <!-- question Modal End -->
          
          <!-- message Modal Start -->
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""messageModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium messageMdlHeading"">New Message</h2>
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </a>
                    </div>
                    <div class=""slds-modal__content"">
                        
                        <div class=""slds-notify-container createMessageNotify""  style=""position:relative;display:none"">
                          <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                            <span class=""slds-assistive-text"">Info</span>
                              
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close""  onclick=""$('.createMessageNotify').hide(100);"">
                              <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                              <span class=""slds-assistive-text"">Close</span>
                            </a>
                            <div class=""notify__content"">
                              <h2 class=""slds-text-heading--small"">
                                  <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                    <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                  </svg>
                                  <span class=""createMessageErrorMsg""></span>
                              </h2>
                            </div>
                          </div>
                        </div>
                        
                        <apex:outputPanel id=""messageModalDiv"">
                        
                            <div class=""slds-form-element"">
                                <label class=""formLabel slds-form-element__label"">Label</label>
                                <div class=""slds-form-element__control"">
                                    <apex:inputText id=""createMessageLbl"" value=""{!msgObj.Name__c}"" styleclass=""slds-input""/>
                                </div>
                            </div>
                        </apex:outputPanel>
                        
                        <div class=""slds-form-element slds-is-required"">
                            <label class=""formLabel slds-form-element__label"">Message</label>
                            <div class=""slds-form-element__control"">
                                <!-- <apex:inputfield id=""createMessageMsg"" value=""{!msgObj.Description__c}"" styleclass="""" /> -->
                                <apex:inputTextArea richtext=""true"" id=""createMessageMsg"" value=""{!msgObj.Description__c}"" styleclass=""slds-input""/>
                            </div>
                        </div>
                        
                        <apex:outputPanel id=""messageModalDiv2"">
                        
                            <!-- <div class=""slds-form-element"">
                                <label class=""formLabel slds-form-element__label"">Tip</label>
                                <div class=""slds-form-element__control"">
                                    <apex:inputText id=""createMessageTip"" value=""{!msgObj.Tip__c}"" styleclass=""slds-input""/>
                                </div>
                            </div>  -->
                            <div class=""slds-grid slds-wrap slds-m-top--small"">
                                <div class=""slds-size--1-of-1"">
                                    <label class=""formLabel slds-form-element__label"">Include in:</label>
                                </div>
                            </div>
                            <div class=""slds-grid slds-wrap"">
                                <div class=""slds-size--1-of-2 slds-m-bottom--small"">
                                    <div class=""slds-form--horizontal"">
                                        <div class="""" style=""text-align:left"">
                                            <div class=""slds-form-element__control"" style=""width:10% !important"">
                                                <label class=""slds-checkbox"">
                                                   <apex:inputCheckbox id=""createMessageIIDis"" styleClass=""sectionCheckboxGroup4"" value=""{!msgObj.IncludedInDiscussion__c}"" onchange=""uncheckAllsectionCheckboxGroup4(this,this.checked)""/>
                                                   <span class=""slds-checkbox--faux""></span>
                                                </label>
                                            </div>
                                            <label class=""slds-form-element__label"" style=""max-width:100% !important"">Call Management - Discussion</label>
                                        </div>
                                    </div>
                                </div>
                                <div class=""slds-size--1-of-2 slds-m-bottom--small"">
                                   <div class=""slds-form--horizontal"">
                                        <div class="""" style=""text-align:left"">
                                            <div class=""slds-form-element__control"" style=""width:10% !important"">
                                                <label class=""slds-checkbox"">
                                                   <apex:inputCheckbox id=""createMessageIIAss"" styleClass=""sectionCheckboxGroup4"" value=""{!msgObj.IncludedInAssessment__c}"" onchange=""uncheckAllsectionCheckboxGroup4(this,this.checked)""/>
                                                   <span class=""slds-checkbox--faux""></span>
                                                </label>
                                            </div>
                                            <label class=""slds-form-element__label"" style=""max-width:100% !important"">Call Management - Assessment</label>
                                        </div>
                                    </div> 
                                </div>
                            </div> 
                        </apex:outputPanel>
                    </div>
                    <div class=""slds-modal__footer"">
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">Cancel</a>
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral slds-button--brand"" onclick=""checkValidation('CreateMessage');return false"">Save</a>
                    </div>
                </div>
          </div>
          <!-- message Modal End -->
          </apex:actionRegion>
          <!-- tool Modal Start -->
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""toolModal"">
                <div class=""slds-modal__container"">
                    
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium toolMdlHeading"">New Tool</h2>
                        <a class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </a>
                    </div>
                    <div class=""slds-modal__content"">
                        <apex:actionStatus id=""StatusTool"" >
                            <apex:facet name=""start"">
                             <apex:outputPanel id=""tstpopupTool""> 
                                <apex:outputPanel styleClass=""popupBackground"" layout=""block"" style=""width:100%""/> 
                                <apex:outputPanel styleClass=""custPopup"" layout=""block""> 
                                    <div class=""slds-spinner--medium"">
                                        <img src=""{!URLFOR($Resource.slds, 'assets/images/spinners/slds_spinner_brand.gif')}"" alt=""Loading..."" style=""margin-top:150%"" />
                                    </div>
                                </apex:outputPanel> 
                             </apex:outputPanel> 
                            </apex:facet> 
                        </apex:actionStatus>
                        
                        <div class=""slds-notify-container createToolNotify""  style=""position:relative;display:none"">
                          <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                            <span class=""slds-assistive-text"">Info</span>
                              
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close""  onclick=""$('.createToolNotify').hide(100);"">
                              <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                              <span class=""slds-assistive-text"">Close</span>
                            </a>
                            <div class=""notify__content"">
                              <h2 class=""slds-text-heading--small"">
                                  <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                    <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                  </svg>
                                  <span class=""createToolErrorMsg""></span>
                              </h2>
                            </div>
                          </div>
                        </div>
                        
                        <apex:actionRegion >
                        
                        <apex:outputPanel id=""toolModalDiv"">
                        
                        <div class=""slds-form-element slds-is-required"">
                            <label class=""formLabel slds-form-element__label"">Label</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputText id=""createToolLbl"" value=""{!toolObj.Name__c}"" styleclass=""slds-input""/>
                            </div>
                        </div>
                        <div class=""slds-form-element "">
                            <label class=""formLabel slds-form-element__label"">Description</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputtextarea id=""createToolDesc"" value=""{!toolObj.Description__c}"" styleclass=""slds-textarea"" />
                            </div>
                        </div>
                        <!-- <div class=""slds-form-element"">
                            <label class=""formLabel slds-form-element__label"">Tip</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputText id=""createToolTip"" value=""{!toolObj.Tip__c}"" styleclass=""slds-input""/>
                            </div>
                        </div> -->
                        <div class=""slds-grid slds-wrap slds-m-top--small"">
                            <div class=""slds-size--1-of-1"">
                                <label class=""formLabel slds-form-element__label"">Include in:</label>
                            </div>
                        </div>
                        <div class=""slds-grid slds-wrap"">
                            <div class=""slds-size--1-of-2"">
                                 <div class=""slds-form--horizontal"">
                                      <div class="""" style=""text-align:left"">
                                          <div class=""slds-form-element__control"" style=""width:14% !important"">
                                              <label class=""slds-checkbox"">
                                                  <apex:inputCheckbox styleClass=""sectionCheckboxGroup5"" value=""{!toolObj.IncludedInGeneral__c}"" /><!-- onchange=""uncheckAllsectionCheckboxGroup5(this,this.checked)"" -->
                                                  <span class=""slds-checkbox--faux""></span>
                                              </label>
                                          </div>
                                          <label class=""slds-form-element__label"" style=""max-width:100% !important"">Sales Tool - General</label>
                                      </div>
                                  </div>
                            </div>
                            <div class=""slds-size--1-of-2"">
                                  <div class=""slds-form--horizontal"">
                                      <div class="""" style=""text-align:left"">
                                          <div class=""slds-form-element__control"" style=""width:14% !important"">
                                              <label class=""slds-checkbox"">
                                                   <apex:inputCheckbox styleClass=""sectionCheckboxGroup5"" value=""{!toolObj.IncludedInSuccessStories__c}""/>
                                                   <span class=""slds-checkbox--faux""></span>
                                              </label>
                                          </div>
                                          <label class=""slds-form-element__label"" style=""max-width:100% !important"">Sales Tool - Success Stories</label>
                                      </div>
                                  </div>
                              </div>
                              <div class=""slds-size--1-of-2 slds-m-top--small"">
                                  <div class=""slds-form--horizontal"">
                                      <div class="""" style=""text-align:left"">
                                          <div class=""slds-form-element__control"" style=""width:14% !important"">
                                              <label class=""slds-checkbox"">
                                                   <apex:inputCheckbox styleClass=""sectionCheckboxGroup5"" value=""{!toolObj.IncludedInObjectionHandling__c}""/>
                                                   <span class=""slds-checkbox--faux""></span>
                                              </label>
                                          </div>
                                          <label class=""slds-form-element__label"" style=""max-width:100% !important"">Sales Tool - Objection Handling</label>
                                      </div>
                                  </div>
                              </div>
                                    
                              <div class=""slds-size--1-of-2 slds-m-top--small"">
                                  <div class=""slds-form--horizontal"">
                                      <div class="""" style=""text-align:left"">
                                          <div class=""slds-form-element__control"" style=""width:14% !important"">
                                              <label class=""slds-checkbox"">
                                                   <apex:inputCheckbox styleClass=""sectionCheckboxGroup5"" value=""{!toolObj.IncludedInCompetition__c}"" />
                                                   <span class=""slds-checkbox--faux""></span>
                                              </label>
                                          </div>
                                          <label class=""slds-form-element__label"" style=""max-width:100% !important"">Sales Tool - Competition</label>
                                      </div>
                                  </div>
                              </div>
                              
                              <div class=""slds-size--1-of-2 slds-m-top--small"">
                                  <div class=""slds-form--horizontal"">
                                      <div class="""" style=""text-align:left"">
                                          <div class=""slds-form-element__control"" style=""width:14% !important"">
                                              <label class=""slds-checkbox"">
                                                   <apex:inputCheckbox styleClass=""sectionCheckboxGroup5"" value=""{!toolObj.IncludedInProduct__c}""/>
                                                   <span class=""slds-checkbox--faux""></span>
                                              </label>
                                          </div>
                                          <label class=""slds-form-element__label"" style=""max-width:100% !important"">Sales Tool - Product</label>
                                      </div>
                                  </div>
                              </div>
                              <div class=""slds-size--1-of-2 slds-m-top--small"">
                                  <div class=""slds-form--horizontal"">
                                    <div class="""" style=""text-align:left"">
                                        <div class=""slds-form-element__control"" style=""width:14% !important"">
                                            <label class=""slds-checkbox"">
                                                 <apex:inputCheckbox styleClass=""sectionCheckboxGroup5"" value=""{!toolObj.IncludedInCallManagementDiscussion__c}""/>
                                                 <span class=""slds-checkbox--faux""></span>
                                            </label>
                                        </div>
                                        <label class=""slds-form-element__label"" style=""max-width:100% !important"">Call Management - Discussion</label>
                                    </div>
                                  </div>
                              </div>
                            
                        </div> 

                        </apex:outputPanel>
                        </apex:actionRegion>
                        <div class=""slds-form-element"">
                            <label class=""formLabel slds-form-element__label"">Add Content</label>
                            <div class=""slds-form-element__control"">
                                <table style=""width:auto !important"">
                                    
                                    <tr>
                                        <td>
                                            <a href=""javascript:void(0)"" >
                                                <span class=""fileUpload slds-button"" onclick=""$('[id$=selectedToolStr]').val('upload');$('.createToolLinkDiv').hide(100);$('.createToolselectContentDiv').hide(100);if({!libraryList.size} > 0){ $('.createToolselectLibDiv').show(100);}"" data-aljs=""tooltip"" data-aljs-placement=""right"" title=""Upload File"">
                                                    <c:SVGComponent styleClass=""slds-icon slds-icon-text-default contentIcons"" path=""/assets/icons/utility-sprite/svg/symbols.svg#attach""/>
                                                    <apex:inputFile styleclass=""upload"" value=""{!contversion.versionData}"" filename=""{!contversion.title}"" onclick=""$('.createToolLinkDiv').hide(100);"" onchange=""$('.emailFileName').text($(this).val().split('\\').pop())""/>
                                                    <span> <div class=""emailFileName truncate-cust"" style=""display: table-cell !important;"">{!contversion.title}</div></span>
                                                </span>
                                            </a>
                                        </td>
                                        <td>
                                            <a href=""javascript:void(0)"" onclick=""$('[id$=selectedToolStr]').val('link');$('.createToolLinkDiv').show(100);$('.upload').val('');$('.emailFileName').val('');$('.createToolselectLibDiv').hide(100);$('.createToolselectContentDiv').hide(100);"" style=""margin-left:10px"" data-aljs=""tooltip"" data-aljs-placement=""right"" title=""Add Link"">
                                                <c:SVGComponent styleClass=""slds-icon slds-icon-text-default contentIcons"" path=""/assets/icons/utility-sprite/svg/symbols.svg#link""/>
                                            </a>
                                        </td>
                                        <td>
                                            <a href=""javascript:void(0)"" onclick=""$('[id$=selectedToolStr]').val('content');$('.createToolLinkDiv').hide(100);$('.upload').val('');$('.emailFileName').val('');$('.createToolselectLibDiv').show(100);$('.createToolselectContentDiv').show(100);"" style=""margin-left:10px"" data-aljs=""tooltip"" data-aljs-placement=""right"" title=""Select SFDC Content"">
                                                <c:SVGComponent styleClass=""slds-icon slds-icon-text-default contentIcons"" path=""/assets/icons/utility-sprite/svg/symbols.svg#opened_folder""/>
                                            </a>
                                        </td>
                                        <td>
                                            <a href=""javascript:void(0)"" onclick=""$('[id$=selectedToolStr]').val('library');$('.createToolLinkDiv').hide(100);$('.upload').val('');$('.emailFileName').val('');$('.createToolselectLibDiv').show(100);$('.createToolselectContentDiv').hide(100);"" style=""margin-left:10px"" data-aljs=""tooltip"" data-aljs-placement=""right"" title=""Select SFDC Library"">
                                                <c:SVGComponent styleClass=""slds-icon slds-icon-text-default contentIcons"" path=""/assets/icons/utility-sprite/svg/symbols.svg#package""/>
                                            </a>
                                        </td>
                                    </tr>
                                </table>
                                    
                            </div>
                        </div>
                        <apex:actionRegion >
                            <apex:actionfunction name=""fillContents"" action=""{!fillContents}"" status=""StatusTool"" rerender=""contentDiv"" oncomplete=""if($('[id=selectedToolStr]').val() == 'content'){$('.createToolselectContentDiv').show();}"">
                                <apex:param assignTo=""{!selectedLibId}"" name=""libid"" value=""""/>
                            </apex:actionfunction>
                            
                            <apex:outputPanel id=""toolModalDiv2"" style=""margin : 0px 5px 0px 0px !important;"">
                                <apex:inputHidden id=""selectedToolStr"" value=""{!selectedToolStr}"" /> 
          
                                <div class=""slds-form-element createToolLinkDiv"" style=""display:{!if(selectedToolStr == 'link','','none')}"">
                                    <label class=""formLabel slds-form-element__label"">Link</label>
                                    <div class=""slds-form-element__control"">
                                        <apex:inputText id=""createToolLink"" value=""{!toolObj.Link__c}"" styleclass=""slds-input""/>
                                    </div>
                                </div>
                                <apex:outputPanel rendered=""{!libraryList.size > 0}"">
                                <div class=""slds-form-element createToolselectLibDiv"" style=""display:none"">
                                    <label class=""formLabel slds-form-element__label"">Select Library</label>
                                    <div class=""slds-form-element__control"">
                                        <apex:selectList value=""{!selectedLibId}"" size=""1"" styleclass=""slds-select"" onchange=""fillContents(this.value);return false""> 
                                            <apex:selectOptions value=""{!libraryList}"" />
                                        </apex:selectList>
                                    </div>
                                </div>
                                </apex:outputPanel>
                            </apex:outputPanel>
                            
                            <apex:outputpanel id=""contentDiv"">
                            <apex:outputPanel rendered=""{!contentList.size > 0}"">
                            <div class=""slds-form-element createToolselectContentDiv"" style=""display:{!if(selectedToolStr == 'content','','none')}"">
                                <label class=""formLabel slds-form-element__label"">Select Content</label>
                                <div class=""slds-form-element__control"">
                                    <apex:selectList value=""{!selectedContentId}"" size=""1"" styleclass=""slds-select""> 
                                        <apex:selectOptions value=""{!contentList}"" />
                                    </apex:selectList>
                                </div>
                            </div>
                            </apex:outputpanel>
                            </apex:outputPanel>
                             
                        </apex:actionRegion>           
                    </div>
                    <div class=""slds-modal__footer"">
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">Cancel</a>
                        <!-- <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral slds-button--brand"" onclick=""checkValidation('CreateTool');"" >Save</a> -->
                        <apex:commandButton value=""Save"" styleclass=""slds-button slds-button--neutral slds-button--brand"" action=""{!insertTool}"" onclick=""checkToolValidations(event);""/>
                    </div>
                </div>
          </div>
          <!-- tool Modal End -->
           
          <!-- training Modal Start -->
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""trainingModal"">
                <div class=""slds-modal__container"">
                    
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium trainingMdlHeading"">New Training</h2>
                        <a class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </a>
                    </div>
                    <div class=""slds-modal__content"">
                        <apex:actionStatus id=""StatusTraining"" >
                            <apex:facet name=""start"">
                             <apex:outputPanel id=""tstpopupTraining""> 
                                <apex:outputPanel styleClass=""popupBackground"" layout=""block"" style=""width:100%""/> 
                                <apex:outputPanel styleClass=""custPopup"" layout=""block""> 
                                    <div class=""slds-spinner--medium"">
                                        <img src=""{!URLFOR($Resource.slds, 'assets/images/spinners/slds_spinner_brand.gif')}"" alt=""Loading..."" style=""margin-top:150%"" />
                                    </div>
                                </apex:outputPanel> 
                             </apex:outputPanel> 
                            </apex:facet> 
                        </apex:actionStatus>
                        
                        <div class=""slds-notify-container createTrainingNotify""  style=""position:relative;display:none"">
                          <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                            <span class=""slds-assistive-text"">Info</span>
                              
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close""  onclick=""$('.createTrainingNotify').hide(100);"">
                              <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                              <span class=""slds-assistive-text"">Close</span>
                            </a>
                            <div class=""notify__content"">
                              <h2 class=""slds-text-heading--small"">
                                  <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                    <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                  </svg>
                                  <span class=""createTrainingErrorMsg""></span>
                              </h2>
                            </div>
                          </div>
                        </div>
                        
                        <apex:actionRegion >
                        
                        <apex:outputPanel id=""trainingModalDiv"">
                        
                        <div class=""slds-form-element slds-is-required"">
                            <label class=""formLabel slds-form-element__label"">Label</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputText id=""createTrainingLbl"" value=""{!trainingObj.Name__c}"" styleclass=""slds-input""/>
                            </div>
                        </div>
                        <div class=""slds-form-element "">
                            <label class=""formLabel slds-form-element__label"">Description</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputtextarea id=""createTrainingDesc"" value=""{!trainingObj.Description__c}"" styleclass=""slds-textarea"" />
                            </div>
                        </div>
                        <div class=""slds-grid slds-wrap slds-m-top--small"">
                            <div class=""slds-size--1-of-1"">
                                <label class=""formLabel slds-form-element__label"">Include in:</label>
                            </div>
                        </div>
                        <div class=""slds-grid slds-wrap"">
                            <div class=""slds-size--1-of-2"">
                                  <div class=""slds-form--horizontal"">
                                    <div class="""" style=""text-align:left"">
                                        <div class=""slds-form-element__control"" style=""width:14% !important"">
                                            <label class=""slds-checkbox"">
                                                 <apex:inputCheckbox id=""createTrainingIIOH"" styleClass=""sectionCheckboxGroup6"" value=""{!trainingObj.IncludedInCallManagementDiscussion__c}"" /><!-- onchange=""uncheckAllsectionCheckboxGroup6(this,this.checked)"" -->
                                                 <span class=""slds-checkbox--faux""></span>
                                            </label>
                                        </div>
                                        <label class=""slds-form-element__label"" style=""max-width:100% !important"">Call Management - Discussion</label>
                                    </div>
                                  </div>
                            </div>
                              
                            <div class=""slds-size--1-of-2"">
                                  <div class=""slds-form--horizontal"">
                                      <div class="""" style=""text-align:left"">
                                          <div class=""slds-form-element__control"" style=""width:14% !important"">
                                              <label class=""slds-checkbox"">
                                                   <apex:inputCheckbox id=""createTrainingIICM"" styleClass=""sectionCheckboxGroup6"" value=""{!trainingObj.IncludedInSuccessStories__c}""/>
                                                   <span class=""slds-checkbox--faux""></span>
                                              </label>
                                          </div>
                                          <label class=""slds-form-element__label"" style=""max-width:100% !important"">Training - Success Stories</label>
                                      </div>
                                  </div>
                              </div>
                              <div class=""slds-size--1-of-2 slds-m-top--small"">
                                     <div class=""slds-form--horizontal"">
                                          <div class="""" style=""text-align:left"">
                                              <div class=""slds-form-element__control"" style=""width:14% !important"">
                                                  <label class=""slds-checkbox"">
                                                      <apex:inputCheckbox id=""createTrainingIIGen"" styleClass=""sectionCheckboxGroup6"" value=""{!trainingObj.IncludedInGeneral__c}"" />
                                                      <span class=""slds-checkbox--faux""></span>
                                                  </label>
                                              </div>
                                              <label class=""slds-form-element__label"" style=""max-width:100% !important"">Training - General</label>
                                          </div>
                                      </div>
                              </div>
                                    
                              <div class=""slds-size--1-of-2 slds-m-top--small"">
                                  <div class=""slds-form--horizontal"">
                                      <div class="""" style=""text-align:left"">
                                          <div class=""slds-form-element__control"" style=""width:14% !important"">
                                              <label class=""slds-checkbox"">
                                                   <apex:inputCheckbox id=""createToolIICom"" styleClass=""sectionCheckboxGroup6"" value=""{!trainingObj.IncludedInCompetition__c}"" />
                                                   <span class=""slds-checkbox--faux""></span>
                                              </label>
                                          </div>
                                          <label class=""slds-form-element__label"" style=""max-width:100% !important"">Training - Competition</label>
                                      </div>
                                  </div>
                              </div>
                              
                              <div class=""slds-size--1-of-2 slds-m-top--small"">
                                  <div class=""slds-form--horizontal"">
                                      <div class="""" style=""text-align:left"">
                                          <div class=""slds-form-element__control"" style=""width:14% !important"">
                                              <label class=""slds-checkbox"">
                                                   <apex:inputCheckbox id=""createTrainingIIObj"" styleClass=""sectionCheckboxGroup5"" value=""{!trainingObj.IncludedInObjectionHandling__c}"" />
                                                   <span class=""slds-checkbox--faux""></span>
                                              </label>
                                          </div>
                                          <label class=""slds-form-element__label"" style=""max-width:100% !important"">Training - Objection Handling</label>
                                      </div>
                                  </div>
                              </div>
                              
                              <div class=""slds-size--1-of-2 slds-m-top--small"">
                                  <div class=""slds-form--horizontal"">
                                      <div class="""" style=""text-align:left"">
                                          <div class=""slds-form-element__control"" style=""width:14% !important"">
