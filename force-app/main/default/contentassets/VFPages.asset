                  function hideShowAnswerContentDiv(val){
                      if(val != 'SingleChoice' && val != 'MultiChoice'){
                          $('.answerContentDiv').hide(100);
                      }else{
                          $('.answerContentDiv').show(100);
                          var ele = $('.answerContentDiv').html();
                          $('.answerContentDiv').html('').html(ele);
                      }   
                  }
                  function dismisAllModal(){
                    $('[id$=playDetailModal]').modal('dismiss');
                    $('[id$=playModal]').modal('dismiss');
                    $('[id$=stageModal]').modal('dismiss');
                    $('[id$=questionModal]').modal('dismiss');
                    $('[id$=messageModal]').modal('dismiss');
                    $('[id$=toolModal]').modal('dismiss');
                    $('[id$=trainingModal]').modal('dismiss');
                    
                  }
                  function checkValidation(mdl){
                     if(mdl == 'CreateStage'){
                         
                         if($('[id$=createStageName]').val() != undefined && $('[id$=createStageName]').val() != null && $('[id$=createStageName]').val().trim().length > 0){
                             console.log('##=' + $('[id$=stagesForDuplicate]').val());
                             if($('[id$=stagesForDuplicate]').val() != undefined && $('[id$=stagesForDuplicate]').val() != null && $('[id$=stagesForDuplicate]').val().trim().length > 0 ){//&& $('[id$=createStageName]').val() != stageOnEdit
                                 var stageArr = $('[id$=stagesForDuplicate]').val().trim().split(';');
                                 var flagForDuplicate = false;
                                 for(var i = 0 ; i < stageArr.length ; i++){
                                    console.log('##1=$([id$=createStageName]).val().trim()= '+ $('[id$=createStageName]').val().trim());
                                    console.log('##1=$(stageArr[i].trim()= '+ stageArr[i].trim() );
                                    
                                    if($('[id$=createStageName]').val().trim() == stageArr[i].trim()){
                                        //console.log('##=true');
                                        flagForDuplicate = true;
                                        break;
                                    }
                                 }
                                 
                                 if(flagForDuplicate){
                                     $('.createStageNotify').show();
                                     $('.createStageErrorMsg').text('Duplicate Stage is not allowed!');
                                     $('[id$=createStageName]').parent().addClass('slds-has-error');
                                     if($('.errorMsg').length == 0){
                                         var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                         $('[id$=createStageName]').after(ele);
                                     
                                     }
                                 }else{
                                     $('.createStageNotify').hide();
                                     $('[id$=createStageName]').parent().removeClass('slds-has-error');
                                     $('.errorMsg').remove();
                                     $('[id$=stageModal]').modal('dismiss');
                                     if($('.stageMdlHeading').text() == 'New Stage'){
                                         createStage();
                                     }else{
                                         updateStage();
                                     }  
                                 }
                             }else{
                                 $('.createStageNotify').hide();
                                 $('[id$=createStageName]').parent().removeClass('slds-has-error');
                                 $('.errorMsg').remove();
                                 $('[id$=stageModal]').modal('dismiss');
                                 if($('.stageMdlHeading').text() == 'New Stage'){
                                     createStage();
                                 }else{
                                     updateStage();
                                 }  
                             }
                             
                             
                         }else{
                             $('.createStageNotify').show();
                             $('.createStageErrorMsg').text('You must have to select stage name!');
                             $('[id$=createStageName]').parent().addClass('slds-has-error');
                             if($('.errorMsg').length == 0){
                                 var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                 $('[id$=createStageName]').after(ele);
                             
                             }
                         }
                     }else if(mdl == 'CreatePlay'){
                         if($('[id$=playNameId]').val() != undefined && $('[id$=playNameId]').val() != null && $('[id$=playNameId]').val().trim().length > 0){
                             $('.createPlayNotify').hide();
                             $('[id$=playNameId]').parent().removeClass('slds-has-error');
                             $('.errorMsg').remove();
                             $('[id$=playModal]').modal('dismiss');
                             //alert(stageIdForInsertedPlay + ' - ' + x1);
                             if($('.playMdlHeading').text() == 'New Play'){
                                createPlay(stageIdForInsertedPlay);
                             }else{
                                updatePlay();
                             }
                         }else{
                             $('.createPlayNotify').show();
                             $('.createPlayErrorMsg').text('You must have to give play name!');
                             $('[id$=playNameId]').parent().addClass('slds-has-error');
                             if($('.errorMsg').length == 0){
                                 var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                 $('[id$=playNameId]').after(ele);
                             }
                         }
                     }else if(mdl == 'CreateProcess'){
                     
                         if($('[id$=createProcessName]').val() != undefined && $('[id$=createProcessName]').val() != null && $('[id$=createProcessName]').val().trim().length > 0
                            && ($('[id$=createProcessProgressT]').val() != undefined && $('[id$=createProcessProgressT]').val() != null && $('[id$=createProcessProgressT]').val().trim().length > 0)
                         ){
                             $('.createProcessNotify').hide();
                             $('[id$=createProcessName]').parent().removeClass('slds-has-error');
                              $('[id$=createProcessProgressT]').parent().removeClass('slds-has-error');
                             $('.errorMsg').remove();
                             $('[id$=processModal]').modal('dismiss');
                             updateProcess();
                         }else{
                             /*$('.createProcessNotify').show();
                             $('.createProcessErrorMsg').text('You must have to give process name!');
                             $('[id$=createProcessName]').parent().addClass('slds-has-error');
                             if($('.errorMsg').length == 0){
                                 var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                 $('[id$=createProcessName]').after(ele);
                             }
                             */
                            
                            var hasError = false;
                            if($('[id$=createProcessName]').val().trim().length > 0){
                                $('[id$=createProcessName]').parent().removeClass('slds-has-error');                        
                            }else{
                                $('[id$=createProcessName]').parent().addClass('slds-has-error');
                                hasError = true;
                            }
                            
                            if($('[id$=createProcessProgressT]').val().trim().length > 0){
                                $('[id$=createProcessProgressT]').parent().removeClass('slds-has-error');                   
                            }else{
                                $('[id$=createProcessProgressT]').parent().addClass('slds-has-error');
                                hasError = true;
                            }
                            
                            if(hasError){
                                $('.createProcessNotify').show();
                                $('.createProcessErrorMsg').text('You must fill Required fields!');
                            }
                         }
                       
                            
                     }else if(mdl == 'CreateQuestion'){
                         if($('[id$=createQuestionDesc]').val() === undefined || $('[id$=createQuestionDesc]').val() == null || $('[id$=createQuestionDesc]').val().trim().length == 0){
                             $('.createQuestionNotify').show();
                             $('.createQuestionErrorMsg').text('You must have to give Question!');
                             $('[id$=createQuestionDesc]').parent().addClass('slds-has-error');
                             if($('.errorMsg').length == 0){
                                 var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                 $('[id$=createQuestionDesc]').after(ele);
                             }
                         
                         }else if($('[id$=createQuestionIIDealP]').prop('checked') && $('[id$=createQuestionAnsType]').val() != 'Checkbox'){
                             $('.createQuestionNotify').show();
                             $('.createQuestionErrorMsg').text('Answer Type must be of Checkbox type ,if you selected Include In Deal Progress!');
                         }else if($('[id$=createQuestionIISuccessI]').prop('checked') && $('[id$=createQuestionAnsType]').val() != 'Rating'){
                             $('.createQuestionNotify').show();
                             $('.createQuestionErrorMsg').text('Answer Type must be of Rating type ,if you selected Include In Success Indicator!');
                         }else if($('[id$=createQuestionIIKeyM]').prop('checked') && $('[id$=createQuestionAnsType]').val() != 'Date'){
                             $('.createQuestionNotify').show();
                             $('.createQuestionErrorMsg').text('Answer Type must be of Date type ,if you selected Include In Key Milestones!');
                         
                         }else if($('[id$=createQuestionAnsType]').val() == 'MultiChoice' || $('[id$=createQuestionAnsType]').val() == 'SingleChoice'){
                             $('.createQuestionNotify').hide();
                             $('[id$=createQuestionDesc]').parent().removeClass('slds-has-error');
                             $('.errorMsg').remove();
                             
                             var flag = false;
                             
                             $('.answers').each(function(index){
                                if($(this).val().trim().length > 0){
                                    flag = true; 
                                }       
                             });
                             
                             if(flag == false){
                                $('.createQuestionNotify').show();
                                $('.createQuestionErrorMsg').text('You must have to give atleast one answer!');
                             
                             }else{
                                $('.createQuestionNotify').hide();
                                $('[id$=createQuestionDesc]').parent().removeClass('slds-has-error');
                                $('.errorMsg').remove();
                                $('[id$=questionModal]').modal('dismiss');
                                if($('.questionMdlHeading').text() == 'New Question'){
                                    createQuestion();
                                }else{
                                    updateQuestion();
                                }
                             }
                         }else{
                             $('.createQuestionNotify').hide();
                             $('[id$=createQuestionDesc]').parent().removeClass('slds-has-error');
                             $('.errorMsg').remove();
                             $('[id$=questionModal]').modal('dismiss');
                             if($('.questionMdlHeading').text() == 'New Question'){
                                createQuestion();
                             }else{
                                updateQuestion();
                             }
                         }
                     }else if(mdl == 'CreateMessage'){
                              
                         if(CKEDITOR.instances['thePage:frm:createMessageMsg'].getData().length > 0){//CKEDITOR.instances['thePage:frm:createMessageMsg'].getData().length > 0
                             $('.createMessageNotify').hide();
                             $('[id$=createMessageMsg]').parent().removeClass('slds-has-error');
                             $('.errorMsg').remove();
                             $('[id$=messageModal]').modal('dismiss');
                             if($('.messageMdlHeading').text() == 'New Message'){
                                createMessage();
                             }else{
                                updateMessage();
                             }
                         }else{
                             $('.createMessageNotify').show();
                             $('.createMessageErrorMsg').text('You must have to give Message!');
                             $('[id$=createMessageMsg]').parent().addClass('slds-has-error');
                             if($('.errorMsg').length == 0){
                                 var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                 $('[id$=createMessageMsg]').after(ele);
                             }
                         }    
                             
                     }
                  }
