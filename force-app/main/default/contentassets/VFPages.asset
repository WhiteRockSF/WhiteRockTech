                                                   <apex:inputCheckbox id=""createTrainingIIInd"" styleClass=""sectionCheckboxGroup6"" value=""{!trainingObj.IncludedInIndustry__c}""/>
                                                   <span class=""slds-checkbox--faux""></span>
