                  function oncompleteTasks(){
                      $('[data-aljs=""modal""]').modal({
                        onShow : manageBackdrop()
                      });
                      $('[data-aljs=""tooltip""]').tooltip();
                  }
                  
                  function clearModal(id){
                      var ele = $('[id$=' + id + ']').html();
                      $('[id$=' + id + ']').html('').html(ele);
                      $('.slds-notify-container').hide();
                      $('.slds-has-error').removeClass('slds-has-error');
                      $('.errorMsg').remove();
                      oncompleteTasks();
                      
                      //change heading
                      if(id == 'stageModal'){
                          <!--6th feb to make it dynamic according to opportunity or lead -->
                          var isLeadPlay = '{!processObj.PlaybookEntityType__c}';
                          if(isLeadPlay == 'Lead')
                              $('.stageMdlHeading').text('New Status');
                          else
                              $('.stageMdlHeading').text('New Stage'); 
                      }else if(id == 'playModal'){
                          $('.playMdlHeading').text('New Play'); 
                          $('#curStageForPlay').val(playCurStage);
                      }else if(id == 'questionModal'){
                          $('.questionMdlHeading').text('New Question'); 
                      }else if(id == 'messageModal'){
                          $('.messageMdlHeading').text('New Message'); 
                      }
                  }  
        
                function startPlayDrop(playId, stageId, isParentChanged, playOldPosition, playNewPosition, e){
                    /* Parameter Descriptions */
                    // 1. playId :==> Current droped play id
                    // 2. stageId :==> Stage id where play droped
                    // 3. isParentChanged :==> Is parent starge changed ?
                    // 4. playOldPosition :==> Play's old position 
                    // 5. playNewPosition :==> Play's new position 
                    // 6. e :==> Event    
                    
                    var oldStageId = $('#'+playId).data('stageid');
                    console.log('## drop PlayId : '+playId);
                    console.log('## drop StageId : '+stageId);     
                    console.log('## isParentChanged : '+isParentChanged);
                    console.log('## playOldPosition : '+playOldPosition);    
                    console.log('## playNewPosition : '+playNewPosition);
                    console.log('## oldStageId : '+oldStageId);    
                    
                    updatePlayLocationFunc(playId, stageId, isParentChanged, playOldPosition, playNewPosition, oldStageId); 
                    
                    $('#'+playId).data('stageid',''+stageId);
                    //console.log($('#'+PlayId).data('stageid'));
                    //console.log(' updated play StageId : '+$('#'+playId).data('stageid'));
                    
                    $( ""#moveConfirm"").unbind( ""click"" );                   
                    $('#playDropConfirmPrompt').modal('dismiss');
                    //e.preventDefault();
                }
                
                function startQuestionDrop(questionId, playId, questionOldPosition, questionNewPosition, e){
                    updateQuestionLocationFunc(questionId, playId, questionOldPosition, questionNewPosition); 
                    $('#'+questionId).data('playid',''+playId);
                    $( ""#moveConfirmQuestion"").unbind( ""click"" );                   
                    $('#questionDropConfirmPrompt').modal('dismiss');
                    
                }
                
                function startMessageDrop(messageId, playId, messageOldPosition, messageNewPosition, e){
                    updateMessageLocationFunc(messageId, playId, messageOldPosition, messageNewPosition); 
                    $('#'+messageId).data('playid',''+playId);
                    $( ""#moveConfirmMessage"").unbind( ""click"" );                   
                    $('#messageDropConfirmPrompt').modal('dismiss');
                }
                
                function startToolDrop(toolId, playId, toolOldPosition, toolNewPosition, e){
                    updateToolLocationFunc(toolId, playId, toolOldPosition, toolNewPosition); 
                    $('#'+toolId).data('playid',''+playId);
                    $( ""#moveConfirmTool"").unbind( ""click"" );                   
                    $('#toolDropConfirmPrompt').modal('dismiss');
                }
                
                function startTrainingDrop(trainingId, playId, trainingOldPosition, trainingNewPosition, e){
                    updateTrainingLocationFunc(trainingId, playId, trainingOldPosition, trainingNewPosition); 
                    $('#'+trainingId).data('playid',''+playId);
                    $( ""#moveConfirmTraining"").unbind( ""click"" );                   
                    $('#trainingDropConfirmPrompt').modal('dismiss');
                }
                
                function stopPlayDrop(th){            
                    $('#examplesDrop .sortable-list').sortable('cancel');
                    $( ""#moveConfirm"").unbind( ""click"" );
                    //$(th).sortable('cancel');
                }
                
                function stopQuestionDrop(th){            
                    $('#questionDrop .sortable-list').sortable('cancel');
                    $( ""#moveConfirmQuestion"").unbind( ""click"" );
                    //$(th).sortable('cancel');
                }
                
                function stopMessageDrop(th){            
                    $('#messageDrop .sortable-list').sortable('cancel');
                    $( ""#moveConfirmMessage"").unbind( ""click"" );
                    //$(th).sortable('cancel');
                }
                function stopToolDrop(th){            
                    $('#toolDrop .sortable-list').sortable('cancel');
                    $( ""#moveConfirmTool"").unbind( ""click"" );
                    //$(th).sortable('cancel');
                }
                
                function stopTrainingDrop(th){            
                    $('#trainingDrop .sortable-list').sortable('cancel');
                    $( ""#moveConfirmTraining"").unbind( ""click"" );
                }
                function updatePlayLocationFunc(PlayId, StageId, isParentChanged, playOldPosition, playNewPosition, oldStageId){        
                    console.log('call remote');
                    $('[id$=Status] [id$=start]').show();
                    
                    Visualforce.remoting.Manager.invokeAction(
                        '{!$RemoteAction.PlaybooxBuilderController.updatePlayLocation}',
                        PlayId,
                        StageId,
                        isParentChanged, 
                        playOldPosition, 
                        playNewPosition, 
                        oldStageId, 
                        function(result, event){
                            if (event.status) {
                               $('[id$=Status] [id$=start]').hide();
                               console.log('Saved successfully!');
                               console.log('result : '+result);
                               fillStageModal();
                            } else if (event.type === 'exception') {
                                $('[id$=Status] [id$=start]').hide();
                                //console.log(event.message + ""<br/>\n<pre>"" + event.where + ""</pre>"");                        
                            } else {
                                $('[id$=Status] [id$=start]').hide();
                                //console.log('responseErrors : '+event.message);                        
                            }
                        }, 
                        {escape: true}
                    );
            
                }
                
                function updateQuestionLocationFunc(questionId, playId, questionOldPosition, questionNewPosition){        
                    $('[id$=Status] [id$=start]').show();
                    Visualforce.remoting.Manager.invokeAction(
                        '{!$RemoteAction.PlaybooxBuilderController.updateQuestionLocation}',
                        questionId,
                        playId,
                        parseInt(questionOldPosition), 
                        parseInt(questionNewPosition), 
                        function(result, event){
                            if (event.status) {
                               $('[id$=Status] [id$=start]').hide();
                               console.log('Saved successfully!');
                               console.log('result : '+result);
                               getPlayDetailsTwo();
                            } else if (event.type === 'exception') {
                                $('[id$=Status] [id$=start]').hide();
                                //console.log(event.message + ""<br/>\n<pre>"" + event.where + ""</pre>"");                        
                            } else {
                                $('[id$=Status] [id$=start]').hide();
                                //console.log('responseErrors : '+event.message);                        
                            }
                        }, 
                        {escape: true}
                    );
            
                }
                
