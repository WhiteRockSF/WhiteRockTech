            .slds-modal__header{
                background : #00599c !important;
                color : white !important;
            }
            .slds-modal__content{
                background:#f4f6f9 !important;
            }
            .slds-modal__footer{
                background:#adcfe6 !important;
            }
            
            .slds-form-element {
                margin-top: 0.60rem !important;
            }
            
            .QMTHeading{
                font-size: 15px !important;
                font-weight : bold !important;
            }
            .formLabel{
                font-weight : bold !important;
            }
            
            .contentIcons{
                height : 20px !important;
                width : 20px !important;
            }
            /* custom truncate for upload file text*/
            .truncate-cust{
                max-width : 107px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }
          </style>
      </head>
      <body>
        <div class=""slds"">
          <apex:form id=""frm"">
          <apex:outputPanel layout=""none"" rendered=""{!!insfPrivlFalse}"">
              <h2 style=""font-size:22px"">Insufficient Privileges!</h2>
          </apex:outputPanel>
          <apex:outputPanel layout=""none"" rendered=""{!insfPrivlFalse}"">
           
          <apex:actionRegion >
          <apex:actionStatus id=""Status"" >
            <apex:facet name=""start"">
             <apex:outputPanel id=""tstpopup""> 
                <apex:outputPanel styleClass=""popupBackground"" layout=""block"" style=""width:100%""/> 
                <apex:outputPanel styleClass=""custPopup"" layout=""block""> 
                    <div class=""slds-spinner--medium"">
                        <img src=""{!URLFOR($Resource.slds, 'assets/images/spinners/slds_spinner_brand.gif')}"" alt=""Loading..."" height=""100"" width=""100""/>
                    </div>
                </apex:outputPanel> 
             </apex:outputPanel> 
            </apex:facet> 
          </apex:actionStatus>
          
          <apex:actionfunction name=""fetchAvailableStagesOnly"" action=""{!fetchAvailableStagesOnly}"" status=""Status"" rerender=""headerDiv, mainDiv, name_stageModal"" oncomplete=""if('{!JSENCODE(playObjIdForUpdate)}'.trim().length >= 15){getPlayDetails('{!JSENCODE(playObjIdForUpdate)}'); return false;}oncompleteTasks();"">
            <apex:param assignTo=""{!availableRecordTypeStages}"" name=""recTStage"" value=""""/>
          </apex:actionfunction>
          <!-- use below function without calling get play details oncomplete because we dont have to open play detail modal after save playboox -->
          <apex:actionfunction name=""fetchAvailableStagesOnlyWithoutPopup"" action=""{!fetchAvailableStagesOnly}"" status=""Status"" rerender=""headerDiv, mainDiv, name_stageModal"" oncomplete=""oncompleteTasks();"">
            <apex:param assignTo=""{!availableRecordTypeStages}"" name=""recTStage"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""createStage"" action=""{!insertStage}"" status=""Status"" rerender=""mainDiv, name_stageModal"" oncomplete=""oncompleteTasks();""/>
          <apex:actionfunction name=""updateStage"" action=""{!updateStage}"" status=""Status"" rerender=""mainDiv, name_stageModal"" oncomplete=""oncompleteTasks();""/>
          <apex:actionfunction name=""updatePlay"" action=""{!updatePlay}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();""/>
          <apex:actionfunction name=""publish"" action=""{!publishPlaybook}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();$('[id$=publishOkModal]').modal('show');manageBackdrop();""/>
          
          <apex:actionfunction name=""fillStageModal"" action=""{!fillStageModal}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();""/>
          
          <apex:actionfunction name=""createPlay"" action=""{!insertPlay}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();"">
              <apex:param assignTo=""{!playParentId}"" name=""ppi"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""getPlayDetails"" action=""{!getPlayDetails}"" status=""Status"" rerender=""mainDiv"" oncomplete=""$('[id$=playDropConfirmPrompt]').modal('dismiss');  oncompleteTasks();$('[id$=playDetailModal]').modal('show');manageBackdrop();$('.playDetailMdlHeading').text('{!playNameForModal}');initializeInnerPlayDragging();"">
              <apex:param assignTo=""{!playObjIdForUpdate}"" name=""pi"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""getPlayDetailsTwo"" action=""{!getPlayDetails}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();$('[id$=playDetailModal]').modal('show');manageBackdrop();$('.playDetailMdlHeading').text('{!playNameForModal}');initializeInnerPlayDragging();"">
              
          </apex:actionfunction>
          <apex:actionfunction name=""createQuestion"" action=""{!insertQuestion}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();getPlayDetails('{!JSENCODE(playObjIdForUpdate)}'); return false""/>
          <apex:actionfunction name=""updateQuestion"" action=""{!updateQuestion}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();getPlayDetails('{!JSENCODE(playObjIdForUpdate)}'); return false""/>
          <apex:actionfunction name=""initializeQuestion"" action=""{!initializeQuestion}"" status=""Status"" rerender=""questionModalDiv, questionModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss');$('[id$=questionModal]').modal('show');manageBackdrop();$('.questionMdlHeading').text('New Question');$('.slds-notify-container').hide(); fillRichTextAreaQuestionTip('',false);""/>
          
          <!-- Load new questions in exist question div and open. --> 
          <apex:actionfunction name=""loadQuestions"" action=""{!loadQuestions}"" status=""Status"" rerender=""cloneQuestionDiv"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss'); $('[id$=clone_question_modal]').modal('show');manageBackdrop(); $('.slds-notify-container').hide();""/>
          <!-- Load new meassage in exist meassage div and open. --> 
          <apex:actionfunction name=""loadMessages"" action=""{!loadMessages}"" status=""Status"" rerender=""cloneMessageDiv"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss'); $('[id$=clone_message_modal]').modal('show');manageBackdrop(); $('.slds-notify-container').hide();""/>
          <!-- Load new tool in exist tool div and open. --> 
          <apex:actionfunction name=""loadTools"" action=""{!loadTools}"" status=""Status"" rerender=""cloneToolDiv"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss'); $('[id$=clone_tool_modal]').modal('show');manageBackdrop(); $('.slds-notify-container').hide();""/>
          <!-- Load new training in exist training div and open. --> 
          <apex:actionfunction name=""loadTrainings"" action=""{!loadTrainings}"" status=""Status"" rerender=""cloneTrainingDiv"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss'); $('[id$=clone_training_modal]').modal('show');manageBackdrop(); $('.slds-notify-container').hide();""/>
          
          <!-- Clone Question Action -->
          <apex:actionfunction name=""cloneQuestion"" action=""{!cloneQuestion}"" status=""Status"" rerender=""cloneQuestionDiv"" oncomplete=""$('[id$=clone_question_modal]').modal('dismiss'); "">
             <!-- <apex:param assignTo=""{!playId}"" value="""" name=""arg1"" /> -->
             <apex:param assignTo=""{!quesId}"" value="""" name=""arg2"" />             
          </apex:actionfunction>
          <!-- Clone Message Action -->
          <apex:actionfunction name=""cloneMessage"" action=""{!cloneMessage}"" status=""Status"" rerender=""cloneMessageDiv"" oncomplete=""$('[id$=clone_message_modal]').modal('dismiss');"">
             <!-- <apex:param assignTo=""{!playId}"" value="""" name=""arg11"" /> -->
             <apex:param assignTo=""{!messageId}"" value="""" name=""arg22"" />             
          </apex:actionfunction>
          <!-- Clone Tool Action -->
          <apex:actionfunction name=""cloneTool"" action=""{!cloneTool}"" status=""Status"" rerender=""cloneToolDiv"" oncomplete=""$('[id$=clone_tool_modal]').modal('dismiss');"">
             <!-- <apex:param assignTo=""{!playId}"" value="""" name=""arg111"" /> -->
             <apex:param assignTo=""{!toolId}"" value="""" name=""arg222"" />             
          </apex:actionfunction>
          <!-- Clone Training Action -->
          <apex:actionfunction name=""cloneTraining"" action=""{!cloneTraining}"" status=""Status"" rerender=""cloneTrainingDiv"" oncomplete=""$('[id$=clone_training_modal]').modal('dismiss');"">
             <!-- <apex:param assignTo=""{!playId}"" value="""" name=""arg1111"" /> -->
             <apex:param assignTo=""{!trainingId}"" value="""" name=""arg2222"" />             
          </apex:actionfunction>
          
          <apex:actionfunction name=""initializeMessage"" action=""{!initializeMessage}"" status=""Status"" rerender=""messageModalDiv,messageModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss');$('[id$=messageModal]').modal('show');manageBackdrop();$('.messageMdlHeading').text('New Message');$('.slds-notify-container').hide();fillRichTextArea('',false);""/>
          <apex:actionfunction name=""initializeTool"" action=""{!initializeTool}"" status=""Status"" rerender=""toolModalDiv,contentDiv,toolModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss');$('[id$=toolModal]').modal('show');manageBackdrop();$('.toolMdlHeading').text('New Tool');$('.slds-notify-container').hide();""/>
          <apex:actionfunction name=""initializeTraining"" action=""{!initializeTraining}"" status=""Status"" rerender=""trainingModalDiv,contentDiv,trainingModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss');$('[id$=trainingModal]').modal('show');manageBackdrop();$('.trainingMdlHeading').text('New Training');$('.slds-notify-container').hide();""/>
          
          <apex:actionfunction name=""createMessage"" action=""{!insertMessage}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks(); getPlayDetails('{!JSENCODE(playObjIdForUpdate)}'); initializeInnerPlayDragging();""/>
          
          <apex:actionfunction name=""createTool"" action=""{!insertTool}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks(); getPlayDetails('{!JSENCODE(playObjIdForUpdate)}');initializeInnerPlayDragging();""/>
          <apex:actionfunction name=""createTraining"" action=""{!insertTraining}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks(); getPlayDetails('{!JSENCODE(playObjIdForUpdate)}');initializeInnerPlayDragging();""/>
          
          <apex:actionfunction name=""showHideAnsContent"" action=""{!showHideAnsContent}"" status=""StatusQuestion"" rerender=""questionModalDiv, questionModalDiv2"" />
          <apex:actionfunction name=""increaseAnswerContent"" action=""{!increaseAnswerContent}"" status=""StatusQuestion"" rerender=""questionModalDiv, questionModalDiv2"" />
          <apex:actionfunction name=""removeAnswerContent"" action=""{!removeAnswerContent}"" status=""StatusQuestion"" rerender=""questionModalDiv, questionModalDiv"" >
              <apex:param assignTo=""{!removeAnsIndex}"" name=""aI"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""fillModalValuesForEditQuestion"" action=""{!fillModalValuesForEditQuestion}"" status=""StatusPlayDetail"" rerender=""questionModalDiv, questionModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss');$('[id$=questionModal]').modal('show');manageBackdrop();$('.questionMdlHeading').text('Edit Question');$('.slds-notify-container').hide();fillRichTextAreaQuestionTip('{!quesObj.Tip__c}',true);"">
              <apex:param assignTo=""{!questionIdForUpdate}"" name=""qI"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""fillModalValuesForEditMessage"" action=""{!fillModalValuesForEditMessage}"" status=""StatusPlayDetail"" rerender=""messageModalDiv,messageModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss');$('[id$=messageModal]').modal('show');manageBackdrop();$('.messageMdlHeading').text('Edit Message');$('.slds-notify-container').hide();fillRichTextArea('{!msgObj.Description__c}',true); initializeInnerPlayDragging()"">
              <apex:param assignTo=""{!messageIdForUpdate}"" name=""mI"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""updateMessage"" action=""{!updateMessage}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();getPlayDetails('{!JSENCODE(playObjIdForUpdate)}'); initializeInnerPlayDragging();""/>
          <apex:actionfunction name=""fillModalValuesForEditTool"" action=""{!fillModalValuesForEditTool}"" status=""StatusPlayDetail"" rerender=""toolModalDiv,contentDiv,toolModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss');$('[id$=toolModal]').modal('show');manageBackdrop();$('.toolMdlHeading').text('Edit Tool');$('.slds-notify-container').hide();"">
              <apex:param assignTo=""{!toolIdForUpdate}"" name=""tI"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""fillModalValuesForEditTraining"" action=""{!fillModalValuesForEditTraining}"" status=""StatusPlayDetail"" rerender=""trainingModalDiv,contentDiv,trainingModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss');$('[id$=trainingModal]').modal('show');manageBackdrop();$('.trainingMdlHeading').text('Edit Training');$('.slds-notify-container').hide();"">
              <apex:param assignTo=""{!trainingIdForUpdate}"" name=""trI"" value=""""/>
          </apex:actionfunction>
          
          <apex:actionfunction name=""deleteStage"" action=""{!deleteStage}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();"">
              <apex:param assignTo=""{!deleteId}"" name=""di1"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""deletePlay"" action=""{!deletePlay}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();"">
              <apex:param assignTo=""{!deleteId}"" name=""di2"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""deleteQuestion"" action=""{!deleteQuestion}"" status=""Status"" rerender=""playDetailDiv"" oncomplete=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">
              <apex:param assignTo=""{!deleteId}"" name=""di1"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""deleteMessage"" action=""{!deleteMessage}"" status=""Status"" rerender=""playDetailDiv"" oncomplete=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">
              <apex:param assignTo=""{!deleteId}"" name=""di1"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""deleteTool"" action=""{!deleteTool}"" status=""Status"" rerender=""playDetailDiv"" oncomplete=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">
              <apex:param assignTo=""{!deleteId}"" name=""di1"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""deleteTraining"" action=""{!deleteTraining}"" status=""Status"" rerender=""playDetailDiv"" oncomplete=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">
              <apex:param assignTo=""{!deleteId}"" name=""di1"" value=""""/>
          </apex:actionfunction>
          
          <apex:inputHidden id=""quesIdForEdit"" value=""{!quesObjIdForUpdate}""/>
          <apex:inputHidden id=""msgIdForEdit"" value=""{!msgObjIdForUpdate}""/>
          
          <script>
            //SCRIPT TO GET AVAILABLE STAGES RELATED TO PERTICULAR RECORD TYPE
            var availableStageStr = '';
            if('{!salesPRecordTypeId}' != null && '{!salesPRecordTypeId}'.trim().length > 14){
                var result = sforce.connection.describeLayout('Opportunity', new Array('{!salesPRecordTypeId}'));
                var res = result.getArray('recordTypeMappings')[0].picklistsForRecordType;
                
                for(var index=0; index<res.length; index++ ){
                  if(res[index].picklistName == 'StageName'){
                    for(var j = 0; j < res[index].picklistValues.length; j++){
                        if(res[index].picklistValues[j].active){
                            availableStageStr += res[index].picklistValues[j].value + '___';        
                            //console.log(availableStageStr);
                        }
                    }
                    
                  }
                  if(availableStageStr.length > 0){
                      $('[id$=Status] [id$=start]').show();
                      //fetchAvailableStagesOnly(availableStageStr); return false;
                  }
                }
            }
            
            function fetchAvailableStageList(recTypeId){
                availableStageStr = '';
                if(recTypeId != null && recTypeId.trim().length > 14){
                    var result = sforce.connection.describeLayout('Opportunity', new Array(recTypeId));
                    var res = result.getArray('recordTypeMappings')[0].picklistsForRecordType;
                    
                    for(var index=0; index<res.length; index++ ){
                      if(res[index].picklistName == 'StageName'){
                        for(var j = 0; j < res[index].picklistValues.length; j++){
                            if(res[index].picklistValues[j].active){
                                availableStageStr += res[index].picklistValues[j].value + '___';        
                                //console.log(availableStageStr);
                            }
                        }
                        
                      }
                      
                    }
                }
                $('[id$=Status] [id$=start]').show();
                fetchAvailableStagesOnlyWithoutPopup(availableStageStr); return false;
            }
          </script>                    
          
          <section id=""header"">   
              <apex:outputPanel id=""headerDiv"">
              <apex:actionfunction name=""updateProcess"" action=""{!updateProcess}"" status=""Status"" rerender=""headerDiv, publishmodalTextPanel, deletemodalTextPanel, processModalId"" oncomplete=""fetchAvailableStageList('{!salesPRecordTypeId}');""/>
              <div class=""slds-page-header"" role=""banner"">
                  <div class=""slds-grid slds-p-vertical--small"">
                    <div class=""slds-col slds-has-flexi-truncate"">
                      <p class=""slds-text-heading--label"" style=""text-transform:none"">Playbook</p>
                      <div class=""slds-grid"">
                        <div class=""slds-grid slds-type-focus slds-no-space"">
                            <apex:outputPanel rendered=""{!processObj != null}"">
                                <h1 class=""slds-text-heading--large slds-truncate"" title=""{!processObj.name}"">{!processObj.Name__c}</h1>
                            </apex:outputPanel>
                        </div>
                      </div>
                    </div>
                    <div class=""slds-col slds-no-flex slds-align-bottom"">
                      <div class=""slds-grid"">
                        <div class=""slds-button-group"" role=""group"">
                        
                          <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs=""modal"" data-aljs-show=""processModal"" onclick=""clearModal('processModal');fillModalValuesForEditProcess('{!JSENCODE(processObj.name__c)}','{!JSENCODE(processObj.description__c)}',{!processObj.ProgressThreshold__c});"">Edit</a>
                          <apex:outputPanel layout=""none"" rendered=""{!!processObj.Active__c}"">
                          <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs=""modal"" data-aljs-show=""deleteModal"">Delete</a>
                          </apex:outputPanel>
                          <apex:outputPanel layout=""none"" rendered=""{!processObj.Active__c}"">
                          <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" disabled=""true"">Delete</a>
                          </apex:outputPanel>
                          <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs=""modal"" data-aljs-show=""publishModal"">Publish</a>
                          <a href=""/apex/PlaybooxBuilderDashboard"" class=""slds-button slds-button--neutral"" >Dashboard</a>
                        </div>
                      </div>
                    </div>
                  </div>
              </div>
              </apex:outputPanel>
          </section>
          
          <section id=""stagesAndData"">
              <apex:outputPanel id=""mainDiv"">
              <apex:inputHidden id=""stagesForDuplicate"" value=""{!stagesForDuplicate}""/>
              
              <div class=""slds-grid slds-wrap"">
                  <div class=""slds-size--10-of-12"" style=""border-right:1px solid #d8dde6;"">
                      <apex:outputPanel rendered=""{!stageMdlList.size > 0}"">
                      <div class=""slds-scrollable--x"">
                          <table class=""slds-table slds-table--bordered stage-header"">
                              <tbody>
                                  <tr>
                                      <td colspan=""{!stageMdlList.size}"">
                                          <apex:inputHidden id=""stageIdForEdit"" value=""{!stageObjIdForUpdate}""/>
                                          <div class=""slds-tabs--path"" role=""application tablist"">
                                              <ul class=""slds-tabs--path__nav"" role=""presentation"">
                                                <apex:variable value=""{!0}"" var=""cnt""/>
                                                <apex:repeat value=""{!stageMdlList}"" var=""mList"">
                                                    <apex:variable value=""{!cnt + 1}"" var=""cnt""/>
                                                    <li class=""slds-tabs--path__item slds-is-current"" role=""presentation"" style=""width:270px !important;min-width:270px !important;max-width:270px !important ""  onmouseover=""$(this).css('background-color','#0076DE');$('.editStg{!cnt}').show();$('.stgClose{!cnt}').show();"" onmouseout=""$('.editStg{!cnt}').hide();$('.stgClose{!cnt}').hide();"">
                                                      <a class=""slds-tabs--path__link"" aria-selected=""false"" tabindex=""-1"" role=""tab"" href=""javascript:void(0)"" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""stageModal"" onclick=""clearModal('stageModal');fillModalValuesForEditStage('{!JSENCODE(mList.stgObj.id)}','{!JSENCODE(mList.stgObj.name__c)}','{!JSENCODE(mList.stgObj.description__c)}',{!mList.stgObj.isLibrary__c});"">
                                                        <span class=""slds-tabs--path__title"">{!mList.stgObj.name__c}
                                                           <c:SVGComponent styleClass=""editStg{!cnt} slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px;display:none""/>
                                                        </span>
                                                      </a>
                                                      <a href=""javascript:void(0)"" class=""stgClose{!cnt} stageBarClose"" onclick=""event.stopPropagation();$('.deleteMdlHeading').text('Delete Stage');$('[id$=deleteMainModal]').modal('show');manageBackdrop();deletingId = '{!JSENCODE(mList.stgObj.id)}';deleteWhat = 'stage';""  role=""tab"" tabindex=""-1"" style=""display:none"">
                                                        <c:SVGComponent styleClass="" slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""height:20px;width:20px;""/>
                                                      </a>
                                                    </li>
                                                </apex:repeat>
                                              </ul>
                                           </div>
                                      </td>
                                  </tr>
                                  
                              </tbody>                                        
                          </table>
                          
                          <div id=""examplesDrop"" class=""slds-grid slds-p-left--large"" style=""border-collapse:collapse; border-bottom:1px solid #d8dde6;"">
                              <apex:variable value=""{!0}"" var=""cnt""/>
                              <apex:inputHidden id=""playIdForEdit"" value=""{!playObjIdForUpdate}""/>
                              <apex:repeat value=""{!stageMdlList}"" var=""mList"">
                              <apex:variable value=""{!cnt + 1}"" var=""cnt""/>
                              <div class=""slds-col"" style=""text-align:center;border-left:2px solid #CCC ; border-right:{!if(cnt == stageMdlList.size ,'2px solid #CCC','0px' )} ;width:270px !important;min-width:270px !important;max-width:270px !important;"">
                                  <div class=""slds-scrollable--y"" style=""max-height:595px"">
                                   
                                      <a href=""javascript:void(0)"" class=""add-play-link"" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""playModal"" onclick=""stageIdForInsertedPlay = '{!JSENCODE(mList.stgObj.id)}', playCurStage = '{!JSENCODE(mList.stgObj.Name__c)}'; clearModal('playModal'); "">
                                            <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                                            Add Play
                                      </a>
                                                                           
                                      <ul id=""{!mList.stgObj.id}"" class=""sortable-list slds-list--vertical slds-has-cards--space has-selections"" style=""padding:5px"">
                                          <apex:variable value=""{!0}"" var=""cntInner""/>
                                          <apex:repeat value=""{!mList.pList}"" var=""p"">
                                              <apex:variable value=""{!cntInner + 1}"" var=""cntInner""/>
                                              <li ondblclick=""$('[id$=playDropConfirmPrompt]').modal('dismiss'); parentPlayId = '{!JSENCODE(p.id)}'; $('[id$=playDetailModal]').modal('dismiss');getPlayDetails('{!JSENCODE(p.id)}');return false;$('.playDetailMdlHeading').text('{!p.name__c}');"" id=""{!JSENCODE(p.id)}"" data-stageid=""{!JSENCODE(mList.stgObj.id)}"" class=""sortable-item slds-list__item"" style=""min-height:80px;"" onmouseover=""$(this).addClass('slds-theme--shade');"" onmouseout=""$(this).removeClass('slds-theme--shade');"">
                                                  <div class=""slds-tile slds-tile--board"">
                                                    <table>
                                                        <tr>
                                                            <td style=""width:90%"">
                                                                  <a href=""javascript:void(0)""  data-aljs=""modal"" data-aljs-show=""playModal"" onclick=""playCurStage = '{!JSENCODE(mList.stgObj.Name__c)}';event.stopPropagation();$('[id$=playModal]').modal('dismiss');clearModal('playModal');fillModalValuesForEditPlay('{!JSENCODE(p.id)}','{!JSENCODE(p.name__c)}','{!JSENCODE(p.description__c)}');"" onmouseover=""$('.editPlay{!cnt}{!cntInner}').show();"" onmouseout=""$('.editPlay{!cnt}{!cntInner}').hide();"">{!p.Name__c}
                                                                    <c:SVGComponent styleClass=""editPlay{!cnt}{!cntInner} slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px;display:none""/>
                                                                  </a>
                                                            </td>
                                                            <td  style=""width:10%"">
                                                                  <a href=""javascript:void(0)"" class=""removePlay playClose{!cnt}{!cntInner} slds-float--right"" onclick=""event.stopPropagation();$('.deleteMdlHeading').text('Delete Play');$('[id$=deleteMainModal]').modal('show');manageBackdrop();deletingId = '{!JSENCODE(p.id)}';deleteWhat = 'play';""  role=""tab"" tabindex=""-1"">
                                                                    <c:SVGComponent styleClass="" slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""height:20px;width:20px;""/>
                                                                  </a>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                   
                                                    <div class=""slds-tile__detail"">
                                                      
                                                    </div>
                                                  </div>
                                              </li>
                                          </apex:repeat>
                                      </ul>
                                  </div>
                              </div>
                              </apex:repeat>
                              
                          </div>
                          
                      </div>
                      </apex:outputPanel>
                  </div>
                  <div class=""slds-size--2-of-12"" style=""text-align:center"">
                      <div style=""margin-top:15px"">
                          <a href=""javascript:void(0)"" class="""" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""stageModal"" onclick=""clearModal('stageModal')"">
                                <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                                Add Stage
                          </a>
                      </div>
                  </div>
              </div>
              <!-- Play Detail Modal Start -->
              <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-modal--large  slds-hide"" id=""playDetailModal"">
                    <div class=""slds-modal__container playDetailModalContainer"" style=""width:65%"">
                        <div class=""slds-modal__header"">
                            <h2 class=""slds-text-heading--medium playDetailMdlHeading"">Play Detail</h2>
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-modal__close"" onclick=""$('[id$=playDetailModal]').modal('dismiss');"">
                                <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                                <span class=""slds-assistive-text"">Close</span>
                            </a>
                        </div>
                        <div class=""slds-modal__content"">
                            <apex:actionStatus id=""StatusPlayDetail"" >
                                <apex:facet name=""start"">
                                 <apex:outputPanel id=""tstpopupPlayDetail""> 
                                    <apex:outputPanel styleClass=""popupBackground"" layout=""block"" style=""width:100%""/> 
                                    <apex:outputPanel styleClass=""custPopup"" layout=""block""> 
                                        <div class=""slds-spinner--medium"">
                                            <img src=""{!URLFOR($Resource.slds, 'assets/images/spinners/slds_spinner_brand.gif')}"" alt=""Loading..."" style=""margin-top:150%"" />
                                        </div>
                                    </apex:outputPanel> 
                                 </apex:outputPanel> 
                                </apex:facet> 
                            </apex:actionStatus>
                                
                            <div class=""slds-grid"">
                                <div class=""slds-col slds-text-align--center"">
                                    <span class=""slds-text-heading--label"" style=""font-size:16px"">Add New:</span>
                                    <!--<a href=""javascript:void(0)"" class="""" style=""margin-left:10px;text-decoration:none"" onclick=""initializeQuestion();return false"">
                                        <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#question"" cssStyle=""height:20px;width:20px""/>
                                    </a>-->                                     
                                    <!--<a href=""javascript:void(0)"" class="""" style=""margin-left:10px;text-decoration:none"" onclick=""initializeMessage();return false"">
                                        <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#notebook"" cssStyle=""height:20px;width:20px""/>
                                    </a>
                                    <a href=""javascript:void(0)"" class="""" style=""margin-left:10px;text-decoration:none"" onclick=""initializeTool();return false"">
                                        <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#custom_apps"" cssStyle=""height:20px;width:20px""/>
                                    </a>-->
                                    
                                    <a href=""javascript:void(0)"" class=""slds-button slds-button--small slds-button--brand "" data-aljs=""modal"" data-aljs-show=""questionpromptmodal"" style=""padding:0 10px;text-decoration:none"" >
                                        Question
                                        <!-- <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#question"" cssStyle=""height:20px;width:20px""/>-->
                                    </a>                                   
                                    <a href=""javascript:void(0)"" class=""slds-button slds-button--small slds-button--brand messageBtn"" data-aljs=""modal"" style=""padding:0 10px;text-decoration:none"" data-aljs-show=""messagePromptModal"">
                                        Message
                                        <!-- <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#notebook"" cssStyle=""height:20px;width:20px""/>-->
                                    </a>
                                    <a href=""javascript:void(0)"" class=""slds-button slds-button--small slds-button--brand toolBtn"" data-aljs=""modal"" style=""padding:0 10px;text-decoration:none"" data-aljs-show=""toolPromptModal"">
                                        Tool
                                        <!-- <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#custom_apps"" cssStyle=""height:20px;width:20px""/>-->
                                    </a>
                                    <a href=""javascript:void(0)"" class=""slds-button slds-button--small slds-button--brand toolBtn"" data-aljs=""modal"" style=""padding:0 10px;text-decoration:none"" data-aljs-show=""trainingPromptModal"">
                                        Training
                                        <!-- <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#custom_apps"" cssStyle=""height:20px;width:20px""/>-->
                                    </a>                                  
                                </div>
                            </div>
                            <apex:outputPanel id=""playDetailDiv"">
                            
                            <!-- Questions -->
                            <!-- <apex:outputText rendered=""{!questionList.size > 0}"" styleclass=""slds-section__title slds-m-top--medium QMTHeading"" style=""display:block"" value=""Questions""/> -->                                      
                            <!-- <apex:outputpanel layout=""none"" rendered=""{!questionList.size == 0}"">
                                No Question Exist
                            </apex:outputpanel> -->
                            <div id=""questionDrop"" class=""slds-m-top--small"">
                                <apex:outputpanel layout=""none"" rendered=""{!questionList.size > 0}"">
                                    <apex:variable value=""{!0}"" var=""cnt""/>
                                    
                                    <ul id="""" class=""sortable-list slds-list--vertical slds-has-cards--space has-selections"" style=""padding:4px"">
                                                   
                                    <apex:repeat value=""{!questionList}"" var=""q"">
                                        <apex:variable value=""{!cnt + 1}"" var=""cnt""/>
                                        <li  id=""{!q.id}"" data-playid=""{!q.play__c}"" class=""sortable-item slds-list__item""  onmouseover=""$('.editQuestion{!cnt}').show();"" onmouseout=""$('.editQuestion{!cnt}').hide();"">
                                        <div class=""slds-tile slds-tile--board"">          
                                            <div class=""slds-grid slds-wrap"">
                                                                        
                                                <div class=""slds-col playDetailQuestionCol"" style=""width:45% !important"">
                                                    <div class=""slds-text-longform"" style=""font-size:14px !important;margin-top:6px !important"">
                                                        <!-- <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#question"" cssStyle=""height:20px;width:20px""/> -->
                                                        <a href=""javascript:void(0)""  onclick=""clearModal('questionModal');fillModalValuesForEditQuestion('{!q.id}');return false"" style=""text-decoration:none;"">{!q.Description__c}
                                                          <c:SVGComponent styleClass=""editQuestion{!cnt} slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:17px;width:17px;display:none""/>
                                                                
                                                        </a>
                                                        <a href=""javascript:void(0)"" class=""editQuestion{!cnt}"" onclick=""event.stopPropagation();$('.deleteMdlHeading').text('Delete Question');$('[id$=playDetailModal]').modal('dismiss');$('[id$=deleteMainModal]').modal('show');manageBackdrop();deletingId = '{!q.id}';deleteWhat = 'question';"" style=""display:none"">
                                                            <c:SVGComponent styleClass="" slds-button__icon--stateful slds-icon--small"" clickOperation=""""  path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""height:17px;width:17px;color:#54698D;""/>  
                                                        </a>
                                                        
                                                    </div>
                                                </div>
                                                <div class=""slds-col playDetailQuestionCol"" style=""width:45% !important"">
                                                    <apex:variable var=""showFlag"" value=""{!0}""/> 
                                                    <apex:outputpanel layout=""none""  rendered=""{!q.ResponseType__c == 'SingleChoice' && q.answers__r.size > 0}"">
                                                        
                                                        <select size=""1""  class=""slds-select"" style=""width:100%"">
                                                            <apex:repeat value=""{!q.answers__r}"" var=""a"">
                                                                <Option>{!a.Answer__c}</Option>
                                                                <apex:variable var=""showFlag"" value=""{!if(showFlag == 0 && a.FlagType__c == 'Red',1,if(showFlag == 1 , 1 , 0))}""/> 
                                                            </apex:repeat>
                                                        </select>
                                                    </apex:outputpanel>
                                                    
                                                    <apex:outputpanel layout=""none"" rendered=""{!q.ResponseType__c == 'MultiChoice'  && q.answers__r.size > 0}"">
                                                        <select size=""3"" multiple=""multiple""  class=""slds-select"" style=""width:100%"">
                                                            <apex:repeat value=""{!q.answers__r}"" var=""a"">
                                                                <Option>{!a.Answer__c}</Option>
                                                                <apex:variable var=""showFlag"" value=""{!if(showFlag == 0 && a.FlagType__c == 'Red',1,if(showFlag == 1 , 1 , 0))}""/>
                                                            </apex:repeat>
                                                        </select>
                                                    </apex:outputpanel>
                                                    
                                                    <apex:outputpanel layout=""none"" rendered=""{!q.ResponseType__c == 'Date'}"">
                                                        <input type=""text"" class=""slds-input"" style=""width:100%""/>
                                                    </apex:outputpanel>
                                                    
                                                    <apex:outputpanel layout=""none"" rendered=""{!q.ResponseType__c == 'Text'}"">
                                                        <input type=""text"" class=""slds-input"" style=""width:100%""/>
                                                    </apex:outputpanel>
                                                    
                                                    <apex:outputpanel layout=""none"" rendered=""{!q.ResponseType__c == 'Number' || q.ResponseType__c == 'DataMap' || q.ResponseType__c == 'Amount' || q.ResponseType__c == 'Percent'}"">
                                                        <input type=""text"" class=""slds-input"" style=""width:100%""/>
                                                    </apex:outputpanel>
                                                    
                                                    <apex:outputpanel layout=""none"" rendered=""{!q.ResponseType__c == 'Checkbox'}"">
                                                        <label class=""slds-checkbox""  style="""">
                                                            <input type=""checkbox""/>
                                                            <span class=""slds-checkbox--faux""></span>
                                                        </label> 
                                                    </apex:outputpanel>
                                                    
                                                    <apex:outputpanel layout=""none"" rendered=""{!q.ResponseType__c == 'Rating'}"">
                                                        <select size=""1"" class=""slds-select"" style=""width:100%"">
                                                            <Option>Positive</Option>
                                                            <Option>Neutral</Option>
                                                            <Option>Negative</Option>
                                                        </select>
                                                    </apex:outputpanel>
                                                </div>
                                            </div>
                                        </div>
                                        </li>
                                    
                                    </apex:repeat>
                                    
                                    </ul>
                                </apex:outputpanel>
                            </div>
                            
                            
                            <!-- Messages -->
                            <!-- <apex:outputText rendered=""{!messageList.size > 0}"" styleclass=""slds-section__title slds-m-top--medium QMTHeading"" style=""display:block"" value=""Messages""/> -->                            
                            <!-- <apex:outputpanel layout=""none"" rendered=""{!messageList.size == 0}"">
                                No Message Exist
                            </apex:outputpanel> -->
                            <div id=""messageDrop"">
                            <apex:outputpanel layout=""none"" rendered=""{!messageList.size > 0}"">
                                <apex:variable value=""{!0}"" var=""cnt""/>
                                <ul id="""" class=""sortable-list slds-list--vertical slds-has-cards--space has-selections"" style=""padding:4px"">
                                <apex:repeat value=""{!messageList}"" var=""m"">
                                    <apex:variable value=""{!cnt + 1}"" var=""cnt""/>
                                    <li  id=""{!m.id}"" data-playid=""{!m.play__c}"" class=""sortable-item slds-list__item""  onmouseover=""$('.editMessage{!cnt}').show();"" onmouseout=""$('.editMessage{!cnt}').hide();"">
                                    <div class=""slds-grid"">
                                        <div class=""slds-col"">
                                            <div class=""slds-text-longform"" style=""font-size:14px !important;"">
                                                <!-- <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#notebook"" cssStyle=""height:20px;width:20px""/> -->
                                                <apex:outputText value=""{!m.Description__c}"" escape=""false""/>     
                                                <a href=""javascript:void(0)"" onclick=""clearModal('messageModal'); fillModalValuesForEditMessage('{!m.id}'); return false;""  style=""text-decoration:none"">
                                                  <c:SVGComponent styleClass=""editMessage{!cnt} slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:17px;width:17px;display:none""/>
                                                </a>
                                                <a href=""javascript:void(0)"" class=""editMessage{!cnt}"" onclick=""event.stopPropagation();$('.deleteMdlHeading').text('Delete Message');$('[id$=playDetailModal]').modal('dismiss');$('[id$=deleteMainModal]').modal('show');manageBackdrop();deletingId = '{!m.id}';deleteWhat = 'message';"" style=""display:none"">
                                                    <c:SVGComponent styleClass="" slds-button__icon--stateful slds-icon--small"" clickOperation=""""  path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""height:17px;width:17px;color:#54698D;""/>  
                                                </a>
                                                
                                            </div>
                                        </div>
                                    </div>
                                    </li>
                                </apex:repeat>
                                </ul>
                            </apex:outputpanel>
                            </div>
                            <!-- Tools -->
                            <!-- <apex:outputText rendered=""{!toolList.size > 0}"" styleclass=""slds-section__title slds-m-top--medium QMTHeading"" style=""display:block"" value=""Tools""/> -->
                            <div id=""toolDrop"">
                            <apex:outputpanel layout=""none"" rendered=""{!toolList.size > 0}"">
                                <apex:variable value=""{!0}"" var=""cnt""/>
                                <ul id="""" class=""sortable-list slds-list--vertical slds-has-cards--space has-selections"" style=""padding:4px"">
                                <apex:repeat value=""{!toolList}"" var=""t"">
                                    <apex:variable value=""{!cnt + 1}"" var=""cnt""/>
                                    <li  id=""{!t.id}"" data-playid=""{!t.play__c}"" class=""sortable-item slds-list__item"" onmouseover=""$('.editTool{!cnt}').show();"" onmouseout=""$('.editTool{!cnt}').hide();"">
                                    <div class=""slds-grid"">
                                        <div class=""slds-col"">
                                            <div class=""slds-text-longform"" style=""font-size:14px !important;"" >
                                                <!-- <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#custom_apps"" cssStyle=""height:20px;width:20px""/> -->
                                                <a href=""javascript:void(0)""  onclick=""clearModal('toolModal');fillModalValuesForEditTool('{!t.id}');return false""  style=""text-decoration:none"">{!t.Name__c}
                                                  <c:SVGComponent styleClass=""editTool{!cnt} slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:17px;width:17px;display:none""/>
                                                </a>
                                                <a href=""javascript:void(0)"" class=""editTool{!cnt} "" onclick=""event.stopPropagation();$('.deleteMdlHeading').text('Delete Tool');$('[id$=playDetailModal]').modal('dismiss');$('[id$=deleteMainModal]').modal('show');manageBackdrop();deletingId = '{!t.id}';deleteWhat = 'tool';"" style=""display:none"">
                                                    <c:SVGComponent styleClass=""slds-button__icon--stateful slds-icon--small"" clickOperation=""""  path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""height:17px;width:17px;color:#54698D;""/>   
                                                </a>
                                                
                                            </div>
                                        </div>
                                    </div>
                                    </li>
                                </apex:repeat>
                                </ul>
                            </apex:outputpanel>
                            </div>
                            
                            <!-- Training -->
                            <!-- <apex:outputText rendered=""{!trainingList.size > 0}"" styleclass=""slds-section__title slds-m-top--medium QMTHeading"" style=""display:block"" value=""Training""/> -->
                            <div id=""trainingDrop"">
                            <apex:outputpanel layout=""none"" rendered=""{!trainingList.size > 0}"">
                                <apex:variable value=""{!0}"" var=""cnt""/>
                                <ul id="""" class=""sortable-list slds-list--vertical slds-has-cards--space has-selections"" style=""padding:4px"">
                                <apex:repeat value=""{!trainingList}"" var=""t"">
                                    <apex:variable value=""{!cnt + 1}"" var=""cnt""/>
                                    <li  id=""{!t.id}"" data-playid=""{!t.play__c}"" class=""sortable-item slds-list__item"" onmouseover=""$('.editTraining{!cnt}').show();"" onmouseout=""$('.editTraining{!cnt}').hide();"">
                                    <div class=""slds-grid"">
                                        <div class=""slds-col"">
                                            <div class=""slds-text-longform"" style=""font-size:14px !important;"" >
                                                <!-- <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#custom_apps"" cssStyle=""height:20px;width:20px""/> -->
                                                <a href=""javascript:void(0)""  onclick=""clearModal('trainingModal');fillModalValuesForEditTraining('{!t.id}');return false""  style=""text-decoration:none"">{!t.Name__c}
                                                  <c:SVGComponent styleClass=""editTraining{!cnt} slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:17px;width:17px;display:none""/>
                                                </a>
                                                <a href=""javascript:void(0)"" class=""editTraining{!cnt} "" onclick=""event.stopPropagation();$('.deleteMdlHeading').text('Delete Training');$('[id$=playDetailModal]').modal('dismiss');$('[id$=deleteMainModal]').modal('show');manageBackdrop();deletingId = '{!t.id}';deleteWhat = 'training';"" style=""display:none"">
                                                    <c:SVGComponent styleClass=""slds-button__icon--stateful slds-icon--small"" clickOperation=""""  path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""height:17px;width:17px;color:#54698D;""/>   
                                                </a>
                                                
                                            </div>
                                        </div>
                                    </div>
                                    </li>
                                </apex:repeat>
                                </ul>
                            </apex:outputpanel>
                            </div>
                            </apex:outputPanel>
                        </div>
                        <div class=""slds-modal__footer"">
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" onclick=""$('[id$=playDetailModal]').modal('dismiss');"">Cancel</a>
                            <!-- <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral slds-button--brand"" data-aljs=""modal"" data-aljs-show=""playModal"">Save</a> -->
                        </div>
                    </div>
              </div>
              <!-- Play Detail Modal End -->
              <script>    
                  /* Set scroll of main div when stages container width greater then main div */
                  if(parseInt($('.stage-header').css('width')) > parseInt($('.main-scroll').css('width'))){                 
                     $('.main-scroll').addClass('custom-scroll');              
                  } else {                  
                     $('.main-scroll').removeClass('custom-scroll');
                  }
                  
                  /*Set minimum height for dropable play zone dynamically*/
                  $('#examplesDrop .sortable-list').css('min-height',(parseInt($('#examplesDrop').css('height'))-parseInt($('.add-play-link').css('height'))));
                  
                   /* Drag Drop play funtionality */
                    $(document).ready(function(){
                        /* play drag drop start */
                        console.log('init sort');
                        $('#examplesDrop .sortable-list').sortable({
                            revert : true,
                            connectWith : '#examplesDrop .sortable-list',                           
                            start: function(event, ui) {
                                ui.item.startPos = ui.item.index();
                            },
                            stop : function(event,ui){  
                                /* Parameter Descriptions */
                                // 1. ui.item.context.id :==> Current droped play id
                                // 2. ui.item.context.parentElement.id :==> Stage id where play droped
                                // 3. true :==> Is parent changed ?
                                // 4. ui.item.startPos :==> Play's old position 
                                // 5. ui.item.index() :==> Play's new position 
                                // 6. e :==> Event       
                                console.log('Here we go!');
                                if (ui.item.context.parentElement.id != $('#'+ui.item.context.id).data('stageid')) {                        
                                    // the item got moved from one to another parent  
                                    currentElement = this;
                                    $('[id$=playModal]').modal('dismiss');
                                    $('[id$=deleteModal]').modal('dismiss');
                                    $('[id$=playDropConfirmPrompt]').modal('show');manageBackdrop();                   
                                    
                                    
                                    //console.log('on drop stop update play order of diff parent');
                                    //console.log(""index==>Start position:==> "" + ui.item.startPos);
                                    //console.log('index==>'+ui.item.index());
                                   
                                    //var th = this;                        
                                    /*$('#noMove').click(function(){
                                        stopPlayDrop(th);                           
                                    });*/
                                    
                                    $('#moveConfirm').click(function(e){         
                                        //alert('move confirm');         
                                         e.preventDefault(); 
                                         startPlayDrop(ui.item.context.id, ui.item.context.parentElement.id, true, ui.item.startPos, ui.item.index(), e);
                                    });                          
                               
                                } else if(ui.item.context.parentElement.id == $('#'+ui.item.context.id).data('stageid')){
                                    // the item got moved in same parent  
                                    currentElement = this;
                                    $('[id$=playModal]').modal('dismiss');
                                    $('[id$=deleteModal]').modal('dismiss');
                                    $('[id$=playDropConfirmPrompt]').modal('show');manageBackdrop();                   
                                    
                                    //console.log('on drop stop update play order of same parent');
                                    //console.log(""index==>Start position:==> "" + ui.item.startPos);
                                    //console.log('index==>'+ui.item.index());
                                                                     
                                    $('#moveConfirm').click(function(e){     
                                        e.preventDefault(); 
                                        startPlayDrop(ui.item.context.id, ui.item.context.parentElement.id, false, ui.item.startPos, ui.item.index(), e);
                                    });                          
                               
                                }else {
                                    // the item was returned to the same position
                                    stopPlayDrop(this);                  
                                }                                 
                            }          
                        });
                        /* play drag drop end */
                    });  
                        
                    
                    function initializeInnerPlayDragging(){
                        /* question drag drop start */
                        console.log('init sort question');
                        $('#questionDrop .sortable-list').sortable({
                            revert : true,
                            connectWith : '#questionDrop .sortable-list',                           
                            start: function(event, ui) {
                                ui.item.startPos = ui.item.index();
                            },
                            stop : function(event,ui){  
                                /* Parameter Descriptions */
                                // 1. ui.item.context.id :==> Current droped question id
                                // 2. ui.item.context.parentElement.id :==> play id where play droped
                                // 3. true :==> Is parent changed ?
                                // 4. ui.item.startPos :==> Play's old position 
                                // 5. ui.item.index() :==> Play's new position 
                                // 6. e :==> Event       
                                console.log('Here we go!');
                                console.log('ui.item.context.parentElement.id='+ui.item.context.parentElement.id);
                                console.log('ui.item.context.id).data(playid)='+$('#'+ui.item.context.id).data('playid'));
                                // the item got moved in same parent  
                                questionCurrentElement = this;
                                $('[id$=questionDropConfirmPrompt]').modal('show');manageBackdrop();                   
                                
                                
                                console.log('on drop stop update play order of same parent');
                                console.log(""index==>Start position:==> "" + ui.item.startPos);
                                console.log('index==>'+ui.item.index());
                                console.log('parentId='+$('#'+ui.item.context.id).data('playid'));                                
                                $('#moveConfirmQuestion').click(function(e){     
                                    e.preventDefault(); 
                                    startQuestionDrop(ui.item.context.id, $('#'+ui.item.context.id).data('playid'),ui.item.startPos, ui.item.index(), e);
                                });                          
                               
                                                                 
                            }          
                        });
                        /* question drag drop end */               
                        
                        /* message drag drop start */
                        $('#messageDrop .sortable-list').sortable({
                            revert : true,
                            connectWith : '#messageDrop .sortable-list',                           
                            start: function(event, ui) {
                                ui.item.startPos = ui.item.index();
                            },
                            stop : function(event,ui){  
                                msgCurrentElement = this;
                                $('[id$=messageDropConfirmPrompt]').modal('show');manageBackdrop();                   
                                $('#moveConfirmMessage').click(function(e){     
                                    e.preventDefault(); 
                                    startMessageDrop(ui.item.context.id, $('#'+ui.item.context.id).data('playid'),ui.item.startPos, ui.item.index(), e);
                                });                          
                               
                                                                 
                            }          
                        });
                        /* message drag drop end */               
                        
                        /* tool drag drop start */
                        $('#toolDrop .sortable-list').sortable({
                            revert : true,
                            connectWith : '#toolDrop .sortable-list',                           
                            start: function(event, ui) {
                                ui.item.startPos = ui.item.index();
                            },
                            stop : function(event,ui){  
                                // the item got moved in same parent  
                                toolCurrentElement = this;
                                $('[id$=toolDropConfirmPrompt]').modal('show');manageBackdrop();                   
                                $('#moveConfirmTool').click(function(e){     
                                    e.preventDefault(); 
                                    startToolDrop(ui.item.context.id, $('#'+ui.item.context.id).data('playid'),ui.item.startPos, ui.item.index(), e);
                                });                          
                            }          
                        });
                        /* tool drag drop end */
                        
                        /* training drag drop start */
                        $('#trainingDrop .sortable-list').sortable({
                            revert : true,
                            connectWith : '#trainingDrop .sortable-list',                           
                            start: function(event, ui) {
                                ui.item.startPos = ui.item.index();
                            },
                            stop : function(event,ui){  
                                // the item got moved in same parent  
                                trainingCurrentElement = this;
                                $('[id$=trainingDropConfirmPrompt]').modal('show');manageBackdrop();                   
                                $('#moveConfirmTraining').click(function(e){     
                                    e.preventDefault(); 
                                    startTrainingDrop(ui.item.context.id, $('#'+ui.item.context.id).data('playid'),ui.item.startPos, ui.item.index(), e);
                                });                          
                            }          
                        });
                        /* training drag drop end */               
                    }
                  
              </script>
              </apex:outputPanel>
          </section>
          <!-- Stage Modal Start -->
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""stageModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium stageMdlHeading"">New Stage</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button>
                    </div>
                    <div class=""slds-modal__content"">
                        
                        <div class=""slds-notify-container createStageNotify""  style=""position:relative;display:none"">
                          <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                            <span class=""slds-assistive-text"">Info</span>
                              
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close""  onclick=""$('.createStageNotify').hide(100);"">
                              <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                              <span class=""slds-assistive-text"">Close</span>
                            </a>
                            <div class=""notify__content"">
                              <h2 class=""slds-text-heading--small"">
                                  <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                    <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                  </svg>
                                  <span class=""createStageErrorMsg""></span>
                              </h2>
                            </div>
                          </div>
                        </div>
                        <apex:outputPanel id=""name_stageModal"">
                            <div class=""slds-form-element slds-is-required"">
                                <label class=""formLabel slds-form-element__label"">Stage Name</label>
                                <div class=""slds-form-element__control"">
                                    <apex:selectList id=""createStageName"" value=""{!stageObj.Name__c}"" size=""1"" styleclass=""slds-select""> 
                                        <apex:selectoptions value=""{!stagePicklist}""/>
                                    </apex:selectList>
                                </div>
                            </div>
                        </apex:outputPanel>
                        <div class=""slds-form-element"">
                            <label class=""formLabel slds-form-element__label"">Description</label>
                            <div class=""slds-form-element__control "">
                                <apex:inputTextArea id=""createStageDesc"" value=""{!stageObj.Description__c}"" styleclass=""slds-textarea""/>    
                            </div>
                        </div>
                        <div class=""slds-form--horizontal"">
                            <div class=""slds-form-element"" style=""text-align:left"">
                                <div class=""slds-form-element__control"" style=""width:4% !important"">
                                    <label class=""slds-checkbox"">
                                       <apex:inputCheckbox id=""createStageIsLibrary"" value=""{!stageObj.isLibrary__c}"" />
                                       <span class=""slds-checkbox--faux""></span>
                                    </label>
                                </div>
                                <label class=""slds-form-element__label"" style=""max-width:100% !important"">Do not display as stage on scorecard</label>
                            </div>
                        </div>
                                     
                    </div>
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Cancel</button>
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""checkValidation('CreateStage'); return false"">Save</button>
                    </div>
                </div>
          </div>
          <!-- Stage Modal End -->
          
          <!-- New Modals for Questions -->
          <!-- Added on 3-25-2015 -->
          <!-- Desc : This is the second screen if we go to select from exiting -->
            <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""clone_question_modal"">
                <div class=""slds-modal__container"">
                
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium"">Choose the question template you want to use</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button>
                    </div>
                    
                    <div class=""slds-modal__content"" style=""min-height: 400px;"">
                        <div class=""slds-form-element"">                      
                             <apex:outputPanel id=""cloneQuestionDiv"" layout=""block"" style=""width:100%"">
                                 <script>
                                      //jQuery Datatable 
                                      $(document).ready(function (){
                                  
                                        var table = $('#example').DataTable({
                                            ""language"": {
                                              ""search"": """",
                                              ""lengthMenu"": ""_MENU_"",
                                              searchPlaceholder: ""Search records""
                                            },
                                        });
                                         
                                        $('#example_length label select').addClass('slds-select');        
                                        $('#example_filter label input').addClass('slds-select');
                                        
                                        $('#example tbody').on( 'click', 'tr', function () {
                                            if ( $(this).hasClass('selected') ) {
                                                $(this).removeClass('selected');
                                            }
                                            else {
                                                table.$('tr.selected').removeClass('selected');
                                                $(this).addClass('selected');
                                            }
                                        } );
                                  
                                    });
                                 </script>
                                 
                                 <table class=""slds-table slds-table--bordered"" id=""example"" cellspacing=""0"" width=""100%"">
                                  <thead>
                                      <tr class=""slds-text-heading--label"">          
                                          <th class=""slds-is-sortable""> Stage </th>         
                                          <th class=""slds-is-sortable""> Question </th>
                                      </tr>
                                  </thead>
                                  
                                  <tbody>
                                      <apex:repeat value=""{!questions}"" var=""ques"" id=""existList"">
                                          <!--<li class=""slds-picklist__item"" aria-selected=""false"" role=""option"">
                                            <span class=""slds-truncate"" onclick="" $('.checked').hide(); $(this).find('.checked').show();"">
                                                <span>{!ques.Play__r.Stage__r.Name__c}  - {!ques.Description__c} </span>
                                            </span>
                                          </li>-->
                                          
                                          <tr class=""slds-hint-parent"" onclick=""rowQuesId='{!ques.Id}'; rowPlayId = parentPlayId;"">        
                                           <td class=""slds-truncate"">{!ques.Play__r.Stage__r.Name__c}</td>
                                            <td class=""slds-truncate"">{!ques.Description__c}</td>           
                                          </tr>
                                      </apex:repeat>
                                  </tbody>
                                 </table>
                                 
                              </apex:outputPanel>                           
                        </div>
                    </div>
                    
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""cloneQuestion(rowQuesId); return false"">Select</button>
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=questionpromptmodal]').modal('show');manageBackdrop(); return false"">Cancel</button>                     
                    </div>
                </div>
                
            </div>
            <!-- Question clone modal end -->
          
            <!-- Massage Clone modal --> 
            <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""clone_message_modal"">
                <div class=""slds-modal__container"">
                
                    <div class=""slds-modal__header"">
