                  <!--  create task modal start -->
                  <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""taskModal"">
                        <div class=""slds-modal__container"">
                            <div class=""slds-modal__header"">
                                <h2 class=""slds-text-heading--medium"">Task Detail</h2>
                                <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                                    <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                                    <span class=""slds-assistive-text"">Close</span>
                                </button>
                            </div>
                            <div class=""slds-modal__content"">
                                <div class=""slds-notify-container taskNotify""  style=""position:relative;display:none"">
                                  <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                                    <span class=""slds-assistive-text"">Info</span>
                                      
                                    <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close"" onclick=""$('.taskNotify').hide(100);"">
                                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                                      <span class=""slds-assistive-text"">Close</span>
                                    </a>
                                    <div class=""notify__content"">
                                      <h2 class=""slds-text-heading--small"">
                                          <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                            <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                          </svg>
                                          <span class=""taskErrorMsg""></span>
                                      </h2>
                                    </div>
                                  </div>
                                </div>
                                
                                <div class=""slds-form-element slds-is-required"">
                                    <label class=""formLabel slds-form-element__label"">Subject</label>
                                    <div class=""slds-form-element__control"">
                                        <apex:inputText id=""taskSubject"" value=""{!taskInsertObj.subject}"" styleclass=""slds-input""/>
                                    </div>
                                </div>
                                
                                <div class=""slds-form-element slds-is-required"">
                                    <label class=""formLabel slds-form-element__label"">Status</label>
                                    <div class=""slds-form-element__control"">
                                        <apex:inputField id=""taskStatus"" value=""{!taskInsertObj.status}"" styleclass=""slds-select""/>
                                    </div>
                                </div>
                                
                                <div class=""slds-form-element"">
                                    <label class=""formLabel slds-form-element__label"">Due Date</label>
                                    <div class=""slds-form-element__control slds-input-has-icon slds-input-has-icon--right"">
                                        <svg aria-hidden=""true"" class=""slds-input__icon"" >
                                          <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#event')}""></use>
                                        </svg> 
                                        <apex:inputText value=""{!taskInsertObj.activityDate}"" styleClass=""dt slds-input"" html-placeholder=""Pick a Date""/>
                                    </div>
                                </div>
                                
                                <div class=""slds-form-element"">
                                    <label class=""formLabel slds-form-element__label"">Contact</label>
                                    <div class=""slds-form-element__control"">
                                        <input type=""text"" id=""taskWhoName""/>
                                        <apex:inputHidden id=""taskWhoId"" value=""{!taskInsertObj.whoid}""/>
                                        <div id=""taskWhoDiv""></div>
                                    </div>
                                </div>
                                
                                <div class=""slds-form-element slds-is-required"">
                                    <label class=""formLabel slds-form-element__label"">Priority</label>
                                    <div class=""slds-form-element__control"">
                                        <apex:inputField id=""taskPriority"" value=""{!taskInsertObj.priority}"" styleclass=""slds-select""/>
                                    </div>
                                </div>
                                
                                <div class=""slds-form-element"">
                                    <label class=""formLabel slds-form-element__label"">Comments</label>
                                    <div class=""slds-form-element__control"">
                                        <apex:inputField value=""{!taskInsertObj.description}"" styleclass=""slds-textarea""/>
                                    </div>
                                </div>
                                
                                <div class=""slds-form-element rem-sec"">
                                    <label class=""formLabel slds-form-element__label"">Reminder</label>
                                    <div class=""slds-grid"">
                                        <div class=""slds-size--12-of-12"">
                                            <div class=""slds-form-element__control"">
                                                <label class=""slds-checkbox"">
                                                   <apex:inputCheckbox value=""{!taskInsertObj.isReminderSet}"" onchange=""if(this.checked){$('.taskRem').show(); showDatePicker();  }else{$('.taskRem').hide()}""/>
                                                   <span class=""slds-checkbox--faux""></span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class=""slds-grid"">
                                        <div class=""slds-size--7-of-12 slds-m-top--small"">
                                            <div class=""taskRem slds-form-element__control slds-input-has-icon slds-input-has-icon--right"" style=""display:none"">
                                                <svg aria-hidden=""true"" class=""slds-input__icon"" >
                                                  <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#event')}""></use>
                                                </svg> 
                                                <input id=""taskRemDate"" type=""Text""  class=""dt slds-input"" placeholder=""Pick a Date""/>
                                            </div>
                                        </div>
                                        <div class=""slds-size--5-of-12 slds-m-top--small"">
                                            <div class=""taskRem slds-form-element__control slds-input-has-icon slds-input-has-icon--right"" style=""display:none"">
                                                <svg aria-hidden=""true"" class=""taskRemSvg slds-input__icon"">
                                                  <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#clock')}""></use>
                                                </svg> 
                                                <input type=""Text""  Class=""taskRemTime slds-input"" placeholder=""Pick a time""/>
                                            </div>
                                            <div class=""taskRemTimeDiv""></div>
                                        </div>
                                        
                                    </div>
                                    <apex:inputHidden id=""taskReminderHidden"" value=""{!taskRemDateTimeStr}""/>
                                  
                                </div>
                               
                            </div>
                            <div class=""slds-modal__footer"">
                                <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Cancel</button>
                                <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""updateTaskDateTimeFields();return false"">Save</button>
                            </div>
                        </div>
                  </div>
                  <!--  create task modal end -->
                  
                  <!--  create meeting event start -->
                  <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""meetingEventModal"">
                        <div class=""slds-modal__container"">
