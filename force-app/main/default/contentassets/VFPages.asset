"066150000039qv9AAA","","LeadPlayMaker","39.0","LeadPlayMaker","","1","Lead","false","false","<apex:page standardController=""Lead"" extensions=""LeadPlaymakerController""  showHeader=""false"" standardStylesheets=""false"" sidebar=""false"" applyBodyTag=""false"" docType=""html-5.0"" applyHtmlTag=""false"" id=""thePage"" >
    <apex:stylesheet value=""{!URLFOR($Resource.slds, 'assets/styles/salesforce-lightning-design-system-vf.css')}"" />
    <script src=""{!URLFOR($Resource.jquery,'jquery.min.js')}""></script>
  
    <script src=""{!URLFOR($Resource.jquery,'moment.js')}""></script>
  
    <script src=""{!URLFOR($Resource.aljs, 'jquery.aljs-init.min.js')}""></script>
    <script src=""{!URLFOR($Resource.aljs, 'jquery.aljs-modal.min.js')}""></script>
    <script src=""{!URLFOR($Resource.aljs, 'moment.js')}""></script>
    <script src=""{!URLFOR($Resource.aljs, 'jquery.aljs-datepicker.min.js')}""></script>
    <script src=""{!URLFOR($Resource.aljs, 'jquery.aljs-tooltip.min.js')}""></script>
   
    <script>
        var assetsLocation = '{!URLFOR($Resource.slds)}';
        $.aljsInit({
            assetsLocation: assetsLocation,
            scoped: true
        });      
    </script>    
    <html xmlns=""http://www.w3.org/2000/svg"" xmlns:xlink=""http://www.w3.org/1999/xlink"">
        <body class=""slds""> 
            <style>
                /* Smartphones (portrait and landscape) ----------- */
                @media only screen
                and (min-device-width : 320px)
                and (max-device-width : 480px) {
                    .stageBarCol1{
                        width:100% !important;
                    }
                }             
                 
                /* Smartphones (portrait) ----------- */
                @media only screen
                and (max-width : 320px) {
                    .stageBarCol1{
                        width:100% !important;
                    }
                }
                 
                
                .custPopup{
                     left:45%;
                     top=57%;
                     z-index: 9999;
                     position:absolute; 
                 } 
                
                .popupBackground{ 
                    background-color:white;
                    opacity: 0.30;
                    filter: alpha(opacity = 30);
                    position:absolute;
                    width: 100%;
                    height: 100%;
                    top: 0;
                    left: 0;
                    z-index: 9998; 
                }
                <!-- For make checkbox blue -->    
                <!--
                .slds .slds-checkbox [type=""checkbox""]:checked ~ .slds-checkbox--faux:after {
                   border-bottom: 2px solid white;
                   border-left: 2px solid white;
                }
                .slds-checkbox--faux{
                   background-color:#1589ee;            
                }
                .slds .slds-checkbox .slds-checkbox--faux{
                   background-color:#1589ee;
                   border:0;
                }
                .slds .slds-checkbox [type=""checkbox""]:focus:checked ~ .slds-checkbox--faux {
                   background-color:#1589ee;
                }
                -->
                <!-- For make checkbox blue -->  
                
                .slds-datepicker{
                    width:260px;
                    
                }
                
                .datepicker__month td , .datepicker__month th{
                    padding: 1px !important;
                }
                
                .fileUpload {
                    position: relative;
                    overflow: hidden;
                }
                .fileUpload input.upload {
                    position: absolute;
                    top: 0;
                    right: 0;
                    margin: 0;
                    padding: 0;
                    font-size: 20px;
                    cursor: pointer;
                    opacity: 0;
                    filter: alpha(opacity=0);
                } 
                
                .tdBorder{
                    border:1px solid #CCC;
                }
                .tdBorderT{
                    border-top:1px solid #CCC;
                }
                .tdBorderL{
                    border-left:1px solid #CCC;
                }
                .tdBorderR{
                    border-right:1px solid #CCC;
                }
                .tdBorderB{
                    border-bottom:1px solid #CCC;
                }
                .dealPTbl tr > th:first-child, .dealPTbl tr > td:first-child{
                    padding-left:8px !important;
                }
                
                .slds-modal__header{
                    background : #00599c !important;
                    color : white !important;
                }
                .slds-modal__content{
                    background:#f4f6f9 !important;
                }
                .slds-modal__footer{
                    background:#adcfe6 !important;
                }
                
                h1.playHeading{
                    line-height: 2 !important;
                }
                .wordWrapClass{
                    white-space:normal !important;
                    word-break:break-word !important;
                    
                }
                /*TO MAKE QUESTION VERTICALLY ALIGNED TOP*/
                td.wordWrapClass{
                    vertical-align : top !important;
                }
                .formLabel{
                    font-weight : bold !important;
                }
                #stageMoveModal{
                    top : 0 !important;
                    bottom : initial !important;
                }
                .dealSumTd2InnerTbl{
                    width : 100%;
                }
                .dealSumTd2InnerTbl tr:hover{
                    border : none !important;
                }
                .dealSumTd2InnerTbl td{
                    padding : 0px !important;
                    border : none !important;
                }
                /*MAKE ALL SAVE BUTTONS AS BLACK*/
                .saveButton{
                    background : #333 !important;
                    border-color : #333 !important;
                }
                /*MAKE STICKEY NOTE LIGHTER IF EMPTY*/
                .svgLightblue{
                    fill : lightblue !important;
                }
                /*TO MAKE PLAY BAR AS GREEN-BLUE COLOR AND MAKE PLAY BAR HEADING AS SECTION HEADING*/
                .playHeading{
                    background : #00599c !important;/*#0070D2 !important;*//* #215968 !important; */
                    padding: 4px !important;
                    /*font-size : 18px !important;*/
                }
                /*CHANGE TABLE HEADER BACKGROUND */
                .slds-table thead tr{
                    background : #00599c !important;
                }
                /* MAKE SECTION HEADING BOLD */
                .slds-section-title{
                    /*font-weight : bold !important;*/
                }
                /*TO MAKE POPUP BACKGROUND DARDKER */
                .slds-backdrop--open {
                    opacity: 0.7 !important;
                    transition: opacity 0.4s linear 0s;
                    visibility: visible;
                }
                /*TO MAKE Ul TO SHOW BULLETS*/
                .showUlBullets ul, .slds-tooltip__body ul{
                    list-style-type: disc !important;
                }
                .showUlBullets ol, .slds-tooltip__body ol{
                    list-style-type: decimal !important;
                }
                .slds-tooltip__body ul, .slds-tooltip__body ol{
                    padding-left: 15px !important;
                }
                /*TO DISPLAY STICKY NOTE FULLY */
                .slds-tooltip__body{
                    /*white-space: normal !important;*/
                }
                .slds-tooltip{
                    /*width: auto !important;*/
                    
                }
                #selectPlaybookModal .slds-modal__container{
                    height: auto !important;
                }
                .slds-modal__container{
                    height: auto !important;
                }
                .showUlBullets ul {
                    margin-left: 25px;
                }
                
                .slds .slds-tooltip {
                    max-width: 350px;
                    min-height: 40px;
                }
          </style>
            <apex:form id=""frm"">
                <apex:actionRegion >
                    <apex:actionStatus id=""one1"" >
                        <apex:facet name=""start""> 
                            <apex:outputPanel id=""tstpopup""> 
                                <apex:outputPanel styleClass=""popupBackground"" layout=""block"" style=""width:100%""/> 
                                <apex:outputPanel styleClass=""custPopup"" layout=""block""> 
                                    <div class=""slds-spinner--medium"">
                                        <img src=""{!URLFOR($Resource.slds, 'assets/images/spinners/slds_spinner_brand.gif')}"" alt=""Loading..."" style=""margin-top:150%""/>
                                    </div>
                                </apex:outputPanel> 
                             </apex:outputPanel> 
                        </apex:facet> 
                    </apex:actionStatus>
                    <apex:actionFunction name=""init"" action=""{!init}"" rerender=""mainDiv"" status=""one1"" oncomplete=""onCompleteTasks('{!errorMsg}')"" >
                        <apex:param assignTo=""{!availableRecordTypeStages}"" name=""recTStage"" value=""""/>
                    </apex:actionFunction>
                    <apex:actionFunction name=""main"" action=""{!main}"" rerender=""mainDiv"" status=""one1""  oncomplete=""onCompleteTasks('{!errorMsg}');"">
                        <apex:param assignTo=""{!selectedStage}"" name=""selS"" value=""""/>
                    </apex:actionFunction>
                    <apex:actionFunction name=""bulkInsertion"" action=""{!playbookBulkInsertion}"" rerender=""mainDiv"" status=""one1""  oncomplete=""onCompleteTasks('{!errorMsg}');"">
                        <apex:param assignTo=""{!selectedPlaybookID}"" name=""Pera1"" value=""""/>
                    </apex:actionFunction>
                    <apex:actionFunction name=""saveCallManagementChanges"" action=""{!saveCallManagementChanges}"" rerender=""callManagementDiv"" status=""cMStatus"" oncomplete=""onCompleteTasks('{!errorMsg}'); expandAfterSave();""/>
                    <apex:actionFunction name=""updateQuestionNote"" action=""{!updateQuestionNote}"" rerender=""callManagementDiv"" status=""cMStatus"" oncomplete=""onCompleteTasks('{!errorMsg}'); expandAfterSave();""/>
                    
                    <c:Lightning_Lookup /><!-- it will include SOAP API files also -->
                    <script>
                        //SCRIPT TO GET AVAILABLE STAGES RELATED TO PERTICULAR RECORD TYPE
                        var availableStageStr = '';
                        if('{!currentRecordTypeId}' != null && '{!currentRecordTypeId}'.trim().length > 14){
                            var result = sforce.connection.describeLayout('Lead', new Array('{!currentRecordTypeId}'));
                            var res = result.getArray('recordTypeMappings')[0].picklistsForRecordType;
                                
                            for(var index=0; index<res.length; index++ ){
                                if(res[index].picklistName == 'Status'){
                                    for(var j = 0; j < res[index].picklistValues.length; j++){
                                        if(res[index].picklistValues[j].active){
                                            availableStageStr += res[index].picklistValues[j].value + '___';        
                                            //console.log(availableStageStr);
                                        }
                                    }
                                    
                                }                                  
                            }
                        }
                        
                        $('[id$=one1]').show();
                       // alert('{!currentRecordTypeId}');
                        
                    </script>
                    <apex:outputPanel id=""mainDiv"">
                         <!-- To show error notification while saving-->
                          <div class=""slds-notify_container NotificationBox"" style=""display : none;"">
                              <div class=""slds-notify slds-notify--alert slds-theme--error slds-theme--alert-texture"" role=""alert"">
                                <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close"" onclick=""$('.NotificationBox').slideUp(400);"">
                                  <c:SVGComponent styleClass=""slds-button__icon"" path=""assets/icons/utility-sprite/svg/symbols.svg#close""/>
                                  <span class=""slds-assistive-text"">Close</span>
                                </a>
                                <span class=""slds-assistive-text"">Error</span>
                                <h2>
                                  <c:SVGComponent styleClass=""slds-icon icon-text-email slds-icon--small slds-m-right--x-small"" path=""assets/icons/utility-sprite/svg/symbols.svg#ban""/>
                                  <span class=""NotificationBoxText""></span> 
                                </h2>
                              </div>
                          </div>
                        <apex:outputpanel rendered=""{!processInsList.size == 0 && showSelectPlaybook}"">
                            <div class=""slds-grid"">
                                <div class=""slds-col"">
                                    <div class=""slds-text-align--left"">
                                        <a id=""selectPlaybook"" href=""javascript:void(0)"" class=""slds-button slds-button--brand"" data-aljs=""modal"" data-aljs-show=""selectPlaybookModal"" >Select Playbook</a>
                                    </div>
                                </div>
                            </div>
                        </apex:outputpanel>
                           
                        <apex:outputpanel rendered=""{!processInsList.size > 0}"">
                              <apex:inputHidden id=""currStage"" value=""{!selectedStage}""/>
                              <apex:variable value=""{!if(leadObj.Status != null ,true,false)}"" var=""statusFlag""/>
                              <!-- Stage Bar start -->
                              <div class=""slds-grid slds-wrap"">
                                <div class=""stageBarCol1 slds-size--12-of-12 slds-m-top--small"">
                                    <div class=""slds-scrollable--x"">
                                    <div class=""slds-tabs--path"" role=""application tablist"">
                                        <ul class=""slds-tabs--path__nav"" role=""presentation"">
                                          <apex:repeat value=""{!leadStatusList}"" var=""s"">
                                              <li class=""slds-tabs--path__item {!if(currentStatusExist , if(leadStatusMap[s] > leadStatusMap[selectedStage],'slds-is-incomplete',if(leadStatusMap[s] == leadStatusMap[selectedStage],'slds-is-current','slds-is-complete')),'slds-is-incomplete')}"" role=""presentation"">
                                                <a class=""slds-tabs--path__link"" aria-selected=""false"" tabindex=""-1"" role=""tab"" href=""#void"" aria-live=""assertive""  onclick=""$('.slds-tabs--path__item').removeClass('slds-is-active');$(this).parent().addClass('slds-is-active');$('.markStageBtn').css('background','#16325C');main('{!s}'); return false;"">
                                                  <span class=""slds-tabs--path__stage""><!-- $(this).parent().next('::before').css('background','#000');"" -->
                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--x-small"" path=""/assets/icons/utility-sprite/svg/symbols.svg#check""/>
                                                  </span>
                                                  <span class=""slds-tabs--path__title"">{!s} </span>
                                                </a>
                                              </li>
                                          
                                          </apex:repeat>
                                        </ul>
                                    </div>
                                    </div>
                                </div>
                              </div>
                              <!-- Stage Bar End -->
                              <div class=""slds-grid"">
                                  <div class=""slds-col slds-col--padded "">
                                      <div class=""slds-grid"">
                                          <div class=""slds-col slds-col-padded slds-wrap slds-m-top--small"">
                                              <div class=""slds-text-align--center"">
                                                  <a id=""CallManagementBtn"" href=""javascript:void(0)"" class=""slds-m-top--small slds-button slds-button--brand"" onclick=""changeTab(this.id); enaDisSaveBtn({!CMDMdlList.size == 0 && CMAMdlList.size == 0} , 'CMSaveBtn');"" style=""background:#00599c !important;border:1px solid #215968"">Call Management</a>
                                                  <a id=""SalesToolsBtn"" href=""javascript:void(0)"" class=""slds-m-top--small slds-button slds-button--brand"" onclick=""changeTab(this.id);"">Sales Tools</a>
                                                  <a id=""SalesTrainingBtn"" href=""javascript:void(0)"" class=""slds-m-top--small slds-button slds-button--brand"" onclick=""changeTab(this.id);"">Sales Training</a>
                                                  
                                                  <!--
                                                      <a style=""float:right; margin-right:30px;"" id=""ExportDealSummary"" data-aljs=""modal"" data-aljs-show=""ExportDocPrompt"" class=""slds-m-top--small slds-button slds-button--neutral"" href=""javascript:void(0)"" title=""Export Deal Summary"">
                                                          <c:SVGComponent styleClass=""slds-button__icon--stateful"" path=""/assets/icons/utility-sprite/svg/symbols.svg#download""/>
                                                      </a>
                                                  -->
                                              </div>
                                          </div>
                                      </div>
                                      
                                      <!--CM -->
                                      <div id=""CallManagement""  class=""slds-m-top--large slds-m-horizontal--medium"">
                                         
                                          <apex:actionStatus id=""cMStatus"" >
                                            <apex:facet name=""start""> 
                                             <apex:outputPanel id=""tstpopupCM""> 
                                                <apex:outputPanel styleClass=""popupBackground"" layout=""block"" style=""width:100%""/> 
                                                <apex:outputPanel styleClass=""custPopup"" layout=""block""> 
                                                    <div class=""slds-spinner--medium"">
                                                        <img src=""{!URLFOR($Resource.slds, 'assets/images/spinners/slds_spinner_brand.gif')}"" alt=""Loading..."" style=""margin-top:150%""/>
                                                    </div>
                                                </apex:outputPanel> 
                                             </apex:outputPanel> 
                                            </apex:facet> 
                                          </apex:actionStatus>
                                          
                                          <apex:outputPanel id=""callManagementDiv"">
                                          
                                              <apex:inputHidden id=""callDisHidden"" value=""{!expandClassDisStr}""/>
                                              <apex:inputHidden id=""callAssHidden"" value=""{!expandClassAssStr}""/>
                                              <apex:inputHidden id=""questionIdForNote"" value=""{!questionIdForNote}""/>
                                          
                                              <div class=""slds-grid slds-wrap"">
                                                  <div class=""slds-size--12-of-12"">
                                                      <div class=""slds-grid slds-wrap"">
                                                          <div class=""slds-size--12-of-12 slds-m-bottom--large"">
                                                              <div class=""slds-text-align--center"">
                                                                  <apex:commandButton styleclass=""CMSaveBtn slds-button slds-button--brand slds-m-top--large slds-float--right saveButton"" onclick=""saveCallManagementChanges() ; return false;"" value=""Save"" />
                                                              </div>    
                                                          </div>
                                                      </div>                                                      
                                                      <!-- CallManagement Discussion -->
                                                      <apex:outputpanel layout=""none"" rendered=""{!CMDMdlList.size > 0}"">
                                                      
                                                          <div class=""slds-grid"">
                                                              <div class=""slds-col"">
                                                          
                                                                  <apex:outputText styleclass=""slds-section-title"" rendered=""{!CMDMdlList.size > 0}""  value=""DISCUSSION"" />
                                                                  <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral slds-button--small slds-float--right"" aria-live=""assertive"" onclick=""collapseToggleAll('quesTblTd','disCollapseText',{!CMDMdlList.size});"" style=""display:{!if(CMDMdlList.size == 0,'none','block')}"">
                                                                        <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                                                                        <span class=""disCollapseText"">Open All</span>
                                                                  </a>
                                                              </div>
                                                          </div>
                                                          <!-- <apex:outputpanel layout=""none"" rendered=""{!CMDMdlList.size == 0}"">
                                                              <p class=""slds-text-body--regular slds-m-top--medium"">No Discussions! </p>
                                                          </apex:outputpanel> -->
                                                          <apex:variable value=""{!0}"" var=""cntCM""/>
                                                                        
                                                          <apex:repeat value=""{!CMDMdlList}"" var=""cmd"">
                                                              <apex:variable value=""{!cntCM + 1}"" var=""cntCM""/>
                                                              
                                                                  <h1 class=""playHeading slds-text-align--center  slds-p-horizontal--x-small slds-m-top--small"" onclick=""$('.quesTblTd{!cntCM}').toggle(250);changeCollapseBtn('quesTblTd','disCollapseText',{!CMDMdlList.size});"" style=""cursor:pointer;background:#558ED5;color:white"">{!cmd.playName}</h1>
                                                                  <!-- Questions start-->
                                                                  <apex:outputPanel layout=""none"" rendered=""{!cmd.qList.size > 0}"">
                                                                  <table class=""slds-table slds-table--bordered"">
                                                                      <!--<thead>
                                                                        <tr class="" slds-text-heading--label"">
                                                                          <th scope=""col"" class=""quesTblTd{!cntCM}"" style=""display:none;width:60%;background:#DBEEF4"">
                                                                            <b>Ask</b>
                                                                          </th>
                                                                          <th scope=""col"" class=""quesTblTd{!cntCM}"" style=""display:none;width:40%"">
                                                                            <b>Response</b>
                                                                          </th>
                                                                        </tr>
                                                                      </thead>-->
                                                                      <tbody>
                                                                        <apex:variable value=""{!0}"" var=""cntDCM""/>
                                                                        <apex:repeat value=""{!cmd.qList }"" var=""q"">
                                                                            <apex:variable value=""{!cntDCM + 1}"" var=""cntDCM""/>
                                                                            <tr class=""slds-hint-parent"">
                                                                                <td class=""quesTblTd{!cntCM} wordWrapClass"" style=""display:none;width:60%;background:#DBEEF4"" >
                                                                                    {!q.qObj.Description__c}
                                                                                    <apex:outputPanel layout=""none"" rendered=""{!q.qObj.Tip__c != null && LEN(q.qObj.Tip__c) > 0}"">
                                                                                        <div style=""float:right"">
                                                                                            <a href=""javascript:void(0)"" class=""slds-theme--shade"" style=""padding:5px;"" data-aljs=""tooltip"" data-aljs-placement=""top"" title=""{!q.qObj.Tip__c}"">Tip</a>
                                                                                        </div>
                                                                                    </apex:outputPanel>
                                                                                            
                                                                                </td>
                                                                                <td class=""quesTblTd{!cntCM} wordWrapClass"" style=""display:none;width:40%;"" onmouseover=""if($('.dCMInput{!cntCM}{!cntDCM}1').css('display') == 'none'){$('.editDCM{!cntCM}{!cntDCM}1').show();}"" onmouseout=""if($('.dCMInput{!cntCM}{!cntDCM}1').css('display') == 'none'){$('.editDCM{!cntCM}{!cntDCM}1').hide();$('.editDCM{!cntCM}{!cntDCM}1').hide();}"">
                                                                                    <table class=""dealSumTd2InnerTbl"">
                                                                                        <tr>
                                                                                        <td class=""wordWrapClass"" style=""width : 93% !important"">
                                                                                            <apex:outputPanel rendered=""{! (q.qObj.ResponseType__c == 'Text' || (q.qObj.ResponseType__c == 'DataMap' && q.datamapStr == 'text'))}"" layout=""none"">
                                                                                                <span class=""dCMText{!cntCM}{!cntDCM}1"">{!q.text}</span>
                                                                                               
                                                                                                <apex:inputTextArea rendered=""{!(q.qObj.ResponseType__c == 'DataMap' && fieldLengthMap[q.qObj.Name__c] > 500) || q.qObj.ResponseType__c != 'DataMap'}"" value=""{!q.text}"" styleClass=""dCMInput{!cntCM}{!cntDCM}1 slds-textarea"" style=""display:none;width:100%""/>
                                                                                                <apex:inputText maxlength=""{!fieldLengthMap[q.qObj.Name__c]}""  rendered=""{!(q.qObj.ResponseType__c == 'DataMap' && fieldLengthMap[q.qObj.Name__c] < 500)}"" value=""{!q.text}"" styleClass=""dCMInput{!cntCM}{!cntDCM}1 slds-textarea"" style=""display:none;width:100%""/>
                                                                                                <a href=""javascript:void(0)"" class=""editDCM{!cntCM}{!cntDCM}1 "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.dCMInput{!cntCM}{!cntDCM}1').show();$('.dCMText{!cntCM}{!cntDCM}1').hide();expandClassDis += 'quesTblTd{!cntCM};';"" style=""display:none;"">
                                                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                                </a>
                                                                                     
                                                                                            </apex:outputPanel>
                                                                                            
                                                                                            <apex:outputPanel rendered=""{! (q.qObj.ResponseType__c == 'Number' || q.qObj.ResponseType__c == 'Amount' ||(q.qObj.ResponseType__c == 'DataMap' && q.datamapStr == 'decimal'))}"" layout=""none"">
                                                                                                <span class=""dCMText{!cntCM}{!cntDCM}1"">{!if(q.qObj.ResponseType__c == 'Amount' && q.text != null && LEN(TRIM(q.text)) > 0, '$','')}</span><span class=""dCMText{!cntCM}{!cntDCM}1 applyThousandSeprator"">{!q.text}</span>
                                                                                                <apex:inputText maxlength=""{!if(q.qObj.ResponseType__c == 'DataMap', fieldLengthMap[q.qObj.Name__c], 100)}"" value=""{!q.text}"" styleClass=""dCMInput{!cntCM}{!cntDCM}1 slds-input "" style=""display:none;width:100%"" html-onpaste=""allowNumbersOnly(event,this);"" onkeyup=""allowNumbersOnly(event,this);""/>
                                                                                                <a href=""javascript:void(0)"" class=""editDCM{!cntCM}{!cntDCM}1 "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.dCMInput{!cntCM}{!cntDCM}1').show();$('.dCMText{!cntCM}{!cntDCM}1').hide();expandClassDis += 'quesTblTd{!cntCM};';"" style=""display:none;"">
                                                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                                </a>
                                                                                            </apex:outputPanel>
                                                                                            <apex:outputPanel rendered=""{! (q.qObj.ResponseType__c == 'Percent')}"" layout=""none"">
                                                                                                <span class=""dCMText{!cntCM}{!cntDCM}1"">{!q.text}{!if(q.text != NULL && LEN(TRIM(q.text)) > 0, '%','')}</span>
                                                                                                <apex:inputText value=""{!q.text}"" styleClass=""dCMInput{!cntCM}{!cntDCM}1 slds-input"" style=""display:none;width:100%"" html-onpaste=""allowPercentOnly(event,this);"" onkeyup=""allowPercentOnly(event,this);"" onblur=""if($(this).length > 0) validatePercent($(this).val(),this);""/>
                                                                                                <a href=""javascript:void(0)"" class=""editDCM{!cntCM}{!cntDCM}1 "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.dCMInput{!cntCM}{!cntDCM}1').show();$('.dCMText{!cntCM}{!cntDCM}1').hide();expandClassDis += 'quesTblTd{!cntCM};';"" style=""display:none;"">
                                                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                                </a>
                                                                                            </apex:outputPanel>
                                                                                            <apex:outputPanel rendered=""{! (q.qObj.ResponseType__c == 'Date' || (q.qObj.ResponseType__c == 'DataMap' && (q.datamapStr == 'date' || q.datamapStr == 'datetime')))}"" layout=""none"">
                                                                                                           <span class=""dCMText{!cntCM}{!cntDCM}1"">{!q.text}</span>
                                                                                                           <div class=""dCMInput{!cntCM}{!cntDCM}1 slds-form-element"" style=""display:none;width:100%;float:left"">
                                                                                      
                                                                                                               <div class=""slds-form-element__control slds-input-has-icon slds-input-has-icon--right"">
                                                                                                                    <c:SVGComponent styleClass=""slds-input__icon slds-icon-text-default""  path=""assets/icons/utility-sprite/svg/symbols.svg#event"" clickOperation=""""/>
                                                                                                                    <apex:inputText value=""{!q.text}"" styleClass=""dt slds-input"" html-placeholder=""Pick a date""/>
                                                                                                               </div>
                                                                                                           </div>
                                                                                                           <a href=""javascript:void(0)"" class=""editDCM{!cntCM}{!cntDCM}1 "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.dCMInput{!cntCM}{!cntDCM}1').show();$('.dCMText{!cntCM}{!cntDCM}1').hide();expandClassDis += 'quesTblTd{!cntCM};';"" style=""display:none;"">
                                                                                                               <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                                           </a>
                                                                                                
                                                                                            </apex:outputPanel>
                                                                                            
                                                                                            
                                                                                            <apex:outputPanel rendered=""{!q.qObj.ResponseType__c == 'Checkbox' || (q.qObj.ResponseType__c == 'DataMap' &&  q.datamapStr == 'checkbox')}"" layout=""none"">
                                                                                                <div class=""slds-form-element__control"">
                                                                                                     <label class=""slds-checkbox"">
                                                                                                         <apex:inputCheckbox value=""{!q.check}"" onchange=""expandClassDis += 'quesTblTd{!cntCM};';""/>
                                                                                                         <span class=""slds-checkbox--faux""></span>
                                                                                                     </label> 
                                                                                                 </div>
                                                                                             
                                                                                            </apex:outputPanel>
                                                                                            <apex:outputPanel rendered=""{!q.qObj.ResponseType__c == 'SingleChoice' || (q.qObj.ResponseType__c == 'DataMap' &&  q.datamapStr == 'singlechoice')}"" layout=""none"">
                                                                                                <span class=""dCMText{!cntCM}{!cntDCM}1"" style=""{!if(q.selectedSChoiceRedFlag, 'Color: Red;', '')}"">{!q.selectedSChoice}</span>
                                                                                                <apex:selectList value=""{!q.selectedSChoice}"" size=""1"" styleClass=""dCMInput{!cntCM}{!cntDCM}1 slds-select"" style=""display:none;width:100%"">
                                                                                                    <apex:selectoption itemValue="""" itemLabel=""None""/>
                                                                                                    <apex:selectoptions value=""{!q.choice}""/>
                                                                                                </apex:selectList>
                                                                                                <a href=""javascript:void(0)"" class=""editDCM{!cntCM}{!cntDCM}1 "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.dCMInput{!cntCM}{!cntDCM}1').show();$('.dCMText{!cntCM}{!cntDCM}1').hide();expandClassDis += 'quesTblTd{!cntCM};';"" style=""display:none;"">
                                                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                                </a>
                                                                                            </apex:outputPanel>
                                                                                            
                                                                                            <apex:outputPanel rendered=""{!q.qObj.ResponseType__c == 'Rating'}"" layout=""none"">
                                                                                                        <span class=""dCMText{!cntCM}{!cntDCM}1"">{!q.selectedRating}</span>
                                                                                                        <apex:selectList value=""{!q.selectedRating}"" size=""1"" styleClass=""dCMInput{!cntCM}{!cntDCM}1 slds-select"" style=""display:none;width:100%"">
                                                                                                            <apex:selectoption itemValue="""" itemLabel=""None""/>
                                                                                                            <apex:selectoptions value=""{!q.choice}""/>
                                                                                                        </apex:selectList> 
                                                                                                        <a href=""javascript:void(0)"" class=""editDCM{!cntCM}{!cntDCM}1"" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.dCMInput{!cntCM}{!cntDCM}1').show();$('.dCMText{!cntCM}{!cntDCM}1').hide();expandClassDis += 'quesTblTd{!cntCM};';"" style=""display:none;"">
                                                                                                            <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                                        </a>
                                                                                            </apex:outputPanel>
                                                                                            
                                                                                            <apex:outputPanel rendered=""{!q.qObj.ResponseType__c == 'MultiChoice' || (q.qObj.ResponseType__c == 'DataMap' &&  q.datamapStr == 'multichoice')}"" layout=""none"">
                                                                                                                <!-- <apex:outputPanel styleclass=""D2CMT{!cntCM}{!cntDCM}1"" rendered=""{!q.selectedMChoice.size == 0}"">
                                                                                                                    <ul class="""" style=""float:left"">
                                                                                                                        <li>None</li>
                                                                                                                    </ul>
                                                                                                                </apex:outputPanel>  --> 
                                                                                                                <ul class=""dCMText{!cntCM}{!cntDCM}1"" style=""float:left"">
                                                                                                                    <apex:repeat value=""{!q.selectedMChoice}"" var=""str"">
                                                                                                                        <li style=""{!if(q.selectedMChoiceRedFlagMap[str], 'Color: Red;', '')}"">
                                                                                                                            {!str}
                                                                                                                        </li>
                                                                                                                    </apex:repeat>
                                                                                                                </ul>
                                                                                                                <apex:selectList value=""{!q.selectedMChoice}"" size=""3"" multiselect=""true"" styleClass=""dCMInput{!cntCM}{!cntDCM}1 slds-select"" style=""display:none;width:100%"">
                                                                                                                    <apex:selectoptions value=""{!q.choice}""/>
                                                                                                                </apex:selectList>
                                                                                                                <a href=""javascript:void(0)"" class=""editDCM{!cntCM}{!cntDCM}1 "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.dCMInput{!cntCM}{!cntDCM}1').show();$('.dCMText{!cntCM}{!cntDCM}1').hide();$('.D2CMT{!cntCM}{!cntDCM}1').hide();expandClassDis += 'quesTblTd{!cntCM};';"" style=""display:none;"">
                                                                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                                                </a>
                                                                                                                                                                                      
                                                                                            </apex:outputPanel>
                                                                                        </td>
                                                                                        <td style=""width : 7% !important"">
                                                                                            <div class=""stickyNote"" style=""float:right;"">
                                                                                                <a href=""javascript:void(0)"" class=""stickyNoteAnchor"" onclick=""$('[id$=noteQuestionModal]').modal('show'); manageBackdrop(); $('[id$=createNoteQuestion]').val('{!q.qObj.note__c}');$('[id$=questionIdForNote]').val('{!q.qObj.id}');expandClassDis += 'quesTblTd{!cntCM};';"" data-aljs=""tooltip"" data-aljs-placement=""left"" title=""{!if(q.qObj.note__c == null ,'Note',q.qObj.note__c)}"">
                                                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default {!if(q.qObj.Note__c == null ,'svgLightblue','')}"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#page"" cssStyle=""height:20px;width:20px""/>
                                                                                                </a>
                                                                                            </div>
                                                                                        </td>
                                                                                        </tr>
                                                                                    </table>
                                                                                 </td>
                                                                            </tr>
                                                                        </apex:repeat>
                                                                        
                                                                       </tbody>
                                                                  </table>
                                                                  </apex:outputPanel>
                                                                  <!-- question end -->
                                                                  
                                                                  <!-- Message Start -->
                                                                  <apex:outputPanel layout=""none"" rendered=""{!cmd.msgList.size > 0}"">
                                                                  <table class=""slds-table slds-table--bordered"">
                                                                      <tbody>
                                                                        <apex:repeat value=""{!cmd.msgList }"" var=""m"">
                                                                            <tr class=""slds-hint-parent"">
                                                                                <td class=""quesTblTd{!cntCM}"" style=""display:none;background:#DBEEF4"">
                                                                                    <ul class="""">
                                                                                        <li class=""showUlBullets"">
                                                                                            <apex:outputText style=""white-space: normal;"" value=""{!m.Description__c}""  escape=""false""/>
                                                                                            <apex:outputPanel layout=""none"" rendered=""{!m.Tip__c != null && LEN(m.Tip__c) > 0}"">
                                                                                                <div style=""float:right"">
                                                                                                    <a href=""javascript:void(0)"" class=""slds-theme--shade"" style=""padding:5px""  data-aljs=""tooltip"" data-aljs-placement=""top"" title=""{!m.Tip__c}"">Tip</a>
                                                                                                </div>
                                                                                            </apex:outputPanel>
                                                                                        </li>
                                                                                    </ul>
                                                                                </td>
                                                                            </tr>
                                                                        </apex:repeat>
                                                                        
                                                                       </tbody>
                                                                  </table>
                                                                  </apex:outputPanel>
                                                                  <!-- Message End -->
                                                                  
                                                                  <!-- CMD Tool Start -->
                                                                  <apex:outputpanel layout=""none"" rendered=""{!cmd.toolList.size > 0}"">
                                                                      <table class=""slds-table slds-table--bordered"">
                                                                          <tbody>
                                                                            <apex:repeat value=""{!cmd.toolList}"" var=""q"">
                                                                                <tr class=""slds-hint-parent"">
                                                                                    <td class=""quesTblTd{!cntCM} wordWrapClass"" style=""display:none;background:#DBEEF4;width:60%;"">
                                                                                        <ul class="""">
                                                                                            <li>
                                                                                                <a href=""{!if(BEGINS(LOWER(q.Link__c),'http://') || BEGINS(LOWER(q.Link__c),'https://'),q.Link__c,'http://' + q.Link__c)}""  target=""_blank"">{!q.Name__c}</a>
                                                                                                <apex:outputPanel layout=""none"" rendered=""{!q.Tip__c != null && LEN(q.Tip__c) > 0}"">
                                                                                                    <div style=""float:right"">
                                                                                                       <a href=""javascript:void(0)"" class=""slds-theme--shade"" style=""padding:5px"" data-aljs=""tooltip"" data-aljs-placement=""top"" title=""{!q.Tip__c}"">Tip</a>
                                                                                                    </div>
                                                                                                </apex:outputPanel>
                                                                                            </li>
                                                                                        </ul>
                                                                                    </td>
                                                                                    <td class=""quesTblTd{!cntCM} wordWrapClass"" style=""display:none;width:40%;"">
                                                                                        <ul class="""">
                                                                                            <li>{!q.Description__c}</li>
                                                                                        </ul>
                                                                                     </td>
                                                                                </tr>
                                                                            </apex:repeat>
                                                                           </tbody>
                                                                      </table>
                                                                  </apex:outputpanel>
                                                                  <!-- CMD Tool End -->
                                                                  <!-- CMD Training Start -->
                                                                  <apex:outputpanel layout=""none"" rendered=""{!cmd.trainingList.size > 0}"">
                                                                      <table class=""slds-table slds-table--bordered"">
                                                                          <tbody>
                                                                            <apex:repeat value=""{!cmd.trainingList}"" var=""q"">
                                                                                <tr class=""slds-hint-parent"">
                                                                                    <td class=""quesTblTd{!cntCM} wordWrapClass"" style=""display:none;background:#DBEEF4;width:60%;"">
                                                                                        <ul class="""">
                                                                                            <li>
                                                                                                <a href=""{!if(BEGINS(LOWER(q.Link__c),'http://') || BEGINS(LOWER(q.Link__c),'https://'),q.Link__c,'http://' + q.Link__c)}""  target=""_blank"">{!q.Name__c}</a>
                                                                                                <apex:outputPanel layout=""none"" rendered=""{!q.Tip__c != null && LEN(q.Tip__c) > 0}"">
                                                                                                    <div style=""float:right"">
                                                                                                       <a href=""javascript:void(0)"" class=""slds-theme--shade"" style=""padding:5px"" data-aljs=""tooltip"" data-aljs-placement=""top"" title=""{!q.Tip__c}"">Tip</a>
                                                                                                    </div>
                                                                                                </apex:outputPanel>
                                                                                            </li>
                                                                                        </ul>
                                                                                    </td>
                                                                                    <td class=""quesTblTd{!cntCM} wordWrapClass"" style=""display:none;width:40%;"">
                                                                                        <ul class="""">
                                                                                            <li>{!q.Description__c}</li>
                                                                                        </ul>
                                                                                     </td>
                                                                                </tr>
                                                                            </apex:repeat>
                                                                           </tbody>
                                                                      </table>
                                                                  </apex:outputpanel>
                                                                  <!-- CMD Tool End -->
                                                          </apex:repeat>
                                                            
                                                      </apex:outputpanel>
                                                      <!-- CallManagement Discussion -->
                                                      
                                                      <!-- CallManagement Assessment -->
                                                      <apex:outputpanel layout=""none"" rendered=""{!CMAMdlList.size > 0}"">
                                                      
                                                          <div class=""slds-grid"">
                                                              <div class=""slds-col slds-m-top--large"">
                                                                  <apex:outputText styleclass=""slds-section-title"" rendered=""{!CMAMdlList.size > 0}"" value=""ASSESSMENT"" />
                                                                  <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral slds-button--small slds-float--right "" aria-live=""assertive"" onclick=""collapseToggleAll('quesTblTdAss','assCollapseText',{!CMAMdlList.size})""  style=""display:{!if(CMAMdlList.size == 0,'none','block')}"">
                                                                        <c:SVGComponent styleClass="" slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                                                                        <span class=""assCollapseText"">Open All</span>
                                                                  </a>
                                                              </div>
                                                          </div>
                                                          
                                                          <!-- <apex:outputpanel layout=""none"" rendered=""{!CMAMdlList.size == 0}"">
                                                              <p class=""slds-text-body--regular slds-m-top--medium"">No Assessments! </p>
                                                          </apex:outputpanel> -->
                                                          <apex:variable value=""{!0}"" var=""cntCM""/>
                                                          
                                                          <apex:repeat value=""{!CMAMdlList}"" var=""cmd"">
                                                              <apex:variable value=""{!cntCM + 1}"" var=""cntCM""/>
                                                                  <h1 class=""playHeading slds-text-align--center slds-p-horizontal--x-small slds-m-top--small""  onclick=""$('.quesTblTdAss{!cntCM}').toggle(250);changeCollapseBtn('quesTblTdAss','assCollapseText',{!CMAMdlList.size});"" style=""cursor:pointer;background:#558ED5;color:white"">{!cmd.playName}</h1>
                                                                  <!-- Questions start-->
                                                                  <apex:outputPanel layout=""none"" rendered=""{!cmd.qList.size > 0}"">
                                                                  <table class=""slds-table slds-table--bordered"">
                                                                      <!-- <thead>
                                                                        <tr class=""slds-text-heading--label"">
                                                                          <th scope=""col"" class=""quesTblTdAss{!cntCM}"" style=""display:none;width:60%;background:#DBEEF4"">
                                                                            <b>Ask</b>
                                                                          </th>
                                                                          <th scope=""col"" class=""quesTblTdAss{!cntCM}"" style=""display:none;width:40%"">
                                                                            <b>Response</b>
                                                                          </th>
                                                                        </tr>
                                                                      </thead> -->
                                                                      <tbody>
                                                                        <apex:variable value=""{!0}"" var=""cntDCM""/>
                                                                        <apex:variable value=""{!0}"" var=""cntACM""/>
                                                                        
                                                                        <apex:repeat value=""{!cmd.qList}"" var=""q"">
                                                                            <apex:variable value=""{! cntDCM + 1}"" var=""cntDCM""/>
                                                                            <apex:variable value=""{! cntACM + 1}"" var=""cntACM""/>
                                                                            <tr class=""slds-hint-parent"">
                                                                                <td class=""quesTblTdAss{!cntCM} wordWrapClass"" style=""display:none;width:60%;background:#DBEEF4"">
                                                                                    <ul class="""">
                                                                                        <li>
                                                                                            {!q.qObj.Description__c}
                                                                                            <apex:outputPanel layout=""none"" rendered=""{!q.qObj.Tip__c != null && LEN(q.qObj.Tip__c) > 0}"">
                                                                                                <div style=""float:right"">
                                                                                                    <a href=""javascript:void(0)"" class=""slds-theme--shade"" style=""padding:5px""  data-aljs=""tooltip"" data-aljs-placement=""top"" title=""{!q.qObj.Tip__c}"">Tip</a>
                                                                                                </div>
                                                                                            </apex:outputPanel>
                                                                                        </li>
                                                                                    </ul>
                                                                                </td>
                                                                                <td class=""quesTblTdAss{!cntCM} wordWrapClass"" style=""display:none;width:40%;""   onmouseover=""if($('.ACMInput{!cntCM}{!cntACM}1').css('display') == 'none'){$('.editACM{!cntCM}{!cntACM}1').show();}"" onmouseout=""if($('.ACMInput{!cntCM}{!cntACM}1').css('display') == 'none'){$('.editACM{!cntCM}{!cntACM}1').hide();$('.editACM{!cntCM}{!cntACM}1').hide();}"">
                                                                                    <table class=""dealSumTd2InnerTbl"">
                                                                                        <tr>
                                                                                        <td class=""wordWrapClass"" style=""width : 93% !important"">
                                                                                            <apex:outputPanel rendered=""{! (q.qObj.ResponseType__c == 'Text' || (q.qObj.ResponseType__c == 'DataMap' && q.datamapStr == 'text'))}"" layout=""none"">
                                                                                                <ul class="""">
                                                                                                       <li>
                                                                                                            <span class=""ACMText{!cntCM}{!cntACM}1"">{!q.text}</span>
                                                                                                            <apex:inputTextArea rendered=""{!(q.qObj.ResponseType__c == 'DataMap' && fieldLengthMap[q.qObj.Name__c] > 500) || q.qObj.ResponseType__c != 'DataMap'}"" value=""{!q.text}"" styleClass=""ACMInput{!cntCM}{!cntACM}1 slds-textarea"" style=""display:none;width:100%""/>
                                                                                                            <apex:inputText maxlength=""{!fieldLengthMap[q.qObj.Name__c]}""  rendered=""{!(q.qObj.ResponseType__c == 'DataMap' && fieldLengthMap[q.qObj.Name__c] < 500)}"" value=""{!q.text}"" styleClass=""ACMInput{!cntCM}{!cntACM}1 slds-textarea"" style=""display:none;width:100%""/>
                                                                                                            <a href=""javascript:void(0)"" class=""editACM{!cntCM}{!cntACM}1 "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.ACMInput{!cntCM}{!cntACM}1').show();$('.ACMText{!cntCM}{!cntACM}1').hide();expandClassAss += 'quesTblTdAss{!cntCM};';"" style=""display:none;"">
                                                                                                               <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                                            </a>
                                                                                                       </li>
                                                                                                    
                                                                                                </ul>
                                                                                            </apex:outputPanel>
                                                                                            
                                                                                            <apex:outputPanel rendered=""{! (q.qObj.ResponseType__c == 'Number' || q.qObj.ResponseType__c == 'Amount' || (q.qObj.ResponseType__c == 'DataMap' && q.datamapStr == 'decimal'))}"" layout=""none"">
                                                                                                <span class=""ACMText{!cntCM}{!cntACM}1"">{!if(q.qObj.ResponseType__c == 'Amount' && q.text != null && LEN(TRIM(q.text)) > 0, '$','')}</span><span class=""ACMText{!cntCM}{!cntACM}1 applyThousandSeprator"">{!q.text}</span>
                                                                                                <apex:inputText maxlength=""{!if(q.qObj.ResponseType__c == 'DataMap', fieldLengthMap[q.qObj.Name__c], 100)}"" value=""{!q.text}"" styleClass=""ACMInput{!cntCM}{!cntACM}1 slds-input "" style=""display:none;width:100%"" html-onpaste=""allowNumbersOnly(event,this);"" onkeyup=""allowNumbersOnly(event,this);""/>
                                                                                                <a href=""javascript:void(0)"" class=""editACM{!cntCM}{!cntACM}1 "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.ACMInput{!cntCM}{!cntACM}1').show();$('.ACMText{!cntCM}{!cntACM}1').hide();expandClassAss += 'quesTblTdAss{!cntCM};';"" style=""display:none;"">
                                                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                                </a>
                                                                                                
                                                                                            </apex:outputPanel>
                                                                                            <apex:outputPanel rendered=""{! (q.qObj.ResponseType__c == 'Percent')}"" layout=""none"">
                                                                                                <span class=""ACMText{!cntCM}{!cntACM}1"">{!q.text}{!if(q.text != NULL && LEN(TRIM(q.text)) > 0, '%','')}</span>
                                                                                                <apex:inputText value=""{!q.text}"" styleClass=""ACMInput{!cntCM}{!cntACM}1 slds-input"" style=""display:none;width:100%"" html-onpaste=""allowPercentOnly(event,this);"" onkeyup=""allowPercentOnly(event,this);"" onblur=""if($(this).length > 0) validatePercent($(this).val(),this);""/>
                                                                                                <a href=""javascript:void(0)"" class=""editACM{!cntCM}{!cntACM}1 "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.ACMInput{!cntCM}{!cntACM}1').show();$('.ACMText{!cntCM}{!cntACM}1').hide();expandClassAss += 'quesTblTdAss{!cntCM};';"" style=""display:none;"">
                                                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                                </a>
                                                                                            </apex:outputPanel>
                                                                                            <apex:outputPanel rendered=""{! (q.qObj.ResponseType__c == 'Date' || (q.qObj.ResponseType__c == 'DataMap' && (q.datamapStr == 'date' || q.datamapStr == 'datetime')))}"" layout=""none"">
                                                                                                <ul class="""">
                                                                                                       <li >
                                                                                                            <span class=""ACMText{!cntCM}{!cntACM}1"">{!q.text}</span>
                                                                                                           <div class=""ACMInput{!cntCM}{!cntACM}1 slds-form-element"" style=""display:none;width:100%;float:left"">
                                                                                      
                                                                                                               <div class=""slds-form-element__control slds-input-has-icon slds-input-has-icon--right"">
                                                                                                                    <c:SVGComponent styleClass=""slds-input__icon slds-icon-text-default""  path=""assets/icons/utility-sprite/svg/symbols.svg#event"" clickOperation=""""/>
                                                                                                                    <apex:inputText value=""{!q.text}"" styleClass=""dt slds-input"" html-placeholder=""Pick a date""/>
                                                                                                               </div>
                                                                                                           </div>
                                                                                                           <a href=""javascript:void(0)"" class=""editACM{!cntCM}{!cntACM}1 "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.ACMInput{!cntCM}{!cntACM}1').show();$('.ACMText{!cntCM}{!cntACM}1').hide();expandClassAss += 'quesTblTdAss{!cntCM};';"" style=""display:none;"">
                                                                                                               <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                                           </a>
                                                                                                       </li>
                                                                                                    
                                                                                                </ul>
                                                                                            </apex:outputPanel>
                                                                                            
                                                                                            
                                                                                            <apex:outputPanel rendered=""{!q.qObj.ResponseType__c == 'Checkbox' || (q.qObj.ResponseType__c == 'DataMap' &&  q.datamapStr == 'checkbox')}"" layout=""none"">
                                                                                                <ul class="""">
                                                                                                    <li>
                                                                                                        <div class=""slds-form-element__control"">
                                                                                                             <label class=""slds-checkbox"">
                                                                                                                 <apex:inputCheckbox value=""{!q.check}"" onchange=""expandClassAss += 'quesTblTdAss{!cntCM};';""/>
                                                                                                                 <span class=""slds-checkbox--faux""></span>
                                                                                                             </label> 
                                                                                                         </div>
                                                                                                     </li>
                                                                                                 </ul>
                                                                                            </apex:outputPanel>
                                                                                            <apex:outputPanel rendered=""{!q.qObj.ResponseType__c == 'SingleChoice' || (q.qObj.ResponseType__c == 'DataMap' &&  q.datamapStr == 'singlechoice')}"" layout=""none"">
                                                                                                <ul class="""">
                                                                                                    <li>
                                                                                                        <span class=""ACMText{!cntCM}{!cntACM}1"" style=""{!if(q.selectedSChoiceRedFlag, 'Color: Red;', '')}"">{!q.selectedSChoice}</span>
                                                                                                        <apex:selectList value=""{!q.selectedSChoice}"" size=""1"" styleClass=""ACMInput{!cntCM}{!cntACM}1 slds-select"" style=""display:none;width:100%"">
                                                                                                            <apex:selectoption itemValue="""" itemLabel=""None""/>
                                                                                                            <apex:selectoptions value=""{!q.choice}""/>
                                                                                                        </apex:selectList>
                                                                                                        <a href=""javascript:void(0)"" class=""editACM{!cntCM}{!cntACM}1 "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.ACMInput{!cntCM}{!cntACM}1').show();$('.ACMText{!cntCM}{!cntACM}1').hide();expandClassAss += 'quesTblTdAss{!cntCM};';"" style=""display:none;"">
                                                                                                            <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                                        </a>
                                                                                                    </li>
                                                                                                    
                                                                                                </ul>
                                                                                            </apex:outputPanel>
                                                                                            
                                                                                            <apex:outputPanel rendered=""{!q.qObj.ResponseType__c == 'Rating'}"" layout=""none"">
                                                                                                <ul class="""">
                                                                                                    <li>
                                                                                                        <span class=""ACMText{!cntCM}{!cntACM}1"">{!q.selectedRating}</span>
                                                                                                        <apex:selectList value=""{!q.selectedRating}"" size=""1"" styleClass=""ACMInput{!cntCM}{!cntACM}1 slds-select"" style=""display:none;width:100%"">
                                                                                                            <apex:selectoption itemValue="""" itemLabel=""None""/>
                                                                                                            <apex:selectoptions value=""{!q.choice}""/>
                                                                                                        </apex:selectList> 
                                                                                                        <a href=""javascript:void(0)"" class=""editACM{!cntCM}{!cntACM}1"" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.ACMInput{!cntCM}{!cntACM}1').show();$('.ACMText{!cntCM}{!cntACM}1').hide();expandClassAss += 'quesTblTdAss{!cntCM};';"" style=""display:none;"">
                                                                                                            <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                                        </a>
                                                                                                    </li>
                                                                                                    
                                                                                                </ul>
                                                                                            </apex:outputPanel>
                                                                                            
                                                                                            <apex:outputPanel rendered=""{!q.qObj.ResponseType__c == 'MultiChoice' || (q.qObj.ResponseType__c == 'DataMap' &&  q.datamapStr == 'multichoice')}"" layout=""none"">
                                                                                                                <!-- <apex:outputPanel styleclass=""D2CMT{!cntCM}{!cntACM}1"" rendered=""{!q.selectedMChoice.size == 0}"">
                                                                                                                    <ul class="""" style=""float:left"">
                                                                                                                        <li>None</li>
                                                                                                                    </ul>
                                                                                                                </apex:outputPanel>   -->
                                                                                                                <ul class="" ACMText{!cntCM}{!cntACM}1"" style=""float:left"">
                                                                                                                    <apex:repeat value=""{!q.selectedMChoice}"" var=""str"">
                                                                                                                        <li style=""{!if(q.selectedMChoiceRedFlagMap[str], 'Color: Red;', '')}"">
                                                                                                                            {!str}
                                                                                                                        </li>
                                                                                                                    </apex:repeat>
                                                                                                                </ul>
                                                                                                                <apex:selectList value=""{!q.selectedMChoice}"" multiselect=""true"" size=""3"" styleClass=""ACMInput{!cntCM}{!cntACM}1 slds-select"" style=""display:none;width:100%"">
                                                                                                                    <apex:selectoptions value=""{!q.choice}""/>
                                                                                                                </apex:selectList>
                                                                                                                <a href=""javascript:void(0)"" class=""editACM{!cntCM}{!cntACM}1 "" onclick=""$(this).parent().parent().parent().css('list-style','none');$(this).hide();$('.ACMInput{!cntCM}{!cntACM}1').show();$('.ACMText{!cntCM}{!cntACM}1').hide();$('.D2CMT{!cntCM}{!cntACM}1').hide();expandClassAss += 'quesTblTdAss{!cntCM};';"" style=""display:none;"">
                                                                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px""/>
                                                                                                                </a>
                                                                                                            
                                                                                              
                                                                                            </apex:outputPanel>
                                                                                        </td>
                                                                                        <td style=""width : 7% !important"">
                                                                                            <div style=""float:right;"">
                                                                                                <a href=""javascript:void(0)"" class=""stickyNoteAnchor"" onclick=""$('[id$=noteQuestionModal]').modal('show'); manageBackdrop(); $('[id$=createNoteQuestion]').val('{!q.qObj.note__c}');$('[id$=questionIdForNote]').val('{!q.qObj.id}');expandClassAss += 'quesTblTdAss{!cntCM};';"" data-aljs=""tooltip"" data-aljs-placement=""left"" title=""{!if(q.qObj.note__c == null ,'Note',q.qObj.note__c)}"">
                                                                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default {!if(q.qObj.Note__c == null ,'svgLightblue','')}"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#page"" cssStyle=""height:20px;width:20px""/>
                                                                                                </a>
                                                                                            </div>
                                                                                        </td>
                                                                                        
                                                                                        </tr>
                                                                                    </table>
                                                                                 </td>
                                                                            </tr>
                                                                        </apex:repeat>
                                                                        
                                                                       </tbody>
                                                                  </table>
                                                                  </apex:outputPanel>
                                                                  <!-- question end -->
                                                                  
                                                                  <!-- Message Start -->
                                                                  <apex:outputPanel layout=""none"" rendered=""{!cmd.msgList.size > 0}"">
                                                                  <table class=""slds-table slds-table--bordered"">
                                                                      <tbody>
                                                                        <apex:repeat value=""{!cmd.msgList }"" var=""m"">
                                                                            <tr class=""slds-hint-parent"">
                                                                                <td class=""quesTblTdAss{!cntCM}"" style=""display:none;background:#DBEEF4"">
                                                                                    <ul class="""">
                                                                                        <li class=""showUlBullets"">
                                                                                            <apex:outputText style=""white-space: normal;"" value=""{!m.Description__c}"" escape=""false""/>
                                                                                            <apex:outputPanel layout=""none"" rendered=""{!m.Tip__c != null && LEN(m.Tip__c) > 0}"">
                                                                                                <div style=""float:right"">
                                                                                                    <a href=""javascript:void(0)"" class=""slds-theme--shade"" style=""padding:5px""  data-aljs=""tooltip"" data-aljs-placement=""top"" title=""{!m.Tip__c}"">Tip</a>
                                                                                                </div>
                                                                                            </apex:outputPanel>
                                                                                        </li>
                                                                                    </ul>
                                                                                </td>
                                                                            </tr>
                                                                        </apex:repeat>
                                                                        
                                                                       </tbody>
                                                                  </table>
                                                                  </apex:outputPanel>
                                                                  <!-- Message End -->
                                                          </apex:repeat>
                                                                      
                                                      </apex:outputpanel>
                                                      <!-- CallManagement Assessment -->
                                                      
                                                      <div class=""slds-grid slds-wrap"">
                                                          <div class=""slds-size--12-of-12"">
                                                              <apex:commandButton styleclass=""CMSaveBtn slds-button slds-button--brand slds-m-top--large slds-float--right saveButton"" onclick=""saveCallManagementChanges() ; return false;"" value=""Save"" />
                                                          </div>
                                                      </div>
                                                  </div>
                                              </div>
                                          </apex:outputPanel>      
                                      </div>
                                      
                                      <!--CM -->
                                      
                                      <!--Tools-->
                                      <!-- ### Tools ### -->
                                      <div id=""SalesTools"" style=""display:none""  class=""slds-m-top--large"">
                                          <apex:variable value=""{!1}"" var=""cntST""/>
                                          <div class=""slds-grid slds-wrap"">
                                              <div class=""slds-size--12-of-12"">
                                                  <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral slds-button--small slds-float--right"" aria-live=""assertive"" onclick=""collapseToggleAll('toolTblTd','toolCollapseText',{!sToolSectionCount});"" style=""display:{!if(sToolsGMdlList.size == 0 && sToolsComMdlList.size == 0 && sToolsOMdlList.size == 0 && sToolsPMdlList.size == 0 && sToolsSSMdlList.size == 0, 'none','block')}"">
                                                        <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                                                        <span class=""toolCollapseText"">Open All</span>
                                                  </a>
                                              </div>
                                          </div>
                                          <apex:variable value=""{!0}"" var=""cntST""/>
                                          <!-- Sales Tools General -->
                                          <div class=""slds-grid slds-wrap"">
                                              <div class=""slds-size--12-of-12"">
                                                  <apex:outputpanel layout=""none"" rendered=""{!sToolsGMdlList.size > 0}"">
                                                      <apex:variable value=""{!cntST + 1}"" var=""cntST""/>
                                                      <h1 class=""playHeading slds-text-align--center slds-p-horizontal--x-small slds-m-top--large"" onclick=""$('.toolTblTd{!cntST}').toggle(250);changeCollapseBtn('toolTblTd','toolCollapseText',{!sToolSectionCount});"" style=""cursor:pointer;background:#558ED5;color:white"">General</h1>
                                                      <table class=""slds-table slds-table--bordered"">
                                                          <tbody>
                                                            <apex:repeat value=""{!sToolsGMdlList}"" var=""q"">
                                                                <tr class=""slds-hint-parent"">
                                                                    <td class=""toolTblTd{!cntST} wordWrapClass"" style=""display:none;background:#DBEEF4;width:40%;"">
                                                                        <ul class="""">
                                                                            <li>
                                                                                <a href=""{!if(BEGINS(LOWER(q.Link__c),'http://') || BEGINS(LOWER(q.Link__c),'https://'),q.Link__c,'http://' + q.Link__c)}""  target=""_blank"">{!q.Name__c}</a>
                                                                                <apex:outputPanel layout=""none"" rendered=""{!q.Tip__c != null && LEN(q.Tip__c) > 0}"">
                                                                                    <div style=""float:right"">
                                                                                       <a href=""javascript:void(0)"" class=""slds-theme--shade"" style=""padding:5px"" data-aljs=""tooltip"" data-aljs-placement=""top"" title=""{!q.Tip__c}"">Tip</a>
                                                                                    </div>
                                                                                </apex:outputPanel>
                                                                            </li>
                                                                        </ul>
                                                                    </td>
                                                                    <td class=""toolTblTd{!cntST} wordWrapClass"" style=""display:none;width:60%;"">
                                                                        <ul class="""">
                                                                            <li>{!q.Description__c}</li>
                                                                        </ul>
                                                                     </td>
                                                                </tr>
                                                            </apex:repeat>
                                                           </tbody>
                                                      </table>
                                                  </apex:outputpanel>
                                              </div>
                                          </div>
                                          <!-- Sales Tools General -->
                                          <!-- Sales Tools Success Stories -->
                                          <div class=""slds-grid slds-wrap"">
                                              <div class=""slds-size--12-of-12"">
                                                  <apex:outputpanel layout=""none"" rendered=""{!sToolsSSMdlList.size > 0}"">
                                                      <apex:variable value=""{!cntST + 1}"" var=""cntST""/>
                                                      <h1 class=""playHeading slds-text-align--center slds-p-horizontal--x-small slds-m-top--large"" onclick=""$('.toolTblTd{!cntST}').toggle(250);changeCollapseBtn('toolTblTd','toolCollapseText', {!sToolSectionCount});"" style=""cursor:pointer;background:#558ED5;color:white"">Success Stories</h1>
                                                       <table class=""slds-table slds-table--bordered"">
                                                           <tbody>
                                                             <apex:repeat value=""{!sToolsSSMdlList}"" var=""q"">
                                                                 <tr class=""slds-hint-parent"">
                                                                     <td class=""toolTblTd{!cntST} wordWrapClass"" style=""display:none;background:#DBEEF4;width:40%;"">
                                                                         <ul class="""">
                                                                             <li>
                                                                                 <a href=""{!if(BEGINS(LOWER(q.Link__c),'http://') || BEGINS(LOWER(q.Link__c),'https://'),q.Link__c,'http://' + q.Link__c)}""  target=""_blank"">{!q.Name__c}</a>
                                                                                 <apex:outputPanel layout=""none"" rendered=""{!q.Tip__c != null && LEN(q.Tip__c) > 0}"">
                                                                                     <div style=""float:right"">
                                                                                        <div style=""float:right"">
                                                                                            <a href=""javascript:void(0)"" class=""slds-theme--shade"" style=""padding:5px"" data-aljs=""tooltip"" data-aljs-placement=""top"" title=""{!q.Tip__c}"">Tip</a>
                                                                                        </div>
                                                                                     </div>
                                                                                 </apex:outputPanel>
                                                                             </li>
                                                                         </ul>
                                                                     </td>
                                                                     <td class=""toolTblTd{!cntST} wordWrapClass"" style=""display:none;width:60%;"">
                                                                         <ul class="""">
                                                                             <li>{!q.Description__c}</li>
                                                                         </ul>
                                                                      </td>
                                                                 </tr>
                                                             </apex:repeat>
                                                            </tbody>
                                                       </table>
                                                  </apex:outputpanel>
                                              </div>
                                          </div>
                                          <!-- Sales Tools Success Stories -->
                                          
                                          <!-- Sales Tools Objections Handling -->
                                          <div class=""slds-grid slds-wrap"">
                                              <div class=""slds-size--12-of-12"">
                                                  <apex:outputpanel layout=""none"" rendered=""{!sToolsOMdlList.size > 0}"">
                                                      <apex:variable value=""{!cntST + 1}"" var=""cntST""/>
                                                      <h1 class=""playHeading slds-text-align--center slds-p-horizontal--x-small slds-m-top--large"" onclick=""$('.toolTblTd{!cntST}').toggle(250);changeCollapseBtn('toolTblTd','toolCollapseText', {!sToolSectionCount});"" style=""cursor:pointer;background:#558ED5;color:white"">Objection-Handling</h1>
                                                       <table class=""slds-table slds-table--bordered"">
                                                           <tbody>
                                                             <apex:repeat value=""{!sToolsOMdlList}"" var=""q"">
                                                                 <tr class=""slds-hint-parent"">
                                                                     <td class=""toolTblTd{!cntST} wordWrapClass"" style=""display:none;background:#DBEEF4;width:40%;"">
                                                                         <ul class="""">
                                                                             <li>
                                                                                 <a href=""{!if(BEGINS(LOWER(q.Link__c),'http://') || BEGINS(LOWER(q.Link__c),'https://'),q.Link__c,'http://' + q.Link__c)}""  target=""_blank"">{!q.Name__c}</a>
                                                                                 <apex:outputPanel layout=""none"" rendered=""{!q.Tip__c != null && LEN(q.Tip__c) > 0}"">
                                                                                     <div style=""float:right"">
                                                                                        <div style=""float:right"">
                                                                                            <a href=""javascript:void(0)"" class=""slds-theme--shade"" style=""padding:5px"" data-aljs=""tooltip"" data-aljs-placement=""top"" title=""{!q.Tip__c}"">Tip</a>
                                                                                        </div>
                                                                                     </div>
                                                                                 </apex:outputPanel>
                                                                             </li>
                                                                         </ul>
                                                                     </td>
                                                                     <td class=""toolTblTd{!cntST} wordWrapClass"" style=""display:none;width:60%;"">
                                                                         <ul class="""">
                                                                             <li>{!q.Description__c}</li>
                                                                         </ul>
                                                                      </td>
                                                                 </tr>
                                                             </apex:repeat>
                                                            </tbody>
                                                       </table>
                                                  </apex:outputpanel>
                                              </div>
                                          </div>
                                          <!-- Sales Tools Objections handling -->
                                          <!-- Sales Tools Competition -->
                                          <div class=""slds-grid slds-wrap"">
                                              <div class=""slds-size--12-of-12"">
                                                  <apex:outputpanel layout=""none"" rendered=""{!sToolsComMdlList.size > 0}"">
                                                      <apex:variable value=""{!cntST + 1}"" var=""cntST""/>
                                                          <h1 class=""playHeading slds-text-align--center slds-p-horizontal--x-small slds-m-top--large"" onclick=""$('.toolTblTd{!cntST}').toggle(250);changeCollapseBtn('toolTblTd','toolCollapseText',{!sToolSectionCount});"" style=""cursor:pointer;background:#558ED5;color:white"">Competition</h1>
                                                          <table class=""slds-table slds-table--bordered"">
                                                             <tbody>
                                                                 <apex:repeat value=""{!sToolsComMdlList}"" var=""q"">
                                                                     <tr class=""slds-hint-parent"">
                                                                         <td class=""toolTblTd{!cntST} wordWrapClass"" style=""display:none;background:#DBEEF4;width:40%;"">
                                                                             <ul class="""">
                                                                                 <li>
                                                                                     <a href=""{!if(BEGINS(LOWER(q.Link__c),'http://') || BEGINS(LOWER(q.Link__c),'https://'),q.Link__c,'http://' + q.Link__c)}""  target=""_blank"">{!q.Name__c}</a>
                                                                                     <apex:outputPanel layout=""none"" rendered=""{!q.Tip__c != null && LEN(q.Tip__c) > 0}"">
                                                                                         <div style=""float:right"">
                                                                                            <a href=""javascript:void(0)"" class=""slds-theme--shade"" style=""padding:5px"" data-aljs=""tooltip"" data-aljs-placement=""top"" title=""{!q.Tip__c}"">Tip</a>
                                                                                         </div>
                                                                                     </apex:outputPanel>
                                                                                 </li>
                                                                             </ul>
                                                                         </td>
                                                                         <td class=""toolTblTd{!cntST} wordWrapClass"" style=""display:none;white-space: normal;width:60%;"">
                                                                             <ul class="""">
                                                                                 <li>{!q.Description__c}</li>
                                                                             </ul>
                                                                          </td>
                                                                     </tr>
                                                                 </apex:repeat>
                                                              </tbody>
                                                          </table>
                                                          
                                                  </apex:outputpanel>
                                              </div>
                                          </div>
                                          <!-- Sales Tools Competition -->
                                          
                                          <!-- Sales Tools Product -->
                                          <div class=""slds-grid slds-wrap"">
                                              <div class=""slds-size--12-of-12"">
                                                  <apex:outputpanel layout=""none"" rendered=""{!sToolsPMdlList.size > 0}"">
                                                      <apex:variable value=""{!cntST + 1}"" var=""cntST""/>
                                                      <h1 class=""playHeading slds-text-align--center slds-p-horizontal--x-small slds-m-top--large"" onclick=""$('.toolTblTd{!cntST}').toggle(250);changeCollapseBtn('toolTblTd','toolCollapseText', {!sToolSectionCount});"" style=""cursor:pointer;background:#558ED5;color:white"">Product</h1>
                                                       <table class=""slds-table slds-table--bordered"">
                                                           <tbody>
                                                             <apex:repeat value=""{!sToolsPMdlList}"" var=""q"">
                                                                 <tr class=""slds-hint-parent"">
                                                                     <td class=""toolTblTd{!cntST} wordWrapClass"" style=""display:none;background:#DBEEF4;width:40%;"">
                                                                         <ul class="""">
                                                                             <li>
                                                                                 <a href=""{!if(BEGINS(LOWER(q.Link__c),'http://') || BEGINS(LOWER(q.Link__c),'https://'),q.Link__c,'http://' + q.Link__c)}""  target=""_blank"">{!q.Name__c}</a>
                                                                                 <apex:outputPanel layout=""none"" rendered=""{!q.Tip__c != null && LEN(q.Tip__c) > 0}"">
                                                                                     <div style=""float:right"">
                                                                                        <div style=""float:right"">
                                                                                            <a href=""javascript:void(0)"" class=""slds-theme--shade"" style=""padding:5px"" data-aljs=""tooltip"" data-aljs-placement=""top"" title=""{!q.Tip__c}"">Tip</a>
                                                                                        </div>
                                                                                     </div>
                                                                                 </apex:outputPanel>
                                                                             </li>
                                                                         </ul>
                                                                     </td>
                                                                     <td class=""toolTblTd{!cntST} wordWrapClass"" style=""display:none;width:60%;"">
                                                                         <ul class="""">
                                                                             <li>{!q.Description__c}</li>
                                                                         </ul>
                                                                      </td>
                                                                 </tr>
                                                             </apex:repeat>
                                                            </tbody>
                                                       </table>
                                                  </apex:outputpanel>
                                              </div>
                                          </div>
                                          <!-- Sales Tools Product -->
                                          
                                      </div>
                                      
                                      <!--Tools-->
                                      
                                      <!--Training -->
                                      <!-- ### Training ### -->
                                      <div id=""SalesTraining"" style=""display:none""  class=""slds-m-top--large"">
                                        
                                          <div class=""slds-grid slds-wrap"">
                                              <div class=""slds-size--12-of-12"">
                                                  <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral slds-button--small slds-float--right"" aria-live=""assertive"" onclick=""collapseToggleAll('trainingTblTd','trainingCollapseText',{!sTrainingSectionCount});"" style=""display:{!if(SuccessStoriesTrainingList.size == 0 && GeneralTrainingList.size == 0 && CompetitionTrainingList.size == 0 && ObjHandTrainingList.size == 0 && IndustryTrainingList.size == 0  && ProductTrainingList.size == 0, 'none','block')}"">
                                                  <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                                                      <span class=""trainingCollapseText"">Open All</span>
                                                  </a>
                                              </div>
                                          </div>
                                          <apex:variable value=""{!0}"" var=""cntST""/>
                                          <!-- Success-Stories -->
                                          <div class=""slds-grid slds-wrap"">
                                              <div class=""slds-size--12-of-12"">                                        
                                                    <apex:outputpanel layout=""none"" rendered=""{!SuccessStoriesTrainingList.size > 0}"">
                                                        <apex:variable value=""{!cntST + 1}"" var=""cntST""/>
