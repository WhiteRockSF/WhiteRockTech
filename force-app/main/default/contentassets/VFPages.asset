                                      <apex:repeat value=""{!trainings}"" var=""training"" id=""existTrainingList"">                                     
                                          <tr class=""slds-hint-parent"" onclick=""rowTrainingId='{!training.Id}'; rowPlayId = parentPlayId;"">        
                                            <td class=""slds-truncate"">{!training.Play__r.Stage__r.Name__c}</td>
                                            <td class=""slds-truncate"">{!training.Name__c}</td>           
