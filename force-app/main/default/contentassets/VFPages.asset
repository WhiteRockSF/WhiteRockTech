                                        <input type=""text"" id=""meetWhoName""/>
                                        <apex:inputHidden id=""meetWhoId"" value=""{!evntMeetInsertObj.whoid}""/>
                                        <div id=""meetWhoDiv""></div>
                                    </div>
                                </div>
                                
                                <div class=""slds-form-element meetstart-sec"">
                                    <label class=""formLabel slds-form-element__label"">Start</label>
                                    <div class=""slds-grid"">
                                        <div class=""slds-size--4-of-12"">
                                            <div class=""slds-form-element__control slds-input-has-icon slds-input-has-icon--right"">
                                                <svg aria-hidden=""true"" class=""slds-input__icon"" >
                                                  <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#event')}""></use>
                                                </svg> 
                                                <input id=""meetStartDate"" type=""Text""  Class=""dt slds-input"" placeholder=""Pick a Date""/>
                                            </div>
                                        </div>
                                        <div class=""slds-size--3-of-12"">
                                            <div class=""slds-form-element__control slds-input-has-icon slds-input-has-icon--right"">
                                                <svg aria-hidden=""true"" class=""meetStartSvg slds-input__icon"">
                                                  <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#clock')}""></use>
