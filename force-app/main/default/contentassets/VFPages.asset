  <html xmlns=""http://www.w3.org/2000/svg"" xmlns:xlink=""http://www.w3.org/1999/xlink"">
  
      <head>
           
          <script>
          
              var assetsLocation = '{!URLFOR($Resource.slds)}';
              $.aljsInit({
                  assetsLocation: assetsLocation,
                  scoped: true
              });
              
              var jHead = jQuery.noConflict();

              jHead(document).ready(function(){
                  jHead('.more-button').click(function(){
                      jHead('.more-list').toggle();
                  });
              });
              
          </script>
          
          <style>
              .slds-dropdown--length-with-icon-10 {
                max-height: calc((1.5rem + 1rem) * 10);
                overflow-y: auto;
                -webkit-overflow-scrolling: touch;
              }
              .slds-active {
                    background-color: #D8DDe9;                  
                    color: #16325c;
              }
          </style>
      </head>
      
      <body class=""slds"">
      
          <!-- Custom header for salesforce clasic mode -->
          <section >
            <div class=""slds-tabs--default"">
                <ul class=""slds-tabs--scoped__nav"" role=""tablist"">
                
                    <apex:variable value=""{!0}"" var=""index""/>
                    <apex:repeat value=""{!tabs}"" var=""tab"">
                        <apex:outputText rendered=""{!IF(index<7, true, false)}"" escape=""false"">
                            <li id=""menu-{!index}"" class=""slds-tabs--default__item slds-text-heading--label"" title=""{!tab.linkname}"" role=""presentation"">
                                <a class=""slds-tabs--default__link"" href=""{!tab.linkurl}"" role=""tab"" tabindex=""-1"" aria-selected=""false"" aria-controls=""tab-default-2"" id=""tab-default-{!index}__item"">
                                    <img src=""{!tab.iconUrl}"" />&nbsp; {!tab.linkname}
                                </a>
                            </li>
                        </apex:outputText>
                        
                         <apex:outputText rendered=""{!IF(index>=7, true, false)}"" escape=""false"">
                         
                            <apex:outputText rendered=""{!IF(index==7, true, false)}"" escape=""false"" value='<li class=""slds-dropdown-trigger slds-dropdown-trigger--click slds-is-open slds-tabs--default__item slds-tabs__item--overflow slds-text-heading--label"" title=""More"" role=""presentation"">
                                    <a class=""slds-tabs--default__link more-button"" href=""javascript:void(0)"" aria-haspopup=""true"">More<span class=""slds-assistive-text"">search results</span>
                                     &#9660;    
                                    </a><div class=""slds-dropdown slds-dropdown--medium slds-dropdown--right slds-dropdown--menu more-list"" style=""display:none"">         
                                  <ul class=""slds-dropdown__list slds-dropdown--length-with-icon-10"" role=""menu"">' />
                                
                                <!-- Set tab as selected using tab name -->    
                                <li id=""menu-{!index}"" class=""slds-dropdown__item {!IF(tab.linkname == 'Opportunity Dashboard' ,'slds-active','')}"" title=""{!tab.linkname}"">
                                  <a href=""{!tab.linkurl}"" role=""menuitem"">                                        
                                      <p class=""slds-truncate"">
                                          <img src=""{!tab.iconUrl}"" /> &nbsp; {!tab.linkname}
                                      </p>
                                  </a>
                                </li>                   
                                        
                            <apex:outputText rendered=""{!IF(index==tabs.size-1, true, false)}"" escape=""false"" value=""</ul></div></li>""/>
                                                        
                        </apex:outputText>
                            
                        <apex:variable value=""{!index+1}"" var=""index""/>                             
                    </apex:repeat>
                  
                </ul>  
             
            </div>
          </section>
          
          
      </body>
      
  </html>
