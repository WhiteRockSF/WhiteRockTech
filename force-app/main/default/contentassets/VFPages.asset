          <apex:actionfunction name=""initializeTool"" action=""{!initializeTool}"" status=""Status"" rerender=""toolModalDiv,contentDiv,toolModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss');$('[id$=toolModal]').modal('show');manageBackdrop();$('.toolMdlHeading').text('New Tool');$('.slds-notify-container').hide();""/>
