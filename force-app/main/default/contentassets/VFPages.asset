                  <!--  create note modal start -->
                  <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""noteModal"">
                        <div class=""slds-modal__container"">
                            <div class=""slds-modal__header"">
