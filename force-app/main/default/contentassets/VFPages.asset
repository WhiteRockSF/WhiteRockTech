                    </div>
                    
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""cloneMessage(rowMessageId); return false"">Select</button>
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=messagePromptModal]').modal('show');manageBackdrop(); return false"">Cancel</button>                     
                    </div>
                </div>
                
            </div>
            <!-- Massage Clone modal end -->
            
            <!-- Tool Clone modal --> 
            <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""clone_tool_modal"">
                <div class=""slds-modal__container"">
                
