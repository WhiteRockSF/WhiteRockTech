          <apex:actionfunction name=""fillModalValuesForEditMessage"" action=""{!fillModalValuesForEditMessage}"" status=""StatusPlayDetail"" rerender=""messageModalDiv,messageModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss');$('[id$=messageModal]').modal('show');manageBackdrop();$('.messageMdlHeading').text('Edit Message');$('.slds-notify-container').hide();fillRichTextArea('{!msgObj.Description__c}',true); initializeInnerPlayDragging()"">
              <apex:param assignTo=""{!messageIdForUpdate}"" name=""mI"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""updateMessage"" action=""{!updateMessage}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();getPlayDetails('{!JSENCODE(playObjIdForUpdate)}'); initializeInnerPlayDragging();""/>
          <apex:actionfunction name=""fillModalValuesForEditTool"" action=""{!fillModalValuesForEditTool}"" status=""StatusPlayDetail"" rerender=""toolModalDiv,contentDiv,toolModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss');$('[id$=toolModal]').modal('show');manageBackdrop();$('.toolMdlHeading').text('Edit Tool');$('.slds-notify-container').hide();"">
              <apex:param assignTo=""{!toolIdForUpdate}"" name=""tI"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""fillModalValuesForEditTraining"" action=""{!fillModalValuesForEditTraining}"" status=""StatusPlayDetail"" rerender=""trainingModalDiv,contentDiv,trainingModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismiss');$('[id$=trainingModal]').modal('show');manageBackdrop();$('.trainingMdlHeading').text('Edit Training');$('.slds-notify-container').hide();"">
              <apex:param assignTo=""{!trainingIdForUpdate}"" name=""trI"" value=""""/>
          </apex:actionfunction>
          
          <apex:actionfunction name=""deleteStage"" action=""{!deleteStage}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();"">
              <apex:param assignTo=""{!deleteId}"" name=""di1"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""deletePlay"" action=""{!deletePlay}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();"">
              <apex:param assignTo=""{!deleteId}"" name=""di2"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""deleteQuestion"" action=""{!deleteQuestion}"" status=""Status"" rerender=""playDetailDiv"" oncomplete=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">
              <apex:param assignTo=""{!deleteId}"" name=""di1"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""deleteMessage"" action=""{!deleteMessage}"" status=""Status"" rerender=""playDetailDiv"" oncomplete=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">
              <apex:param assignTo=""{!deleteId}"" name=""di1"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""deleteTool"" action=""{!deleteTool}"" status=""Status"" rerender=""playDetailDiv"" oncomplete=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">
              <apex:param assignTo=""{!deleteId}"" name=""di1"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""deleteTraining"" action=""{!deleteTraining}"" status=""Status"" rerender=""playDetailDiv"" oncomplete=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">
              <apex:param assignTo=""{!deleteId}"" name=""di1"" value=""""/>
          </apex:actionfunction>
          
          <apex:inputHidden id=""quesIdForEdit"" value=""{!quesObjIdForUpdate}""/>
          <apex:inputHidden id=""msgIdForEdit"" value=""{!msgObjIdForUpdate}""/>
          
          <script>
            //SCRIPT TO GET AVAILABLE STAGES RELATED TO PERTICULAR RECORD TYPE
            var availableStageStr = '';
            if('{!salesPRecordTypeId}' != null && '{!salesPRecordTypeId}'.trim().length > 14){
                <!-- 6th feb to make dynamic according to lead and opportunity-->
                var objectType = '{!processObj.PlaybookEntityType__c}'
                var result;
                
                if(objectType == 'Opportunity')
                    result = sforce.connection.describeLayout('Opportunity', new Array('{!salesPRecordTypeId}'));
                else if(objectType == 'Lead')
                    result = sforce.connection.describeLayout('Lead', new Array('{!salesPRecordTypeId}'));
                    
                
                var res = result.getArray('recordTypeMappings')[0].picklistsForRecordType;
                
                for(var index=0; index<res.length; index++ ){
                  if(res[index].picklistName == 'StageName'){
                    for(var j = 0; j < res[index].picklistValues.length; j++){
                        if(res[index].picklistValues[j].active){
                            availableStageStr += res[index].picklistValues[j].value + '___';        
                            //console.log(availableStageStr);
                        }
                    }
                    
                  }
                  if(res[index].picklistName == 'Status'){
                    for(var j = 0; j < res[index].picklistValues.length; j++){
                        if(res[index].picklistValues[j].active){
                            availableStageStr += res[index].picklistValues[j].value + '___';        
                            //console.log(availableStageStr);
                        }
                    }
                    
                  }
                  if(availableStageStr.length > 0){
                      $('[id$=Status] [id$=start]').show();
                      //fetchAvailableStagesOnly(availableStageStr); return false;
                  }
                }    
                
                //alert('{!salesPRecordTypeId}');
                //alert(availableStageStr);           
            }
            
            function fetchAvailableStageList(recTypeId){
                availableStageStr = '';
                if(recTypeId != null && recTypeId.trim().length > 14){
                    var objectType = '{!processObj.PlaybookEntityType__c}'
                    var result;
                    
                    if(objectType == 'Opportunity')
                        result = sforce.connection.describeLayout('Opportunity', new Array(recTypeId));
                    else if(objectType == 'Lead')
                        result = sforce.connection.describeLayout('Lead', new Array(recTypeId));
                    
                    res = result.getArray('recordTypeMappings')[0].picklistsForRecordType;
                    
                    for(var index=0; index<res.length; index++ ){
                      if(res[index].picklistName == 'StageName'){
                        for(var j = 0; j < res[index].picklistValues.length; j++){
                            if(res[index].picklistValues[j].active){
                                availableStageStr += res[index].picklistValues[j].value + '___';        
                                //console.log(availableStageStr);
                            }
                        }
                        
                      }
                      if(res[index].picklistName == 'Status'){
                        for(var j = 0; j < res[index].picklistValues.length; j++){
                            if(res[index].picklistValues[j].active){
                                availableStageStr += res[index].picklistValues[j].value + '___';        
                                //console.log(availableStageStr);
                            }
                        }
                        
                      }
                      
                    }
                }
               // alert(recTypeId);
                //alert('{!salesPRecordTypeId}');
                $('[id$=Status] [id$=start]').show();
                fetchAvailableStagesOnlyWithoutPopup(availableStageStr); return false;
            }
          </script>                    
          
          <section id=""header"">   
              <apex:outputPanel id=""headerDiv"">
              <apex:actionfunction name=""updateProcess"" action=""{!updateProcess}"" status=""Status"" rerender=""headerDiv, publishmodalTextPanel, deletemodalTextPanel, processModalId"" oncomplete=""fetchAvailableStageList('{!salesPRecordTypeId}');""/>
              <div class=""slds-page-header"" role=""banner"">
                  <div class=""slds-grid slds-p-vertical--small"">
                    <div class=""slds-col slds-has-flexi-truncate"">
                      <p class=""slds-text-heading--label"" style=""text-transform:none"">Playbook</p>
                      <div class=""slds-grid"">
                        <div class=""slds-grid slds-type-focus slds-no-space"">
                            <apex:outputPanel rendered=""{!processObj != null}"">
                                <h1 class=""slds-text-heading--large slds-truncate"" title=""{!processObj.name}"">{!processObj.Name__c}</h1>
                            </apex:outputPanel>
                        </div>
                      </div>
                    </div>
                    <div class=""slds-col slds-no-flex slds-align-bottom"">
                      <div class=""slds-grid"">
                        <div class=""slds-button-group"" role=""group"">
                        
                          <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs=""modal"" data-aljs-show=""processModal"" onclick=""clearModal('processModal');fillModalValuesForEditProcess('{!JSENCODE(processObj.name__c)}','{!JSENCODE(processObj.description__c)}',{!processObj.ProgressThreshold__c});"">Edit</a>
                          <apex:outputPanel layout=""none"" rendered=""{!!processObj.Active__c}"">
                          <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs=""modal"" data-aljs-show=""deleteModal"">Delete</a>
                          </apex:outputPanel>
                          <apex:outputPanel layout=""none"" rendered=""{!processObj.Active__c}"">
                          <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" disabled=""true"">Delete</a>
                          </apex:outputPanel>
                          <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs=""modal"" data-aljs-show=""publishModal"">Publish</a>
                          <a href=""/apex/PlaybooxBuilderDashboard"" class=""slds-button slds-button--neutral"" >Dashboard</a>
                        </div>
                      </div>
                    </div>
                  </div>
              </div>
              </apex:outputPanel>
          </section>
          
          <section id=""stagesAndData"">
              <apex:outputPanel id=""mainDiv"">
              <apex:inputHidden id=""stagesForDuplicate"" value=""{!stagesForDuplicate}""/>
              
              <div class=""slds-grid slds-wrap"">
                  <div class=""slds-size--10-of-12"" style=""border-right:1px solid #d8dde6;"">
                      <apex:outputPanel rendered=""{!stageMdlList.size > 0}"">
                      <div class=""slds-scrollable--x"">
                          <table class=""slds-table slds-table--bordered stage-header"">
                              <tbody>
                                  <tr>
                                      <td colspan=""{!stageMdlList.size}"">
                                          <apex:inputHidden id=""stageIdForEdit"" value=""{!stageObjIdForUpdate}""/>
                                          <div class=""slds-tabs--path"" role=""application tablist"">
                                              <ul class=""slds-tabs--path__nav"" role=""presentation"">
                                                <apex:variable value=""{!0}"" var=""cnt""/>
                                                <apex:repeat value=""{!stageMdlList}"" var=""mList"">
                                                    <apex:variable value=""{!cnt + 1}"" var=""cnt""/>
                                                    <li class=""slds-tabs--path__item slds-is-current"" role=""presentation"" style=""width:270px !important;min-width:270px !important;max-width:270px !important ""  onmouseover=""$(this).css('background-color','#0076DE');$('.editStg{!cnt}').show();$('.stgClose{!cnt}').show();"" onmouseout=""$('.editStg{!cnt}').hide();$('.stgClose{!cnt}').hide();"">
                                                      <a class=""slds-tabs--path__link"" aria-selected=""false"" tabindex=""-1"" role=""tab"" href=""javascript:void(0)"" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""stageModal"" onclick=""clearModal('stageModal');fillModalValuesForEditStage('{!JSENCODE(mList.stgObj.id)}','{!JSENCODE(mList.stgObj.name__c)}','{!JSENCODE(mList.stgObj.description__c)}',{!mList.stgObj.isLibrary__c});"">
                                                        <span class=""slds-tabs--path__title"">{!mList.stgObj.name__c}
                                                           <c:SVGComponent styleClass=""editStg{!cnt} slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px;display:none""/>
                                                        </span>
                                                      </a>
                                                      <apex:outputPanel layout=""none"" rendered=""{!IF(processObj.PlaybookEntityType__c == 'Opportunity', true, false)}"">
                                                          <a href=""javascript:void(0)"" class=""stgClose{!cnt} stageBarClose"" onclick=""event.stopPropagation();$('.deleteMdlHeading').text('Delete Stage');$('[id$=deleteMainModal]').modal('show');manageBackdrop();deletingId = '{!JSENCODE(mList.stgObj.id)}';deleteWhat = 'stage';""  role=""tab"" tabindex=""-1"" style=""display:none"">
                                                            <c:SVGComponent styleClass="" slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""height:20px;width:20px;""/>
                                                          </a>
                                                      </apex:outputPanel>
                                                      <apex:outputPanel layout=""none"" rendered=""{!IF(processObj.PlaybookEntityType__c == 'Lead', true, false)}"">
                                                          <a href=""javascript:void(0)"" class=""stgClose{!cnt} stageBarClose"" onclick=""event.stopPropagation();$('.deleteMdlHeading').text('Delete Status');$('[id$=deleteMainModal]').modal('show');manageBackdrop();deletingId = '{!JSENCODE(mList.stgObj.id)}';deleteWhat = 'stage';""  role=""tab"" tabindex=""-1"" style=""display:none"">
                                                            <c:SVGComponent styleClass="" slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""height:20px;width:20px;""/>
                                                          </a>
                                                      </apex:outputPanel>
                                                    </li>
                                                </apex:repeat>
                                              </ul>
                                           </div>
                                      </td>
                                  </tr>
                                  
                              </tbody>                                        
                          </table>
                          
                          <div id=""examplesDrop"" class=""slds-grid slds-p-left--large"" style=""border-collapse:collapse; border-bottom:1px solid #d8dde6;"">
                              <apex:variable value=""{!0}"" var=""cnt""/>
                              <apex:inputHidden id=""playIdForEdit"" value=""{!playObjIdForUpdate}""/>
                              <apex:repeat value=""{!stageMdlList}"" var=""mList"">
                              <apex:variable value=""{!cnt + 1}"" var=""cnt""/>
                              <div class=""slds-col"" style=""text-align:center;border-left:2px solid #CCC ; border-right:{!if(cnt == stageMdlList.size ,'2px solid #CCC','0px' )} ;width:270px !important;min-width:270px !important;max-width:270px !important;"">
                                  <div class=""slds-scrollable--y"" style=""max-height:595px"">
                                   
                                      <a href=""javascript:void(0)"" class=""add-play-link"" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""playModal"" onclick=""stageIdForInsertedPlay = '{!JSENCODE(mList.stgObj.id)}', playCurStage = '{!JSENCODE(mList.stgObj.Name__c)}'; clearModal('playModal'); "">
                                            <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                                            Add Play
                                      </a>
                                                                           
                                      <ul id=""{!mList.stgObj.id}"" class=""sortable-list slds-list--vertical slds-has-cards--space has-selections"" style=""padding:5px"">
                                          <apex:variable value=""{!0}"" var=""cntInner""/>
                                          <apex:repeat value=""{!mList.pList}"" var=""p"">
                                              <apex:variable value=""{!cntInner + 1}"" var=""cntInner""/>
                                              <li ondblclick=""$('[id$=playDropConfirmPrompt]').modal('dismiss'); parentPlayId = '{!JSENCODE(p.id)}'; $('[id$=playDetailModal]').modal('dismiss');getPlayDetails('{!JSENCODE(p.id)}');return false;$('.playDetailMdlHeading').text('{!p.name__c}');"" id=""{!JSENCODE(p.id)}"" data-stageid=""{!JSENCODE(mList.stgObj.id)}"" class=""sortable-item slds-list__item"" style=""min-height:80px;"" onmouseover=""$(this).addClass('slds-theme--shade');"" onmouseout=""$(this).removeClass('slds-theme--shade');"">
                                                  <div class=""slds-tile slds-tile--board"">
                                                    <table>
                                                        <tr>
                                                            <td style=""width:90%"">
                                                                  <a href=""javascript:void(0)""  data-aljs=""modal"" data-aljs-show=""playModal"" onclick=""playCurStage = '{!JSENCODE(mList.stgObj.Name__c)}';event.stopPropagation();$('[id$=playModal]').modal('dismiss');clearModal('playModal');fillModalValuesForEditPlay('{!JSENCODE(p.id)}','{!JSENCODE(p.name__c)}','{!JSENCODE(p.description__c)}');"" onmouseover=""$('.editPlay{!cnt}{!cntInner}').show();"" onmouseout=""$('.editPlay{!cnt}{!cntInner}').hide();"">{!p.Name__c}
                                                                    <c:SVGComponent styleClass=""editPlay{!cnt}{!cntInner} slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px;display:none""/>
                                                                  </a>
                                                            </td>
                                                            <td  style=""width:10%"">
                                                                  <a href=""javascript:void(0)"" class=""removePlay playClose{!cnt}{!cntInner} slds-float--right"" onclick=""event.stopPropagation();$('.deleteMdlHeading').text('Delete Play');$('[id$=deleteMainModal]').modal('show');manageBackdrop();deletingId = '{!JSENCODE(p.id)}';deleteWhat = 'play';""  role=""tab"" tabindex=""-1"">
                                                                    <c:SVGComponent styleClass="" slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""height:20px;width:20px;""/>
                                                                  </a>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                   
                                                    <div class=""slds-tile__detail"">
                                                      
                                                    </div>
                                                  </div>
                                              </li>
                                          </apex:repeat>
                                      </ul>
                                  </div>
                              </div>
                              </apex:repeat>
                              
                          </div>
                          
                      </div>
                      </apex:outputPanel>
                  </div>
                  <div class=""slds-size--2-of-12"" style=""text-align:center"">
                      <!-- 6th feb To make dynamic according to opportunity or lead -->
