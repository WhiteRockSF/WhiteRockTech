                               getPlayDetailsTwo();
                            } else if (event.type === 'exception') {
                                $('[id$=Status] [id$=start]').hide();
                                //console.log(event.message + ""<br/>\n<pre>"" + event.where + ""</pre>"");                        
                            } else {
                                $('[id$=Status] [id$=start]').hide();
                                //console.log('responseErrors : '+event.message);                        
                            }
                        }, 
                        {escape: true}
                    );
            
                }
                
                function updateToolLocationFunc(toolId, playId, toolOldPosition, toolNewPosition){        
                    $('[id$=Status] [id$=start]').show();
                    Visualforce.remoting.Manager.invokeAction(
                        '{!$RemoteAction.PlaybooxBuilderController.updateToolLocation}',
                        toolId,
                        playId,
                        parseInt(toolOldPosition), 
                        parseInt(toolNewPosition), 
                        function(result, event){
                            if (event.status) {
                               $('[id$=Status] [id$=start]').hide();
                               console.log('Saved successfully!');
                               console.log('result : '+result);
                               getPlayDetailsTwo();
                            } else if (event.type === 'exception') {
                                $('[id$=Status] [id$=start]').hide();
                                //console.log(event.message + ""<br/>\n<pre>"" + event.where + ""</pre>"");                        
                            } else {
                                $('[id$=Status] [id$=start]').hide();
                                //console.log('responseErrors : '+event.message);                        
                            }
                        }, 
                        {escape: true}
                    );
            
                }
                
                function updateTrainingLocationFunc(trainingId, playId, trainingOldPosition, trainingNewPosition){        
                    $('[id$=Status] [id$=start]').show();
                    Visualforce.remoting.Manager.invokeAction(
                        '{!$RemoteAction.PlaybooxBuilderController.updateTrainingLocation}',
                        trainingId,
                        playId,
                        parseInt(trainingOldPosition), 
                        parseInt(trainingNewPosition), 
                        function(result, event){
                            if (event.status) {
                               $('[id$=Status] [id$=start]').hide();
                               console.log('Saved successfully!');
                               console.log('result : '+result);
                               getPlayDetailsTwo();
                            } else if (event.type === 'exception') {
                                $('[id$=Status] [id$=start]').hide();
                                //console.log(event.message + ""<br/>\n<pre>"" + event.where + ""</pre>"");                        
                            } else {
                                $('[id$=Status] [id$=start]').hide();
                                //console.log('responseErrors : '+event.message);                        
                            }
                        }, 
                        {escape: true}
                    );
            
                }
              </script>
          </apex:form>
         </div>
       </body>
      
  </html>   
