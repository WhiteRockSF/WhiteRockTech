"06615000003Ft1wAAC","","PlaybooxBuilderClone","36.0","PlaybooxBuilderClone","","2","PlaybooxBuilderController","false","false","<apex:page controller=""PlaybooxBuilderController""  showHeader=""false"" standardStylesheets=""false"" sidebar=""false"" applyBodyTag=""false"" docType=""html-5.0"" applyHtmlTag=""false"" id=""thePage"">
  <apex:stylesheet value=""{!URLFOR($Resource.slds, 'assets/styles/salesforce-lightning-design-system-vf.css')}"" />
  
  <!--<script src=""https://ajax.googleapis.com/ajax/libs/jquery/1.11.3/jquery.min.js""></script>-->
  
  <script src=""//code.jquery.com/jquery-1.11.3.js""></script>
  <script src=""//code.jquery.com/ui/1.11.4/jquery-ui.js""></script>
    
  <script src=""{!URLFOR($Resource.aljs, 'jquery.aljs-init.min.js')}""></script>
  <script src=""{!URLFOR($Resource.aljs, 'jquery.aljs-modal.min.js')}""></script>
  <script src=""{!URLFOR($Resource.aljs, 'jquery.aljs-tooltip.min.js')}""></script>
  <apex:stylesheet value=""{!URLFOR($Resource.Datatable, 'css/jquery.dataTables.min.css')}""/>
    
  <script src=""{!URLFOR($Resource.Datatable, 'js/jquery.dataTables.min.js')}""></script>
    
  <script>
      
      var currentElement;
      var assetsLocation = '{!URLFOR($Resource.slds)}';
      $.aljsInit({
          assetsLocation: assetsLocation,
          scoped: true
      });
      
      var parentPlayId = '';
  </script>
  
  <html xmlns=""http://www.w3.org/2000/svg"" xmlns:xlink=""http://www.w3.org/1999/xlink"">
      <head>
          <style>
            .custom-scroll {
                -webkit-overflow-scrolling: touch !important;     
                overflow-scrolling: touch !important;     
                max-width: 100% !important;            
                overflow-x: scroll !important;     
            }
              /* jQuery Datatable Style */
              table.dataTable.select tbody tr,
              table.dataTable thead th:first-child {
              cursor: pointer;
              }
              
              table.dataTable tbody tr.selected {
              background-color: #b0bed9 !important;
              }
              
              table.dataTable thead tr th{
                font-weight:bold !important;
              }
              
              table.dataTable.hover tbody tr:hover,
              table.dataTable.display tbody tr:hover{
              background-color: #f5f5f5 !important;
              }
              
              table.dataTable.stripe tbody tr odd selected,
              table.dataTable.display tbody tr:hover{    
              background-color: #abb9d3 !important;
              }
              
              #example_info{float:left !important; margin:10px !important;}
              #example_paginate{float:right !important; margin:10px !important;}
              #example_length{float:left !important; margin:10px !important;}
              #example_filter{float:right !important; margin:10px !important;}
              
              #example1_info{float:left !important; margin:10px !important;}
              #example1_paginate{float:right !important; margin:10px !important;}
              #example1_length{float:left !important; margin:10px !important;}
              #example1_filter{float:right !important; margin:10px !important;}
              
              #example2_info{float:left !important; margin:10px !important;}
              #example2_paginate{float:right !important; margin:10px !important;}
              #example2_length{float:left !important; margin:10px !important;}
              #example2_filter{float:right !important; margin:10px !important;}
              
              /* jQuery Datatable Style End */
              .NewProcessAction{
                    display:block;
                    text-align:center;
                    padding:5px;
                    text-decoration:none !important;
                    color:#505050 !important
              }
              
              .custPopup{
                    left:50%;
                    top:50%;
                    z-index: 9999;
                    position:fixed; 
                    margin-top : -50px;
                    margin-left : -50px;
                    
              } 
                
              .popupBackground{ 
                    background-color:white;
                    opacity: 0.30;
                    filter: alpha(opacity = 30);
                    position:fixed;
                    width: 100%;
                    height: 100%;
                    top: 0;
                    left: 0;
                    z-index: 9998; 
              }
              .slds-is-current:before {
                  background-color: #0076DE !important;
              }
              
              .slds-notify--toast {
                  margin:0px !important;
                  margin-top:8px !important;
                  margin-bottom:8px !important;
                  
              }
              
             .fileUpload {
                position: relative;
                overflow: hidden;
            }
            .fileUpload input.upload {
                position: absolute;
                top: 0;
                right: 0;
                margin: 0;
                padding: 0;
                font-size: 20px;
                cursor: pointer;
                opacity: 0;
                filter: alpha(opacity=0);
            } 
            .slds-backdrop--open {
                opacity: 0.5 !important;
                transition: opacity 0.4s linear 0s;
                visibility: visible;
            }
            .stageBarClose{
                position: absolute !important;
                right: 0 !important;
                top: 0 !important;
                z-index: 9999 !important;
                color: #fff !important;
                text-decoration: none !important;
                font-size: 20px !important;
                padding: 10px !important;
                margin-top: -10px !important;
            }
            
            .add-play-link {
                display: block;
                padding: 20px;
            }
            
            .sortable-item{
                cursor: move !important;
                background: rgb(249,252,247); /* Old browsers */
                background: -moz-linear-gradient(top, rgba(249,252,247,1) 0%, rgba(245,249,240,1) 100%); /* FF3.6-15 */
                background: -webkit-linear-gradient(top, rgba(249,252,247,1) 0%,rgba(245,249,240,1) 100%); /* Chrome10-25,Safari5.1-6 */
                background: linear-gradient(to bottom, rgba(249,252,247,1) 0%,rgba(245,249,240,1) 100%); /* W3C, IE10+, FF16+, Chrome26+, Opera12+, Safari7+ */
                filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#f9fcf7', endColorstr='#f5f9f0',GradientType=0 ); 
            }
          
            .removePlay {
                position:absolute;
                right:0;
                top:0;
            }
            
            .removePlay{ display:none; }
        
            .sortable-item:hover div p .removePlay{ display:block; }
            
          </style>
      </head>
      <body class=""slds"">
          <apex:form id=""frm"">
          <apex:actionRegion >
          <apex:actionStatus id=""Status"" >
            <apex:facet name=""start"">
             <apex:outputPanel id=""tstpopup""> 
                <apex:outputPanel styleClass=""popupBackground"" layout=""block"" style=""width:100%""/> 
                <apex:outputPanel styleClass=""custPopup"" layout=""block""> 
                    <div class=""slds-spinner--medium"">
                        <img src=""{!URLFOR($Resource.slds, 'assets/images/spinners/slds_spinner_brand.gif')}"" alt=""Loading..."" height=""100"" width=""100""/>
                    </div>
                </apex:outputPanel> 
             </apex:outputPanel> 
            </apex:facet> 
          </apex:actionStatus>
          <apex:actionfunction name=""createStage"" action=""{!insertStage}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();""/>
          <apex:actionfunction name=""updateStage"" action=""{!updateStage}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();""/>
          <apex:actionfunction name=""updatePlay"" action=""{!updatePlay}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();""/>
          <apex:actionfunction name=""publish"" action=""{!publishPlaybook}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();$('[id$=publishOkModal]').modal('show');""/>
          <apex:actionfunction name=""updateProcess"" action=""{!updateProcess}"" status=""Status"" rerender=""headerDiv"" oncomplete=""oncompleteTasks();""/>
          
          <apex:actionfunction name=""createPlay"" action=""{!insertPlay}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();"">
              <apex:param assignTo=""{!playParentId}"" name=""ppi"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""getPlayDetails"" action=""{!getPlayDetails}"" status=""Status"" rerender=""mainDiv"" oncomplete=""$('[id$=playDropConfirmPrompt]').modal('dismiss'); oncompleteTasks();dismisAllModal();$('[id$=playDetailModal]').modal('show');$('.playDetailMdlHeading').text('{!playNameForModal}');"">
              <apex:param assignTo=""{!playObjIdForUpdate}"" name=""pi"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""getPlayDetailsTwo"" action=""{!getPlayDetails}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();dismisAllModal();$('[id$=playDetailModal]').modal('show');$('.playDetailMdlHeading').text('{!playNameForModal}');"">
              
          </apex:actionfunction>
          <apex:actionfunction name=""createQuestion"" action=""{!insertQuestion}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();getPlayDetails('{!playObjIdForUpdate}'); return false""/>
          <apex:actionfunction name=""updateQuestion"" action=""{!updateQuestion}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();getPlayDetails('{!playObjIdForUpdate}'); return false""/>
          <apex:actionfunction name=""initializeQuestion"" action=""{!initializeQuestion}"" status=""Status"" rerender=""questionModalDiv"" oncomplete=""$('[id$=playDetailModal]').modal('dismis');$('[id$=questionModal]').modal('show');$('.questionMdlHeading').text('New Question');$('.slds-notify-container').hide();""/>
          
          <!-- Load new questions in exist question div and open. --> 
          <apex:actionfunction name=""loadQuestions"" action=""{!loadQuestions}"" status=""Status"" rerender=""cloneQuestionDiv"" oncomplete=""$('[id$=playDetailModal]').modal('dismis'); $('[id$=clone_question_modal]').modal('show'); $('.slds-notify-container').hide();""/>
          <!-- Load new meassage in exist meassage div and open. --> 
          <apex:actionfunction name=""loadMessages"" action=""{!loadMessages}"" status=""Status"" rerender=""cloneMessageDiv"" oncomplete=""$('[id$=playDetailModal]').modal('dismis'); $('[id$=clone_message_modal]').modal('show'); $('.slds-notify-container').hide();""/>
          <!-- Load new tool in exist tool div and open. --> 
          <apex:actionfunction name=""loadTools"" action=""{!loadTools}"" status=""Status"" rerender=""cloneToolDiv"" oncomplete=""$('[id$=playDetailModal]').modal('dismis'); $('[id$=clone_tool_modal]').modal('show'); $('.slds-notify-container').hide();""/>
          
          <!-- Clone Question Action -->
          <apex:actionfunction name=""cloneQuestion"" action=""{!cloneQuestion}"" status=""Status"" rerender=""cloneQuestionDiv"" oncomplete=""$('[id$=clone_question_modal]').modal('dismiss'); updateQuestion();"">
             <apex:param assignTo=""{!playId}"" value="""" name=""arg1"" />
             <apex:param assignTo=""{!quesId}"" value="""" name=""arg2"" />             
          </apex:actionfunction>
          <!-- Clone Message Action -->
          <apex:actionfunction name=""cloneMessage"" action=""{!cloneMessage}"" status=""Status"" rerender=""cloneMessageDiv"" oncomplete=""$('[id$=clone_message_modal]').modal('dismiss'); updateMessage();"">
             <apex:param assignTo=""{!playId}"" value="""" name=""arg11"" />
             <apex:param assignTo=""{!messageId}"" value="""" name=""arg22"" />             
          </apex:actionfunction>
          <!-- Clone Tool Action -->
          <apex:actionfunction name=""cloneTool"" action=""{!cloneTool}"" status=""Status"" rerender=""cloneToolDiv"" oncomplete=""$('[id$=clone_tool_modal]').modal('dismiss'); updateQuestion();"">
             <apex:param assignTo=""{!playId}"" value="""" name=""arg111"" />
             <apex:param assignTo=""{!toolId}"" value="""" name=""arg222"" />             
          </apex:actionfunction>
          
          <apex:actionfunction name=""initializeMessage"" action=""{!initializeMessage}"" status=""Status"" rerender=""messageModalDiv,messageModalDiv"" oncomplete=""$('[id$=playDetailModal]').modal('dismis');$('[id$=messageModal]').modal('show');$('.messageMdlHeading').text('New Message');$('.slds-notify-container').hide();""/>
          <apex:actionfunction name=""initializeTool"" action=""{!initializeTool}"" status=""Status"" rerender=""toolModalDiv,contentDiv,toolModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismis');$('[id$=toolModal]').modal('show');$('.toolMdlHeading').text('New Tool');$('.slds-notify-container').hide();""/>
          
          <apex:actionfunction name=""createMessage"" action=""{!insertMessage}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();getPlayDetails('{!playObjIdForUpdate}'); return false""/>
          <apex:actionfunction name=""createTool"" action=""{!insertTool}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();getPlayDetails('{!playObjIdForUpdate}'); return false""/>
          <apex:actionfunction name=""showHideAnsContent"" action=""{!showHideAnsContent}"" status=""StatusQuestion"" rerender=""questionModalDiv"" />
          <apex:actionfunction name=""increaseAnswerContent"" action=""{!increaseAnswerContent}"" status=""StatusQuestion"" rerender=""questionModalDiv"" />
          <apex:actionfunction name=""removeAnswerContent"" action=""{!removeAnswerContent}"" status=""StatusQuestion"" rerender=""questionModalDiv"" >
              <apex:param assignTo=""{!removeAnsIndex}"" name=""aI"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""fillModalValuesForEditQuestion"" action=""{!fillModalValuesForEditQuestion}"" status=""StatusPlayDetail"" rerender=""questionModalDiv"" oncomplete=""$('[id$=playDetailModal]').modal('dismis');$('[id$=questionModal]').modal('show');$('.questionMdlHeading').text('Edit Question');$('.slds-notify-container').hide();"">
              <apex:param assignTo=""{!questionIdForUpdate}"" name=""qI"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""fillModalValuesForEditMessage"" action=""{!fillModalValuesForEditMessage}"" status=""StatusPlayDetail"" rerender=""messageModalDiv,messageModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismis');$('[id$=messageModal]').modal('show');$('.messageMdlHeading').text('Edit Message');$('.slds-notify-container').hide();"">
              <apex:param assignTo=""{!messageIdForUpdate}"" name=""mI"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""updateMessage"" action=""{!updateMessage}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();getPlayDetails('{!playObjIdForUpdate}'); return false""/>
          <apex:actionfunction name=""fillModalValuesForEditTool"" action=""{!fillModalValuesForEditTool}"" status=""StatusPlayDetail"" rerender=""toolModalDiv,contentDiv,toolModalDiv2"" oncomplete=""$('[id$=playDetailModal]').modal('dismis');$('[id$=toolModal]').modal('show');$('.toolMdlHeading').text('Edit Tool');$('.slds-notify-container').hide();"">
              <apex:param assignTo=""{!toolIdForUpdate}"" name=""tI"" value=""""/>
          </apex:actionfunction>
          
          <apex:actionfunction name=""deleteStage"" action=""{!deleteStage}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();"">
              <apex:param assignTo=""{!deleteId}"" name=""di1"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""deletePlay"" action=""{!deletePlay}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();"">
              <apex:param assignTo=""{!deleteId}"" name=""di2"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""deleteQuestion"" action=""{!deleteQuestion}"" status=""Status"" rerender=""playDetailDiv"" oncomplete=""$('[id$=playDetailModal]').modal('show');"">
              <apex:param assignTo=""{!deleteId}"" name=""di1"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""deleteMessage"" action=""{!deleteMessage}"" status=""Status"" rerender=""playDetailDiv"" oncomplete=""$('[id$=playDetailModal]').modal('show');"">
              <apex:param assignTo=""{!deleteId}"" name=""di1"" value=""""/>
          </apex:actionfunction>
          <apex:actionfunction name=""deleteTool"" action=""{!deleteTool}"" status=""Status"" rerender=""playDetailDiv"" oncomplete=""$('[id$=playDetailModal]').modal('show');"">
              <apex:param assignTo=""{!deleteId}"" name=""di1"" value=""""/>
          </apex:actionfunction>
          
          <apex:inputHidden id=""quesIdForEdit"" value=""{!quesObjIdForUpdate}""/>
          <apex:inputHidden id=""msgIdForEdit"" value=""{!msgObjIdForUpdate}""/>
                              
          
          <section id=""header"">   
              <apex:outputPanel id=""headerDiv"">
              <div class=""slds-page-header"" role=""banner"">
                  <div class=""slds-grid slds-p-vertical--small"">
                    <div class=""slds-col slds-has-flexi-truncate"">
                      <p class=""slds-text-heading--label"" style=""text-transform:none"">Playbook</p>
                      <div class=""slds-grid"">
                        <div class=""slds-grid slds-type-focus slds-no-space"">
                            <apex:outputPanel rendered=""{!processObj != null}"">
                                <h1 class=""slds-text-heading--large slds-truncate"" title=""{!processObj.name}"">{!processObj.Name__c}</h1>
                            </apex:outputPanel>
                        </div>
                      </div>
                    </div>
                    <div class=""slds-col slds-no-flex slds-align-bottom"">
                      <div class=""slds-grid"">
                        <div class=""slds-button-group"" role=""group"">
                        
                          <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs=""modal"" data-aljs-show=""processModal"" onclick=""clearModal('processModal');fillModalValuesForEditProcess('{!processObj.name__c}','{!processObj.description__c}',{!processObj.ProgressThreshold__c});"">Edit</a>
                          <apex:outputPanel layout=""none"" rendered=""{!processObj.PublishDate__c == null}"">
                          <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs=""modal"" data-aljs-show=""deleteModal"">Delete</a>
                          </apex:outputPanel>
                          <apex:outputPanel layout=""none"" rendered=""{!processObj.PublishDate__c != null}"">
                          <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" disabled=""true"">Delete</a>
                          </apex:outputPanel>
                          <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs=""modal"" data-aljs-show=""publishModal"">Publish</a>
                          <a href=""/apex/PlaybooxBuilderDashboard"" class=""slds-button slds-button--neutral"" >Dashboard</a>
                        </div>
                      </div>
                    </div>
                  </div>
              </div>
              </apex:outputPanel>
          </section>
          
          <section id=""stagesAndData"">
              <apex:outputPanel id=""mainDiv"">
              <apex:inputHidden id=""stagesForDuplicate"" value=""{!stagesForDuplicate}""/>
              
              <div class=""slds-grid slds-wrap"">
                  <div class=""slds-size--10-of-12"" style=""border-right:1px solid #d8dde6;"">
                      <apex:outputPanel rendered=""{!stageMdlList.size > 0}"">
                      <div class=""slds-scrollable--x main-scroll"">
                          <table class=""slds-table slds-table--bordered stage-header"">
                              <tbody>
                                  <tr>
                                      <td colspan=""{!stageMdlList.size}"">
                                          <apex:inputHidden id=""stageIdForEdit"" value=""{!stageObjIdForUpdate}""/>
                                          <div class=""slds-tabs--path"" role=""application tablist"">
                                              <ul class=""slds-tabs--path__nav"" role=""presentation"">
                                                <apex:variable value=""{!0}"" var=""cnt""/>
                                                <apex:repeat value=""{!stageMdlList}"" var=""mList"">
                                                    <apex:variable value=""{!cnt + 1}"" var=""cnt""/>
                                                    <li class=""slds-tabs--path__item slds-is-current"" role=""presentation"" style=""width:270px !important;min-width:270px !important;max-width:270px !important""  onmouseover=""$(this).css('background-color','#0076DE');$('.editStg{!cnt}').show();$('.stgClose{!cnt}').show();"" onmouseout=""$('.editStg{!cnt}').hide();$('.stgClose{!cnt}').hide();"">
                                                      <a class=""slds-tabs--path__link"" aria-selected=""false"" tabindex=""-1"" role=""tab"" href=""javascript:void(0)"" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""stageModal"" onclick=""clearModal('stageModal');fillModalValuesForEditStage('{!mList.stgObj.id}','{!mList.stgObj.name__c}','{!mList.stgObj.description__c}',{!mList.stgObj.isLibrary__c});"">
                                                        <span class=""slds-tabs--path__title"">{!mList.stgObj.name__c}
                                                           <c:SVGComponent styleClass=""editStg{!cnt} slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px;display:none""/>
                                                        </span>
                                                      </a>
                                                      <a href=""javascript:void(0)"" class=""stgClose{!cnt} stageBarClose"" onclick=""event.stopPropagation();$('.deleteMdlHeading').text('Delete Stage');$('[id$=deleteMainModal]').modal('show');deletingId = '{!mList.stgObj.id}';deleteWhat = 'stage';""  role=""tab"" tabindex=""-1"" style=""display:none"">
                                                        <c:SVGComponent styleClass="" slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""height:20px;width:20px;""/>
                                                      </a>
                                                    </li>
                                                </apex:repeat>
                                              </ul>
                                           </div>
                                      </td>
                                  </tr>
                                  
                              </tbody>                                        
                          </table>
                          
                          <div id=""examplesDrop"" class=""slds-grid slds-p-left--large"" style=""border-collapse:collapse; border-bottom:1px solid #d8dde6;"">
                              <apex:variable value=""{!0}"" var=""cnt""/>
                              <apex:inputHidden id=""playIdForEdit"" value=""{!playObjIdForUpdate}""/>
                              <apex:repeat value=""{!stageMdlList}"" var=""mList"">
                              <apex:variable value=""{!cnt + 1}"" var=""cnt""/>
                              <div class=""slds-col"" style=""text-align:center;border-left:2px solid #CCC ; border-right:{!if(cnt == stageMdlList.size ,'2px solid #CCC','0px' )} ;width:270px !important;min-width:270px !important;max-width:270px !important;"">
                                  <div class=""slds-scrollable--y"" style=""max-height:400px"">
                                   
                                      <a href=""javascript:void(0)"" class=""add-play-link"" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""playModal"" onclick=""stageIdForInsertedPlay = '{!mList.stgObj.id}', playCurStage = '{!mList.stgObj.Name__c}'; clearModal('playModal'); "">
                                            <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                                            Add Play
                                      </a>
                                                                           
                                      <ul id=""{!mList.stgObj.id}"" class=""sortable-list slds-list--vertical slds-has-cards--space has-selections"" style=""padding:5px"">
                                          <apex:variable value=""{!0}"" var=""cntInner""/>
                                          <apex:repeat value=""{!mList.pList}"" var=""p"">
                                              <apex:variable value=""{!cntInner + 1}"" var=""cntInner""/>
                                          
                                              <li ondblclick=""$('[id$=playDropConfirmPrompt]').modal('dismiss'); parentPlayId = '{!p.id}'; $('[id$=playDetailModal]').modal('dismiss');getPlayDetails('{!p.id}');return false;$('.playDetailMdlHeading').text('{!p.name__c}');"" id=""{!p.id}"" data-stageid=""{!mList.stgObj.id}"" class=""sortable-item slds-list__item"" style=""min-height:100px;"" onmouseover=""$(this).addClass('slds-theme--shade');"" onmouseout=""$(this).removeClass('slds-theme--shade');"">
                                                  <div class=""slds-tile slds-tile--board"">
                                                    <p class=""slds-tile__title"" style=""text-align:center"" >
                                                     
                                                      <a href=""javascript:void(0)""  data-aljs=""modal"" data-aljs-show=""playModal"" onclick=""playCurStage = '{!mList.stgObj.Name__c}';event.stopPropagation();$('[id$=playModal]').modal('dismiss');clearModal('playModal');fillModalValuesForEditPlay('{!p.id}','{!p.name__c}','{!p.description__c}');"" onmouseover=""$('.editPlay{!cnt}{!cntInner}').show();"" onmouseout=""$('.editPlay{!cnt}{!cntInner}').hide();"">{!p.Name__c}
                                                        <c:SVGComponent styleClass=""editPlay{!cnt}{!cntInner} slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px;display:none""/>
                                                      </a>
                                                      
                                                      <a href=""javascript:void(0)"" class=""removePlay playClose{!cnt}{!cntInner} slds-float--right"" onclick=""event.stopPropagation();$('.deleteMdlHeading').text('Delete Play');$('[id$=deleteMainModal]').modal('show');deletingId = '{!p.id}';deleteWhat = 'play';""  role=""tab"" tabindex=""-1"">
                                                        <c:SVGComponent styleClass="" slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""height:20px;width:20px;""/>
                                                      </a>
                                                      
                                                    </p>
                                                    <div class=""slds-tile__detail"">
                                                      
                                                    </div>
                                                  </div>
                                              </li>
                                          </apex:repeat>
                                      </ul>
                                  </div>
                              </div>
                              </apex:repeat>
                              
                          </div>
                          
                      </div>
                      </apex:outputPanel>
                  </div>
                  <div class=""slds-size--2-of-12"" style=""text-align:center"">
                      <div style=""margin-top:15px"">
                          <a href=""javascript:void(0)"" class="""" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""stageModal"" onclick=""clearModal('stageModal')"">
                                <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                                Add Stage
                          </a>
                      </div>
                  </div>
              </div>
              <!-- Play Detail Modal Start -->
              <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-modal--large  slds-hide"" id=""playDetailModal"">
                    <div class=""slds-modal__container"">
                        <div class=""slds-modal__header"">
                            <h2 class=""slds-text-heading--medium playDetailMdlHeading"">Play Detail</h2>
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-modal__close"" onclick=""$('[id$=playDetailModal]').modal('dismiss');"">
                                <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                                <span class=""slds-assistive-text"">Close</span>
                            </a>
                        </div>
                        <div class=""slds-modal__content"">
                            <apex:actionStatus id=""StatusPlayDetail"" >
                                <apex:facet name=""start"">
                                 <apex:outputPanel id=""tstpopupPlayDetail""> 
                                    <apex:outputPanel styleClass=""popupBackground"" layout=""block"" style=""width:100%""/> 
                                    <apex:outputPanel styleClass=""custPopup"" layout=""block""> 
                                        <div class=""slds-spinner--medium"">
                                            <img src=""{!URLFOR($Resource.slds, 'assets/images/spinners/slds_spinner_brand.gif')}"" alt=""Loading..."" style=""margin-top:150%"" />
                                        </div>
                                    </apex:outputPanel> 
                                 </apex:outputPanel> 
                                </apex:facet> 
                            </apex:actionStatus>
                                
                            <div class=""slds-grid"">
                                <div class=""slds-col slds-text-align--center"">
                                    <span class=""slds-text-heading--label"" style=""font-size:16px"">Add New </span>
                                    <!--<a href=""javascript:void(0)"" class="""" style=""margin-left:10px;text-decoration:none"" onclick=""initializeQuestion();return false"">
                                        <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#question"" cssStyle=""height:20px;width:20px""/>
                                    </a>-->
                                    <a href=""javascript:void(0)""  data-aljs=""modal"" data-aljs-show=""questionpromptmodal"" style=""margin-left:10px;text-decoration:none"" >
                                        <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#question"" cssStyle=""height:20px;width:20px""/>
                                    </a>
                                    
                                    <!--<a href=""javascript:void(0)"" class="""" style=""margin-left:10px;text-decoration:none"" onclick=""initializeMessage();return false"">
                                        <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#notebook"" cssStyle=""height:20px;width:20px""/>
                                    </a>
                                    <a href=""javascript:void(0)"" class="""" style=""margin-left:10px;text-decoration:none"" onclick=""initializeTool();return false"">
                                        <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#custom_apps"" cssStyle=""height:20px;width:20px""/>
                                    </a>-->
                                    <a href=""javascript:void(0)"" class="""" data-aljs=""modal"" style=""margin-left:10px;text-decoration:none"" data-aljs-show=""messagePromptModal"">
                                        <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#notebook"" cssStyle=""height:20px;width:20px""/>
                                    </a>
                                    <a href=""javascript:void(0)"" class="""" data-aljs=""modal"" style=""margin-left:10px;text-decoration:none"" data-aljs-show=""toolPromptModal"">
                                        <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#custom_apps"" cssStyle=""height:20px;width:20px""/>
                                    </a>
                                  
                                </div>
                            </div>
                            <apex:outputPanel id=""playDetailDiv"">
                            
                            <!-- Questions -->
                            <p class=""slds-section__title slds-m-top--medium"" style=""font-size:20px"">Questions</p>
                            <apex:outputpanel layout=""none"" rendered=""{!questionList.size == 0}"">
                                No Question Exist
                            </apex:outputpanel>
                            <apex:outputpanel layout=""none"" rendered=""{!questionList.size > 0}"">
                                <apex:variable value=""{!0}"" var=""cnt""/>
                                <apex:repeat value=""{!questionList}"" var=""q"">
                                    <apex:variable value=""{!cnt + 1}"" var=""cnt""/>
                                
                                    <div class=""slds-grid"">
                                        <div class=""slds-col slds-m-left--large slds-m-top--medium"">
                                            <div class=""slds-text-longform"" style=""font-size:18px !important"" onmouseover=""$('.editQuestion{!cnt}').show();"" onmouseout=""$('.editQuestion{!cnt}').hide();"" >
                                                <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#question"" cssStyle=""height:20px;width:20px""/>
                                                <a href=""javascript:void(0)""  onclick=""clearModal('questionModal');fillModalValuesForEditQuestion('{!q.id}');return false"" style=""text-decoration:none"">{!q.Description__c}
                                                  <c:SVGComponent styleClass=""editQuestion{!cnt} slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px;display:none""/>
                                                        
                                                </a>
                                                <a href=""javascript:void(0)"" class=""editQuestion{!cnt}"" onclick=""event.stopPropagation();$('.deleteMdlHeading').text('Delete Question');$('[id$=playDetailModal]').modal('dismiss');$('[id$=deleteMainModal]').modal('show');deletingId = '{!q.id}';deleteWhat = 'question';"" style=""display:none"">
                                                    <c:SVGComponent styleClass="" slds-button__icon--stateful slds-icon--small"" clickOperation=""""  path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""color:#54698D;""/>  
                                                </a>
                                                
                                            </div>
                                            <apex:outputpanel layout=""none""  rendered=""{!q.ResponseType__c == 'SingleChoice' && q.answers__r.size > 0}"">
                                                
                                                <select size=""1""  class=""slds-select"" style=""width:200px;margin-top:10px;margin-left:25px"">
                                                    <apex:repeat value=""{!q.answers__r}"" var=""a"">
                                                        <Option>{!a.Answer__c}</Option>
                                                    </apex:repeat>
                                                </select>
                                            </apex:outputpanel>
                                            
                                            <apex:outputpanel layout=""none"" rendered=""{!q.ResponseType__c == 'MultiChoice'  && q.answers__r.size > 0}"">
                                                <select size=""3"" multiple=""multiple""  class=""slds-select"" style=""width:200px;margin-top:10px;margin-left:25px"">
                                                    <apex:repeat value=""{!q.answers__r}"" var=""a"">
                                                        <Option>{!a.Answer__c}</Option>
                                                    </apex:repeat>
                                                </select>
                                            </apex:outputpanel>
                                            
                                            <apex:outputpanel layout=""none"" rendered=""{!q.ResponseType__c == 'Date'}"">
                                                <input type=""text"" class=""slds-input"" style=""width:200px;margin-top:10px;margin-left:25px""/>
                                            </apex:outputpanel>
                                            
                                            <apex:outputpanel layout=""none"" rendered=""{!q.ResponseType__c == 'Text'}"">
                                                <input type=""text"" class=""slds-input"" style=""width:200px;margin-top:10px;margin-left:25px""/>
                                            </apex:outputpanel>
                                            
                                            <apex:outputpanel layout=""none"" rendered=""{!q.ResponseType__c == 'WholeNumber' || q.ResponseType__c == 'Number' || q.ResponseType__c == 'Currency'}"">
                                                <input type=""text"" class=""slds-input"" style=""width:200px;margin-top:10px;margin-left:25px""/>
                                            </apex:outputpanel>
                                            
                                            <apex:outputpanel layout=""none"" rendered=""{!q.ResponseType__c == 'Checkbox'}"">
                                                <label class=""slds-checkbox""  style=""margin-top:10px;margin-left:25px"">
                                                    <input type=""checkbox""/>
                                                    <span class=""slds-checkbox--faux""></span>
                                                </label> 
                                            </apex:outputpanel>
                                            
                                            <apex:outputpanel layout=""none"" rendered=""{!q.ResponseType__c == 'Rating'}"">
                                                <select size=""1"" class=""slds-select"" style=""width:200px;margin-top:10px;margin-left:25px"">
                                                    <Option>Positive</Option>
                                                    <Option>Neutral</Option>
                                                    <Option>Negative</Option>
                                                </select>
                                            </apex:outputpanel>
                                        </div>
                                    </div>
                                </apex:repeat>
                            </apex:outputpanel>
                            
                            <!-- Messages -->
                            <p class=""slds-section__title slds-m-top--medium"" style=""font-size:20px"">Messages</p>
                            <apex:outputpanel layout=""none"" rendered=""{!messageList.size == 0}"">
                                No Message Exist
                            </apex:outputpanel>
                            <apex:outputpanel layout=""none"" rendered=""{!messageList.size > 0}"">
                                <apex:variable value=""{!0}"" var=""cnt""/>
                                
                                <apex:repeat value=""{!messageList}"" var=""m"">
                                    <apex:variable value=""{!cnt + 1}"" var=""cnt""/>
                                
                                    <div class=""slds-grid"">
                                        <div class=""slds-col slds-m-left--large slds-m-top--medium"">
                                            <div class=""slds-text-longform"" style=""font-size:18px !important"" onmouseover=""$('.editMessage{!cnt}').show();"" onmouseout=""$('.editMessage{!cnt}').hide();"">
                                                <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#notebook"" cssStyle=""height:20px;width:20px""/>
                                                <a href=""javascript:void(0)"" onclick=""clearModal('messageModal');fillModalValuesForEditMessage('{!m.id}');return false""  style=""text-decoration:none"">{!m.Description__c}
                                                  <c:SVGComponent styleClass=""editMessage{!cnt} slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px;display:none""/>
                                                </a>
                                                <a href=""javascript:void(0)"" class=""editMessage{!cnt}"" onclick=""event.stopPropagation();$('.deleteMdlHeading').text('Delete Message');$('[id$=playDetailModal]').modal('dismiss');$('[id$=deleteMainModal]').modal('show');deletingId = '{!m.id}';deleteWhat = 'message';"" style=""display:none"">
                                                    <c:SVGComponent styleClass="" slds-button__icon--stateful slds-icon--small"" clickOperation=""""  path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""color:#54698D;""/>  
                                                </a>
                                                
                                            </div>
                                        </div>
                                    </div>
                                </apex:repeat>
                            </apex:outputpanel>
                            
                            <!-- Tools -->
                            <p class=""slds-section__title slds-m-top--medium"" style=""font-size:20px"">Tools</p>
                            <apex:outputpanel layout=""none"" rendered=""{!toolList.size == 0}"">
                                No Tool Exist
                            </apex:outputpanel>
                            <apex:outputpanel layout=""none"" rendered=""{!toolList.size > 0}"">
                                <apex:variable value=""{!0}"" var=""cnt""/>
                                
                                <apex:repeat value=""{!toolList}"" var=""t"">
                                    <apex:variable value=""{!cnt + 1}"" var=""cnt""/>
                                
                                    <div class=""slds-grid"">
                                        <div class=""slds-col slds-m-left--large slds-m-top--medium"">
                                            <div class=""slds-text-longform"" style=""font-size:18px !important"" onmouseover=""$('.editTool{!cnt}').show();"" onmouseout=""$('.editTool{!cnt}').hide();"">
                                                <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#custom_apps"" cssStyle=""height:20px;width:20px""/>
                                                <a href=""javascript:void(0)""  onclick=""clearModal('toolModal');fillModalValuesForEditTool('{!t.id}');return false""  style=""text-decoration:none"">{!t.Name__c}
                                                  <c:SVGComponent styleClass=""editTool{!cnt} slds-button__icon--stateful slds-icon--small""  path=""assets/icons/utility-sprite/svg/symbols.svg#brush"" cssStyle=""height:20px;width:20px;display:none""/>
                                                </a>
                                                <a href=""javascript:void(0)"" class=""editTool{!cnt} "" onclick=""event.stopPropagation();$('.deleteMdlHeading').text('Delete Tool');$('[id$=playDetailModal]').modal('dismiss');$('[id$=deleteMainModal]').modal('show');deletingId = '{!t.id}';deleteWhat = 'tool';"" style=""display:none"">
                                                    <c:SVGComponent styleClass=""slds-button__icon--stateful slds-icon--small"" clickOperation=""""  path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""color:#54698D;""/>   
                                                </a>
                                                
                                            </div>
                                        </div>
                                    </div>
                                </apex:repeat>
                            </apex:outputpanel>
                            </apex:outputPanel>
                        </div>
                        <div class=""slds-modal__footer"">
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" onclick=""$('[id$=playDetailModal]').modal('dismiss');"">Cancel</a>
                            <!-- <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral slds-button--brand"" data-aljs=""modal"" data-aljs-show=""playModal"">Save</a> -->
                        </div>
                    </div>
              </div>
              <!-- Play Detail Modal End -->
              <script>    
                  /* Set scroll of main div when stages container width greater then main div */
                  if(parseInt($('.stage-header').css('width')) > parseInt($('.main-scroll').css('width'))){                 
                     $('.main-scroll').addClass('custom-scroll');              
                  } else {                  
                     $('.main-scroll').removeClass('custom-scroll');
                  }
                  
                  /*Set minimum height for dropable play zone dynamically*/
                  $('.sortable-list').css('min-height',(parseInt($('#examplesDrop').css('height'))-parseInt($('.add-play-link').css('height'))));
                  
                   /* Drag Drop play funtionality */
                    $(document).ready(function(){
                        console.log('init sort');
                        $('#examplesDrop .sortable-list').sortable({
                            revert : true,
                            connectWith : '#examplesDrop .sortable-list',                           
                            stop : function(event,ui){  
                                
                                if (ui.item.context.parentElement.id != $('#'+ui.item.context.id).data('stageid')) {                        
                                    // the item got moved   
                                    $('[id$=deleteModal]').modal('dismiss');
                                    $('[id$=playDropConfirmPrompt]').modal('show');                   
                                    
                                    currentElement = this;
                                    //console.log('currentElement : '+currentElement);
                                    
                                    //var th = this;                        
                                    /*$('#noMove').click(function(){
                                        stopPlayDrop(th);                           
                                    });*/
                                    
                                    $('#moveConfirm').click(function(e){                   
                                        startPlayDrop(ui.item.context.id, ui.item.context.parentElement.id, e);
                                    });                          
                               
                                } else {
                                    // the item was returned to the same position
                                    stopPlayDrop(this);                      
                                }                                  
                            }          
                        });            
                    });
              </script>
              </apex:outputPanel>
          </section>
          <!-- Stage Modal Start -->
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""stageModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium stageMdlHeading"">New Stage</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button>
                    </div>
                    <div class=""slds-modal__content"">
                        
                        <div class=""slds-notify-container createStageNotify""  style=""position:relative;display:none"">
                          <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                            <span class=""slds-assistive-text"">Info</span>
                              
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close""  onclick=""$('.createStageNotify').hide(100);"">
                              <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                              <span class=""slds-assistive-text"">Close</span>
                            </a>
                            <div class=""notify__content"">
                              <h2 class=""slds-text-heading--small"">
                                  <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                    <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                  </svg>
                                  <span class=""createStageErrorMsg""></span>
                              </h2>
                            </div>
                          </div>
                        </div>
                        
                        <div class=""slds-form-element slds-is-required"">
                            <label class=""slds-form-element__label"">Stage Name</label>
                            <div class=""slds-form-element__control"">
                                <apex:selectList id=""createStageName"" value=""{!stageObj.Name__c}"" size=""1"" styleclass=""slds-select""> 
                                    <apex:selectoptions value=""{!stagePicklist}""/>
                                </apex:selectList>
                            </div>
                        </div>
                        <div class=""slds-form-element"">
                            <label class=""slds-form-element__label"">Description</label>
                            <div class=""slds-form-element__control "">
                                <apex:inputTextArea id=""createStageDesc"" value=""{!stageObj.Description__c}"" styleclass=""slds-textarea""/>    
                            </div>
                        </div>
                        <div class=""slds-form-element"">
                            <label class=""slds-form-element__label"">Do not display as stage on scorecard</label>
                            <div class=""slds-form-element__control"">
                                <label class=""slds-checkbox"">
                                   <apex:inputCheckbox id=""createStageIsLibrary"" value=""{!stageObj.isLibrary__c}"" />
                                   <span class=""slds-checkbox--faux""></span>
                                </label>
                            </div>
                        </div>
                                     
                    </div>
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Cancel</button>
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""checkValidation('CreateStage'); return false"">Save</button>
                    </div>
                </div>
          </div>
          <!-- Stage Modal End -->
          
          <!-- New Modals for Questions -->
          <!-- Added on 3-25-2015 -->
          <!-- Desc : This is the second screen if we go to select from exiting -->
            <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""clone_question_modal"">
                <div class=""slds-modal__container"">
                
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium"">Choose the question template you want to use</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button>
                    </div>
                    
                    <div class=""slds-modal__content"" style=""min-height: 400px;"">
                        <div class=""slds-form-element"">                      
                             <apex:outputPanel id=""cloneQuestionDiv"" layout=""block"" style=""width:100%"">
                                 <script>
                                      //jQuery Datatable 
                                      $(document).ready(function (){
                                  
                                        var table = $('#example').DataTable({
                                            ""language"": {
                                              ""search"": """",
                                              ""lengthMenu"": ""_MENU_"",
                                              searchPlaceholder: ""Search records""
                                            },
                                        });
                                         
                                        $('#example_length label select').addClass('slds-select');        
                                        $('#example_filter label input').addClass('slds-select');
                                        
                                        $('#example tbody').on( 'click', 'tr', function () {
                                            if ( $(this).hasClass('selected') ) {
                                                $(this).removeClass('selected');
                                            }
                                            else {
                                                table.$('tr.selected').removeClass('selected');
                                                $(this).addClass('selected');
                                            }
                                        } );
                                  
                                    });
                                 </script>
                                 
                                 <table class=""slds-table slds-table--bordered"" id=""example"" cellspacing=""0"" width=""100%"">
                                  <thead>
                                      <tr class=""slds-text-heading--label"">          
                                          <th class=""slds-is-sortable""> Stage </th>         
                                          <th class=""slds-is-sortable""> Question </th>
                                      </tr>
                                  </thead>
                                  
                                  <tbody>
                                      <apex:repeat value=""{!questions}"" var=""ques"" id=""existList"">
                                          <!--<li class=""slds-picklist__item"" aria-selected=""false"" role=""option"">
                                            <span class=""slds-truncate"" onclick="" $('.checked').hide(); $(this).find('.checked').show();"">
                                                <span>{!ques.Play__r.Stage__r.Name__c}  - {!ques.Description__c} </span>
                                            </span>
                                          </li>-->
                                          
                                          <tr class=""slds-hint-parent"" onclick=""rowQuesId='{!ques.Id}'; rowPlayId = parentPlayId;"">        
                                           <td class=""slds-truncate"">{!ques.Play__r.Stage__r.Name__c}</td>
                                            <td class=""slds-truncate"">{!ques.Description__c}</td>           
                                          </tr>
                                      </apex:repeat>
                                  </tbody>
                                 </table>
                                 
                              </apex:outputPanel>                           
                        </div>
                    </div>
                    
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""cloneQuestion(rowPlayId, rowQuesId); return false"">Select</button>
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=questionpromptmodal]').modal('show'); return false"">Cancel</button>                     
                    </div>
                </div>
                
            </div>
            <!-- Question clone modal end -->
          
            <!-- Massage Clone modal --> 
            <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""clone_message_modal"">
                <div class=""slds-modal__container"">
                
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium"">Choose the message template you want to use</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show'); return false"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button>
                    </div>
                    
                    <div class=""slds-modal__content"" style=""min-height: 400px;"">
                        <div class=""slds-form-element"">                      
                             <apex:outputPanel id=""cloneMessageDiv"" layout=""block"" style=""width:100%"">
                                 <script>
                                      //jQuery Datatable 
                                      $(document).ready(function (){
                                  
                                        var table = $('#example1').DataTable({
                                            ""language"": {
                                              ""search"": """",
                                              ""lengthMenu"": ""_MENU_"",
                                              searchPlaceholder: ""Search records""
                                            },
                                        });
                                         
                                        $('#example1_length label select').addClass('slds-select');        
                                        $('#example1_filter label input').addClass('slds-select');
                                        
                                        $('#example1 tbody').on( 'click', 'tr', function () {
                                            if ( $(this).hasClass('selected') ) {
                                                $(this).removeClass('selected');
                                            }
                                            else {
                                                table.$('tr.selected').removeClass('selected');
                                                $(this).addClass('selected');
                                            }
                                        } );
                                  
                                    });
                                 </script>
                                 
                                 <table class=""slds-table slds-table--bordered"" id=""example1"" cellspacing=""0"" width=""100%"">
                                  <thead>
                                      <tr class=""slds-text-heading--label"">          
                                          <th class=""slds-is-sortable""> Stage </th>         
                                          <th class=""slds-is-sortable""> Message </th>
                                      </tr>
                                  </thead>
                                  
                                  <tbody>
                                      <apex:repeat value=""{!messages}"" var=""message"" id=""existMessageList"">   
                                          <tr class=""slds-hint-parent"" onclick=""rowMessageId='{!message.Id}'; rowPlayId = parentPlayId;"">        
                                            <td class=""slds-truncate"">{!message.Play__r.Stage__r.Name__c}</td>
                                            <td class=""slds-truncate"">{!message.Name__c}</td>           
                                          </tr>
                                      </apex:repeat>
                                  </tbody>
                                 </table>
                                 
                              </apex:outputPanel>                           
                        </div>
                    </div>
                    
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""cloneMessage(rowPlayId, rowMessageId); return false"">Select</button>
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=messagePromptModal]').modal('show'); return false"">Cancel</button>                     
                    </div>
                </div>
                
            </div>
            <!-- Massage Clone modal end -->
            
            <!-- Tool Clone modal --> 
            <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""clone_tool_modal"">
                <div class=""slds-modal__container"">
                
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium"">Choose the tool template you want to use</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show'); return false"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button>
                    </div>
                    
                    <div class=""slds-modal__content"" style=""min-height: 400px;"">
                        <div class=""slds-form-element"">                      
                             <apex:outputPanel id=""cloneToolDiv"" layout=""block"" style=""width:100%"">
                                 <script>
                                      //jQuery Datatable 
                                      $(document).ready(function (){
                                  
                                        var table = $('#example2').DataTable({
                                            ""language"": {
                                              ""search"": """",
                                              ""lengthMenu"": ""_MENU_"",
                                              searchPlaceholder: ""Search records""
                                            },
                                        });
                                         
                                        $('#example2_length label select').addClass('slds-select');        
                                        $('#example2_filter label input').addClass('slds-select');
                                        
                                        $('#example2 tbody').on( 'click', 'tr', function () {
                                            if ( $(this).hasClass('selected') ) {
                                                $(this).removeClass('selected');
                                            }
                                            else {
                                                table.$('tr.selected').removeClass('selected');
                                                $(this).addClass('selected');
                                            }
                                        } );
                                  
                                    });
                                 </script>
                                 
                                 <table class=""slds-table slds-table--bordered"" id=""example2"" cellspacing=""0"" width=""100%"">
                                  <thead>
                                      <tr class=""slds-text-heading--label"">          
                                          <th class=""slds-is-sortable""> Stage </th>         
                                          <th class=""slds-is-sortable""> Tool </th>
                                      </tr>
                                  </thead>                                  
                                  <tbody>
                                      <apex:repeat value=""{!tools}"" var=""tool"" id=""existToolList"">                                     
                                          <tr class=""slds-hint-parent"" onclick=""rowToolId='{!tool.Id}'; rowPlayId = parentPlayId;"">        
                                            <td class=""slds-truncate"">{!tool.Play__r.Stage__r.Name__c}</td>
                                            <td class=""slds-truncate"">{!tool.Name__c}</td>           
                                          </tr>
                                      </apex:repeat>
                                  </tbody>
                                 </table>                                 
                              </apex:outputPanel>                           
                        </div>
                    </div>
                    
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""cloneTool(rowPlayId, rowToolId); return false"">Select</button>
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=toolPromptModal]').modal('show');"">Cancel</button>                     
                    </div>
                </div>
                
            </div>
            <!-- Tool Clone modal -->
           
            <!-- Question prompt modal -->
            <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""questionpromptmodal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium"">Create New Question</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show'); return false"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button> 
                    </div>
                    <div class=""slds-modal__content"">
                        <h4>Choose starting point to create new question</h4>
                        <br/>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" aria-live=""assertive"" onclick=""loadQuestions();return false"">Copy existing</a>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" onclick=""initializeQuestion();return false"" aria-live=""assertive"" >Create from blank</a>
                        <br/>
                        <br/>
                    </div>
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show'); return false"" >Cancel</button>                     
                    </div>
                </div>
            </div>
            <!-- End Quetions Model -->
          
            <!-- Message prompt modal -->
            <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""messagePromptModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium"">Create New Message</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show'); return false"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button> 
                    </div>
                    <div class=""slds-modal__content"">
                        <h4>Choose starting point to create new message</h4>
                        <br/>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" aria-live=""assertive"" onclick=""loadMessages();return false"">Copy existing</a>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" onclick=""initializeMessage();return false"" aria-live=""assertive"" >Create from blank</a>
                        <br/>
                        <br/>
                    </div>
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show'); return false"" >Cancel</button>                     
                    </div>
                </div>
            </div>
            
            <!-- Tools prompt modal -->
            <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""toolPromptModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium"">Create New Tool</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show'); return false"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button> 
                    </div>
                    <div class=""slds-modal__content"">
                        <h4>Choose starting point to create new tool</h4>
                        <br/>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" aria-live=""assertive"" onclick=""loadTools(); return false"" >Copy existing</a>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" onclick=""initializeTool();return false"" aria-live=""assertive"" >Create from blank</a>
                        <br/>
                        <br/>
                    </div>
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show'); return false"" >Cancel</button>                     
                    </div>
                </div>
            </div>
         <!-- Play Modal Start -->
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""playModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium playMdlHeading"">New Play</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button>
                    </div>
                    <div class=""slds-modal__content"">
                        
                        <div class=""slds-notify-container createPlayNotify""  style=""position:relative;display:none"">
                          <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                            <span class=""slds-assistive-text"">Info</span>
                              
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close""  onclick=""$('.createPlayNotify').hide(100);"">
                              <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                              <span class=""slds-assistive-text"">Close</span>
                            </a>
                            <div class=""notify__content"">
                              <h2 class=""slds-text-heading--small"">
                                  <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                    <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                  </svg>
                                  <span class=""createPlayErrorMsg""></span>
                              </h2>
                            </div>
                          </div>
                        </div>
                        <div class=""slds-form-element slds-is-required"">
                            <label class=""slds-form-element__label"">Current Stage</label>
                            <div class=""slds-form-element__control"">
                                <input type=""text"" id=""curStageForPlay"" value=""Stage Name"" class=""slds-input"" readonly=""true""/>
                            </div>
                        </div>
                        <div class=""slds-form-element slds-is-required"">
                            <label class=""slds-form-element__label"">Play Name</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputText id=""playNameId"" value=""{!playObj.Name__c}"" styleclass=""slds-input""/>
                            </div>
                        </div>
                        <div class=""slds-form-element"">
                            <label class=""slds-form-element__label"">Description</label>
                            <div class=""slds-form-element__control "">
                                <apex:inputTextArea id=""playDescId"" value=""{!playObj.Description__c}"" styleclass=""slds-textarea""/>    
                            </div>
                        </div>
                        
                        
                    </div>
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Cancel</button>
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""checkValidation('CreatePlay');return false"">Save</button>
                    </div>
                </div>
          </div>
          <!-- Play Modal End -->
          
          
          <!--  playbook delete modal start-->
          <div>
            <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""deleteModal"">
              <div class=""slds-modal__container  slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium"">Delete Playbook</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <p>Are you sure to delete {!processObj.name}?</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                  <apex:commandbutton action=""{!deletePlaybook}"" styleclass=""slds-button slds-button--neutral"" value=""Yes""/>
                  <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">No</button>
                </div>
              </div>
            </div>
            <div class=""slds-backdrop slds-backdrop--open""></div>
          </div>
          <!--  playbook delete modal start-->
          
          <!--  delete modal start-->
          <div>
            <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""deleteMainModal"">
              <div class=""slds-modal__container  slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium deleteMdlHeading"">Delete Playbook</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <p>Are you sure to delete?</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                  <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" onclick=""$('[id$=deleteMainModal]').modal('dismiss');deleteRecord();return false"">Yes</a>
                  <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">No</button>
                </div>
              </div>
            </div>
            <div class=""slds-backdrop slds-backdrop--open""></div>
          </div>
          <!-- delete modal start-->
          
          <!--  playbook publish modal start-->
          <div>
            <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""publishModal"">
              <div class=""slds-modal__container  slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium"">Publish Playbook</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <p>Are you sure to publish {!processObj.name}.</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                  <apex:commandButton styleclass=""slds-button slds-button--neutral"" action=""{!publishPlaybook}"" value=""Yes""/>
                  <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">No</button>
                </div>
              </div>
            </div>
            <div class=""slds-backdrop slds-backdrop--open""></div>
          </div>
          <!--  playbook publish modal start-->
          
          <!--  playbook publish ok modal start-->
          <div>
            <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""publishOkModal"">
              <div class=""slds-modal__container  slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium"">Publish Playbook</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <p>Playbook {!processObj.name} has been published.</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                  <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Ok</button>
                </div>
              </div>
            </div>
            <div class=""slds-backdrop slds-backdrop--open""></div>
          </div>
          <!--  playbook publish ok modal start-->
          
          <!-- Process Modal Start -->
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""processModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium processMdlHeading"">Edit Playbook</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button>
                    </div>
                    <div class=""slds-modal__content"">
                        
                        <div class=""slds-notify-container createProcessNotify""  style=""position:relative;display:none"">
                          <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                            <span class=""slds-assistive-text"">Info</span>
                              
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close""  onclick=""$('.createProcessNotify').hide(100);"">
                              <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                              <span class=""slds-assistive-text"">Close</span>
                            </a>
                            <div class=""notify__content"">
                              <h2 class=""slds-text-heading--small"">
                                  <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                    <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                  </svg>
                                  <span class=""createProcessErrorMsg""></span>
                              </h2>
                            </div>
                          </div>
                        </div>
                        
                        <div class=""slds-form-element slds-is-required"">
                            <label class=""slds-form-element__label"">Playbook Name</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputText id=""createProcessName"" value=""{!processObj.Name__c}"" styleclass=""slds-input""/>
                            </div>
                        </div>
                        <div class=""slds-form-element"">
                            <label class=""slds-form-element__label"">Playbook Description</label>
                            <div class=""slds-form-element__control "">
                                <apex:inputTextArea id=""createProcessDesc"" value=""{!processObj.Description__c}"" styleclass=""slds-textarea""/>    
                            </div>
                        </div>
                        
                        <div class=""slds-form-element"">
                            <label class=""slds-form-element__label"">ProgressThreshold(%)</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputText id=""createProcessProgressT"" value=""{!processObj.ProgressThreshold__c}"" styleclass=""slds-input""/>
                            </div>
                        </div> 
                    </div>
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Cancel</button>
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""checkValidation('CreateProcess');return false"">Save</button>
                    </div>
                </div>
          </div>
          <!-- Process Modal End -->
          
          <!-- question Modal Start -->
              
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""questionModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium questionMdlHeading"">New Question</h2>
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </a>
                    </div>
                    <div class=""slds-modal__content"">
                        <apex:actionStatus id=""StatusQuestion"" >
                            <apex:facet name=""start"">
                             <apex:outputPanel id=""tstpopupQuestion""> 
                                <apex:outputPanel styleClass=""popupBackground"" layout=""block"" style=""width:100%""/> 
                                <apex:outputPanel styleClass=""custPopup"" layout=""block""> 
                                    <div class=""slds-spinner--medium"">
                                        <img src=""{!URLFOR($Resource.slds, 'assets/images/spinners/slds_spinner_brand.gif')}"" alt=""Loading..."" style=""margin-top:150%"" />
                                    </div>
                                </apex:outputPanel> 
                             </apex:outputPanel> 
                            </apex:facet> 
                        </apex:actionStatus>
                        
                        <div class=""slds-notify-container createQuestionNotify""  style=""position:relative;display:none"">
                          <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                            <span class=""slds-assistive-text"">Info</span>
                              
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close""  onclick=""$('.createQuestionNotify').hide(100);"">
                              <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                              <span class=""slds-assistive-text"">Close</span>
                            </a>
                            <div class=""notify__content"">
                              <div class=""slds-grid"">
                                <div class=""slds-size--3-of-10"">
                                  <h2 class=""slds-text-heading--small"">
                                    <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                      <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                    </svg>
                                  </h2>
                                </div>
                                <div class=""slds-size--7-of-10"">
                                    <h2 class=""slds-text-heading--small"">
                                        <span class=""createQuestionErrorMsg"" style=""white-space:normal""></span>
                                    </h2>
                                </div>
                              </div>
                              
                            </div>
                          </div>
                        </div>
                        
                        <apex:outputPanel id=""questionModalDiv"">
                        <div class=""slds-form-element slds-is-required"">
                            <label class=""slds-form-element__label"">Question</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputTextarea id=""createQuestionDesc"" value=""{!quesObj.Description__c}"" styleclass=""slds-textarea""/>
                            </div>
                        </div>
                        <div class=""slds-form-element"">
                            <label class=""slds-form-element__label"">Tip</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputText id=""createQuestionTip"" value=""{!quesObj.Tip__c}"" styleclass=""slds-input""/>
                            </div>
                        </div>
                        <div class=""slds-form-element"">
                            <label class=""slds-form-element__label slds-is-required"">Importance</label>
                            <div class=""slds-form-element__control "">
                                <apex:selectList id=""createQuestionImportance"" value=""{!quesObj.Points__c}"" size=""1"" styleclass=""slds-select""> 
                                    <apex:selectOption itemLabel=""Not Important"" itemValue=""0"" />
                                    <apex:selectOption itemLabel=""Somewhat Important"" itemValue=""1"" />
                                    <apex:selectOption itemLabel=""Important"" itemValue=""2"" />
                                    <apex:selectOption itemLabel=""Very Important"" itemValue=""3"" />
                                </apex:selectList>
                                    
                            </div>
                        </div>
                        <div class=""slds-grid slds-wrap slds-m-top--small"">
                            <div class=""slds-size--1-of-2"">
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"">Include In Deal Progress Section</label>
                                    <div class=""slds-form-element__control"">
                                        <label class=""slds-checkbox"">
                                           <apex:inputCheckbox id=""createQuestionIIDealP"" styleClass=""sectionCheckbox"" value=""{!quesObj.IncludedInDealProgress__c}"" onchange=""uncheckAllSectionCheckbox(this,this.checked)""/>
                                           <span class=""slds-checkbox--faux""></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class=""slds-size--1-of-2"">
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"">Include In Executive Summary</label>
                                    <div class=""slds-form-element__control"">
                                        <label class=""slds-checkbox"">
                                           <apex:inputCheckbox id=""createQuestionIIExecS"" styleClass=""sectionCheckbox"" value=""{!quesObj.IncludedInExecSummary__c}"" onchange=""uncheckAllSectionCheckbox(this,this.checked)""/>
                                           <span class=""slds-checkbox--faux""></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        
                            <div class=""slds-size--1-of-2"">
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"">Include In Key Milestone Section</label>
                                    <div class=""slds-form-element__control"">
                                        <label class=""slds-checkbox"">
                                           <apex:inputCheckbox id=""createQuestionIIKeyM"" styleClass=""sectionCheckbox"" value=""{!quesObj.IncludedInKeyMilestones__c}"" onchange=""uncheckAllSectionCheckbox(this,this.checked)""/>
                                           <span class=""slds-checkbox--faux""></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class=""slds-size--1-of-2"">
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"">Include In Success Indicators Section</label>
                                    <div class=""slds-form-element__control"">
                                        <label class=""slds-checkbox"">
                                           <apex:inputCheckbox id=""createQuestionIISuccessI"" styleClass=""sectionCheckbox"" value=""{!quesObj.IncludedInSuccessIndicators__c}"" onchange=""uncheckAllSectionCheckbox(this,this.checked)""/>
                                           <span class=""slds-checkbox--faux""></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class=""slds-size--1-of-2"">
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"">Include In Call Management Assessment Section</label>
                                    <div class=""slds-form-element__control"">
                                        <label class=""slds-checkbox"">
                                           <apex:inputCheckbox id=""createQuestionIIAss"" styleClass=""sectionCheckbox"" value=""{!quesObj.IncludedInAssessment__c}"" onchange=""uncheckAllSectionCheckbox(this,this.checked)""/>
                                           <span class=""slds-checkbox--faux""></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class=""slds-size--1-of-2"">
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"">Include In Call Management Discussion Section</label>
                                    <div class=""slds-form-element__control"">
                                        <label class=""slds-checkbox"">
                                           <apex:inputCheckbox id=""createQuestionIIDis"" styleClass=""sectionCheckbox"" value=""{!quesObj.IncludedInDiscussion__c}"" onchange=""uncheckAllSectionCheckbox(this,this.checked)""/>
                                           <span class=""slds-checkbox--faux""></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>    
                        <div class=""slds-form-element slds-is-required"">
                            <label class=""slds-form-element__label "">Answer Type</label>
                            <div class=""slds-form-element__control "">
                                <apex:selectList id=""createQuestionAnsType"" value=""{!quesObj.ResponseType__c}"" size=""1"" styleclass=""slds-select"" onchange=""showHideAnsContent();return false""> 
                                    <apex:selectoptions value=""{!responsePicklist}""/>
                                </apex:selectList>    
                            </div>
                        </div>
                        
                        <apex:outputPanel rendered=""{!ansModalList.size > 0}"">
                        <div class=""slds-form-element answerContentDiv slds-is-required"">
                            <label class=""slds-form-element__label"">Answer Content</label>
                            <div class=""slds-form-element__control "">
                                <apex:variable value=""{!-1}"" var=""ansIndex""/>
                                <apex:repeat value=""{!ansModalList}"" var=""ans"">
                                <apex:variable value=""{!ansIndex + 1}"" var=""ansIndex""/>
                                
                                <div style=""margin-top:5px"">
                                    <table cellpadding=""3"">
                                        <tr>
                                            <td style=""width:45%"">
                                                <apex:inputText value=""{!ans.answer}"" styleclass=""slds-input answers"" />
                                            </td>
                                            <td style=""width:5%;padding-left:10px !important"">
                                                <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#priority"" cssStyle=""height:20px;width:20px""/>
                                            </td>
                                            <td style=""width:25%;padding-left:10px !important"">
                                                <apex:selectList styleclass=""slds-select"" value=""{!ans.flagtype}"" size=""1"">
                                                    <apex:selectOption itemValue="""" itemLabel=""--None--""/>
                                                    <apex:selectOption itemValue=""Red"" itemLabel=""Red""/>
                                                    <apex:selectOption itemValue=""Green"" itemLabel=""Green""/>
                                                    
                                                </apex:selectList>
                                            </td>
                                            <td style=""width:20%;padding-left:10px !important"">
                                                <apex:selectList styleclass=""slds-select"" value=""{!ans.weight}"" size=""1"">
                                                    <apex:selectOption itemValue=""-1"" itemLabel=""-1""/>
                                                    <apex:selectOption itemValue=""0"" itemLabel=""0""/>
                                                    <apex:selectOption itemValue=""1"" itemLabel=""1""/>
                                                    <apex:selectOption itemValue=""2"" itemLabel=""2""/>
                                                </apex:selectList>
                                            </td>
                                            <td style=""width:5%;padding-left:10px !important"">
                                                <a href=""javascript:void(0)"" class="""" style=""text-decoration:none;margin-left:5px""  onclick=""removeAnswerContent({!ansIndex});return false"">
                                                    <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#close"" cssStyle=""height:20px;width:20px""/>
                                                </a>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                
                                </apex:repeat>
                                
                                <div style=""margin-top:10px"">
                                    <a href=""javascript:void(0)"" class="""" style=""text-decoration:none""  onclick=""increaseAnswerContent(); return false"">
                                        <c:SVGComponent styleClass=""slds-icon slds-icon--small slds-icon-text-default"" clickOperation="""" path=""assets/icons/utility-sprite/svg/symbols.svg#add"" cssStyle=""height:20px;width:20px""/>
                                    </a>
                                </div>    
                            </div>
                        </div>
                        </apex:outputPanel>
                        </apex:outputPanel>
                    </div>
                    <div class=""slds-modal__footer"">
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');"">Cancel</a>
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""checkValidation('CreateQuestion');return false"">Save</button>
                    </div>
                </div>
          </div>
          <!-- question Modal End -->
          
          <!-- message Modal Start -->
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""messageModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium messageMdlHeading"">New Message</h2>
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </a>
                    </div>
                    <div class=""slds-modal__content"">
                        
                        <div class=""slds-notify-container createMessageNotify""  style=""position:relative;display:none"">
                          <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                            <span class=""slds-assistive-text"">Info</span>
                              
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close""  onclick=""$('.createMessageNotify').hide(100);"">
                              <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                              <span class=""slds-assistive-text"">Close</span>
                            </a>
                            <div class=""notify__content"">
                              <h2 class=""slds-text-heading--small"">
                                  <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                    <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                  </svg>
                                  <span class=""createMessageErrorMsg""></span>
                              </h2>
                            </div>
                          </div>
                        </div>
                        
                        <apex:outputPanel id=""messageModalDiv"">
                        
                            <div class=""slds-form-element"">
                                <label class=""slds-form-element__label"">Label</label>
                                <div class=""slds-form-element__control"">
                                    <apex:inputText id=""createMessageLbl"" value=""{!msgObj.Name__c}"" styleclass=""slds-input""/>
                                </div>
                            </div>
                        </apex:outputPanel>
                        
                        <div class=""slds-form-element slds-is-required"">
                            <label class=""slds-form-element__label"">Message</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputfield id=""createMessageMsg"" value=""{!msgObj.Description__c}"" styleclass="""" />
                            </div>
                        </div>
                        
                        <apex:outputPanel id=""messageModalDiv2"">
                        
                            <div class=""slds-form-element"">
                                <label class=""slds-form-element__label"">Tip</label>
                                <div class=""slds-form-element__control"">
                                    <apex:inputText id=""createMessageTip"" value=""{!msgObj.Tip__c}"" styleclass=""slds-input""/>
                                </div>
                            </div>
                            <div class=""slds-grid slds-wrap slds-m-top--small"">
                                <div class=""slds-size--1-of-2"">
                                    <div class=""slds-form-element"">
                                        <label class=""slds-form-element__label"">Include In Call Management Assessment Section</label>
                                        <div class=""slds-form-element__control"">
                                            <label class=""slds-checkbox"">
                                               <apex:inputCheckbox id=""createMessageIIAss"" styleClass=""sectionCheckbox"" value=""{!msgObj.IncludedInAssessment__c}"" onchange=""uncheckAllSectionCheckbox(this,this.checked)""/>
                                               <span class=""slds-checkbox--faux""></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class=""slds-size--1-of-2"">
                                    <div class=""slds-form-element"">
                                        <label class=""slds-form-element__label"">Include In Call Management Discussion Section</label>
                                        <div class=""slds-form-element__control"">
                                            <label class=""slds-checkbox"">
                                               <apex:inputCheckbox id=""createMessageIIDis"" styleClass=""sectionCheckbox"" value=""{!msgObj.IncludedInDiscussion__c}"" onchange=""uncheckAllSectionCheckbox(this,this.checked)""/>
                                               <span class=""slds-checkbox--faux""></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                
                            </div> 
                        </apex:outputPanel>
                    </div>
                    <div class=""slds-modal__footer"">
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');"">Cancel</a>
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral slds-button--brand"" onclick=""checkValidation('CreateMessage');return false"">Save</a>
                    </div>
                </div>
          </div>
          <!-- message Modal End -->
          </apex:actionRegion>
          <!-- tool Modal Start -->
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""toolModal"">
                <div class=""slds-modal__container"">
                    
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium toolMdlHeading"">New Tool</h2>
                        <a class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </a>
                    </div>
                    <div class=""slds-modal__content"">
                        <apex:actionStatus id=""StatusTool"" >
                            <apex:facet name=""start"">
                             <apex:outputPanel id=""tstpopupTool""> 
                                <apex:outputPanel styleClass=""popupBackground"" layout=""block"" style=""width:100%""/> 
                                <apex:outputPanel styleClass=""custPopup"" layout=""block""> 
                                    <div class=""slds-spinner--medium"">
                                        <img src=""{!URLFOR($Resource.slds, 'assets/images/spinners/slds_spinner_brand.gif')}"" alt=""Loading..."" style=""margin-top:150%"" />
                                    </div>
                                </apex:outputPanel> 
                             </apex:outputPanel> 
                            </apex:facet> 
                        </apex:actionStatus>
                        
                        <div class=""slds-notify-container createToolNotify""  style=""position:relative;display:none"">
                          <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                            <span class=""slds-assistive-text"">Info</span>
                              
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close""  onclick=""$('.createToolNotify').hide(100);"">
                              <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                              <span class=""slds-assistive-text"">Close</span>
                            </a>
                            <div class=""notify__content"">
                              <h2 class=""slds-text-heading--small"">
                                  <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                    <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                  </svg>
                                  <span class=""createToolErrorMsg""></span>
                              </h2>
                            </div>
                          </div>
                        </div>
                        
                        <apex:actionRegion >
                        
                        <apex:outputPanel id=""toolModalDiv"">
                        
                        <div class=""slds-form-element slds-is-required"">
                            <label class=""slds-form-element__label"">Label</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputText id=""createToolLbl"" value=""{!toolObj.Name__c}"" styleclass=""slds-input""/>
                            </div>
                        </div>
                        <div class=""slds-form-element "">
                            <label class=""slds-form-element__label"">Description</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputtextarea id=""createToolDesc"" value=""{!toolObj.Description__c}"" styleclass=""slds-textarea"" />
                            </div>
                        </div>
                        <div class=""slds-form-element"">
                            <label class=""slds-form-element__label"">Tip</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputText id=""createToolTip"" value=""{!toolObj.Tip__c}"" styleclass=""slds-input""/>
                            </div>
                        </div>
                        <div class=""slds-grid slds-wrap slds-m-top--small"">
                            <div class=""slds-size--1-of-2"">
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"">Sales Tools – General</label>
                                    <div class=""slds-form-element__control"">
                                        <label class=""slds-checkbox"">
                                           <apex:inputCheckbox id=""createToolIIGen"" styleClass=""sectionCheckbox"" value=""{!toolObj.IncludedInGeneral__c}"" onchange=""uncheckAllSectionCheckbox(this,this.checked)""/>
                                           <span class=""slds-checkbox--faux""></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class=""slds-size--1-of-2"">
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"">Sales Tools – Differentiation</label>
                                    <div class=""slds-form-element__control"">
                                        <label class=""slds-checkbox"">
                                           <apex:inputCheckbox id=""createToolIIDiff"" styleClass=""sectionCheckbox"" value=""{!toolObj.IncludedInCompetition__c}"" onchange=""uncheckAllSectionCheckbox(this,this.checked)""/>
                                           <span class=""slds-checkbox--faux""></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            
                            <div class=""slds-size--1-of-2"">
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"">Sales Tools – Objections</label>
                                    <div class=""slds-form-element__control"">
                                        <label class=""slds-checkbox"">
                                           <apex:inputCheckbox id=""createToolIIObj"" styleClass=""sectionCheckbox"" value=""{!toolObj.IncludedInObjectionHandling__c}"" onchange=""uncheckAllSectionCheckbox(this,this.checked)""/>
                                           <span class=""slds-checkbox--faux""></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class=""slds-size--1-of-2"">
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"">Sales Training – Product</label>
                                    <div class=""slds-form-element__control"">
                                        <label class=""slds-checkbox"">
                                           <apex:inputCheckbox id=""createToolIIPrd"" styleClass=""sectionCheckbox"" value=""{!toolObj.IncludedInProduct__c}"" onchange=""uncheckAllSectionCheckbox(this,this.checked)""/>
                                           <span class=""slds-checkbox--faux""></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class=""slds-size--1-of-2"">
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"">Sales Training – Videos</label>
                                    <div class=""slds-form-element__control"">
                                        <label class=""slds-checkbox"">
                                           <apex:inputCheckbox id=""createToolIIVid"" styleClass=""sectionCheckbox"" value=""{!toolObj.IncludedInSuccessStories__c}"" onchange=""uncheckAllSectionCheckbox(this,this.checked)""/>
                                           <span class=""slds-checkbox--faux""></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            
                        </div> 
                        
                        </apex:outputPanel>
                        </apex:actionRegion>
                        <div class=""slds-form-element"">
                            <label class=""slds-form-element__label"">Select The Tool</label>
                            <div class=""slds-form-element__control"">
                                <table style=""width:0%"">
                                    
                                    <tr>
                                        <td>
                                            <a href=""javascript:void(0)"" class=""fileUpload slds-button"" onclick=""$('[id$=selectedToolStr]').val('upload');$('.createToolLinkDiv').hide(100);$('.createToolselectContentDiv').hide(100);if({!libraryList.size} > 0){ $('.createToolselectLibDiv').show(100);}"" data-aljs=""tooltip"" data-aljs-placement=""right"" title=""File Upload"">
                                                <c:SVGComponent styleClass=""slds-button__icon--stateful slds-icon--small"" path=""/assets/icons/utility-sprite/svg/symbols.svg#attach""/>
                                                <apex:inputFile styleclass=""upload"" value=""{!contversion.versionData}"" filename=""{!contversion.title}"" onclick=""$('.createToolLinkDiv').hide(100);"" onchange=""$('.emailFileName').text($(this).val().split('\\').pop())""/>
                                                <span class=""emailFileName"">{!contversion.title}</span>
                                            </a>
                                        </td>
                                        <td>
                                            <a href=""javascript:void(0)"" onclick=""$('[id$=selectedToolStr]').val('link');$('.createToolLinkDiv').show(100);$('.upload').val('');$('.emailFileName').val('');$('.createToolselectLibDiv').hide(100);$('.createToolselectContentDiv').hide(100);"" style=""margin-left:10px"" data-aljs=""tooltip"" data-aljs-placement=""right"" title=""Link"">
                                                <c:SVGComponent styleClass=""slds-button__icon--stateful slds-icon--small"" path=""/assets/icons/utility-sprite/svg/symbols.svg#link""/>
                                            </a>
                                        </td>
                                        <td>
                                            <a href=""javascript:void(0)"" onclick=""$('[id$=selectedToolStr]').val('content');$('.createToolLinkDiv').hide(100);$('.upload').val('');$('.emailFileName').val('');$('.createToolselectLibDiv').show(100);$('.createToolselectContentDiv').show(100);"" style=""margin-left:10px"" data-aljs=""tooltip"" data-aljs-placement=""right"" title=""Select Content"">
                                                <c:SVGComponent styleClass=""slds-button__icon--stateful slds-icon--small"" path=""/assets/icons/utility-sprite/svg/symbols.svg#opened_folder""/>
                                            </a>
                                        </td>
                                        <td>
                                            <a href=""javascript:void(0)"" onclick=""$('[id$=selectedToolStr]').val('library');$('.createToolLinkDiv').hide(100);$('.upload').val('');$('.emailFileName').val('');$('.createToolselectLibDiv').show(100);$('.createToolselectContentDiv').hide(100);"" style=""margin-left:10px"" data-aljs=""tooltip"" data-aljs-placement=""right"" title=""Select Library"">
                                                <c:SVGComponent styleClass=""slds-button__icon--stateful slds-icon--small"" path=""/assets/icons/utility-sprite/svg/symbols.svg#package""/>
                                            </a>
                                        </td>
                                    </tr>
                                </table>
                                    
                            </div>
                        </div>
                        <apex:actionRegion >
                            <apex:actionfunction name=""fillContents"" action=""{!fillContents}"" status=""StatusTool"" rerender=""contentDiv"" oncomplete=""if($('[id=selectedToolStr]').val() == 'content'){$('.createToolselectContentDiv').show();}"">
                                <apex:param assignTo=""{!selectedLibId}"" name=""libid"" value=""""/>
                            </apex:actionfunction>
                            
                            <apex:outputPanel id=""toolModalDiv2"">
                                <apex:inputHidden id=""selectedToolStr"" value=""{!selectedToolStr}"" /> 
          
                                <div class=""slds-form-element createToolLinkDiv"" style=""display:{!if(selectedToolStr == 'link','','none')}"">
                                    <label class=""slds-form-element__label"">Link</label>
                                    <div class=""slds-form-element__control"">
                                        <apex:inputText id=""createToolLink"" value=""{!toolObj.Link__c}"" styleclass=""slds-input""/>
                                    </div>
                                </div>
                                <apex:outputPanel rendered=""{!libraryList.size > 0}"">
                                <div class=""slds-form-element createToolselectLibDiv"" style=""display:none"">
                                    <label class=""slds-form-element__label"">Select Library</label>
                                    <div class=""slds-form-element__control"">
                                        <apex:selectList value=""{!selectedLibId}"" size=""1"" styleclass=""slds-select"" onchange=""fillContents(this.value);return false""> 
                                            <apex:selectOptions value=""{!libraryList}"" />
                                        </apex:selectList>
                                    </div>
                                </div>
                                </apex:outputPanel>
                            </apex:outputPanel>
                            
                            <apex:outputpanel id=""contentDiv"">
                            <apex:outputPanel rendered=""{!contentList.size > 0}"">
                            <div class=""slds-form-element createToolselectContentDiv"" style=""display:{!if(selectedToolStr == 'content','','none')}"">
                                <label class=""slds-form-element__label"">Select Content</label>
                                <div class=""slds-form-element__control"">
                                    <apex:selectList value=""{!selectedContentId}"" size=""1"" styleclass=""slds-select""> 
                                        <apex:selectOptions value=""{!contentList}"" />
                                    </apex:selectList>
                                </div>
                            </div>
                            </apex:outputpanel>
                            </apex:outputPanel>
                             
                        </apex:actionRegion>           
                    </div>
                    <div class=""slds-modal__footer"">
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');"">Cancel</a>
                        <!-- <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral slds-button--brand"" onclick=""checkValidation('CreateTool');"" >Save</a> -->
                        <apex:commandButton value=""Save"" styleclass=""slds-button slds-button--neutral slds-button--brand"" action=""{!insertTool}"" onclick=""checkToolValidations(event);""/>
                    </div>
                </div>
          </div>
          <!-- tool Modal End -->
           
           
            <!-- Play drag drop confirm prompt modal -->
                        
             <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""playDropConfirmPrompt"">
              <div class=""slds-modal__container slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium"">Move Play</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <p>Are you sure to move play!</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                    <button class="" slds-button slds-button--brand"" id=""moveConfirm"">Yes</button>
                    <button class=""slds-button slds-button--neutral"" id=""noMove"" onclick=""stopPlayDrop(currentElement); return false"" data-aljs-dismiss=""modal"">No</button> 
                </div>
              </div>
            </div>

            <!-- End Quetions Model -->
            
          </apex:form>
       </body>
      <script>
          var selectedToolStr = '';
          var stageOnEdit = '';                        
          var deleteWhat = '';
          var deletingId = '';
          
          
          
          $(document).ready(function(){
              $('[data-aljs=""modal""]').modal({              
                onShow: function(obj) {
                            $('.aljs-modal-container').remove();
                            $('body').append('<div class=""aljs-modal-container""><div class=""slds-backdrop slds-backdrop--open""></div></div>');
                        }
              });
              
              $('[data-aljs=""tooltip""]').tooltip();
                  
              if('{!playObjIdForUpdate}'.trim().length >= 15){
                  getPlayDetails('{!playObjIdForUpdate}'); return false;
              }
              
              CKEDITOR.config.toolbar = [
    { name: 'clipboard', groups: [ 'clipboard', 'undo' ], items: [ 'Cut', 'Copy', 'Paste', 'PasteText', 'PasteFromWord', '-', 'Undo', 'Redo' ] },
    { name: 'editing', groups: [ 'find', 'selection', 'spellchecker' ], items: [ 'Scayt' ] },
    { name: 'links', items: [ 'Link', 'Unlink', 'Anchor' ] },
    { name: 'insert', items: [ 'Image', 'Table', 'HorizontalRule', 'SpecialChar' ] },
    { name: 'tools', items: [ 'Maximize' ] },
    { name: 'document', groups: [ 'mode', 'document', 'doctools' ], items: [ 'Source' ] },
    { name: 'others', items: [ '-' ] },
    '/',
    { name: 'basicstyles', groups: [ 'basicstyles', 'cleanup' ], items: [ 'Bold', 'Italic', 'Strike', '-', 'RemoveFormat' ] },
    { name: 'paragraph', groups: [ 'list', 'indent', 'blocks', 'align', 'bidi' ], items: [ 'NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote' ] },
    { name: 'styles', items: [ 'Styles', 'Format' ] },
    { name: 'about', items: [ 'About' ] }
];
              
              
          });
          
          function deleteRecord(){
              if(deletingId.trim().length >= 15){
                  if(deleteWhat == 'stage'){
                      deleteStage(''+deletingId);
                  }else if(deleteWhat == 'play'){
                      deletePlay(''+deletingId);
                  }else if(deleteWhat == 'question'){
                      deleteQuestion(''+deletingId);
                  }else if(deleteWhat == 'message'){
                      deleteMessage(''+deletingId);
                  }else if(deleteWhat == 'tool'){
                      deleteTool(''+deletingId);
                  }
              }
          }
          
          function uncheckAllSectionCheckbox(ele,flag){
              $('.sectionCheckbox').prop('checked',false);
              $(ele).prop('checked',flag);
          }
          function hideShowAnswerContentDiv(val){
              if(val != 'SingleChoice' && val != 'MultiChoice'){
                  $('.answerContentDiv').hide(100);
              }else{
                  $('.answerContentDiv').show(100);
                  var ele = $('.answerContentDiv').html();
                  $('.answerContentDiv').html('').html(ele);
              }   
          }
          function dismisAllModal(){
            $('[id$=playDetailModal]').modal('dismis');
            $('[id$=playModal]').modal('dismis');
            $('[id$=stageModal]').modal('dismis');
            $('[id$=questionModal]').modal('dismis');
            $('[id$=messageModal]').modal('dismis');
            $('[id$=toolModal]').modal('dismis');
            
          }
          function checkValidation(mdl){
             if(mdl == 'CreateStage'){
                 
                 if($('[id$=createStageName]').val() != undefined && $('[id$=createStageName]').val() != null && $('[id$=createStageName]').val().trim().length > 0){
                     
                     if($('[id$=stagesForDuplicate]').val() != undefined && $('[id$=stagesForDuplicate]').val() != null && $('[id$=stagesForDuplicate]').val().trim().length > 0 && $('[id$=createStageName]').val() != stageOnEdit){
                         var stageArr = $('[id$=stagesForDuplicate]').val().trim().split(';');
                         var flagForDuplicate = false;
                         for(var i = 0 ; i < stageArr.length ; i++){
                            if($('[id$=createStageName]').val().trim() == stageArr[i].trim()){
                                flagForDuplicate = true;
                            }
                         }
                         
                         if(flagForDuplicate){
                             $('.createStageNotify').show();
                             $('.createStageErrorMsg').text('Duplicate Stage is not allowed!');
                             $('[id$=createStageName]').parent().addClass('slds-has-error');
                             if($('.errorMsg').length == 0){
                                 var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                 $('[id$=createStageName]').after(ele);
                             
                             }
                         }else{
                             $('.createStageNotify').hide();
                             $('[id$=createStageName]').parent().removeClass('slds-has-error');
                             $('.errorMsg').remove();
                             $('[id$=stageModal]').modal('dismiss');
                             if($('.stageMdlHeading').text() == 'New Stage'){
                                 createStage();
                             }else{
                                 updateStage();
                             }  
                         }
                     }else{
                         $('.createStageNotify').hide();
                         $('[id$=createStageName]').parent().removeClass('slds-has-error');
                         $('.errorMsg').remove();
                         $('[id$=stageModal]').modal('dismiss');
                         if($('.stageMdlHeading').text() == 'New Stage'){
                             createStage();
                         }else{
                             updateStage();
                         }  
                     }
                     
                     
                 }else{
                     $('.createStageNotify').show();
                     $('.createStageErrorMsg').text('You must have to select stage name!');
                     $('[id$=createStageName]').parent().addClass('slds-has-error');
                     if($('.errorMsg').length == 0){
                         var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                         $('[id$=createStageName]').after(ele);
                     
                     }
                 }
             }else if(mdl == 'CreatePlay'){
                 if($('[id$=playNameId]').val() != undefined && $('[id$=playNameId]').val() != null && $('[id$=playNameId]').val().trim().length > 0){
                     $('.createPlayNotify').hide();
                     $('[id$=playNameId]').parent().removeClass('slds-has-error');
                     $('.errorMsg').remove();
                     $('[id$=playModal]').modal('dismiss');
                     //alert(stageIdForInsertedPlay + ' - ' + x1);
                     if($('.playMdlHeading').text() == 'New Play'){
                        createPlay(stageIdForInsertedPlay);
                     }else{
                        updatePlay();
                     }
                 }else{
                     $('.createPlayNotify').show();
                     $('.createPlayErrorMsg').text('You must have to give play name!');
                     $('[id$=playNameId]').parent().addClass('slds-has-error');
                     if($('.errorMsg').length == 0){
                         var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                         $('[id$=playNameId]').after(ele);
                     }
                 }
             }else if(mdl == 'CreateProcess'){
             
                 if($('[id$=createProcessName]').val() != undefined && $('[id$=createProcessName]').val() != null && $('[id$=createProcessName]').val().trim().length > 0
                    && ($('[id$=createProcessProgressT]').val() != undefined && $('[id$=createProcessProgressT]').val() != null && $('[id$=createProcessProgressT]').val().trim().length > 0)
                 ){
                     $('.createProcessNotify').hide();
                     $('[id$=createProcessName]').parent().removeClass('slds-has-error');
                      $('[id$=createProcessProgressT]').parent().removeClass('slds-has-error');
                     $('.errorMsg').remove();
                     $('[id$=processModal]').modal('dismiss');
                     updateProcess();
                 }else{
                     /*$('.createProcessNotify').show();
                     $('.createProcessErrorMsg').text('You must have to give process name!');
                     $('[id$=createProcessName]').parent().addClass('slds-has-error');
                     if($('.errorMsg').length == 0){
                         var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                         $('[id$=createProcessName]').after(ele);
                     }
                     */
                    
                    var hasError = false;
                    if($('[id$=createProcessName]').val().trim().length > 0){
                        $('[id$=createProcessName]').parent().removeClass('slds-has-error');                        
                    }else{
                        $('[id$=createProcessName]').parent().addClass('slds-has-error');
                        hasError = true;
                    }
                    
                    if($('[id$=createProcessProgressT]').val().trim().length > 0){
                        $('[id$=createProcessProgressT]').parent().removeClass('slds-has-error');                   
                    }else{
                        $('[id$=createProcessProgressT]').parent().addClass('slds-has-error');
                        hasError = true;
                    }
                    
                    if(hasError){
                        $('.createProcessNotify').show();
                        $('.createProcessErrorMsg').text('You must fill Required fields!');
                    }
                 }
               
                    
             }else if(mdl == 'CreateQuestion'){
                 if($('[id$=createQuestionDesc]').val() === undefined || $('[id$=createQuestionDesc]').val() == null || $('[id$=createQuestionDesc]').val().trim().length == 0){
                     $('.createQuestionNotify').show();
                     $('.createQuestionErrorMsg').text('You must have to give Question!');
                     $('[id$=createQuestionDesc]').parent().addClass('slds-has-error');
                     if($('.errorMsg').length == 0){
                         var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                         $('[id$=createQuestionDesc]').after(ele);
                     }
                 
                 }else if($('[id$=createQuestionIIDealP]').prop('checked') && $('[id$=createQuestionAnsType]').val() != 'Checkbox'){
                     $('.createQuestionNotify').show();
                     $('.createQuestionErrorMsg').text('Answer Type must be of Checkbox type ,if you selected Include In Deal Progress!');
                 }else if($('[id$=createQuestionIIExecS]').prop('checked') && $('[id$=createQuestionAnsType]').val() != 'Text'){
                     $('.createQuestionNotify').show();
                     $('.createQuestionErrorMsg').text('Answer Type must be of Text type ,if you selected Include In Exec Summary!');
                 }else if($('[id$=createQuestionIISuccessI]').prop('checked') && $('[id$=createQuestionAnsType]').val() != 'Rating'){
                     $('.createQuestionNotify').show();
                     $('.createQuestionErrorMsg').text('Answer Type must be of Rating type ,if you selected Include In Success Indicator!');
                 }else if($('[id$=createQuestionIIKeyM]').prop('checked') && $('[id$=createQuestionAnsType]').val() != 'Date'){
                     $('.createQuestionNotify').show();
                     $('.createQuestionErrorMsg').text('Answer Type must be of Date type ,if you selected Include In Key Milestone!');
                 
                 }else if($('[id$=createQuestionAnsType]').val() == 'MultiChoice' || $('[id$=createQuestionAnsType]').val() == 'SingleChoice'){
                     $('.createQuestionNotify').hide();
                     $('[id$=createQuestionDesc]').parent().removeClass('slds-has-error');
                     $('.errorMsg').remove();
                     
                     var flag = false;
                     
                     $('.answers').each(function(index){
                        if($(this).val().trim().length > 0){
                            flag = true; 
                        }       
                     });
                     
                     if(flag == false){
                        $('.createQuestionNotify').show();
                        $('.createQuestionErrorMsg').text('You must have to give atleast one answer!');
                     
                     }else{
                        $('.createQuestionNotify').hide();
                        $('[id$=createQuestionDesc]').parent().removeClass('slds-has-error');
                        $('.errorMsg').remove();
                        $('[id$=questionModal]').modal('dismiss');
                        if($('.questionMdlHeading').text() == 'New Question'){
                            createQuestion();
                        }else{
                            updateQuestion();
                        }
                     }
                 }else{
                     $('.createQuestionNotify').hide();
                     $('[id$=createQuestionDesc]').parent().removeClass('slds-has-error');
                     $('.errorMsg').remove();
                     $('[id$=questionModal]').modal('dismiss');
                     if($('.questionMdlHeading').text() == 'New Question'){
                        createQuestion();
                     }else{
                        updateQuestion();
                     }
                 }
             }else if(mdl == 'CreateMessage'){
                 if($('[id$=createMessageMsg]').val() != undefined && $('[id$=createMessageMsg]').val() != null && $('[id$=createMessageMsg]').val().trim().length > 0){
                     $('.createMessageNotify').hide();
                     $('[id$=createMessageMsg]').parent().removeClass('slds-has-error');
                     $('.errorMsg').remove();
                     $('[id$=messageModal]').modal('dismiss');
                     if($('.messageMdlHeading').text() == 'New Message'){
                        createMessage();
                     }else{
                        updateMessage();
                     }
                 }else{
                     $('.createMessageNotify').show();
                     $('.createMessageErrorMsg').text('You must have to give Message!');
                     $('[id$=createMessageMsg]').parent().addClass('slds-has-error');
                     if($('.errorMsg').length == 0){
                         var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                         $('[id$=createMessageMsg]').after(ele);
                     }
                 }    
             }
          }
          function checkToolValidations(event){
                 if($('[id$=createToolLbl]').val() != undefined && $('[id$=createToolLbl]').val() != null && $('[id$=createToolLbl]').val().trim().length > 0){
                     $('.createToolNotify').hide();
                     $('[id$=createToolLbl]').parent().removeClass('slds-has-error');
                     $('.errorMsg').remove();
                     
                 }else{
                     $('.createToolNotify').show();
                     $('.createToolErrorMsg').text('You must have to give Label!');
                     $('[id$=createToolLbl]').parent().addClass('slds-has-error');
                     if($('.errorMsg').length == 0){
                         var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                         $('[id$=createToolLbl]').after(ele);
                     }
                     event.preventDefault();
  
                 }    
             
          }
          function fillModalValuesForEditStage(stgId,stgName,stgDesc,isLib){
              $('[id$=stageIdForEdit]').val(stgId);
              $('[id$=createStageName]').val(stgName);
              stageOnEdit = stgName;
              $('[id$=createStageDesc]').val(stgDesc);
              if(isLib == true){
                $('[id$=createStageIsLibrary]').prop('checked','true');
              }
              $('.stageMdlHeading').text('Edit Stage');       
          }
          function fillModalValuesForEditProcess(pName,Desc,th){
              $('[id$=createProcessName]').val(pName);
              $('[id$=createProcessDesc]').val(Desc);
              $('[id$=createProcessProgressT]').val(''+th);
          }
          
          function fillModalValuesForEditPlay(playId,playName,playDesc){
              $('[id$=playIdForEdit]').val(playId);
              $('[id$=playNameId]').val(playName);
              $('[id$=playDescId]').val(playDesc);
              
              $('.playMdlHeading').text('Edit Play');  
              
          }
          
          function fillValuesForEditQuestion(){
          }
          
          function fillValuesForEditMessage(){
          }
          
          function fillValuesForEditTool(){
          }
          
          function oncompleteTasks(){
              $('[data-aljs=""modal""]').modal({onShow: function(obj) {
                $('.aljs-modal-container').remove();
                $('body').append('<div class=""aljs-modal-container""><div class=""slds-backdrop slds-backdrop--open""></div></div>');
              }});
              $('[data-aljs=""tooltip""]').tooltip();
                  
          }
          
          function clearModal(id){
              var ele = $('[id$=' + id + ']').html();
              $('[id$=' + id + ']').html('').html(ele);
              $('.slds-notify-container').hide();
              $('.slds-has-error').removeClass('slds-has-error');
              $('.errorMsg').remove();
              oncompleteTasks();
              
              //change heading
              if(id == 'stageModal'){
                  $('.stageMdlHeading').text('New Stage'); 
              }else if(id == 'playModal'){
                  $('.playMdlHeading').text('New Play'); 
                  $('#curStageForPlay').val(playCurStage);
              }else if(id == 'questionModal'){
                  $('.questionMdlHeading').text('New Question'); 
              }else if(id == 'messageModal'){
                  $('.messageMdlHeading').text('New Message'); 
              }
          }  

        function startPlayDrop(playId, stageId, e){
            updatePlay(playId, stageId);            
            //console.log(' drop PlayId : '+playId);
            //console.log(' drop StageId : '+stageId);     
            
            $('#'+playId).data('stageid',''+stageId);
            //console.log($('#'+PlayId).data('stageid'));
            //console.log(' updated play StageId : '+$('#'+playId).data('stageid'));
                               
            $('#playDropConfirmPrompt').modal('dismiss');
            e.preventDefault();
        }
        
        function stopPlayDrop(th){            
            //$('#examplesDrop .sortable-list').sortable('cancel');
            $(th).sortable('cancel');
        }
        
        function updatePlay(PlayId, StageId){        
            
            $('[id$=Status] [id$=start]').show();
            
