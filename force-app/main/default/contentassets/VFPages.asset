                </div>
                
            </div>
            <!-- Tool Clone modal -->
            
            <!-- Training Clone modal --> 
            <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""clone_training_modal"">
                <div class=""slds-modal__container"">
                
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium"">Choose the training template you want to use</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop(); return false"">
