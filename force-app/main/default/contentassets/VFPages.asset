"06615000002uMFHAA2","","PlaymakerPDF","26.0","PlaymakerPDF","","2","PlaymakerPDFController","false","false","<apex:page showHeader=""false"" controller=""PlaymakerPDFController"" renderAs=""PDF"">
<head>
    <meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"" />
<style type=""text/css"">
    html {
        font-size: 100%;
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
    }
    body {
        margin: 0;
        font-family: ""Helvetica Neue"",Helvetica,Arial,sans-serif;
        font-size: 12px;
        line-height: 16px;
        color: #333;
        background-color: white;
    }
    h4 {
        font-size: 17.5px;
    }
    h5 {
        font-size: 14px;
    }
    h1, h2, h3, h4, h5, h6 {
        margin: 0;
        font-family: inherit;
        font-weight: bold;
        line-height: 20px;
        color: inherit;
        text-rendering: optimizelegibility;
    }
    
    .container {
        margin-right: auto;
        margin-left: auto;
        width: 690px;
    }
    
    .row {
        margin-left: -20px;
    }
    
    .span12 {
        width: 690px;
        float: left;
        min-height: 1px;
        margin-left: 20px;
    }
    
    .Red {
        color:red;
    }
    
    .table {
        width: 100%;
        margin-bottom: 20px;
        background-color: transparent;
        border-collapse: collapse;
    }
    
    .table th, .table td {
        padding: 8px;
        text-align: left;
        vertical-align: top;
        /*border-top: 1px solid #DDD;*/
        
    }
	
    .textbackground {
        background:#dbe5f1;
    }
    .headerText {
        color:#17365e;
        font-weight:bold;
    }
    .content {
        font-style:italic;
        font-size:12;
    }
    
    .answer {
        font-size:12;
    }
    
    .Table{
        max-width: 100%;
        background-color: transparent;
        border-collapse: collapse;
        font-size: 12px;
        border-spacing: 0;
    }
    
    .table td {
        border-top:1px solid #17365e;
        border-bottom:1px solid #17365e;
    }
    
    .table td img {
        vertical-align:middle;
        margin-right:10px;
    }
    
    .radio, .checkbox {
        min-height: 20px;
        padding-left: 20px;
    }
    label {
        display: block;
        margin-bottom: 5px;
    }
    
    label, input, button, select, textarea {
        font-size: 12px;
        font-weight: normal;
        line-height: 20px;
    }
</style>
</head>
<body>
<apex:form >
    <div class=""container"">
    <div class=""row"">
        <div class=""span12"" style=""background:#17365e; color:#fff;"">
            <div style=""padding:10px;"">
            <h4>Deal Summary | <span style=""font-style:italic"">{!Opportunity.Name}</span></h4>
            </div>
        </div>
    </div>
    <div class=""row"">
        <div class=""span12"">
            <table class=""table"">
                <tbody>
                    <tr>
                        <td style=""width:30%;"" class=""textbackground headerText"">Account</td>
                        <td class=""headerText"">{!Account.Name}</td>
                    </tr>
                    <tr>
                        <td class=""textbackground headerText"" style=""background:#dbe5f1;"">Amount</td>
                        <td class=""headerText"">
                            <apex:outputText value=""${0,number,###,###,###,##0}"">       
                                <apex:param value=""{!Opportunity.Amount}""/>
                            </apex:outputText>
                        </td>
                    </tr>
                    <tr>
                        <td class=""textbackground headerText"">Stage</td>
                        <td class=""headerText""><apex:outputField value=""{!Opportunity.StageName}""/></td>
                    </tr>
                    <tr>
                        <td class=""textbackground headerText"">Close Date</td>
                        <td class=""headerText""><apex:outputField value=""{!Opportunity.CloseDate}""/></td>
                    </tr>
                    <tr>
                        <td class=""textbackground headerText"">Follow-Up Date</td>
                        <td class=""headerText""><apex:outputField value=""{!ProcessInstance.FollowUp__c}""/></td>
                    </tr>
                    <tr>
                        <td class=""textbackground headerText"">Winnability Score</td>
                        <td class=""headerText"">{!WinnabilityScore}</td><!-- {!if(ProcessInstance.Score_percent__c == null , 0 , ProcessInstance.Score_percent__c)} -->
                    </tr>

                    <tr>
                        <td class=""textbackground headerText"">Red Flags</td>
                        <td class=""headerText"" style=""color:red"">{!ProcessInstance.RedFlagCount__c}</td>
                     </tr>
                </tbody>
            </table>
        </div>
    </div>
    <apex:outputPanel layout=""block"" rendered=""{!Contacts.size > 0}"">
    <div class=""row"">
        <div class=""span12"" style=""background:#17365e; color:#fff;"">
            <div style=""padding:10px;"">
            <h5>Player Chart</h5>
            </div>
        </div>
    </div>
    <div class=""row"" >
        <div class=""span12"">
            <table class=""table"" >
                <thead>
                    <tr class=""textbackground"">
                        <th style=""width:17%;border-bottom:1px solid #17365e;"">Name</th>
                        <th style=""width:25%;border-bottom:1px solid #17365e;"">Title</th>
                        <th style=""width:14.5%;border-bottom:1px solid #17365e;"">Role</th>
                        <th style=""width:14.5%;border-bottom:1px solid #17365e;"">Influence</th>
                        <th style=""width:14.5%;border-bottom:1px solid #17365e;"">Stance</th>
                        <th style=""width:14.5%;border-bottom:1px solid #17365e;"">Priority</th>
                    </tr>   
                </thead>
                <tbody>
                <apex:repeat value=""{!Contacts}"" var=""contact"" id=""contactList"">
                    <tr>
                        <td style=""border-bottom:1px solid #17365e;"">{!contact.Contact__r.FirstName} {!contact.Contact__r.LastName}</td>
                        <td style=""border-bottom:1px solid #17365e;"">{!contact.Contact__r.Title}</td>
                        <td style=""border-bottom:1px solid #17365e;"">{!contact.Role__c}</td>
                        <td style=""border-bottom:1px solid #17365e;"">{!contact.Influence__c}</td>
                        <td style=""border-bottom:1px solid #17365e;"">{!contact.Stance__c}</td>
                        <td style=""border-bottom:1px solid #17365e;"">{!contact.Priority__c}</td>
                    </tr>
                </apex:repeat>
                </tbody>
            </table>
        </div>
    </div>
    </apex:outputPanel>
    <apex:outputPanel layout=""block"" rendered=""{!QuestionInstanceExecSummary.size > 0}"">
    <div class=""row"">
        <div class=""span12"" style=""background:#17365e; color:#fff;"">
            <div style=""padding:10px;"">
            <h5>Executive Summary</h5>
            </div>
        </div>
    </div>
    <div class=""row"" >
        <div class=""span12"">
            <table class=""table""  >
                <tbody>
                <apex:repeat value=""{!QuestionInstanceExecSummary}"" var=""qns"" id=""theRepeat"">
                    <tr>
                        <td style=""width:40%;border-bottom:1px solid #17365e;"" class=""textbackground content""><apex:outputText value=""{!qns.Description__c}"" id=""theValue""/></td>
                        <td style=""vertical-align:middle;border-bottom:1px solid #17365e;"" class=""answer"">
                            <apex:repeat var=""ans"" value=""{!qns.AnswerInstances__r}"">
                                <apex:outputLabel styleClass=""checkbox"" rendered=""{!ans.Selected__c}"" style=""{!IF(ans.FlagType__c=='Red' && ans.Selected__c ==true,'color:red','')}"">
                                <apex:outputText value=""$"" rendered=""{!IF(qns.ResponseType__c=='Currency'&& ans.Selected__c ==true,true,false)}""/>
                                <apex:outputField value=""{!ans.Answer__c}"" rendered=""{!ans.Selected__c}""/>                                
                                </apex:outputLabel>
                            </apex:repeat>
                            <apex:outputField value=""{!qns.Note__c}"" rendered=""{!IF(ISBLANK(qns.Note__c) , false , true)}"" />
                        </td>
                    </tr>
                </apex:repeat>
                </tbody>
            </table>
        </div>
    </div>
    </apex:outputPanel>
    <apex:outputPanel layout=""block"" rendered=""{!QuestionInstanceMilestones.size > 0}"">
    <div class=""row"">
        <div class=""span12"" style=""background:#17365e; color:#fff;"">
            <div style=""padding:10px;"">
            <h5>Key Milestones</h5>
            </div>
        </div>
    </div>
    <div class=""row"" >
        <div class=""span12"">
            <table class=""table"">
                <tbody>
                <apex:repeat value=""{!QuestionInstanceMilestones}"" var=""qns"" id=""theRepeatMilestone"">
                    <tr>
                        <td style=""width:40%;border-bottom:1px solid #17365e;"" class=""textbackground content""><apex:outputText value=""{!qns.Description__c}"" id=""theValue""/></td>
                        <td style=""vertical-align:middle;border-bottom:1px solid #17365e;"" class=""answer"">
                            <apex:repeat var=""ans"" value=""{!qns.AnswerInstances__r}"">
                                <apex:outputLabel styleClass=""checkbox"" rendered=""{!ans.Selected__c}"" style=""{!IF(ans.FlagType__c=='Red' && ans.Selected__c ==true,'color:red','')}"">
                                    <apex:outputText value=""$"" rendered=""{!IF(qns.ResponseType__c=='Currency'&& ans.Selected__c ==true,true,false)}""/>
                                    <apex:outputField value=""{!ans.Answer__c}"" rendered=""{!ans.Selected__c}""/>   
                                </apex:outputLabel>
                            </apex:repeat>
                            <apex:outputField value=""{!qns.Note__c}"" rendered=""{!IF(ISBLANK(qns.Note__c) , false , true)}"" />
                        </td>
                    </tr>
                </apex:repeat>
                </tbody>
            </table>
        </div>
    </div>
    </apex:outputPanel>
    <apex:outputPanel layout=""block"" rendered=""{!Notes.size > 0}"">
    <div class=""row"">
        <div class=""span12"" style=""background:#17365e; color:#fff;"">
            <div style=""padding:10px;"">
            <h5>Deal Notes</h5>
            </div>
        </div>
    </div>
    <div class=""row"" >
        <div class=""span12"">
            <table class=""table"" >
                <tbody>
                    <apex:repeat value=""{!Notes}"" var=""note"" id=""noteList"">
                    <tr>
                        <td style=""border-bottom:1px solid #17365e;""><strong style=""float:left""><apex:outputText value=""{!note.Title}"" /></strong>
                        <span style=""float:right""><apex:outputText value=""Posted by {!note.CreatedBy.FirstName} {!note.CreatedBy.LastName}, {0,date,MMMM dd', 'yyyy HH:mm:ss a}"">
                            <apex:param value=""{!note.CreatedDate}"" />
                        </apex:outputText></span>
                            <p style=""clear:both""><apex:outputField value=""{!note.body}"" /></p>
                        </td>
                    </tr>
                    </apex:repeat>
                </tbody>
            </table>
        </div>
    </div>
    </apex:outputPanel>
    </div><!-- end of container -->
    </apex:form>
</body>
</apex:page>","2016-01-18T07:48:03.000Z","00515000006PjX3AAK","2016-11-16T11:53:47.000Z","00515000006PhzjAAC","2016-11-16T11:53:47.000Z"
"06615000003EQr8AAG","","OpportunityDashboard","36.0","OpportunityDashboard","","2","OpportunityDashboardController","true","false","<apex:page controller=""OpportunityDashboardController"" sidebar=""false""  showHeader=""true"" standardStylesheets=""true"" applyBodyTag=""false"" docType=""html-5.0"" applyHtmlTag=""true"" id=""thePage"">
  <apex:stylesheet value=""{!URLFOR($Resource.slds, 'assets/styles/salesforce-lightning-design-system-vf.css')}"" />
  <script src=""{!URLFOR($Resource.jquery,'jquery.min.js')}""></script>
  <script src=""{!URLFOR($Resource.aljs, 'jquery.aljs-init.min.js')}""></script>
  <script src=""{!URLFOR($Resource.aljs, 'jquery.aljs-modal.min.js')}""></script>
  <script src=""{!URLFOR($Resource.aljs, 'jquery.aljs-tooltip.min.js')}""></script>
  <script src=""{!URLFOR($Resource.aljs, 'moment.js')}""></script>
  <script src=""{!URLFOR($Resource.aljs, 'jquery.aljs-datepicker.min.js')}""></script>
   
  <script>
  
      var assetsLocation = '{!URLFOR($Resource.slds)}';
      $.aljsInit({
          assetsLocation: assetsLocation,
          scoped: true
      });
    

  </script>
  
  <html xmlns=""http://www.w3.org/2000/svg"" xmlns:xlink=""http://www.w3.org/1999/xlink"">
      <head>
          <style>
              .custPopup{
                  left: 50%;
                top: 50%;
                z-index: 9999;
                position: absolute;
                margin-top: -28px;
                margin-left: -28px;
              } 
                
              .popupBackground{ 
                    background-color:white;
                    opacity: 0.40;
                    filter: alpha(opacity = 30);
                    position:fixed;
                    width: 100%;
                    height: 100%;
                    top: 0;
                    left: 0;
                    z-index: 9998; 
              }
              .slds-notify--toast {
                  margin:0px !important;
                  margin-top:8px !important;
                  margin-bottom:8px !important;
                  
              }
              
              /* Added new css : 3-25-2016 */
              .NewProcessAction{
                    display:block;
                    text-align:center;
                    padding:5px;
                    text-decoration:none !important;
                    color:#505050 !important
              }
              .checked{display:none;}
              
              .slds-backdrop--open {
                    opacity: 0.7 !important;
                    transition: opacity 0.4s linear 0s;
                    visibility: visible;
                }
                
              .slds-modal__header{
                    background : #00599c !important;
                    color : white !important;
              }
                .slds-modal__content{
                    background:#f4f6f9 !important;
              }
                .slds-modal__footer{
                    background:#adcfe6 !important;
              }
            .slds-list__item:hover{
                background: #0F9AD0 !important;
            }
            #playbooxData {
                padding-bottom: 20px;
            }
            .tile-detail{
                width:100%;
                height:100%; 
                font-size:13px;   
            }
            .tile-detail tbody tr td{
                white-space:nowrap;  text-overflow:ellipsis; max-width:200px;color:white;
            }
            .slds-tile{      
                height: 85%;
                min-height: 70px;
            }
            
            .slds-list__item{
                background:#00A1E0;
                color:white !important;
                min-width:200px !important;
                width:325px !important;
                max-width:325px !important;
                height:170px !important;
                min-height:100px;
                cursor:pointer;
            }
           
             .slds .slds-tabs--path {
                margin-right: 5px;
             }
             /* Custom header css */
             .slds-dropdown--length-with-icon-10 {
                max-height: calc((1.5rem + 1rem) * 10);
                overflow-y: auto;
                -webkit-overflow-scrolling: touch;
             }
             .slds-active {
                background-color: #D8DDe9;                  
                color: #16325c;
             }
             .slds .slds-picklist__options{
                 height:auto;
             }
             .slds-select[size]{
                 overflow:auto !important;
             }
             .slds-select{
                 border-radius: 0 !important;
                 max-height: 250px !important;
             }
             .slds-select[size] option{
                 padding: 4px !important;
             }
            /*.slds-select::-webkit-scrollbar {display:none;}
            .slds-select::-moz-scrollbar {display:none;}
            .slds-select::-o-scrollbar {display:none;}
            .slds-select::-google-ms-scrollbar {display:none;}
            .slds-select::-khtml-scrollbar {display:none;}*/
            
            .slds .slds-datepicker td {
                padding: 0 !important;
            }
            .slds-select{ border:none !important; font-size:13px !important; }
            .filter-col { border: 1px solid #d8dde6; padding: 5px; margin: 10px 5px; }
            
            #playbooxData {
                /*padding-bottom: 20px;
                position: absolute;
                z-index: -1;
                top: 120px;*/
            }
            #filterOptions{ 
                background: #fff;
                display:none;
                /*box-shadow: 0 7px 10px 1px rgba(0, 0, 0, 0.3);*/
                border-bottom: 1px solid #d8dde6;
            }
            #filterOptions div .filter-col{
                /*min-width:150px;*/                
                min-height:300px;               
                max-height:300px;               
            }
            .slds-input {
                font-size:13px !important; 
            }
           .slds-select:focus,
            .slds-select:active {             
              outline: 0 !important; 
              border-color: none !important; 
              background-color: white !important; 
              box-shadow: none !important; 
            }
            .slds-lookup__menu{
                font-size:13px;
                width:200px !important; 
            }
            .slds-lookup__list {
                /*max-height: 165px !important; */
            }
            #playbooxData{
                background-color: white !important; 
            }
            
            
            li.slds-list__item, li.slds-list__item:hover {
                background : #00599c !important;
            }
            .slds-is-current, .slds-is-current:hover{
                background-color : #00b8e0 !important;
            }
            .paddingTopBottom10{
                padding : 5px 0px 5px 0px !important;
            }
            
            .activityTable td{
                padding : 2px 5px 2px 5px !important;
            }
            .openActivityTD .slds-nubbin--top:after{
                left : 18% !important;
            }
            .openActivityTD .slds-nubbin--top:before{
                left : 18% !important;
            }
            .openActivityAnchor{
                color: white !important;    
            }
            .openActivityAnchor:hover{
                color: white !important;
            }
            
            .dealSummaryTD td.popElementDS {
                white-space: normal !important;
                vertical-align: top !important;
                padding-top: 5px !important;
            }
             /*outline: 0;
              border-color: #1589ee;
              background-color: white;
              box-shadow: 0 0 3px #0070D2;*/
          </style>
          <script>
              
                var filterCleared = false;                
               // Clear filter
               function clearFilterCriteria(){                   
                    // Clear all seleted values in UI using js                                      
                    $('[id$=stagesFilter]').val('All');
                    $('[id$=amountFilter]').val('All');
                    $('[id$=followUpFilter]').val('All');
                    $('[id$=closeDateFilter]').val('All');
                    //$('[id$=forecastFilter]').val('All');
                    $('[id$=dealConfidenceFilter]').val('All');
                    $('[id$=ownerFilter]').val('All');
                    $('[id$=playbookFilter]').val('All');
                    $('[id$=accountFilter]').val('All');
                    
                    $('[id$=amountMinVal]').val('');
                    $('[id$=amountMaxVal]').val('');
                    $('[id$=followupFromDate]').val('');
                    $('[id$=followupToDate]').val('');
                    $('[id$=closeFromDate]').val('');
                    $('[id$=closeToDate]').val('');
                    $('[id$=playbookName]').val('');
                    $('[id$=accountName]').val('');
                    $('[id$=userName]').val('');
                    
                    
                    // Call function to submit criteria
                    submitNewCriteria(true);
                    filterCleared = true; 
                    saveFilterCriteria();
                    $('#filterOptions').slideUp(500); 
               }
               
               // Save filter
               function saveFilterCriteria(){
                   var invalidDate = false;
                   $('.pickDate').each(function(){
                       if($(this).val().trim().length>0){
                        var dateString = $(this).val();
                        var date_regex = /^(0[1-9]|1[0-2])\/(0[1-9]|1\d|2\d|3[01])\/(19|20)\d{2}$/;
                        if (!(date_regex.test(dateString))) {                          
                          invalidDate = true;
                          $(this).css('border-color','red');
                          console.log('false');
                        }else{
                           $(this).css('border-color','#d8dde6'); 
                           console.log('true');
                        }  
                       }                      
                   });
                   
                   if(invalidDate){
                       return false;
                   }
                   
                   $('[id$=Status] [id$=start]').show(); 
                   
                   var d = new Date();
                   d.setTime(d.getTime() + (365*24*60*60*1000));
                   var expires = ""expires=""+d.toUTCString();
                   
                   // Clear and Save filter cookies  
                   if(filterCleared){
                       document.cookie = ""apex__PB_OppFilterPlaybookStage"" + ""="" + """" + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterDealSize"" + ""="" + """" + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterCloseDate"" + ""="" + """" + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterForcast"" + ""="" + """" + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterConfidenceIndicator"" + ""="" + """" + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterAccount"" + ""="" + """" + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterFollowUpDate"" + ""="" + """" + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterPlaybook"" + ""="" + """" + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterOwner"" + ""="" + """" + ""; "" + expires;
                       //document.cookie = ""apex__PB_OppFilterRole"" + ""="" + """" + ""; "" + expires;
                   }else{
                       //****** Save current selected values to filter cookies                       
                       var followUpFilter = $('[id$=followUpFilter]').val() == null ? '' : $('[id$=followUpFilter]').val();                       
                       var accountFilter = $('[id$=accountFilter]').val() == null ? '' : $('[id$=accountFilter]').val();
                       var dealConfidenceFilter = $('[id$=dealConfidenceFilter]').val() == null ? '' : $('[id$=dealConfidenceFilter]').val();
                       //var forecastFilter = $('[id$=forecastFilter]').val() == null ? '' : $('[id$=forecastFilter]').val();
                       var closeDateFilter = $('[id$=closeDateFilter]').val() == null ? '' : $('[id$=closeDateFilter]').val();                        
                       var amountFilter = $('[id$=amountFilter]').val() == null ? '' : $('[id$=amountFilter]').val();
                       var stagesFilter = $('[id$=stagesFilter]').val() == null ? '' : $('[id$=stagesFilter]').val();
                       var playbookFilter = $('[id$=playbookFilter]').val() == null ? '' : $('[id$=playbookFilter]').val();
                       var ownerFilter = $('[id$=ownerFilter]').val() == null ? '' : $('[id$=ownerFilter]').val();
                       //var roleFilter = $('[id$=roleFilter]').val() == null ? '' : $('[id$=roleFilter]').val();
                       console.log(ownerFilter);
                       
                       var followUpCookie = (followUpFilter == 'Range') ? followUpFilter+'&'+$('[id$=followupFromDate]').val()+'&'+$('[id$=followupToDate]').val(): followUpFilter;
                       var accountCookie = (accountFilter != 'All') ? $('[id$=accountFilter] option:selected').text()+'&&'+accountFilter : accountFilter;
                       var dealConfidenceCookie = (dealConfidenceFilter != '') ? dealConfidenceFilter.join('&&') : '';
                       //var forecastCookie = (forecastFilter != '') ? forecastFilter.join('&&') : '';
                       var closeDateCookie = (closeDateFilter == 'Range') ? closeDateFilter+'&'+$('[id$=closeFromDate]').val()+'&'+$('[id$=closeToDate]').val() : closeDateFilter;
                       var amountCookie = (amountFilter == 'Range') ? amountFilter +'&'+$('[id$=amountMinVal]').val()+'&'+$('[id$=amountMaxVal]').val() : amountFilter;
                       var stagesCookie = (stagesFilter != '') ? stagesFilter.join('&&') : '';
                       var playbookCookie = (playbookFilter != 'All') ? $('[id$=playbookFilter] option:selected').text()+'&&'+playbookFilter : playbookFilter;
                       var ownerCookie = (ownerFilter != 'All') ? $('[id$=ownerFilter] option:selected').text()+'&&'+ownerFilter : ownerFilter;
                       //var roleCookie = (roleFilter != 'All') ? $('[id$=roleFilter] option:selected').text()+'&&'+roleFilter : roleFilter;
                       
                       document.cookie = ""apex__PB_OppFilterPlaybookStage"" + ""="" + stagesCookie + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterDealSize"" + ""="" + amountCookie + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterCloseDate"" + ""="" + closeDateCookie + ""; "" + expires;
                       //document.cookie = ""apex__PB_OppFilterForcast"" + ""="" + forecastCookie + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterConfidenceIndicator"" + ""="" + dealConfidenceCookie + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterAccount"" + ""="" + accountCookie + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterFollowUpDate"" + ""="" + followUpCookie + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterPlaybook"" + ""="" + playbookCookie + ""; "" + expires;
                       document.cookie = ""apex__PB_OppFilterOwner"" + ""="" + ownerCookie + ""; "" + expires;
                       //document.cookie = ""apex__PB_OppFilterRole"" + ""="" + roleCookie + ""; "" + expires;
                   }
                   filterCleared = false;  
                   
                   setTimeout(function(){
                       $('[id$=Status] [id$=start]').hide(); 
                   },3000);        
               }
              
               // Load filter
               function loadFilterCriteria(){
                   var invalidDate = false;
                   $('.pickDate').each(function(){
                       if($(this).val().trim().length>0){
                        var dateString = $(this).val();
                        var date_regex = /^(0[1-9]|1[0-2])\/(0[1-9]|1\d|2\d|3[01])\/(19|20)\d{2}$/;
                        if (!(date_regex.test(dateString))) {                          
                          invalidDate = true;
                          $(this).css('border-color','red');
                        }else{
                           $(this).css('border-color','#d8dde6'); 
                        }  
                       }                      
                   });
                   
                   if(invalidDate){
                       return false;
                   }
                   
                   filterCleared = false;                   
                   loadCriteria();
                   $('#filterOptions').slideUp(500); 
               }
               
               function submitNewFilters(e){
               
                   var invalidDate = false;
                   $('.pickDate').each(function(){
                       if($(this).val().trim().length>0){
                        var dateString = $(this).val();
                        var date_regex = /^(0[1-9]|1[0-2])\/(0[1-9]|1\d|2\d|3[01])\/(19|20)\d{2}$/;
                        if (!(date_regex.test(dateString))) {                          
                          invalidDate = true;
                          $(this).css('border-color','red');
                        }else{
                           $(this).css('border-color','#d8dde6'); 
                        }  
                       }                      
                   });
                   
                   if(invalidDate){
                       return false;
                   }
                   $('#filterOptions').slideUp(500);
                   console.log('+++++++++');
                   submitNewCriteria(false);
               }
               
              /* ========================= */              
              function amountFilter(){
                  if($('[id$=amountFilter]').val() == 'Range'){
                    $('#amountMin').show();
                    $('#amountMax').show();
                  }else{
                    $('#amountMin').hide();
                    $('#amountMax').hide();
                  }
              }   
              function closeDateFilter(){ 
                  if($('[id$=closeDateFilter]').val() == 'Range'){
                    $('#closeDateFrom').show();
                    $('#closeDateTo').show();
                  }else{
                    $('#closeDateFrom').hide();
                    $('#closeDateTo').hide();
                  }
              }   
              function followUpFilter(){     
                  if($('[id$=followUpFilter]').val() == 'Range'){
                    $('#followUpFrom').show();
                    $('#followUpTo').show();
                  }else{
                    $('#followUpFrom').hide();
                    $('#followUpTo').hide();
                  }
              }                
              //function forecastFilter(){
              //    if($('[id$=forecastFilter]').val() != null && $('[id$=forecastFilter]').val().length > 1){
              //        $(""[id$=forecastFilter] [value='All']"").prop(""selected"", false);
              //    }
              //}
              function dealConfidenceFilter(){
                  if($('[id$=dealConfidenceFilter]').val() != null && $('[id$=dealConfidenceFilter]').val().length > 1){
                      $(""[id$=dealConfidenceFilter] [value='All']"").prop(""selected"", false);
                  }
              }
              function stagesFilter(){
                  if($('[id$=stagesFilter]').val() != null && $('[id$=stagesFilter]').val().length > 1){
                      $(""[id$=stagesFilter] [value='All']"").prop(""selected"", false);
                  }
              }
        
            // Initialize all javascript.
            function initJS(){
                $('[data-aljs=""tooltip""]').tooltip();   
                  
                $('[id$=followupFromDate]').datepicker({
                    format: 'MM/DD/YYYY',
                    //initDate: moment(),
                    onChange: function(datepicker) {                        
                        console.log(datepicker);
                        console.log(this);
                    }
                });
                $('[id$=followupToDate]').datepicker({
                    format: 'MM/DD/YYYY',
                    //initDate: moment(),
                    onChange: function(datepicker) {
                        console.log(datepicker);
                        console.log(this);
                    }
                });
              
                $('[id$=closeFromDate]').datepicker({
                    format: 'MM/DD/YYYY',
                    //initDate: moment(),
                    onChange: function(datepicker) {                        
                        console.log(datepicker);
                        console.log(this);
                    }
                });
                $('[id$=closeToDate]').datepicker({
                    format: 'MM/DD/YYYY',
                    //initDate: moment(),
                    onChange: function(datepicker) {
                        console.log(datepicker);
                        console.log(this);
                    }
                });
                
                amountFilter();
                closeDateFilter();
                followUpFilter();
                
                
            }        
              function initLookUp(){
                  packageNameSpace = '{!namespaceStr}';
                  createLookup('userDiv','userName','userId','user','{!URLFOR($Resource.slds, 'assets/icons/standard-sprite/svg/symbols.svg#user')}','slds-icon-standard-user','ownerFilter'); 
                  createLookup('playbookDiv','playbookName','playbookId','{!namespaceStr}' + 'PbxProcess__c','{!URLFOR($Resource.slds, 'assets/icons/custom-sprite/svg/symbols.svg#custom55')}','slds-icon-standard-lead','playbookFilter'); 
                  createLookup('accountDiv','accountName','accountId','account','{!URLFOR($Resource.slds, 'assets/icons/standard-sprite/svg/symbols.svg#account')}','slds-icon-standard-account','accountFilter'); 
              } 
              
          </script>
      </head>
      <body>
        <div class=""slds"">
          
        <apex:form id=""frm"">
            <c:Lightning_Lookup />
          
          <!--  Action Status Start animation -->
          <apex:actionStatus id=""Status"" >
            <apex:facet name=""start""> 
             <apex:outputPanel id=""tstpopup""> 
                <apex:outputPanel styleClass=""popupBackground"" layout=""block"" style=""width:100%""/> 
                <apex:outputPanel styleClass=""custPopup"" layout=""block""> 
                    <div class=""slds-spinner--medium"">
                        <img src=""{!URLFOR($Resource.slds, 'assets/images/spinners/slds_spinner_brand.gif')}"" alt=""Loading..."" style=""margin-top:150%""/>
                    </div>
                </apex:outputPanel> 
             </apex:outputPanel> 
            </apex:facet> 
          </apex:actionStatus>  
          <!--  Action Status End -->
          
          <!-- Call this function for Submit Or Clear filter  -->
          <apex:actionFunction name=""submitNewCriteria"" action=""{!submitScoreboardFilter}"" status=""Status"" reRender=""filterSection, stagesFilter, mainDiv"" oncomplete=""oncompleteTasks();"">
              <apex:param assignTo=""{!clearFilter}"" name=""ppi"" value=""""/>
          </apex:actionFunction>
          
          <apex:actionFunction name=""resetPicklist"" action=""{!addNewOption}"" reRender=""accountFilter , playbookFilter, ownerFilter"" status=""Status"" oncomplete=""oncompleteTasks();"">
              <apex:param assignTo=""{!newOption}"" name=""ppi1"" value=""""/>
          </apex:actionFunction>
                
          <!-- Call this fun. on Load filter -->
          <apex:actionFunction name=""loadCriteria"" action=""{!loadScoreboardFilter}"" status=""Status"" reRender=""filterSection, mainDiv"" oncomplete=""oncompleteTasks();""/>
         
          <!-- dashboard start -->
          <section id=""header"">   
              <div class=""slds-page-header"" role=""banner"">
                  <div class=""slds-grid slds-p-vertical--small"">
                  
                    <!-- <div class=""slds-col slds-has-flexi-truncate"">
                      <p class=""slds-text-heading--label"">Playboox PlayMaker</p>
                      <div class=""slds-grid"">
                      
                        <div class=""slds-grid slds-type-focus slds-no-space"">
                            <h1 class=""slds-text-heading--large slds-truncate"" title=""Dashboard"">Opportunities Scoreboard</h1>                            
                        </div>
                        
                        <div style=""float:right"">
                            <button aria-live=""assertive"" onclick=""$('#filterOptions').slideToggle(); $('.slds-lookup__menu').addClass('slds-hide');  return false"" data-aljs=""tooltip""  data-aljs-placement=""left"" title=""Filter Options"" class=""slds-button slds-button--icon-container"" aria-haspopup=""true"">                            
                              <c:SVGComponent styleClass=""slds-button__icon"" path=""/assets/icons/utility-sprite/svg/symbols.svg#settings""/>
                            </button>
                        </div>
                        
                      </div>
                    </div>-->
                    <div class=""slds-col slds-has-flexi-truncate"">
                      <p class=""slds-text-heading--label"">Playboox PlayMaker</p>
                      <div class=""slds-grid"" style=""display:inline"">
                      
                        <div style=""float:left"" class=""slds-grid slds-type-focus slds-no-space"">
                            <h1 class=""slds-text-heading--large slds-truncate"" title=""Opportunities Scoreboard"">Opportunities Scoreboard</h1>                            
                        </div>
                        <div style=""float:right"">
                            <button aria-live=""assertive"" onclick=""$('#filterOptions').slideToggle(); $('.slds-lookup__menu').addClass('slds-hide');  return false"" data-aljs=""tooltip""  data-aljs-placement=""left"" title=""Filter Options"" class=""slds-button slds-button--icon-container"" aria-haspopup=""true"">                            
                              <c:SVGComponent styleClass=""slds-button__icon"" path=""/assets/icons/utility-sprite/svg/symbols.svg#settings""/>
                            </button>
                        </div>
                        
                      </div>
                    </div>
                    
                    <!--<div class=""slds-col slds-no-flex slds-align-bottom"">
                      <div class=""slds-grid"">
                        <div class=""slds-button-space-left"" role=""group"">                          
                          <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""processFirstModal"">
                              <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                              New Playbook
                          </a>
                        </div>
                      </div>
                    </div>-->
                    
                  </div>
              </div>
          </section>
          
          <!-- Filter records header -->
          <apex:outputPanel id=""filterSection"" >          
                <div id=""filterOptions"" class=""slds-size--12-of-12"" style="""">   
                                
                    <div style=""width:100%; "" class="" slds-grid slds-wrap slds-has-divider--bottom-space"">         
                          <!--<div class=""slds-col"">
                            <label class=""slds-form-element__label"" for=""select-01"">Role</label>
                            <div class=""slds-scrollable--y"" >                                            
                                <div class=""slds-form-element"">
                                    <div class=""slds-form-element__control"">                                                 
                                      <apex:selectList value=""{!roleSelectedFilter}"" id=""roleFilter"" styleclass=""slds-select"">
                                          <apex:selectOptions value=""{!roleFilter}""/>
                                      </apex:selectList>                            
                                    </div>                                                 
                                </div>
                            </div>
                           </div>-->
                                    
                            <div class=""slds-col filter-col"" style=""max-width:150px; min-width:150px;"">                                                                            
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"" for=""select-01""><b>Owner</b></label>
                                    <div class=""slds-form-element__control"">                                                 
                                      <apex:selectList style=""min-height:80px"" size=""2"" value=""{!ownerSelectedFilter}"" id=""ownerFilter"" styleclass=""slds-select"">
                                          <apex:selectOptions value=""{!ownerFilter}""/>
                                      </apex:selectList>                   
                                    </div> 
                                </div>       
                                <!--<div class=""autocomplete"" style=""margin-top:20px"">
                                    <input type=""text"" class=""slds-input slds-input--small""/>
                                </div>-->
                                <div class=""slds-form-element"">                                  
                                    <div class=""slds-form-element__control"">
                                        <input type=""text"" id=""userName"" />
                                        <input type=""hidden"" id=""userId"" value=""""/>
                                        <div id=""userDiv""></div>
                                    </div>
                                </div>                      
                            </div>
                                    
                            <div class=""slds-col filter-col"" style=""max-width:150px; min-width:150px;"">                                
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"" for=""select-01""><b>Playbook</b></label>
                                    <div class=""slds-form-element__control"">                                                 
                                      <apex:selectList style=""min-height:80px"" size=""2"" value=""{!playbookSelectedFilter}"" id=""playbookFilter"" styleclass=""slds-select"">
                                          <apex:selectOptions value=""{!playbookFilter}""/>
                                      </apex:selectList>                     
                                    </div>   
                                </div>
                                <!--<div class=""autocomplete"" style=""margin-top:20px"">
                                    <input type=""text"" class=""slds-input slds-input--small""/>
                                </div>-->                                 
                                <div class=""slds-form-element"">                                  
                                    <div class=""slds-form-element__control"">
                                        <input type=""text"" id=""playbookName""/>
                                        <input type=""hidden"" id=""playbookId"" value=""""/>
                                        <div id=""playbookDiv""></div>
                                    </div>
                                </div>                                 
                            </div>
                                    
                            <div class=""slds-col filter-col"" style=""max-width:140px; min-width:140px;"">                                
                                <div class=""slds-form-element"">
                                   <label class=""slds-form-element__label"" for=""select-01""><b>Stage</b></label>
                                   <div class=""slds-form-element__control"">                                                 
                                      <apex:selectList value=""{!selectedStagesFilter}"" id=""stagesFilter"" onchange=""stagesFilter(); return false"" multiselect=""true"" styleclass=""slds-select"">
                                          <apex:selectOptions value=""{!stagesFilter}""/>
                                      </apex:selectList>
                                   </div>   
                                </div>
                            </div>
                                    
                            <div class=""slds-col filter-col"" style=""max-width:120px;"">                                
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"" for=""select-01""><b>Amount</b></label>
                                    <div class=""slds-form-element__control"">                                                 
                                      <apex:selectList value=""{!amountSelectedFilter}"" styleclass=""slds-select"" onchange=""amountFilter(); return false"" id=""amountFilter"">
                                          <apex:selectOptions value=""{!amountFilter}""/>
                                      </apex:selectList>              
                                    </div>   
                                    <div class=""slds-form-element__control"" id=""amountMin"" style=""display:none; padding-top:5px;"">
                                        <label class=""slds-form-element__label"" for=""select-01""><b>Min:</b></label>
                                        <apex:inputText html-onpaste=""validatePasteChar(this);"" onkeyup=""validateChar(this)"" value=""{!amountMin}"" id=""amountMinVal"" styleclass=""slds-input slds-input--small""/></div>
                                    <div class=""slds-form-element__control"" id=""amountMax"" style=""display:none; padding-top:5px;"">
                                        <label class=""slds-form-element__label"" for=""select-01""><b>Max:</b></label>
                                        <apex:inputText html-onpaste=""validatePasteChar(this);"" onkeyup=""validateChar(this)"" value=""{!amountMax}"" id=""amountMaxVal"" styleclass=""slds-input slds-input--small""/></div>
                                </div>                         
                            </div>
                                    
                            <div class=""slds-col filter-col"" style=""max-width:120px;"">                                
                                <div class=""slds-form-element"">    
                                    <label class=""slds-form-element__label"" for=""select-01""><b>Close</b></label>
                                    <div class=""slds-form-element__control"">                                                 
                                      <apex:selectList value=""{!closeDateSelectedFilter}"" id=""closeDateFilter"" onchange=""closeDateFilter(); return false"" styleclass=""slds-select"">
                                          <apex:selectOptions value=""{!closeDateFilter}""/>
                                      </apex:selectList>                             
                                    </div>   
                                    <div class=""slds-form-element__control"" id=""closeDateFrom"" style=""display:none"">
                                        <!--<div class=""slds-input-has-icon slds-input-has-icon--right"">-->
                                            <label class=""slds-form-element__label"" for=""select-01""><b>From:</b></label>                                             
                                            <apex:inputText value=""{!closeDateFrom}"" id=""closeFromDate"" styleClass=""pickDate slds-input slds-input--small""/>
                                            <!--<c:SVGComponent styleClass=""slds-button__icon slds-icon-text-default"" path=""/assets/icons/utility-sprite/svg/symbols.svg#event""/>-->
                                        <!--</div>-->
                                    </div>
                                    <div class=""slds-form-element__control"" id=""closeDateTo"" style=""display:none"">
                                        <!--<div class=""slds-input-has-icon slds-input-has-icon--right"">-->        
                                            <label class=""slds-form-element__label"" for=""select-01""><b>To:</b></label>                                        
                                            <apex:inputText value=""{!closeDateTo}"" id=""closeToDate"" styleclass=""pickDate slds-input slds-input--small""/>
                                            <!--<c:SVGComponent styleClass=""slds-button__icon slds-icon-text-default"" path=""/assets/icons/utility-sprite/svg/symbols.svg#event""/>-->
                                        <!--</div>-->
                                    </div>   
                                </div>
                            </div>
                                    
                            <!--<div class=""slds-col filter-col"" style=""max-width:140px; min-width:140px;"">                                
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"" for=""select-01""><b>Forecast</b></label>
                                    <div class=""slds-form-element__control"">                                                 
                                      <apex:selectList value=""{!forecastSelectedFilter}"" onchange=""forecastFilter(this); return false"" id=""forecastFilter"" multiselect=""true"" styleclass=""slds-select"">
                                          <apex:selectOptions value=""{!forecastFilter}""/>
                                      </apex:selectList>                             
                                    </div>   
                                </div>
                            </div>-->
                                    
                            <div class=""slds-col filter-col"" style=""max-width:120px;"">                                
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"" for=""select-01""><b>Confidence</b></label>
                                    <div class=""slds-form-element__control"">                                                 
                                      <apex:selectList value=""{!dealConfidenceSelectedFilter}"" id=""dealConfidenceFilter"" multiselect=""true"" onchange=""dealConfidenceFilter(this); return false""  styleclass=""slds-select"">
                                          <apex:selectOptions value=""{!dealConfidenceFilter}""/>
                                      </apex:selectList>                       
                                    </div>   
                                </div>
                            </div>
                                    
                            <div class=""slds-col filter-col"" style=""max-width:150px; min-width:150px;"">                                
                                <div class=""slds-form-element"">
                                    <label class=""slds-form-element__label"" for=""select-01""><b>Account</b></label>
                                    <div class=""slds-form-element__control"">                                                 
                                      <apex:selectList style=""min-height:80px"" size=""2"" value=""{!accountSelectedFilter}"" id=""accountFilter"" styleclass=""slds-select"">
                                          <apex:selectOptions value=""{!accountFilter}""/>
                                      </apex:selectList>                        
                                    </div>   
                                </div>
                                <!--<div class=""autocomplete"" style=""margin-top:20px"">
                                    <input type=""text"" class=""slds-input slds-input--small""/>
                                </div>-->
                                <div class=""slds-form-element"">                                  
                                    <div class=""slds-form-element__control"">
                                        <input type=""text"" id=""accountName""/>
                                        <input type=""hidden"" id=""accountId"" value=""""/>
                                        <div id=""accountDiv""></div>
                                    </div>
                                </div>   
                            </div>
                            
                            <div class=""slds-col filter-col"" style=""max-width:120px;"">                                
                                <div class=""slds-form-element"">
                                   <label class=""slds-form-element__label"" for=""select-01""><b>Follow Up</b></label>
                                   <div class=""slds-form-element__control"">                                                 
                                      <apex:selectList value=""{!followUpSelectedFilter}"" id=""followUpFilter"" onchange=""followUpFilter(); return false"" styleclass=""slds-select"">
                                          <apex:selectOptions value=""{!followUpFilter}""/>
                                      </apex:selectList>                         
                                    </div>   
                                    <div class=""slds-form-element__control"" id=""followUpFrom"" style=""display:none"">
                                        <!--<div class=""slds-input-has-icon slds-input-has-icon--right"">-->   
                                            <label class=""slds-form-element__label"" for=""select-01""><b>From:</b></label>                                                                                                                 
                                            <apex:inputText value=""{!followUpFrom}"" id=""followupFromDate""  styleclass=""pickDate slds-input slds-input--small""/>
                                            <!--<c:SVGComponent styleClass=""slds-button__icon slds-icon-text-default"" path=""/assets/icons/utility-sprite/svg/symbols.svg#event""/>
                                        </div>-->
                                    </div>
                                    <div class=""slds-form-element__control"" id=""followUpTo"" style=""display:none"">
                                        <!--<div class=""slds-input-has-icon slds-input-has-icon--right"">-->
                                            <label class=""slds-form-element__label"" for=""select-01""><b>To:</b></label>  
                                            <apex:inputText value=""{!followUpTo}"" id=""followupToDate"" styleclass=""pickDate slds-input slds-input--small""/>
                                            <!--<c:SVGComponent styleClass=""slds-button__icon slds-icon-text-default"" path=""/assets/icons/utility-sprite/svg/symbols.svg#event""/>
                                        </div>-->
                                    </div>  
                                </div>                                  
                            </div>              
                    </div>  
                    <br/>  
                    <button class=""slds-button slds-button--brand slds-button--small"" onclick=""submitNewFilters(event); $('#filterOptions').slideUp(500); $('.slds-lookup__menu').addClass('slds-hide'); return false"" aria-live=""assertive"">Submit</button> 
                    <button class=""slds-button slds-button--brand slds-button--small"" onclick=""$('[id$=saveFilterPrompt]').modal('show'); manageBackdrop(); $('.slds-lookup__menu').addClass('slds-hide'); return false"" aria-live=""assertive"">Save</button>
                    <button class=""slds-button slds-button--brand slds-button--small"" onclick=""loadFilterCriteria(); $('.slds-lookup__menu').addClass('slds-hide'); return false"" aria-live=""assertive"">Load</button>
                    <button class=""slds-button slds-button--brand slds-button--small"" onclick=""$('[id$=clearFilterPrompt]').modal('show'); manageBackdrop(); $('.slds-lookup__menu').addClass('slds-hide'); return false"" aria-live=""assertive"">Clear</button>    
                    <button class=""slds-button slds-button--brand slds-button--small"" onclick=""$('#filterOptions').slideUp(500); $('.slds-lookup__menu').addClass('slds-hide'); return false "" aria-live=""assertive"">Close</button>
                    <br/>
                    <br/>  
                    
                </div>
              <script>initLookUp();</script>
          </apex:outputPanel>      
          
          <section id=""playbooxData"" style=""min-height:320px"">
              <apex:outputPanel id=""mainDiv"">             
                  <div class=""slds-grid slds-wrap dashboardDiv"">
                    <apex:variable var=""item"" value=""{!1}""/>
                    <apex:repeat value=""{!ModalData}"" var=""m"">
                        
                        <div class=""slds-col slds-col--padded slds-m-top--medium"" style=""max-width:350px !important;min-width:350px !important"">
                          
                          <ul class=""slds-list--horizontal slds-has-cards--space has-selections"" >
                              <!--onclick=""window.open('/{!opp.id}','_self')""-->
                              <li class=""slds-list__item"" onclick=""event.stopPropagation(); redirectToOppDetail('{!m.pIObj.opportunity__c}');"">
                                  
                                  <div class=""slds-tile slds-tile--board"">
                                      <table class=""tile-detail"">
                                          <tr>
                                              <td style=""font-size:15px"" onmouseover=""addThousandSeparator();""><b aria-live=""assertive"" data-aljs=""tooltip""  data-aljs-placement=""top"" title=""Account: {!m.pIObj.opportunity__r.Account.Name} <br/> Opportunity: {!m.pIObj.opportunity__r.Name} <br/> Deal Size: <span class='currencyFormat'>{!IF(ISBLANK(m.pIObj.opportunity__r.Amount) ,'0', ROUND(m.pIObj.opportunity__r.Amount,0))}</span> <br/> Owner: {!m.pIObj.opportunity__r.Owner.name} <br/> Lead Source: {!m.pIObj.opportunity__r.LeadSource}"">
                                              {!IF(LEN(m.pIObj.opportunity__r.Account.Name) > 42, LEFT(m.pIObj.opportunity__r.Account.Name,39)+' ...' , m.pIObj.opportunity__r.Account.Name)}&nbsp; </b></td>                                            
                                              <td rowspan=""4"" style=""text-align:right; vertical-align:top"">
                                                <div style=""font-size:35px; font-weight:bold; color : white;""><u style=""color: {!if(!m.onTrack, 'red', '')};""><span data-aljs=""tooltip"" data-aljs-placement=""{!IF(MOD(item,4) == 0, 'left', 'right')}"" title=""Score"">{!m.avgWinnScore}</span></u></div>
                                                <div style=""font-size:16px; font-weight:bold; color : rgb(222,45,45);""><span aria-live=""assertive"" data-aljs=""tooltip"" data-aljs-placement=""{!IF(MOD(item,4) == 0, 'left', 'right')}"" title=""{!m.pIObj.opportunity__r.RedFlagCount__c} red flags for this deal"">{!m.pIObj.opportunity__r.RedFlagCount__c}</span></div>
                                              </td>
                                          </tr>                                          
                                          <tr class=""popElementDS"">
                                              <td class=""dealSummaryTD popElementDS""><b class=""popElementDS"">{!IF(LEN(m.pIObj.opportunity__r.Name) > 42, LEFT(m.pIObj.opportunity__r.Name,39)+' ...' , m.pIObj.opportunity__r.Name)}</b>
                                                  <div class=""slds-popover slds-popover--tooltip slds-nubbin--top popElementDS slds-scrollable--y"" role=""dialog"" style=""position:absolute !important; top : 32% !important; max-height: 200px !important; display : none; max-width: none !important;"" onclick=""event.stopPropagation();"">
                                                      <div class=""slds-popover__body popElementDS"">
                                                          <table class=""dealSummary popElementDS"" style=""width: 550px"">
                                                              <thead class=""popElementDS"">
                                                                  <tr class=""slds-text-heading--label popElementDS"">
                                                                      <th colspan=""2"" class=""slds-truncate popElementDS"" style=""text-align: center; color: white;"">{!m.pIObj.opportunity__r.Name} Deal Summary</th>
                                                                  </tr>
                                                              </thead>
                                                              <tbody class=""popElementDS"">
                                                                  <apex:variable value=""{!0}"" var=""paddingIndex""/>
                                                                  <apex:repeat value=""{!m.dsList}"" var=""q"">
                                                                  <apex:variable value=""{!paddingIndex + 1}"" var=""paddingIndex""/>
                                                                  <tr class=""popElementDS"">
                                                                      <td class=""slds-truncate popElementDS"" style=""padding-top : {!if(paddingIndex == 1, '10px !important', '')}; width: 60% !important;"">{!q.quesDesc}</td>
                                                                      <td class=""slds-truncate popElementDS"" style=""padding-top : {!if(paddingIndex == 1, '10px !important', '')}; width: 40% !important"">
                                                                          <apex:outputPanel rendered=""{! (q.responseType == 'Date' || q.responseType == 'Percent' || q.responseType == 'Number' || q.responseType == 'Amount' || q.responseType == 'Text' || (q.responseType == 'DataMap' && q.datamapStr == 'text'))}"" layout=""none"">
                                                                              <span class=""popElementDS"">{!q.text}</span>
                                                                          </apex:outputPanel>
                                                                                
                                                                          <apex:outputPanel rendered=""{!q.responseType == 'Checkbox' || (q.responseType == 'DataMap' &&  q.datamapStr == 'checkbox')}"" layout=""none"">
                                                                              <div class=""slds-form-element__control popElementDS"">
                                                                                   <!-- <label class=""slds-checkbox popElementDS"">
                                                                                       <apex:inputCheckbox value=""{!q.check}"" onclick=""return false"" styleclass=""popElementDS""/>
                                                                                       <span class=""slds-checkbox--faux popElementDS""></span>
                                                                                   </label>-->
                                                                                   <apex:inputCheckbox value=""{!q.check}"" onclick=""return false"" styleclass=""popElementDS""/>
                                                                              </div>
                                                                          </apex:outputPanel>
                                                                          <apex:outputPanel rendered=""{!q.responseType == 'SingleChoice' || (q.responseType == 'DataMap' &&  q.datamapStr == 'singlechoice')}"" layout=""none"">
                                                                              <span class=""popElementDS"" style=""{!if(q.selectedSChoiceRedFlag, 'Color: Red; font-weight: 900;', '')}"">{!q.selectedSChoice}</span>
                                                                          </apex:outputPanel>
                                                                                
                                                                          <apex:outputPanel rendered=""{!q.responseType == 'MultiChoice' || (q.responseType == 'DataMap' &&  q.datamapStr == 'multichoice')}"" layout=""none"">
                                                                              <ul class=""popElementDS"" style=""float:left"">
                                                                                  <apex:repeat value=""{!q.selectedMChoice}"" var=""str"">
                                                                                      <li class=""popElementDS"" style=""{!if(q.selectedMChoiceRedFlagMap[str], 'Color: Red;  font-weight: 900;', '')}"">
                                                                                          {!str}
                                                                                      </li>
                                                                                  </apex:repeat>
                                                                              </ul>
                                                                          </apex:outputPanel>
                                                                      </td>
                                                                      
                                                                  </tr>
                                                                  </apex:repeat>
                                                              </tbody>
                                                          </table>  
                                                      </div>
                                                  </div>
                                              </td>                                             
                                          </tr>
                                          <tr>
                                              <td style=""color:InactiveBorder""> 
                                                  <span aria-live=""assertive"" data-aljs=""tooltip""  data-aljs-placement=""right"" title=""Close"">                                                 
                                                      <apex:outputText value=""{0,date,MMM dd, yyyy}"">
                                                          <apex:param value=""{!m.pIObj.opportunity__r.CloseDate}"" />
                                                      </apex:outputText>
                                                  </span>
                                              </td>
                                          </tr>
                                          <tr>
                                              <td style=""font-size:15px"" class=""paddingTopBottom10"" ><b aria-live=""assertive"" data-aljs=""tooltip""  data-aljs-placement=""right"" title=""Amount"">{!currencySymbol}<span class=""currencyFormat"">{!IF(ISBLANK(m.pIObj.opportunity__r.Amount) ,'0', ROUND(m.pIObj.opportunity__r.Amount,0))}</span> </b></td>
                                          </tr>
                                          <tr>
                                              <td colspan=""2"" style=""color:InactiveBorder"">
                                              <div class="""">
                                                  <span aria-live=""assertive"" data-aljs=""tooltip""  data-aljs-placement=""top"" title=""Sales Playbook and Current Stage"">
                                                  {!IF(LEN(m.pIObj.Name__c) > 20, LEFT(m.pIObj.Name__c,17)+' ...' , m.pIObj.Name__c)} :                                        
                                                  {!IF(LEN(m.pIObj.opportunity__r.StageName) > 20, LEFT(m.pIObj.opportunity__r.StageName,17)+' ...' , m.pIObj.opportunity__r.StageName)}
                                                  </span>
                                              </div>
                                              </td>
                                          </tr>
                                          <tr class=""popElement"">
                                              <td colspan=""2"" class=""openActivityTD popElement"" ><b class=""popElement"" aria-live=""assertive"" style=""color: {!if(m.openActivityPastDue, 'red !important;','')}"">Open Activities:</b>
                                                  <div class=""slds-popover slds-popover--tooltip slds-nubbin--top popElement slds-scrollable--y"" role=""dialog"" style=""position:absolute !important; top : 110% !important; max-height: 105px !important; display : none;"" onclick=""event.stopPropagation(); redirectToRelatedList('{!m.pIObj.opportunity__c}');"">
                                                      <div class=""slds-popover__body popElement"">
                                                          <table class=""activityTable popElement"">
                                                              <thead class=""popElement"">
                                                                  <tr class=""slds-text-heading--label popElement"">
                                                                      <td class=""slds-truncate popElement"">Subject</td>
                                                                      <td class=""slds-truncate popElement"">Contact Name</td>
                                                                      <td class=""slds-truncate popElement"">Due Date</td>
                                                                  </tr>
                                                              </thead>
                                                              <tbody class=""popElement"">
                                                                  <apex:variable value=""{!0}"" var=""paddingIndex""/>
                                                                  <apex:repeat value=""{!m.openActivityList}"" var=""activityRec"">
                                                                  <apex:variable value=""{!paddingIndex + 1}"" var=""paddingIndex""/>
                                                                  <tr class=""popElement"">
                                                                      <td class=""slds-truncate popElement"" style=""padding-top : {!if(paddingIndex == 1, '10px !important', '')}""><a class=""popElement openActivityAnchor"" href=""/{!activityRec.activityId}"" onclick=""event.stopPropagation();"" style=""color: {!if(activityRec.activityDate != NULL && activityRec.activityDate < TODAY(), 'red !important; font-weight: 900 !important','')}"">{!activityRec.subject}</a></td>
                                                                      <td class=""slds-truncate popElement"" style=""padding-top : {!if(paddingIndex == 1, '10px !important', '')}; color: {!if(activityRec.activityDate != NULL && activityRec.activityDate < TODAY(), 'red !important; font-weight: 900 !important','')}"">{!activityRec.whoName}</td>
                                                                      <td class=""slds-truncate popElement"" style=""padding-top : {!if(paddingIndex == 1, '10px !important', '')}; color: {!if(activityRec.activityDate != NULL && activityRec.activityDate < TODAY(), 'red !important; font-weight: 900 !important','')} "">
                                                                          <apex:outputText value=""{0,date,MM'/'dd'/'yyyy}"">
                                                                              <apex:param value=""{!activityRec.activityDate}"" /> 
                                                                          </apex:outputText>
                                                                      </td>
                                                                  </tr>
                                                                  </apex:repeat>
                                                              </tbody>
                                                          </table>  
                                                      </div>
                                                  </div>
                                              </td>
                                          </tr>
                                          <tr class=""popElement"">
                                              <td colspan=""2"" class=""popElement"">                                                  
                                                  <div class=""slds-grid popElement slds-scrollable--x"" style=""margin-top:10px; "">
                                                      <div role=""application"" class=""slds-tabs--path popElement"">
                                                        
                                                        <ul role=""tablist"" class=""slds-tabs--path__nav popElement"">
                                                        <apex:repeat value=""{!m.stageList}"" var=""s"">
                                                            
                                                          <li title=""{!s.stgName}""   style=""padding-right:0px; margin-left: 0; margin-right: 3px !important; width: 25px;"" role=""presentation"" tabindex=""1""   class=""popElement slds-tabs {!if(m.currentStagePos != null  && !ISNULL(m.pIObj.opportunity__r.StageName),if(s.sortP > m.currentStagePos,'slds-is-incomplete',if(s.sortP == m.currentStagePos,'slds-is-current','slds-is-complete')),'slds-is-incomplete')}""><!-- data-aljs=""tooltip""  data-aljs-placement=""top"" title=""{!s.stgName}""-->
                                                            <a aria-live=""assertive"" 
                                                            href=""javascript:void(0)"" 
                                                            role=""tab"" tabindex=""-1"" 
                                                            aria-selected=""false"" 
                                                            aria-controls=""content-path-1"" 
                                                            id=""tabs-path-1"" 
                                                            class=""slds-tabs--path__link popElement"">                                                                
                                                              <span class=""slds-tabs--path__title popElement"" ></span>
                                                            </a>
                                                          </li>    
                                                          </apex:repeat> 
                                                                                                                             
                                                        </ul>
                                                        
                                                      </div>  
                                                  </div>                                                  
                                                  
                                              </td>
                                          </tr>
                                      </table>
                                  </div>
                              </li>
                          
                          </ul>
                         
                        </div>
                        <apex:variable var=""item"" value=""{!item+1}""/>    
                    </apex:repeat>
                  </div>
                  <script>
                      /* Init all js */
                      initJS();
                  </script>
              </apex:outputPanel>
            </section>
          
            
            <!-- Save prompt modal -->
            <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""saveFilterPrompt"">
              <div class=""slds-modal__container slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium"">Save Filters</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <p>Are you sure to save new filters!</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                    <button class="" slds-button slds-button--brand"" data-aljs-dismiss=""modal"" onclick=""saveFilterCriteria(); return false"">Yes</button>
                    <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">No</button> 
                </div>
              </div>
            </div>
            <!-- End Save prompt Model -->
          
            <!-- Clear prompt modal -->
            <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""clearFilterPrompt"">
              <div class=""slds-modal__container slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium"">Clear Filters</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <p>Are you sure to clear all filters!</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                    <button class=""slds-button slds-button--brand"" data-aljs-dismiss=""modal"" onclick=""clearFilterCriteria(); return false"">Yes</button>
                    <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">No</button> 
                </div>
              </div>
            </div>
            <!-- End Clear prompt Model -->
          
        </apex:form>
        </div>
    </body>
    
    <script>      
          $(document).ready(function(){    
              oncompleteTasks();       
          });          
          
          function oncompleteTasks(){
              initJS();
              
              $('[data-aljs=""modal""]').modal({
                  onShow: manageBackdrop()
              });  
              //Add thousand separator
              addThousandSeparator();
              
              //Correct width of activity popover
              manageActivityPopoverWidth();
              
              //Activity popover hide show management
              activityPopoverManagement();
              
              dealSummaryPopoverManagement();
          }
          //used to prevent too much grey background on show popup again and again
          function manageBackdrop(){
              $('.aljs-modal-container').remove();
              $('.slds').append('<div class=""aljs-modal-container""><div class=""slds-backdrop slds-backdrop--open""></div>');
              
          }
          
          function activityPopoverManagement(){
              $('.openActivityTD').each(function(){ $(this).hover(function(){  $('.openActivityTD .slds-popover').hide(); $(this).children('.slds-popover').show();manageActivityPopoverWidth();   }); });
          }
          
          function dealSummaryPopoverManagement(){
              $('.dealSummaryTD').each(function(){ $(this).hover(function(){  $('.dealSummaryTD .slds-popover').hide(); $(this).children('.slds-popover').show(); }); });
              /*$('.popElementDS').click(function(event){
                  event.preventDefault();
              });*/
          }
          
          
          function manageActivityPopoverWidth(){
              $('.activityTable').each(function(){
                  $(this).parent().parent().css('max-width','' + ($(this).width() + 20) + 'px');
              });
          }
          
          function addThousandSeparator(){
              $('.currencyFormat').each(function(){
                  if($(this).text().indexOf(',') == -1)
                      $(this).text((parseInt($(this).text()).toLocaleString('em-US')));
              });
          }
        
          function initDatePicker(){
          
          }
          
          // Validate amount
        function validateChar(th){
            th.value = th.value.replace(/[^0-9]+/, '');
            if(th.value.length > 20){
                th.value = th.value.substr(0,th.value.length > 20 ? 20 : th.value.length);
            } else { 
                return;
            }
        }
        
        function validatePasteChar(th){
            setTimeout(function() {         
                th.value = th.value.replace(/[^0-9]+/, '');
                if(th.value.length > 20){
                    th.value = th.value.substr(0,th.value.length > 20 ? 20 : th.value.length);
                } else { 
                    return;
                }
            }, 10);
        } 
        
        function setPicklistValue(recordName, recordId, pickListClass){
            //console.log('test');
            //console.log(pickListClass);
            
            //var selecter = '[id$='+pickListClass+']';
            //$(selecter+' option[value!=""All""]').remove();
            
            //console.log(selecter);            
            //$(selecter).append('<option value='+recordId+'>'+recordName+'</option>');  
            //$(selecter+"" [value=""+recordId+""]"").prop(""selected"", true);  
            //$(selecter).val(recordId);    
            console.log(recordName+'&&'+recordId+'&&'+pickListClass);       
            resetPicklist(recordName+'&&'+recordId+'&&'+pickListClass); 
            
            setTimeout(function(){
            if(pickListClass == 'accountFilter')
                $('#accountName').val('');
            if(pickListClass == 'playbookFilter')
                $('#playbookName').val('');
            if(pickListClass == 'ownerFilter')
                $('#userName').val('');   
             },500);
        }
        
        function redirectToRelatedList(oppId){
            if({!$User.UIThemeDisplayed == 'Theme3'}){
                window.open('/007?id=' + oppId + '&rlid=RelatedActivityList&closed=0','_blank');    
            }else{
                location.href='/one/one.app?source=aloha#/sObject/' + oppId + '/rlName/OpenActivities/view';
            }
        }
        function redirectToOppDetail(oppId){
            if({!$User.UIThemeDisplayed == 'Theme3'}){
                window.open('/' + oppId,'_blank');    
            }else{
                location.href='/one/one.app?source=aloha#/sObject/' + oppId + '/view';
            }
        }
        
        //for activity popover
        $(document).mouseover(function(event) {
          ele = event.target;
          if(!$(ele).hasClass('popElement')){
             $('.openActivityTD .slds-popover').hide(); 
              
          }
          
          if(!$(ele).hasClass('popElementDS') && !$(ele).hasClass('dealSummaryTD')){
             $('.dealSummaryTD .slds-popover').hide(); 
              
          }
          
        });        
    </script>
    
  </html>
