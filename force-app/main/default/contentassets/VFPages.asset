                                      <h2 class=""slds-text-heading--small"">
                                          <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                            <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                          </svg>
                                          <span class=""createNoteErrorMsg""></span>
                                      </h2>
                                    </div>
                                  </div>
                                </div>
                                
                                <div class=""slds-form-element"">
                                    <label class=""formLabel slds-form-element__label"">Private</label>
                                    <div class=""slds-form-element__control"">
                                        <label class=""slds-checkbox"">
                                           <apex:inputCheckbox value=""{!noteInsertObj.isPrivate}"" />
                                           <span class=""slds-checkbox--faux""></span>
                                        </label>
                                    </div>
                                </div>
                                <div class=""slds-form-element slds-is-required"">
                                    <label class=""formLabel slds-form-element__label"">Title</label>
                                    <div class=""slds-form-element__control "">
                                        <apex:inputText id=""createNoteTitle"" value=""{!noteInsertObj.title}"" styleclass=""slds-input""/>    
                                    </div>
                                </div>
                                <div class=""slds-form-element"">
                                    <label class=""formLabel slds-form-element__label"">Body</label>
                                    <div class=""slds-form-element__control"">
                                        <apex:inputField value=""{!noteInsertObj.body}"" styleclass=""slds-textarea""/>    
                                    </div>
                                </div>
                                     
                            </div>
                            <div class=""slds-modal__footer"">
                                <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Cancel</button>
                                <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""checkValidation('CreateNote');return false"">Save</button>
                            </div>
                        </div>
                  </div>
                  <!--  create note modal end -->
                  
                  <!--  create competitor modal start -->
