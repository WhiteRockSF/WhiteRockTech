                       </apex:outputpanel>
                       <!--  Select Playbook modal start -->
                       <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""selectPlaybookModal"">
                            <div class=""slds-modal__container"">
                                <div class=""slds-modal__header"">
                                    <h2 class=""slds-text-heading--medium"">Playbook Lead</h2>
                                    <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                                        <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/> 
                                        <span class=""slds-assistive-text"">Close</span>
                                    </button>
                                </div>
                                <div class=""slds-modal__content"">
                                    <div>
                                        <h2 class=""slds-text-heading--small"">Choose Playbook you would like to use :</h2>
                                        <apex:outputpanel layout=""none"" rendered=""{!processSelectList.size == 0}"">
                                            <p class=""slds-text-body--regular slds-m-top--medium"">Playbook not exist! </p>
                                        </apex:outputpanel>
                                        <apex:outputpanel layout=""none"" rendered=""{!processSelectList.size > 0}"">
                                            <div class=""slds-scrollable--y"">
                                            <table class=""selectPlaybookTbl slds-table slds-table--bordered slds-m-top--medium"" style=""max-height:350px !important"">
                                                <tbody>
                                                  <apex:repeat value=""{!processSelectList}"" var=""p"">
                                                      <tr class=""slds-hint-parent"">
                                                          <td class=""selectPlaybookTd""  onclick=""selectPlaybookId(this,'{!p.id}');"" style=""cursor:pointer"">
                                                              <p class=""slds-truncate"">{!p.name__c}</p>
                                                          </td>
                                                      </tr>
                                                  </apex:repeat>
                                                </tbody>
                                            </table>
                                            </div>
                                        </apex:outputpanel>
                                    </div>
                                </div>
                                <div class=""slds-modal__footer"">
                                    <!-- <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Cancel</button> -->
                                    <apex:outputpanel layout=""none"" rendered=""{!processSelectList.size > 0}"">
                                        <button class=""slds-button slds-button--neutral slds-button--brand"" data-aljs-dismiss=""modal"" onclick=""bulkInsertion(''+selectedPlaybookID) ; return false"">Select</button>
                                    </apex:outputpanel>
                                    <apex:outputpanel layout=""none"" rendered=""{!processSelectList.size == 0}"">
                                        <button class=""slds-button slds-button--neutral slds-button--brand"" data-aljs-dismiss=""modal""  onclick=""bulkInsertion(''+selectedPlaybookID) ; return false"" disabled=""disabled"">Select</button>
                                    </apex:outputpanel>
                                </div>
                            </div>
                        </div>
                        <!-- Select Playbook modal end -->
                    </apex:outputpanel> 
                    
                    <!--  create question note modal start -->
                      <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""noteQuestionModal"">
                            <div class=""slds-modal__container"">
                                <div class=""slds-modal__header"">
                                    <h2 class=""slds-text-heading--medium"">Note</h2>
                                    <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                                        <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                                        <span class=""slds-assistive-text"">Close</span>
                                    </button>
                                </div>
                                <div class=""slds-modal__content"">
                                    <div class=""slds-form-element"">
                                        <div class=""slds-form-element__control "">
                                            <apex:inputTextArea id=""createNoteQuestion"" rows=""5"" value=""{!noteQuestion}"" styleclass=""slds-textarea""/>    
                                        </div>
                                    </div>
                                </div>
                                <div class=""slds-modal__footer"">
                                    <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">Cancel</button>
                                    <button class=""slds-button slds-button--neutral slds-button--brand"" data-aljs-dismiss=""modal""  onclick=""updateQuestionNote();return false"">Save</button>
                                </div>
                            </div>
                      </div>
                    <!--  create question note  modal end -->
                    
                </apex:actionRegion>
                
            </apex:form>
            <script>
                var selectedPlaybookID;
                
                var expandClassDis = '';
                var expandClassAss = '';
                  
                var dateHtml = '';
                  
                //used to show error notification in case of exception
                function showNotify(msg){
                    if(msg != undefined && msg.trim().length > 0){
                        $('.NotificationBoxText').text(msg);
                        $('.NotificationBox').slideDown(400);
                    }else{
                        $('.NotificationBox').slideUp(400);
                    }
                }
                
                function expandAfterSave(){
                    //alert('here');
                    if(expandClassDis.trim().length > 0){
                        var arr = expandClassDis.split("";"");
                        for(i = 0 ; i < arr.length ; i++){
                            if(arr[i].trim().length > 0){
                                $('.'+ arr[i]).show();
                            }
                        }
                    }
                    if(expandClassAss.trim().length > 0){
                        var arr2 = expandClassAss.split("";"");
                        for(i = 0 ; i < arr2.length ; i++){
                            if(arr2[i].trim().length > 0){
                                $('.'+ arr2[i]).show();
                            }
                        }
                    } 
                    expandClassDis = '';
                    expandClassAss = '';    
                }
                
                $(document).ready(function() {
                    $('[data-aljs=""modal""]').modal();
                   // alert(availableStageStr);
                    init(availableStageStr); 
                    
                });
                
                function manageStickyNote(){
                      //sticky note visibility correction by put <br> 
                      $('.stickyNoteAnchor').each(function(){
                          var titleTxt = $(this).attr('title');
                          if(titleTxt != undefined && titleTxt.trim().length > 40){
                              var titleRepTxt = '';
                              var loopobj = titleTxt.split(' '); 
                              //console.log('%%=;' + loopobj);
                              var loopStr = '';
                              var replacedStr = '';
                              for(var icounter = 0; icounter < loopobj.length; icounter++){
                                  loopStr += loopobj[icounter] + ' ';
                                  if(loopStr.length >  40){
                                      loopStr += '<br />';  
                                      replacedStr += loopStr;
                                      loopStr = ''; 
                                  }     
                              }
                              //console.log('##=replacedStr=' + replacedStr + loopStr);
                              $(this).attr('title', replacedStr + loopStr);             
                          }
                      });
                }
                
                //used to show thousand seprator in case of number answer
                function manageThousandSeprator(){
                      var currentLocale = '{!UserLocale}';
                      
                      console.log('locale=' + currentLocale);
                      if(currentLocale.length > 0){
                          //replace _ with - for eg: en_US with en-US
                          if(currentLocale.indexOf('_') != -1) currentLocale = currentLocale.replace('_','-');
                          $('.applyThousandSeprator').each(function(){
                              if($(this).text() != undefined && $(this).text().length > 0){
                                  $(this).text(parseInt($(this).text()).toLocaleString(currentLocale));     
                              }       
                          });
                      }
                  }
                
                function onCompleteTasks(errorMsg){
                    $('[data-aljs=""modal""]').modal({onShow: manageBackdrop()});   
                    $('.dt').datepicker();
                    $('[data-aljs=""tooltip""]').tooltip();
                    manageStickyNote();
                    manageThousandSeprator();
                    showNotify(errorMsg);
                    
                }
                
                //used to prevent too much grey background on show popup again and again
                function manageBackdrop(){
                    $('.aljs-modal-container').remove();
                    $('.slds').append('<div class=""aljs-modal-container""><div class=""slds-backdrop slds-backdrop--open""></div></div>');
                }
                
                function selectPlaybookId(ele,pId){
                    //$('.selectPlaybookTbl td').removeClass('slds-theme--shade');
                    //$(ele).addClass('slds-theme--shade');   
                    selectedPlaybookID = pId;
                    $('.selectPlaybookTd').css('background','transparent');
                    $(ele).css('background','#CCC');
                    
                }
                 
                function changeTab(btnId){
                    $('[id$=CallManagement]').hide();
                    $('[id$=SalesTools]').hide();
                    $('[id$=SalesTraining]').hide();
                  
                    $('[id$=CallManagementBtn]').removeAttr('style');
                    $('[id$=SalesToolsBtn]').removeAttr('style');
                    $('[id$=SalesTrainingBtn]').removeAttr('style');
                    $('[id$=' + btnId.substr(0,btnId.length-3) + ']').show(500);
                  //$('[id$=' + btnId + ']').css('background','#215968').css('border','1px solid #215968');
                    $('[id$=' + btnId + ']').css('background','#00599c').css('border','1px solid #00599c');
                      
               }
               
               function enaDisSaveBtn(flag , cls){
                  if(flag){
                      $('.'+cls).attr('disabled','disabled');
                  } 
               }
               
               function allowNumbersOnly(e,ele){
                  
                  //var code = e.which;
                  //console.log('#='+code);
                  if($(ele).val() != undefined && $(ele).val().trim().length > 0){
                      $(ele).val($(ele).val().replace(/[^0-9]+/, ''));   
                  }
                  /*if((code < 48 || code > 57) && (code < 96 || code > 105)){
                    if(code != 8 && code != 190 && code != 110){
                        //console.log('code = '+code);
                        e.preventDefault();
                    }
                  }*/
              }
              
              function allowPercentOnly(e,ele){
                  
                  //var code = e.which;
                  //console.log('#='+code);
                  if($(ele).val() != undefined && $(ele).val().trim().length > 0){
                      $(ele).val($(ele).val().replace(/[^0-9 .]+/, ''));   
                  }
                  /*if((code < 48 || code > 57) && (code < 96 || code > 105)){
                    if(code != 8 && code != 190 && code != 110){
                        //console.log('code = '+code);
                        e.preventDefault();
                    }
                  }*/
              }
               
               function changeCollapseBtn(cls,txtCls,size){
                  setTimeout(function() {
                   
                      var openFlag = false;
                      var closeFlag = false;
                      
                      for(var i = 1 ; i <= size ; i++){
                          if($('.'+cls+i).css('display') == 'none'){
                              closeFlag = true;
                              
                          }else{
                              closeFlag = false;
                              break;
                          }       
                      }
                      for(var i = 1 ; i <= size ; i++){
                          if($('.'+cls+i).css('display') != 'none'){
                              openFlag = true;
                          }else{
                              openFlag = false;
                              break;
                          }       
                      }
                      console.log('##openflag='+openFlag);
                      console.log('##closeflag='+closeFlag);
                          
                      if(openFlag){
                          $('.'+txtCls).text('Close All');
                          var svgIcon = $('.'+txtCls).prev().children().children().attr('xlink:href');
                          $('.'+txtCls).prev().children().attr('xlink:href',dashIcon);
                      }else if(closeFlag){
                          $('.'+txtCls).text('Open All');
                          var svgIcon = $('.'+txtCls).prev().children().children().attr('xlink:href');
                          $('.'+txtCls).prev().children().attr('xlink:href',addIcon);
                      }
                  },300);         
              }
               
               function collapseToggleAll(cls,txtCls,size){
                  if(size != undefined && size > 0){
                      if($('.'+txtCls).text() == 'Open All'){
                          for(var i = 1 ; i <= size ; i++){
                              $('.'+cls+i).show(250);
                              console.log('#' + cls+i)
                          }
                      }else if($('.'+txtCls).text() == 'Close All'){
                          for(var i = 1 ; i <= size ; i++){
                              $('.'+cls+i).hide(250);
                              console.log('#' + cls+i)
                          }
                      }
                      changeCollapseBtn(cls,txtCls,size);  
                  }
              }
               //This function is used to validate percent field
               function validatePercent(x,ele) {
                   if(x != undefined && x.trim().length > 0){
                        var validate = true;
                        var parts = x.split(""."");
                        if (typeof parts[1] == ""string"" && (parts[1].length == 0 || parts[1].length > 2))
                            validate = false;
                        var n = parseFloat(x);
                        if (isNaN(n))
                            validate = false;
                        if (n < 0 || n > 100)
                            validate = false;
                        
                        if(!validate){
                            alert('Please enter valid percentage!');
                            $(ele).focus();
                        }
                    }
               }
            </script>
        </body>
    </html>   
</apex:page>","2017-02-06T12:30:08.000Z","00515000006PhzjAAC","2017-03-09T11:58:01.000Z","00515000006PhzjAAC","2017-03-09T11:58:01.000Z"
"06615000003FmZFAA0","","PlaybooxBuilderDashboard","36.0","PlaybooxBuilderDashboard","","2","PlaybooxBuilderDashboardController","true","false","<apex:page controller=""PlaybooxBuilderDashboardController""  showHeader=""true"" standardStylesheets=""false"" sidebar=""false"" applyBodyTag=""false"" docType=""html-5.0"" applyHtmlTag=""true"" id=""thePage"">
  <apex:stylesheet value=""{!URLFOR($Resource.slds, 'assets/styles/salesforce-lightning-design-system-vf.css')}"" />
  <script src=""{!URLFOR($Resource.jquery,'jquery.min.js')}""></script>
  <script src=""{!URLFOR($Resource.aljs, 'jquery.aljs-init.min.js')}""></script>
  <script src=""{!URLFOR($Resource.aljs, 'jquery.aljs-modal.min.js')}""></script>
  <script src=""{!URLFOR($Resource.aljs, 'jquery.aljs-tooltip.min.js')}""></script>
   
  <script>
      var assetsLocation = '{!URLFOR($Resource.slds)}';
      $.aljsInit({
          assetsLocation: assetsLocation,
          scoped: true
      });
      
      var selectedExistProcessId = '';
      
  </script>
  
  <html xmlns=""http://www.w3.org/2000/svg"" xmlns:xlink=""http://www.w3.org/1999/xlink"">
      <head>
          <style>
              .custPopup{
                    left:45%;
                    top=57%;
                    z-index: 9999;
                    position:absolute; 
              } 
                
              .popupBackground{ 
                    background-color:white;
                    opacity: 0.30;
                    filter: alpha(opacity = 30);
                    position:absolute;
                    width: 100%;
                    height: 100%;
                    top: 0;
                    left: 0;
                    z-index: 9998; 
              }
              .slds-notify--toast {
                  margin:0px !important;
                  margin-top:8px !important;
                  margin-bottom:8px !important;
                  
              }
              
              /* Added new css : 3-25-2016 */
              .NewProcessAction{
                    display:block;
                    text-align:center;
                    padding:5px;
                    text-decoration:none !important;
                    color:#505050 !important
              }
              .checked{display:none;}
              
              .slds-backdrop--open {
                    opacity: 0.7 !important;
                    transition: opacity 0.4s linear 0s;
                    visibility: visible;
                }
                
              .slds-modal__header{
                background : #00599c !important;
                color : white !important;
            }
            .slds-modal__content{
                background:#f4f6f9 !important;
            }
            .slds-modal__footer{
                background:#adcfe6 !important;
            }
            .slds-list__item:hover{
                background: #0F9AD0 !important;
            }
            .formLabel{
                font-weight : bold !important;
            }
            .slds-modal{
                 height: auto !important;
            }
            .slds-modal__container{
                height: auto !important;
            }
            /*MAKE TILE COLOR DARK BLUE*/
            li.slds-list__item, li.slds-list__item:hover {
                background : #00599c !important;
            }
            
         /*MAKE TILE COLOR ACCORDING TO LEAD OR OPPORTUNITY*/
         /*
            .leadBackground, .leadBackground:hover{
                background : #003c71 !important;
            }
            
            .oppBackground, .oppBackground:hover{
                background : #00599c !important;
            }
          */
          </style>
          
      </head>
      <body>
        <div class=""slds"">
        <apex:form id=""frm"">
            <apex:pagemessages ></apex:pagemessages>
            <apex:outputPanel layout=""none"" rendered=""{!!insfPrivlFalse}"">
                <h2 style=""font-size:22px"">Insufficient Privileges!</h2>
            </apex:outputPanel>
            <apex:outputPanel layout=""none"" rendered=""{!insfPrivlFalse}"">
            
            <!-- Clone new process with exist process  -->
            <apex:actionFunction action=""{!cloneExistProcess}"" name=""saveCloneProcess"" status=""Status"" rerender=""mainDiv,existList"" oncomplete=""oncompleteTasks();"">
                <apex:param name=""processId"" value="""" assignto=""{!cloneProcessId}""/>
            </apex:actionFunction>
            
            <apex:actionFunction action=""{!changeProcessListOrder}"" status=""Status"" name=""changeListOrder"" rerender=""existList, orderButton"">
                <apex:param name=""order"" value="""" assignto=""{!listOrder}""/>     
            </apex:actionFunction>
            
            <apex:actionFunction action=""{!activeInactivePlaybook}"" status=""Status"" name=""inactivePlaybook"" rerender=""mainDiv"" oncomplete=""oncompleteTasks()"">
                <apex:param name=""pi"" value="""" assignto=""{!playbookIdForInactive}""/>     
            </apex:actionFunction>
            
          <!--  Action Status Start -->
          <apex:actionStatus id=""Status"" >
            <apex:facet name=""start""> 
             <apex:outputPanel id=""tstpopup""> 
                <apex:outputPanel styleClass=""popupBackground"" layout=""block"" style=""width:100%""/> 
                <apex:outputPanel styleClass=""custPopup"" layout=""block""> 
                    <div class=""slds-spinner--medium"">
                        <img src=""{!URLFOR($Resource.slds, 'assets/images/spinners/slds_spinner_brand.gif')}"" alt=""Loading..."" style=""margin-top:150%""/>
                    </div>
                </apex:outputPanel> 
             </apex:outputPanel> 
            </apex:facet> 
          </apex:actionStatus>  
          <!--  Action Status End -->
          
          <apex:actionfunction name=""createProcess"" action=""{!insertProcess}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks();""/>
          
          <section id=""header"">   
              <div class=""slds-page-header"" role=""banner"">
                  <div class=""slds-grid slds-p-vertical--small"">
                    <div class=""slds-col slds-has-flexi-truncate"">
                      <p class=""slds-text-heading--label"">Playboox Playbook</p>
                      <div class=""slds-grid"">
                        <div class=""slds-grid slds-type-focus slds-no-space"">
                            <h1 class=""slds-text-heading--large slds-truncate"" title=""Dashboard"">Dashboard</h1>
                            
                        </div>
                      </div>
                    </div>
                    <div class=""slds-col slds-no-flex slds-align-bottom"">
                      <div class=""slds-grid"">
                        <div class=""slds-button-space-left"" role=""group"">
                            <!-- Updated for show first screen when click on new process button -->
                          <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" aria-live=""assertive"" data-aljs=""modal"" data-aljs-show=""processFirstModal"">
                              <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--left"" path=""/assets/icons/utility-sprite/svg/symbols.svg#add""/>
                              New Playbook
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
              </div>
          </section>
          
          <section id=""playbooxData"">
              <apex:outputPanel id=""mainDiv"">
             
              <div class=""slds-grid slds-wrap dashboardDiv"">
                <apex:repeat value=""{!processList}"" var=""p"">                
                <div class=""slds-col slds-col--padded slds-m-top--medium"" style=""max-width:335px !important;min-width:335px !important"">
                  <ul class=""slds-list--horizontal slds-has-cards--space has-selections"" >                     
                      <li class=""slds-list__item {!IF(p.PlaybookEntityType__c == 'Lead', 'leadBackground' , 'oppBackground' )}"" style=""background:#00A1E0;color:white !important;min-width:180px !important;width:300px !important;max-width:300px !important;height:150px !important;min-height:100px;cursor:pointer;opacity:{!if(!p.active__c,'0.5','')}""  onclick=""window.open('/apex/PlaybooxBuilder?id={!p.id}','_self')"">
                          <div class=""slds-tile slds-tile--board"" style=""height:110px;min-height:70px"">
                            <p class=""slds-tile__title"">
                              <a class=""slds-text-heading--label"" href=""#"" style=""font-size:18px;color:white !important"">{!p.Name__c}</a>
                              <!-- <span class=""slds-badge slds-theme--inverse slds-float--right"" style=""font-size:22px"">{!if(p.points__c != null , p.points__c, '0')}</span> -->
                            </p>
                            <div class=""slds-tile__detail"">
                                <p class=""slds-m-top--medium"">Last Published : 
                                    <apex:outputField value=""{!p.PublishDate__c}""/>
                                </p>  
                            </div>
                          </div>
                          <section class=""slds-clearfix"">
                              <div class=""slds-float--left"">
                                  <a href=""javascript:void(0)"" class="""" aria-live=""assertive"" data-aljs=""tooltip"" style="""" onclick=""event.stopPropagation();editInactiveModal('{!p.id}',{!p.active__c});""  data-aljs-placement=""right"" title=""Set Playbook {!if(p.active__c,'Inactive','Active')}."">
                                      <c:SVGComponent styleClass=""slds-button__icon--stateful slds-button__icon--center"" path=""/assets/icons/utility-sprite/svg/symbols.svg#power"" cssStyle=""color:white;width:20px;height:20px""/>
                                  
                                  </a>
                              </div>
                              <!--
                              <div class=""slds-float--right"">
                                  <p>{!p.PlaybookEntityType__c}</p>
                              </div>
                              -->
                          </section>
                          
                      </li>
                  </ul>
                </div>
                </apex:repeat>
              </div>
              </apex:outputPanel>
          </section>
          
          <!-- Added on 3-25-2015 -->
          <!-- Desc : This is the first screen when go to create new playbook -->
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""processFirstModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium"">Create New Playbook</h2>
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-modal__close"" onclick=""$('#processFirstModal').modal('dismiss');"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </a>
                    </div>
                    <div class=""slds-modal__content"">
                        <h4>Choose the playbook template you want to use</h4>
                        <br/>
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" aria-live=""assertive"" data-aljs-dismiss=""modal"" onclick=""$('#processExistSelectModal').modal('show');"">Copy existing</a>
                      
                        <a href=""javascript:void(0)"" class=""NewProcessAction"" aria-live=""assertive"" data-aljs-dismiss=""modal"" onclick=""clearModal('processModal'); $('#processModal').modal('show'); switchBusinessProcessList();"">Create from blank</a>
                        <br/>
                        <br/>
                    </div>
                    
                    <div class=""slds-modal__footer"">
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" onclick=""$('#processFirstModal').modal('dismiss');"">Cancel</a>                     
                    </div>
                </div>
          </div>
          
          <!--  playbook inactive modal start-->
          <div>
            <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""inactiveModal"">
              <div class=""slds-modal__container  slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium inactiveModalHeading"">Inactive Playbook</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <apex:inputHidden id=""playbookIdForInactive"" value=""{!playbookIdForInactive}""/>
                  <div>
                    <p class=""inactiveModalData"">Are you sure to inactive ?</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                  <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""inactivePlaybook(''+$('[id$=playbookIdForInactive]').val());return false""> Yes </a>
                  <button class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"">No</button>
                </div>
              </div>
            </div>
            <div class=""slds-backdrop slds-backdrop--open""></div>
          </div>
          <!--  playbook inactive modal start-->
          
          <!-- Added on 3-25-2015 -->
          <!-- Desc : This is the second screen if we go to select from exiting -->
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""processExistSelectModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium"">Choose the playbook template you want to use</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button>
                    </div>
                    <div class=""slds-modal__content"">
                      <div class=""slds-form-element"">
                      
                         <ul class=""slds-picklist__options slds-picklist__options--multi shown"" style=""width:100%; height:auto;"">
                            <li class=""slds-picklist__item"" aria-label=""select-1"">
                                <span class=""slds-truncate"">
                                    <span>Playbook Name</span>
                                    <apex:outputPanel style=""position:absolute; top:0; right:0;"" id=""orderButton"">                                  
                                        <apex:outputPanel rendered=""{!listOrder == 'ASC'}""> 
                                            <button class=""slds-button slds-button--icon-container"" style=""font-size:30px"" onclick=""changeListOrder('DESC'); return false"">&#9652;</button>                    
                                        </apex:outputPanel> 
                                                                      
                                        <apex:outputPanel rendered=""{!listOrder == 'DESC'}"">    
                                            <button class=""slds-button slds-button--icon-container"" style=""font-size:30px"" onclick=""changeListOrder('ASC'); return false"">&#9662;</button>                                
                                        </apex:outputPanel>                                           
                                    </apex:outputPanel>                         
                                </span>
                            </li>
                         </ul>
                        
                          <apex:outputPanel layout=""block"" styleclass=""slds-picklist slds-picklist--multi"" id=""existList"">
                            <script>   
                                var selectedExistProcessId = '';      
                            </script>
                            <ul class=""slds-picklist__options slds-picklist__options--multi shown"" style=""width:100%"">
                            
                              <apex:repeat value=""{!processList}"" var=""p"">
                                  <li class=""slds-picklist__item"" aria-selected=""false"" role=""option"">
                                    <div class=""slds-grid"" >                                    
                                        <div class=""slds-col slds-size--4-of-12 "" style=""border-right: 6px solid #d8dde6; border-bottom: 1px solid #00599c; "">
                                            <span class="""" >
                                                <span>{!p.PlaybookEntityType__c}</span>
                                            </span>
                                        </div>
                                        <div class=""slds-col slds-size--8-of-12 "" style=""cursor:pointer; border-bottom: 1px solid #00599c;"" onclick=""selectExistProcess('{!p.id}'); $('.checked').hide(); $(this).find('.checked').show();"">
                                            <span class="""" >
                                                <span>&nbsp;{!p.Name__c}</span>
                                            </span>
                                            <span  class=""checked"" style=""float:right; margin-right: 10px;"">
                                                    &#10004;    
                                            </span>
                                        </div>                                        
                                    </div>                                     
                                  </li>                         
                              </apex:repeat>
                              
                            </ul>
                          </apex:outputPanel>
                          
                        </div>
                        
                    </div>
                    <div class=""slds-modal__footer"">
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""selectProcess(); return false"">Select</button>
                        <button class=""slds-button slds-button--neutral"" onclick=""$('#processFirstModal').modal('show'); manageBackdrop();"" data-aljs-dismiss=""modal"">Cancel</button>                     
                    </div>
                </div>
          </div>
          
          <!-- Process Modal Start -->
          <div aria-hidden=""true"" role=""dialog"" class=""slds-modal slds-fade-in-open slds-hide"" id=""processModal"">
                <div class=""slds-modal__container"">
                    <div class=""slds-modal__header"">
                        <h2 class=""slds-text-heading--medium processMdlHeading"">New Playbook</h2>
                        <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                            <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                            <span class=""slds-assistive-text"">Close</span>
                        </button>
                    </div>
                    <div class=""slds-modal__content"">
                        
                        <div class=""slds-notify-container createProcessNotify""  style=""position:relative;display:none"">
                          <div class=""slds-notify slds-notify--toast slds-theme--error"" role=""alert"" style=""min-width:100%"">
                            <span class=""slds-assistive-text"">Info</span>
                              
                            <a href=""javascript:void(0)"" class=""slds-button slds-button--icon-inverse slds-notify__close""  onclick=""$('.createProcessNotify').hide(100);"">
                              <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--medium"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                              <span class=""slds-assistive-text"">Close</span>
                            </a>
                            <div class=""notify__content"">
                              <h2 class=""slds-text-heading--small"">
                                  <svg aria-hidden=""true"" class=""slds-icon slds-icon--small slds-m-right--small slds-col slds-no-flex"">
                                    <use xlink:href=""{!URLFOR($Resource.slds, '/assets/icons/utility-sprite/svg/symbols.svg#warning')}""></use>
                                  </svg>
                                  <span class=""createProcessErrorMsg""></span>
                              </h2>
                            </div>
                          </div>
                        </div>
                        
                        <div class=""slds-form-element slds-is-required"">
                            <label class=""formLabel slds-form-element__label"">Playbook Name</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputText id=""createProcessName"" value=""{!processObj.Name__c}"" styleclass=""slds-input""/>
                            </div>
                        </div>
                        <div class=""slds-form-element"">
                            <label class=""formLabel slds-form-element__label"">Playbook Description</label>
                            <div class=""slds-form-element__control "">
                                <apex:inputTextArea value=""{!processObj.Description__c}"" styleclass=""slds-textarea""/>    
                            </div>
                        </div>
                        
                        <!-- Added new field to insert : Playbook Entity Type -->
                        <div class=""slds-form-element"">
                            <label class=""formLabel slds-form-element__label"">Playbook Opportunity or Lead?</label>                            
                            <div class=""slds-form-element__control"">
                              <div class=""slds-select_container"">                              
                                <apex:selectList value=""{!PlaybookEntityType}"" StyleClass=""slds-select"" size=""1"" id=""playBookEntityType"" onchange=""switchBusinessProcessList();"">
                                    <apex:selectOptions value=""{!PlaybookEntityTypeList}""/>
                                </apex:selectList>
                              </div>
                            </div>                       
                        </div>
                        <!-- Added new field to select sales process if exist -->
                        <div class=""slds-form-element"">
                            <label class=""formLabel slds-form-element__label oppSelected"" >Sales Process</label>      
                            <label class=""formLabel slds-form-element__label leadSelected"" >Lead Process</label>                      
                            <div class=""slds-form-element__control"">
                                <div class=""slds-select_container oppSelected"">                              
                                    <apex:selectList value=""{!oppBusinessProcessId}"" StyleClass=""slds-select"" size=""1"">
                                        <apex:selectOption itemLabel=""None"" itemValue=""""/>
                                        <apex:selectOptions value=""{!salesProcessList}""/>
                                    </apex:selectList>
                                </div>
                                <div class=""slds-select_container leadSelected"" >                              
                                    <apex:selectList value=""{!leadBusinessProcessId}"" StyleClass=""slds-select"" size=""1"">
                                        <apex:selectOption itemLabel=""None"" itemValue=""""/>
                                        <apex:selectOptions value=""{!leadProcessList}""/>
                                    </apex:selectList>
                                </div>
                            </div>                       
                        </div>
                        <!-- show only when opportunity is selected 3 feb 2017 -->   
                          
                        <div class=""slds-form-element oppSelected"" >
                            <label class=""formLabel slds-form-element__label"">ProgressThreshold(%)</label>
                            <div class=""slds-form-element__control"">
                                <apex:inputText id=""createProcessThreshold"" value=""{!processObj.ProgressThreshold__c}"" styleclass=""slds-input""/>
                            </div>
                        </div> 
                           
                    </div>
                    <div class=""slds-modal__footer"">                       
                        <button class=""slds-button slds-button--neutral slds-button--brand"" onclick=""checkValidation('CreateProcess');return false"">Save</button>
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" onclick=""$('#processFirstModal').modal('show'); return false; manageBackdrop();"" data-aljs-dismiss=""modal"">Cancel</a>
                    </div>
                </div>
          </div>
          <!-- Process Modal End -->
          <script>
      
                /* Added new functions below here to clone exist process : 3/25/2016 */
                
                /* Select a process to clone with new */
                function selectExistProcess(existProcessId){            
                    console.log('existProcessId ******* '+existProcessId);
                    selectedExistProcessId = '';
                    selectedExistProcessId = existProcessId;        
                }
                
                /* Start clone exist process when click select button from exist process modal */
                function selectProcess(){
                    if(selectedExistProcessId != ''){ 
                        saveCloneProcess(selectedExistProcessId);
                    }
                }
                
                  $(document).ready(function(){
                       $('[data-aljs=""modal""]').modal({onShow: manageBackdrop() });
                      $('[data-aljs=""tooltip""]').tooltip();
                      
                     // $(""li.slds-list__item:hover"").css(""background-color"",""red"");
                      //setCards();
                  });
                  
                  //used to prevent too much grey background on show popup again and again
                  function manageBackdrop(){
                      $('.aljs-modal-container').remove();
                      $('.slds').append('<div class=""aljs-modal-container""><div class=""slds-backdrop slds-backdrop--open""></div></div>');
                  }
                  
                  function setCards(){
                      if($('.dashboardDiv').children() != undefined && $('.dashboardDiv').children().length > 0){
                          var cLen = $('.dashboardDiv').children().length % 4;
                          for(var i = 0 ; i <= cLen ; i++){
                              $('.dashboardDiv').children().last().after('<div class=""slds-col slds-col--padded slds-m-top--medium"" style=""max-width:342px !important""></div>');
                          }
                      }
                  }
                  
                  function editInactiveModal(id,flag){
                      $('[id$=playbookIdForInactive]').val(id);
                      if(flag){
                        $('.inactiveModalData').text('Are you sure to inactive?');
                        $('.inactiveModalHeading').text('Inactive Playbook');
                        
                      }else{
                        $('.inactiveModalData').text('Are you sure to active?');
                        $('.inactiveModalHeading').text('Active Playbook');
                        
                      }
                      $('[id$=inactiveModal]').modal('show');manageBackdrop();
                  }
                  
                  function checkValidation(mdl){
                          
                     if(mdl == 'CreateProcess'){
                         if(($('[id$=createProcessName]').val() != undefined && $('[id$=createProcessName]').val() != null && $('[id$=createProcessName]').val().trim().length > 0)
                            &&
                            (  ($('[id$=createProcessThreshold]').val() != undefined && $('[id$=createProcessThreshold]').val() != null && $('[id$=createProcessThreshold]').val().trim().length > 0) || $('[id$=playBookEntityType]').val() == 'Lead' )
                         ){
                             $('.createProcessNotify').hide();
                             $('[id$=createProcessName]').parent().removeClass('slds-has-error');
                             $('[id$=createProcessThreshold]').parent().removeClass('slds-has-error');
                             $('.errorMsg').remove();
                             $('[id$=processModal]').modal('dismiss');
                             if($('.processMdlHeading').text() == 'New Playbook'){
                                 createProcess();
                             }else{
                                 updateProcess();
                             }  
                         }else{
                         
                            var hasError = false;
                            if($('[id$=createProcessName]').val().trim().length > 0){
                                $('[id$=createProcessName]').parent().removeClass('slds-has-error');                        
                            }else{
                                $('[id$=createProcessName]').parent().addClass('slds-has-error');
                                hasError = true;
                            }
                            
                            if($('[id$=createProcessThreshold]').val().trim().length > 0){
                                $('[id$=createProcessThreshold]').parent().removeClass('slds-has-error');                   
                            }else{
                                $('[id$=createProcessThreshold]').parent().addClass('slds-has-error');
                                hasError = true;
                            }
                            
                            if(hasError){
                                $('.createProcessNotify').show();
                                $('.createProcessErrorMsg').text('You must fill Required fields!');
                            }
                            
                            /*if($('.errorMsg').length == 0){
                                 var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                 $('[id$=createProcessName]').after(ele);
                            }*/
                         }
                     }
                 }
                 
                 function oncompleteTasks(){
                    $('[id$=processExistSelectModal]').modal('dismiss');    
                    
                    $('[data-aljs=""modal""]').modal({onShow: manageBackdrop()});
                    
                    $('[data-aljs=""tooltip""]').tooltip();      
                 }
                 
                 function clearModal(id){
                      var ele = $('[id$=' + id + ']').html();
                      $('[id$=' + id + ']').html('').html(ele);
                      $('.slds-notify-container').hide();
                      $('.slds-has-error').removeClass('slds-has-error');
                      $('.errorMsg').remove();
                      oncompleteTasks();
                      
                      //change heading
                      if(id == 'processModal'){
                          $('.processMdlHeading').text('New Playbook'); 
                      }
                  }  
                  
                  //make decision to show sales or lead process
                  var showLeadOrSalesProcessList = '{!PlaybookEntityType}';
                  if(showLeadOrSalesProcessList == 'Opportunity'){
                      $('.leadSelected').hide();
                  }else{
                      $('.oppSelected').hide();
                  }
                  
                  function switchBusinessProcessList(){                     
                      if($('[id$=playBookEntityType]').val() == 'Opportunity'){
                          $('.leadSelected').hide();
                          $('.oppSelected').show();                                                  
                      }else{
                          $('.oppSelected').hide();
                          $('.leadSelected').show();                     
                      }
                  }
                  
             </script>
          </apex:outputPanel>
        </apex:form>
        </div>
      </body>
      
  </html>
</apex:page>","2016-03-08T06:20:55.000Z","00515000006PjX3AAK","2017-03-07T09:49:24.000Z","00515000006PhzjAAC","2017-03-07T09:49:24.000Z"
