                                                                            <li>
                                                                                <a href=""{!if(BEGINS(LOWER(q.Link__c),'http://') || BEGINS(LOWER(q.Link__c),'https://'),q.Link__c,'http://' + q.Link__c)}""  target=""_blank"">{!q.Name__c}</a>
                                                                                <apex:outputPanel layout=""none"" rendered=""{!q.Tip__c != null && LEN(q.Tip__c) > 0}"">
