          <apex:actionfunction name=""createTraining"" action=""{!insertTraining}"" status=""Status"" rerender=""mainDiv"" oncomplete=""oncompleteTasks(); getPlayDetails('{!JSENCODE(playObjIdForUpdate)}');initializeInnerPlayDragging();""/>
          
