                              </div>
                              
                              <div class=""slds-size--1-of-2 slds-m-top--small"">
                                  <div class=""slds-form--horizontal"">
                                      <div class="""" style=""text-align:left"">
                                          <div class=""slds-form-element__control"" style=""width:14% !important"">
                                              <label class=""slds-checkbox"">
                                                   <apex:inputCheckbox id=""createTrainingIIPrd"" styleClass=""sectionCheckboxGroup6"" value=""{!trainingObj.IncludedInProduct__c}""/>
                                                   
                                                   <span class=""slds-checkbox--faux""></span>
                                              </label>
                                          </div>
                                          <label class=""slds-form-element__label"" style=""max-width:100% !important"">Training - Product</label>
                                      </div>
                                  </div>
                              </div>
                        </div> 
                        
                        </apex:outputPanel>
                        </apex:actionRegion>
                        <div class=""slds-form-element"">
                            <label class=""formLabel slds-form-element__label"">Add Content:</label>
                            <div class=""slds-form-element__control"">
                                <table style=""width:auto !important;"">
                                    
                                    <tr>
                                        <td>
                                            <a href=""javascript:void(0)"" >
                                                <span class=""fileUpload slds-button"" onclick=""$('[id$=selectedTrainingStr]').val('upload');$('.createTrainingLinkDiv').hide(100);$('.createTrainingselectContentDiv').hide(100);if({!libraryList.size} > 0){ $('.createTrainingselectLibDiv').show(100);}"" data-aljs=""tooltip"" data-aljs-placement=""right"" title=""Upload File"">
                                                    <c:SVGComponent styleClass=""slds-icon slds-icon-text-default contentIcons"" path=""/assets/icons/utility-sprite/svg/symbols.svg#attach""/>
                                                    <apex:inputFile styleclass=""upload"" value=""{!contversion.versionData}"" filename=""{!contversion.title}"" onclick=""$('.createToolLinkDiv').hide(100);"" onchange=""$('.emailFileNameTraining').text($(this).val().split('\\').pop())""/>
                                                    <span> <div class=""emailFileNameTraining truncate-cust"" style=""display: table-cell !important;"">{!contversion.title}</div></span>
                                                </span>
                                            </a>
                                        </td>
                                        <td>
                                            <a href=""javascript:void(0)"" onclick=""$('[id$=selectedTrainingStr]').val('link');$('.createTrainingLinkDiv').show(100);$('.upload').val('');$('.emailFileNameTraining').val('');$('.createTrainingselectLibDiv').hide(100);$('.createTrainingselectContentDiv').hide(100);"" style=""margin-left:10px"" data-aljs=""tooltip"" data-aljs-placement=""right"" title=""Add Link"">
                                                <c:SVGComponent styleClass=""slds-icon slds-icon-text-default contentIcons"" path=""/assets/icons/utility-sprite/svg/symbols.svg#link""/>
                                            </a>
                                        </td>
                                        <td>
                                            <a href=""javascript:void(0)"" onclick=""$('[id$=selectedTrainingStr]').val('content');$('.createTrainingLinkDiv').hide(100);$('.upload').val('');$('.emailFileNameTraining').val('');$('.createTrainingselectLibDiv').show(100);$('.createTrainingselectContentDiv').show(100);"" style=""margin-left:10px"" data-aljs=""tooltip"" data-aljs-placement=""right"" title=""Select SFDC Content"">
                                                <c:SVGComponent styleClass=""slds-icon slds-icon-text-default contentIcons"" path=""/assets/icons/utility-sprite/svg/symbols.svg#opened_folder""/>
                                            </a>
                                        </td>
                                        <td>
                                            <a href=""javascript:void(0)"" onclick=""$('[id$=selectedTrainingStr]').val('library');$('.createTrainingLinkDiv').hide(100);$('.upload').val('');$('.emailFileNameTraining').val('');$('.createTrainingselectLibDiv').show(100);$('.createTrainingselectContentDiv').hide(100);"" style=""margin-left:10px"" data-aljs=""tooltip"" data-aljs-placement=""right"" title=""Select SFDC Library"">
                                                <c:SVGComponent styleClass=""slds-icon slds-icon-text-default contentIcons"" path=""/assets/icons/utility-sprite/svg/symbols.svg#package""/>
                                            </a>
                                        </td>
                                    </tr>
                                </table>
                                    
                            </div>
                        </div>
                        <apex:actionRegion >
                            <apex:actionfunction name=""fillContentsTraining"" action=""{!fillContents}"" status=""StatusTraining"" rerender=""contentDivTraining"" oncomplete=""if($('[id=selectedTrainingStr]').val() == 'content'){$('.createTrainingselectContentDiv').show();}"">
                                <apex:param assignTo=""{!selectedLibId}"" name=""libid"" value=""""/>
                            </apex:actionfunction>
                            
                            <apex:outputPanel id=""trainingModalDiv2"" ><!-- style=""margin : 0px 5px 0px 0px !important;"" -->
                                <apex:inputHidden id=""selectedTrainingStr"" value=""{!selectedTrainingStr}"" /> 
          
                                <div class=""slds-form-element createTrainingLinkDiv"" style=""display:{!if(selectedTrainingStr == 'link','','none')}"">
                                    <label class=""formLabel slds-form-element__label"">Link</label>
                                    <div class=""slds-form-element__control"">
                                        <apex:inputText id=""createTrainingLink"" value=""{!trainingObj.Link__c}"" styleclass=""slds-input""/>
                                    </div>
                                </div>
                                <apex:outputPanel rendered=""{!libraryList.size > 0}"">
                                <div class=""slds-form-element createTrainingselectLibDiv"" style=""display:none"">
                                    <label class=""formLabel slds-form-element__label"">Select Library</label>
                                    <div class=""slds-form-element__control"">
                                        <apex:selectList value=""{!selectedLibId}"" size=""1"" styleclass=""slds-select"" onchange=""fillContentsTraining(this.value);return false""> 
                                            <apex:selectOptions value=""{!libraryList}"" />
                                        </apex:selectList>
                                    </div>
                                </div>
                                </apex:outputPanel>
                            </apex:outputPanel>
                            
                            <apex:outputpanel id=""contentDivTraining"">
                            <apex:outputPanel rendered=""{!contentList.size > 0}"">
                            <div class=""slds-form-element createTrainingselectContentDiv"" style=""display:{!if(selectedTrainingStr == 'content','','none')}"">
                                <label class=""formLabel slds-form-element__label"">Select Content</label>
                                <div class=""slds-form-element__control"">
                                    <apex:selectList value=""{!selectedContentId}"" size=""1"" styleclass=""slds-select""> 
                                        <apex:selectOptions value=""{!contentList}"" />
                                    </apex:selectList>
                                </div>
                            </div>
                            </apex:outputpanel>
                            </apex:outputPanel>
                             
                        </apex:actionRegion>           
                    </div>
                    <div class=""slds-modal__footer"">
                        <a href=""javascript:void(0)"" class=""slds-button slds-button--neutral"" data-aljs-dismiss=""modal"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop();"">Cancel</a>
                        <apex:commandButton value=""Save"" styleclass=""slds-button slds-button--neutral slds-button--brand"" action=""{!insertTraining}"" onclick=""checkTrainingValidations(event);""/>
                    </div>
                </div>
          </div>
          <!-- training Modal End -->
          
           
            <!-- Play drag drop confirm prompt modal -->
                        
             <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""playDropConfirmPrompt"">
              <div class=""slds-modal__container slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium"">Move Play</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <p>Are you sure to move play!</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                    <button class="" slds-button slds-button--brand"" id=""moveConfirm"">Yes</button>
                    <button class=""slds-button slds-button--neutral"" id=""noMove"" onclick=""stopPlayDrop(currentElement); return false"" data-aljs-dismiss=""modal"">No</button> 
                </div>
              </div>
            </div>
            
            <!-- End Quetions Model -->
            
            <!-- question drag drop confirm prompt modal -->
                        
             <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""questionDropConfirmPrompt"">
              <div class=""slds-modal__container slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium"">Move Question</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <p>Are you sure to move question!</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                    <button class="" slds-button slds-button--brand"" id=""moveConfirmQuestion"">Yes</button>
                    <button class=""slds-button slds-button--neutral"" id=""noMoveQuestion"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop();stopQuestionDrop(questionCurrentElement); return false;"" data-aljs-dismiss=""modal"">No</button> 
                </div>
              </div>
            </div>
            
            <!-- Quetions drag drop Model end -->
            <!-- Message drag drop confirm prompt modal -->
                        
             <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""messageDropConfirmPrompt"">
              <div class=""slds-modal__container slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium"">Move Message</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <p>Are you sure to move message!</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                    <button class="" slds-button slds-button--brand"" id=""moveConfirmMessage"">Yes</button>
                    <button class=""slds-button slds-button--neutral"" id=""noMoveMessage"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop();stopMessageDrop(msgCurrentElement); return false;"" data-aljs-dismiss=""modal"">No</button> 
                </div>
              </div>
            </div>
            
            <!-- Message drag drop Model end -->
            <!-- tool drag drop confirm prompt modal -->
                        
             <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""toolDropConfirmPrompt"">
              <div class=""slds-modal__container slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium"">Move Tool</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <p>Are you sure to move tool!</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                    <button class="" slds-button slds-button--brand"" id=""moveConfirmTool"">Yes</button>
                    <button class=""slds-button slds-button--neutral"" id=""noMoveTool"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop();stopToolDrop(toolCurrentElement); return false;"" data-aljs-dismiss=""modal"">No</button> 
                </div>
              </div>
            </div>
            
            <!-- Tool drag drop Model end -->
            
            <!-- training drag drop confirm prompt modal -->
                        
             <div aria-hidden=""false"" role=""dialog"" class=""slds-modal  slds-modal--prompt  slds-fade-in-open slds-hide"" id=""trainingDropConfirmPrompt"">
              <div class=""slds-modal__container slds-modal--prompt"">
                <div class=""slds-modal__header slds-theme--info slds-theme--alert-texture"">
                  <button class=""slds-button slds-button--icon-inverse slds-modal__close"" data-aljs-dismiss=""modal"">
                      <c:SVGComponent styleClass=""slds-button__icon slds-button__icon--large"" path=""assets/icons/action-sprite/svg/symbols.svg#close""/>
                      <span class=""slds-assistive-text"">Close</span>
                  </button>
                  <h2 class=""slds-text-heading--medium"">Move Training</h2>
                </div>
                <div class=""slds-modal__content slds-p-around--medium"">
                  <div>
                    <p>Are you sure to move training!</p>
                  </div>
                </div>
                <div class=""slds-modal__footer slds-theme--default"">
                    <button class="" slds-button slds-button--brand"" id=""moveConfirmTraining"">Yes</button>
                    <button class=""slds-button slds-button--neutral"" id=""noMoveTraining"" onclick=""$('[id$=playDetailModal]').modal('show');manageBackdrop();stopTrainingDrop(trainingCurrentElement); return false;"" data-aljs-dismiss=""modal"">No</button> 
                </div>
              </div>
            </div>
            
            <!-- Training drag drop Model end -->
           
            </apex:outputPanel>
            
            <script>
                  var selectedToolStr = '';
                  var selectedTrainingStr = '';
                  var stageOnEdit = '';                        
                  var deleteWhat = '';
                  var deletingId = '';
                  
                  
                  
                  $(document).ready(function(){
                      //console.log('##availableStageStr=' + availableStageStr);
                      fetchAvailableStagesOnly(availableStageStr); return false;
                      oncompleteTasks();
                          
                      /*if('{!JSENCODE(playObjIdForUpdate)}'.trim().length >= 15){
                          getPlayDetails('{!JSENCODE(playObjIdForUpdate)}'); return false;
                      }*/
                      
                      if($('#tabBar') != undefined && $('#tabBar') != null){
                          $('[class=slds]').css({width:($('#tabBar').width())+'px','overflow':'hidden'});
                      }
                      
                  });
                  
                  //used to prevent too much grey background on show popup again and again
                  function manageBackdrop(){
                      $('.aljs-modal-container').remove();
                      $('.slds').append('<div class=""aljs-modal-container""><div class=""slds-backdrop slds-backdrop--open""></div></div>');
                  }
               
                  function deleteRecord(){
                      if(deletingId.trim().length >= 15){
                          if(deleteWhat == 'stage'){
                              deleteStage(''+deletingId);
                          }else if(deleteWhat == 'play'){
                              deletePlay(''+deletingId);
                          }else if(deleteWhat == 'question'){
                              deleteQuestion(''+deletingId);
                          }else if(deleteWhat == 'message'){
                              deleteMessage(''+deletingId);
                          }else if(deleteWhat == 'tool'){
                              deleteTool(''+deletingId);
                          }else if(deleteWhat == 'training'){
                              deleteTraining(''+deletingId);
                          }
                      }
                  }
                  
                  function uncheckAllsectionCheckboxGroup1(ele,flag){
                      if(flag){
                          $('[id$=createQuestionIISuccessI]').prop('checked',false);
                          $('.sectionCheckboxGroup1').prop('checked',false);
                          $(ele).prop('checked',flag);
                      }
                  }
                  function uncheckAllsectionCheckboxGroup4(ele,flag){
                      if(flag){
                          $('.sectionCheckboxGroup4').prop('checked',false);
                          $(ele).prop('checked',flag);
                      }
                  }
                  function uncheckAllsectionCheckboxGroup5(ele,flag){
                      if(flag){
                          $('.sectionCheckboxGroup5').prop('checked',false);
                          $(ele).prop('checked',flag);
                      }
                  }
                  //for Training
                  function uncheckAllsectionCheckboxGroup6(ele,flag){
                      if(flag){
                          $('.sectionCheckboxGroup6').prop('checked',false);
                          $(ele).prop('checked',flag);
                      }
                  }
                  function uncheckAllsectionCheckboxGroup(ele,flag){
                      if(flag){
                          $('.sectionCheckboxGroup1').prop('checked',false);
                          $('.sectionCheckboxGroup2').prop('checked',false);
                          $('.sectionCheckboxGroup3').prop('checked',false);
                          $(ele).prop('checked',flag);
                      }
                  }
                  function uncheckAllsectionCheckboxGroup2(ele,flag){
                      if(flag){
                          $('[id$=createQuestionIISuccessI]').prop('checked',false);
                          $('.sectionCheckboxGroup2').prop('checked',false);
                          $(ele).prop('checked',flag);
                      }
                  }
                  function hideShowAnswerContentDiv(val){
                      if(val != 'SingleChoice' && val != 'MultiChoice'){
                          $('.answerContentDiv').hide(100);
                      }else{
                          $('.answerContentDiv').show(100);
                          var ele = $('.answerContentDiv').html();
                          $('.answerContentDiv').html('').html(ele);
                      }   
                  }
                  function dismisAllModal(){
                    $('[id$=playDetailModal]').modal('dismiss');
                    $('[id$=playModal]').modal('dismiss');
                    $('[id$=stageModal]').modal('dismiss');
                    $('[id$=questionModal]').modal('dismiss');
                    $('[id$=messageModal]').modal('dismiss');
                    $('[id$=toolModal]').modal('dismiss');
                    $('[id$=trainingModal]').modal('dismiss');
                    
                  }
                  function checkValidation(mdl){
                     if(mdl == 'CreateStage'){
                         
                         if($('[id$=createStageName]').val() != undefined && $('[id$=createStageName]').val() != null && $('[id$=createStageName]').val().trim().length > 0){
                             console.log('##=' + $('[id$=stagesForDuplicate]').val());
                             if($('[id$=stagesForDuplicate]').val() != undefined && $('[id$=stagesForDuplicate]').val() != null && $('[id$=stagesForDuplicate]').val().trim().length > 0 ){//&& $('[id$=createStageName]').val() != stageOnEdit
                                 var stageArr = $('[id$=stagesForDuplicate]').val().trim().split(';');
                                 var flagForDuplicate = false;
                                 for(var i = 0 ; i < stageArr.length ; i++){
                                    console.log('##1=$([id$=createStageName]).val().trim()= '+ $('[id$=createStageName]').val().trim());
                                    console.log('##1=$(stageArr[i].trim()= '+ stageArr[i].trim() );
                                    
                                    if($('[id$=createStageName]').val().trim() == stageArr[i].trim()){
                                        //console.log('##=true');
                                        flagForDuplicate = true;
                                        break;
                                    }
                                 }
                                 
                                 if(flagForDuplicate){
                                     $('.createStageNotify').show();
                                     <!--6th feb to make app dynamic according to opportunity or lead -->
                                     var isLeadPlay = '{!processObj.PlaybookEntityType__c}';
                                     if(isLeadPlay == 'Lead')
                                         $('.createStageErrorMsg').text('Duplicate Status is not allowed!');
                                     else
                                         $('.createStageErrorMsg').text('Duplicate Stage is not allowed!');
                                         
                                     $('[id$=createStageName]').parent().addClass('slds-has-error');
                                     if($('.errorMsg').length == 0){
                                         var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                         $('[id$=createStageName]').after(ele);
                                     
                                     }
                                 }else{
                                     $('.createStageNotify').hide();
                                     $('[id$=createStageName]').parent().removeClass('slds-has-error');
                                     $('.errorMsg').remove();
                                     $('[id$=stageModal]').modal('dismiss');                                    
                                     if($('.stageMdlHeading').text() == 'New Stage' || $('.stageMdlHeading').text() == 'New Status'){                                         
                                         createStage();
                                     }else{
                                         updateStage();
                                     }  
                                 }
                             }else{
                                 $('.createStageNotify').hide();
                                 $('[id$=createStageName]').parent().removeClass('slds-has-error');
                                 $('.errorMsg').remove();
                                 $('[id$=stageModal]').modal('dismiss');
                                 if($('.stageMdlHeading').text() == 'New Stage' || $('.stageMdlHeading').text() == 'New Status'){
                                     createStage();
                                 }else{
                                     updateStage();
                                 }  
                             }
                             
                             
                         }else{
                             $('.createStageNotify').show();
                             $('.createStageErrorMsg').text('You must have to select stage name!');
                             $('[id$=createStageName]').parent().addClass('slds-has-error');
                             if($('.errorMsg').length == 0){
                                 var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                 $('[id$=createStageName]').after(ele);
                             
                             }
                         }
                     }else if(mdl == 'CreatePlay'){
                         if($('[id$=playNameId]').val() != undefined && $('[id$=playNameId]').val() != null && $('[id$=playNameId]').val().trim().length > 0){
                             $('.createPlayNotify').hide();
                             $('[id$=playNameId]').parent().removeClass('slds-has-error');
                             $('.errorMsg').remove();
                             $('[id$=playModal]').modal('dismiss');
                             //alert(stageIdForInsertedPlay + ' - ' + x1);
                             if($('.playMdlHeading').text() == 'New Play'){
                                createPlay(stageIdForInsertedPlay);
                             }else{
                                updatePlay();
                             }
                         }else{
                             $('.createPlayNotify').show();
                             $('.createPlayErrorMsg').text('You must have to give play name!');
                             $('[id$=playNameId]').parent().addClass('slds-has-error');
                             if($('.errorMsg').length == 0){
                                 var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                 $('[id$=playNameId]').after(ele);
                             }
                         }
                     }else if(mdl == 'CreateProcess'){
                         //alert('here');
                         var objType = '{!processObj.PlaybookEntityType__c}';
                         if($('[id$=createProcessName]').val() != undefined && $('[id$=createProcessName]').val() != null && $('[id$=createProcessName]').val().trim().length > 0
                            && ( objType == 'Lead' || ($('[id$=createProcessProgressT]').val() != undefined && $('[id$=createProcessProgressT]').val() != null && $('[id$=createProcessProgressT]').val().trim().length > 0))
                         ){
                             $('.createProcessNotify').hide();
                             $('[id$=createProcessName]').parent().removeClass('slds-has-error');
                              $('[id$=createProcessProgressT]').parent().removeClass('slds-has-error');
                             $('.errorMsg').remove();
                             $('[id$=processModal]').modal('dismiss');                            
                             updateProcess();
                         }else{
                             /*$('.createProcessNotify').show();
                             $('.createProcessErrorMsg').text('You must have to give process name!');
                             $('[id$=createProcessName]').parent().addClass('slds-has-error');
                             if($('.errorMsg').length == 0){
                                 var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                 $('[id$=createProcessName]').after(ele);
                             }
                             */
                            
                            var hasError = false;
                            if($('[id$=createProcessName]').val().trim().length > 0){
                                $('[id$=createProcessName]').parent().removeClass('slds-has-error');                        
                            }else{
                                $('[id$=createProcessName]').parent().addClass('slds-has-error');
                                hasError = true;
                            }
                            
                            if($('[id$=createProcessProgressT]').val().trim().length > 0){
                                $('[id$=createProcessProgressT]').parent().removeClass('slds-has-error');                   
                            }else{
                                $('[id$=createProcessProgressT]').parent().addClass('slds-has-error');
                                hasError = true;
                            }
                            
                            if(hasError){
                                $('.createProcessNotify').show();
                                $('.createProcessErrorMsg').text('You must fill Required fields!');
                            }
                         }
                       
                            
                     }else if(mdl == 'CreateQuestion'){
                         if($('[id$=createQuestionDesc]').val() === undefined || $('[id$=createQuestionDesc]').val() == null || $('[id$=createQuestionDesc]').val().trim().length == 0){
                             $('.createQuestionNotify').show();
                             $('.createQuestionErrorMsg').text('You must have to give Question!');
                             $('[id$=createQuestionDesc]').parent().addClass('slds-has-error');
                             if($('.errorMsg').length == 0){
                                 var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                 $('[id$=createQuestionDesc]').after(ele);
                             }
                         
                         }else if($('[id$=createQuestionIIDealP]').prop('checked') && $('[id$=createQuestionAnsType]').val() != 'Checkbox'){
                             $('.createQuestionNotify').show();
                             $('.createQuestionErrorMsg').text('Answer Type must be of Checkbox type ,if you selected Include In Deal Progress!');
                         }else if($('[id$=createQuestionIISuccessI]').prop('checked') && $('[id$=createQuestionAnsType]').val() != 'Rating'){
                             $('.createQuestionNotify').show();
                             $('.createQuestionErrorMsg').text('Answer Type must be of Rating type ,if you selected Include In Success Indicator!');
                         }else if($('[id$=createQuestionIIKeyM]').prop('checked') && $('[id$=createQuestionAnsType]').val() != 'Date'){
                             $('.createQuestionNotify').show();
                             $('.createQuestionErrorMsg').text('Answer Type must be of Date type ,if you selected Include In Key Milestones!');
                         
                         }else if($('[id$=createQuestionAnsType]').val() == 'MultiChoice' || $('[id$=createQuestionAnsType]').val() == 'SingleChoice'){
                             $('.createQuestionNotify').hide();
                             $('[id$=createQuestionDesc]').parent().removeClass('slds-has-error');
                             $('.errorMsg').remove();
                             
                             var flag = false;
                             
                             $('.answers').each(function(index){
                                if($(this).val().trim().length > 0){
                                    flag = true; 
                                }       
                             });
                             
                             if(flag == false){
                                $('.createQuestionNotify').show();
                                $('.createQuestionErrorMsg').text('You must have to give atleast one answer!');
                             
                             }else{
                                $('.createQuestionNotify').hide();
                                $('[id$=createQuestionDesc]').parent().removeClass('slds-has-error');
                                $('.errorMsg').remove();
                                $('[id$=questionModal]').modal('dismiss');
                                if($('.questionMdlHeading').text() == 'New Question'){
                                    createQuestion();
                                }else{
                                    updateQuestion();
                                }
                             }
                         }else{
                             $('.createQuestionNotify').hide();
                             $('[id$=createQuestionDesc]').parent().removeClass('slds-has-error');
                             $('.errorMsg').remove();
                             $('[id$=questionModal]').modal('dismiss');
                             if($('.questionMdlHeading').text() == 'New Question'){
                                createQuestion();
                             }else{
                                updateQuestion();
                             }
                         }
                     }else if(mdl == 'CreateMessage'){
                              
                         if(CKEDITOR.instances['thePage:frm:createMessageMsg'].getData().length > 0){//CKEDITOR.instances['thePage:frm:createMessageMsg'].getData().length > 0
                             $('.createMessageNotify').hide();
                             $('[id$=createMessageMsg]').parent().removeClass('slds-has-error');
                             $('.errorMsg').remove();
                             $('[id$=messageModal]').modal('dismiss');
                             if($('.messageMdlHeading').text() == 'New Message'){
                                createMessage();
                             }else{
                                updateMessage();
                             }
                         }else{
                             $('.createMessageNotify').show();
                             $('.createMessageErrorMsg').text('You must have to give Message!');
                             $('[id$=createMessageMsg]').parent().addClass('slds-has-error');
                             if($('.errorMsg').length == 0){
                                 var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                 $('[id$=createMessageMsg]').after(ele);
                             }
                         }    
                             
                     }
                  }
                  function fillRichTextArea(html,flag){
                      CKEDITOR.instances['thePage:frm:createMessageMsg'].setData(html);
                      if(flag)
                        //$('.cke_chrome').last().remove();
                        $('[id$=createMessageMsg]').last().remove();
                      else{
                        $('.cke_button_on').addClass('cke_button_off').removeClass('cke_button_on');
                      }
                      //$('.cke_editor_thePage:frm:createMessageMsg:textAreaDelegate_' + '{!NamespacePrifix}' + 'Description__c').last().remove();
                            
                  }
                  function fillRichTextAreaQuestionTip(html,flag){
                      CKEDITOR.instances['thePage:frm:createQuestionTip'].setData(html);
                      console.log('#flag' + flag);
                      if(flag)
                        $('[id$=createQuestionTip]').last().remove();
                      else{
                        $('.cke_button_on').addClass('cke_button_off').removeClass('cke_button_on');
                      }
                  }
                  function checkToolValidations(event){
                         if($('[id$=createToolLbl]').val() != undefined && $('[id$=createToolLbl]').val() != null && $('[id$=createToolLbl]').val().trim().length > 0){
                             $('.createToolNotify').hide();
                             $('[id$=createToolLbl]').parent().removeClass('slds-has-error');
                             $('.errorMsg').remove();
                             
                         }else{
                             $('.createToolNotify').show();
                             $('.createToolErrorMsg').text('You must have to give Label!');
                             $('[id$=createToolLbl]').parent().addClass('slds-has-error');
                             if($('.errorMsg').length == 0){
                                 var ele = '<span class=""errorMsg slds-form-element__help"">This field is required</span>';
                                 $('[id$=createToolLbl]').after(ele);
                             }
                             event.preventDefault();
          
                         }    
                     
                  }
                  
