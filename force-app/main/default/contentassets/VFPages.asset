                  <c:Lightning_Lookup /><!-- it will include SOAP API files also -->
                  <script>
                    //SCRIPT TO GET AVAILABLE STAGES RELATED TO PERTICULAR RECORD TYPE
                    var availableStageStr = '';
                    if('{!currentRecordTypeId}' != null && '{!currentRecordTypeId}'.trim().length > 14){
                        var result = sforce.connection.describeLayout('Opportunity', new Array('{!currentRecordTypeId}'));
                        var res = result.getArray('recordTypeMappings')[0].picklistsForRecordType;
                        
                        for(var index=0; index<res.length; index++ ){
                          if(res[index].picklistName == 'StageName'){
                            for(var j = 0; j < res[index].picklistValues.length; j++){
                                if(res[index].picklistValues[j].active){
                                    availableStageStr += res[index].picklistValues[j].value + '___';        
                                    //console.log(availableStageStr);
                                }
                            }
                            
                          }
                          $('[id$=one1] [id$=start]').show();
                        }
                    }
                    
                    
                    //var dependentOptionsMapCompatible = [];
                    /*for(var key in getDependentOptions(OBJ_NAME, CTRL_FIELD_NAME, DEP_FIELD_NAME)){
                        //var innerObj;
                        var strKey = ''+ key;
                        console.log('##='+key);
                        dependentOptions[key] = 
                        if(dependentOptions[key].length > 0){
                            var innerObj = {strKey : dependentOptions[key][0]};        
                            dependentOptionsMapCompatible.push(innerObj);
                        }    
                    }*/
                    //alert();
                    //console.log('#==#='+JSON.stringify(dependentOptions));
                    
                  </script>
                  
