                  function fillModalValuesForEditStage(stgId,stgName,stgDesc,isLib){
                      $('[id$=stageIdForEdit]').val(stgId);
                      $('[id$=createStageName]').val(stgName);
                      stageOnEdit = stgName;
                      $('[id$=createStageDesc]').val(stgDesc);
                      if(isLib == true){
                        $('[id$=createStageIsLibrary]').prop('checked','true');
                      }
                      $('.stageMdlHeading').text('Edit Stage');       
                  }
                  function fillModalValuesForEditProcess(pName,Desc,th){
                      $('[id$=createProcessName]').val(pName);
                      $('[id$=createProcessDesc]').val(Desc);
                      $('[id$=createProcessProgressT]').val(''+th);
                  }
                  
