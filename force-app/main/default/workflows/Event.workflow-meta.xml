<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Send_Mike_a_notification</fullName>
        <description>Send Mike a notification</description>
        <protected>false</protected>
        <recipients>
            <recipient>michael@whiterocktech.net</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/NewMeetingSet</template>
    </alerts>
    <rules>
        <fullName>Meetings Set</fullName>
        <actions>
            <name>Send_Mike_a_notification</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Event.CreatedById</field>
            <operation>contains</operation>
            <value>jamaro</value>
        </criteriaItems>
        <criteriaItems>
            <field>Event.Subject</field>
            <operation>equals</operation>
            <value>Meeting</value>
        </criteriaItems>
        <description>When SDR sets meetings for Mike, notify via email to Mike that the SFDC calendar has a new meeting to look at and follow up with prospect by sending info.</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
</Workflow>
