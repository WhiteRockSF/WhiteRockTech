<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>New_or_In_Process_Production</fullName>
    <active>false</active>
    <errorConditionFormula>AND(TEXT(Production__r.Work_In_Process_Status__c)  &lt;&gt; &apos;New&apos;,
TEXT(Production__r.Work_In_Process_Status__c)  &lt;&gt; &apos;In Process&apos;,
NOT(ISBLANK( Production__c )))</errorConditionFormula>
    <errorMessage>Only Production Tickets with the status of New or In Process can have timecards created.</errorMessage>
</ValidationRule>
