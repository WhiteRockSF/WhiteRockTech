<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Current_or_Previous_Month__c</fullName>
    <formula>IF(OR(
AND(MONTH(Date_of_Service__c)=MONTH(TODAY()),
YEAR(Date_of_Service__c)=YEAR(TODAY())),
AND(MONTH(Date_of_Service__c)=MONTH(ADDMONTHS(TODAY(),-1)),
YEAR(Date_of_Service__c)=YEAR(ADDMONTHS(TODAY(),-1)))),
TRUE,
FALSE)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Current or Previous Month</label>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
