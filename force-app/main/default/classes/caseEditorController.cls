public without sharing class caseEditorController {
    @AuraEnabled
    public static List<Case> getRecords(String recId){
       return [SELECT Id,  Trello_Description__c, Subject, Type FROM Case WHERE Id =: recId LIMIT 1];
    }

    @AuraEnabled
    public static String save(String record){

        Case oppRec = (Case)JSON.deserialize(record, Case.class);
        Database.update(oppRec, false);
        return '';
    }

    @AuraEnabled
    public static String createNew(String record){

        Case oppRec = (Case)JSON.deserialize(record, Case.class);
        Database.insert(oppRec, true);
        return 'success';
    }

