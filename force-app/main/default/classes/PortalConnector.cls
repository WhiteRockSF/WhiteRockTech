public without sharing class PortalConnector {

    public static String doCallout(String url, String method, Map<String,Object> body, String token) {
        return doCallout(url, method, JSON.serialize(body), token);        
    }

    public static String doCallout(String url, String method, String body, String token) {
        Http h = new Http();
        
        HttpRequest req = new HttpRequest();
       
        req.setEndpoint(url);
        req.setMethod(method);
        if (String.isNotBlank(token)) {
            req.setHeader('Authorization', 'Bearer ' + token);
        }
        
        req.setTimeout(120000);
         
        if (String.isNotBlank(body)) {
            req.setHeader('Content-Type', 'application/json');
            req.setBody(body);
        }   

        HttpResponse res = h.send(req);
        system.debug( res.getBody());
        return res.getBody();
        
    }

